@article{cabelloc.m.Cancer2009,
  title = {Cancer},
  author = {{Cabello C.M.} and {Lamore S.D.} and {Bair W.B.} and {Bause A.S.} and {Azimian S.} and {Wondrak G.T.}},
  year = {2009},
  month = jan,
  journal = {Free Radic. Biol. Med.},
  volume = {47},
  number = {SUPPL 1},
  pages = {S166--S180},
  publisher = {Elsevier BV},
  abstract = {Altered redox homeostasis involved in the control of cancer cell survival and proliferative signaling represents a chemical vulnerability that can be targeted by prooxidant redox intervention. Here, we demonstrate that the redox dye 2,6- dichlorophenolindophenol (DCPIP) may serve as an experimental chemotherapeutic that targets NQO1*2 breast cancer in vitro and in vivo. This homozygous common missense genotype [NM-000903.2:c.558C{$>$}T] encoding the functionally impaired NQO1 (NAD(P)H:quinone oxidoreductase) P187S protein strongly predicts poor survival among women with breast cancer. MDA- MB-231 mammary adenocarcinoma cells displaying the NQO1*2 genotype were exquisitely sensitive to DCPIP-induced caspase independent cell death. Induction of mitochondrial oxidative stress with early loss of transmembrane potential was followed by nuclear DNA damage with phosphorylation of p53 at Ser 15 and massive depletion of cellular ATP and glutathione. Potency of DCPIP-cytotoxicity in a panel of human melanoma and breast cancer cell lines was inversely correlated with constitutive NQO1 expression levels. Moreover, genetic alteration of NQO1 expression either potentiated (NQO1-siRNA) or reversed (NQO1- overexpression) DCPIP-chemosensitivity. Expression array analysis revealed a DCPIP-induced stress response in MDA-MB- 231 cells with massive up-regulation of genes encoding Hsp70B' (HSPA6), Hsp70 (HSPA1A), heme oxygenase-1 (HMOX1), glutathione S-transferase mu 3 (GSTM3), and p21 (CDKN1A) further confirmed by immunodetection. Systemic administration of DCPIP displayed significant activity in the MDA-MB-231 murine xenograft model of NQO1*2 breast adenocarcinoma. These findings suggest feasibility of targeting NQO1*2 breast cancer (and other malignancies that display low or absent NQO1 enzymatic activity) using DCPIP as a genotype-specific experimental redox chemotherapeutic.},
  langid = {english},
  keywords = {*breast cancer,*chemotherapy,*free radical,*genotype,*society,2,6 dichlorophenolindophenol,adenosine triphosphate,breast adenocarcinoma,cancer cell,cancer cell culture,caspase,cell death,cell nucleus DNA,cell survival,chemosensitivity,cytotoxicity,DNA,DNA damage,dye,enzyme activity,female,gene,glutathione,glutathione transferase M3,heme oxygenase 1,homeostasis,human,immunodetection,in vitro study,melanoma,membrane potential,model,ovid_export_ris.ris,oxidative stress,phosphorylation,protein,protein p53,reduced nicotinamide adenine dinucleotide (phosphate) dehydrogenase (quinone),small interfering RNA,stress,survival,upregulation,xenograft}
}

@article{cabelloDCPIP26dichlorophenolindophenolGenotypedirected2011,
  title = {{{DCPIP}} (2,6-Dichlorophenolindophenol) as a Genotype-Directed Redox Chemotherapeutic Targeting {{NQO1}}*2 Breast Carcinoma},
  author = {Cabello, Christopher M and Lamore, Sarah D and Bair, 3rd, Warner B and Davis, Angela L and Azimian, Sara M and Wondrak, Georg T},
  year = {2011},
  month = mar,
  journal = {Free Radic. Res.},
  volume = {45},
  number = {3},
  pages = {276--292},
  publisher = {Informa Healthcare (69-77 Paul Street, London EC2A 4LQ, United Kingdom)},
  address = {United Kingdom},
  abstract = {Accumulative experimental evidence suggests feasibility of chemotherapeutic intervention targeting human cancer cells by pharmacological modulation of cellular oxidative stress. Current efforts aim at personalization of redox chemotherapy through identification of predictive tumour genotypes and redox biomarkers. Based on earlier research demonstrating that anti-melanoma activity of the pro-oxidant 2,6-dichlorophenolindophenol (DCPIP) is antagonized by cellular NAD(P)H:quinone oxidoreductase (NQO1) expression, this study tested DCPIP as a genotype-directed redox chemotherapeutic targeting homozygous NQO1*2 breast carcinoma, a common missense genotype [rs1800566 polymorphism; NP\_000894.1:p.Pro187Ser] encoding a functionally impaired NQO1 protein. In a panel of cultured breast carcinoma cell lines and NQO1-transfectants with differential NQO1 expression levels, homozygous NQO1*2 MDA-MB231 cells were hypersensitive to DCPIP-induced caspase-independent cell death that occurred after early onset of oxidative stress with glutathione depletion and loss of genomic integrity. Array analysis revealed upregulated expression of oxidative (GSTM3, HMOX1, EGR1), heat shock (HSPA6, HSPA1A, CRYAB) and genotoxic stress response (GADD45A, CDKN1A) genes confirmed by immunoblot detection of HO-1, Hsp70, Hsp70B', p21 and phospho-p53 (Ser15). In a murine xenograft model of human homozygous NQO1*2-breast carcinoma, systemic administration of DCPIP displayed significant anti-tumour activity, suggesting feasibility of redox chemotherapeutic intervention targeting the NQO1*2 genotype.},
  langid = {english},
  keywords = {*2,*breast carcinoma/dt [Drug Therapy],*oxidation reduction potential,*reduced nicotinamide adenine dinucleotide phosphate oxidase 1/ec [Endogenous Compound],6 dichlorophenolindophenol/dt [Drug Therapy],6 dichlorophenolindophenol/ip [Intraperitoneal Drug Administration],6 dichlorophenolindophenol/pd [Pharmacology],alpha actin/ec [Endogenous Compound],animal experiment,animal model,animal tissue,antineoplastic activity,article,biological marker/ec [Endogenous Compound],breast carcinoma/dt [Drug Therapy],cancer cell culture,caspase/ec [Endogenous Compound],CDKN1A gene,controlled study,cryab gene,drug targeting,egr1 gene,feasibility study,gadd45a gene,gene,gene expression regulation,genetic polymorphism,genetic transfection,genomics,genotoxicity,genotype,glutathione/ec [Endogenous Compound],gstm3 gene,heat shock,heat shock protein 70/ec [Endogenous Compound],heat shock protein 70b/ec [Endogenous Compound],heme oxygenase 1/ec [Endogenous Compound],hmox1 gene,homozygosity,hspa1a gene,HSPA6 gene,human,human cell,immunoblotting,microarray analysis,missense mutation,mouse,nonhuman,nucleotide sequence,ovid_export_ris.ris,oxidative stress,proline/ec [Endogenous Compound],protein expression,protein p21/ec [Endogenous Compound],protein p53/ec [Endogenous Compound],serine/ec [Endogenous Compound],tumor xenograft,unclassified drug,upregulation}
}

@article{cadbyComprehensiveGeneticAnalysis2022,
  title = {Comprehensive Genetic Analysis of the Human Lipidome Identifies Loci Associated with Lipid Homeostasis with Links to Coronary Artery Disease},
  author = {Cadby, Gemma and Giles, Corey and Melton, Phillip E and Huynh, Kevin and Mellett, Natalie A and Duong, Thy and Nguyen, Anh and Cinel, Michelle and Smith, Alex and Olshansky, Gavriel and Wang, Tingting and Brozynska, Marta and Inouye, Mike and McCarthy, Nina S and Ariff, Amir and Hung, Joseph and Hui, Jennie and Beilby, John and Dub{\'e}, Marie-Pierre and Watts, Gerald F and Shah, Sonia and Wray, Naomi R and Lim, Wei Ling Florence and Chatterjee, Pratishtha and Martins, Ian and Laws, Simon M and Porter, Tenielle and Vacher, Michael and Bush, Ashley I and Rowe, Christopher C and Villemagne, Victor L and Ames, David and Masters, Colin L and Taddei, Kevin and Arnold, Matthias and Kastenm{\"u}ller, Gabi and Nho, Kwangsik and Saykin, Andrew J and Han, Xianlin and {Kaddurah-Daouk}, Rima and Martins, Ralph N and Blangero, John and Meikle, Peter J and Moses, Eric K},
  year = {2022},
  month = jun,
  journal = {Nat. Commun.},
  volume = {13},
  number = {1},
  pages = {3124},
  abstract = {We integrated lipidomics and genomics to unravel the genetic architecture of lipid metabolism and identify genetic variants associated with lipid species putatively in the mechanistic pathway for coronary artery disease (CAD). We quantified 596 lipid species in serum from 4,492 individuals from the Busselton Health Study. The discovery GWAS identified 3,361 independent lipid-loci associations, involving 667 genomic regions (479 previously unreported), with validation in two independent cohorts. A meta-analysis revealed an additional 70 independent genomic regions associated with lipid species. We identified 134 lipid endophenotypes for CAD associated with 186 genomic loci. Associations between independent lipid-loci with coronary atherosclerosis were assessed in {$\sim$}456,000 individuals from the UK Biobank. Of the 53 lipid-loci that showed evidence of association (P {$<$} 1 {\textbackslash}times 10-3), 43 loci were associated with at least one lipid endophenotype. These findings illustrate the value of integrative biology to investigate the aetiology of atherosclerosis and CAD, with implications for other complex diseases.},
  langid = {english}
}

@article{Cademartiri2010-ta,
  title = {Coronary Calcium Score and Computed Tomography Coronary Angiography in High-Risk Asymptomatic Subjects: Assessment of Diagnostic Accuracy and Prevalence of Non-Obstructive Coronary Artery Disease},
  author = {Cademartiri, Filippo and Maffei, Erica and Palumbo, Alessandro and Seitun, Sara and Martini, Chiara and Tedeschi, Carlo and La Grutta, Ludovico and Midiri, Massimo and Weustink, Annick C and Mollet, Nico R and Krestin, Gabriel P},
  year = {2010},
  journal = {European radiology},
  volume = {20},
  number = {4},
  pages = {846--854},
  publisher = {{Department of Radiology and Cardiology, Azienda Ospedaliero-Universitaria, Parma, Italy. filippocademartiri@hotmail.com}},
  address = {Germany},
  abstract = {OBJECTIVES: The aim of the study was to compare the coronary artery calcium score (CACS) and computed tomography coronary angiography (CTCA) for the assessment of non-obstructive/obstructive coronary artery disease (CAD) in high-risk asymptomatic subjects., METHODS: Two hundred and thirteen consecutive asymptomatic subjects (113 male; mean age 53.6 +/- 12.4 years) with more than one risk factor and an inconclusive or unfeasible non-invasive stress test result underwent CACS and CTCA in an outpatient setting. All patients underwent conventional coronary angiography (CAG). Data from CACS (threshold for positive image: Agatston score 1/100/1,000) and CTCA were compared with CAG regarding the degree of CAD (non-obstructive/obstructive; or=50\% lumen reduction)., RESULTS: The mean calcium score was 151 +/- 403 and the prevalence of obstructive CAD was 17\% (8\% one-vessel and 10\% two-vessel disease). Per-patient sensitivity, specificity, positive and negative predictive values of CACS were: 97\%, 75\%, 45\%, and 100\%, respectively (Agatston {\textquestiondown}or=1); 73\%, 90\%, 60\%, and 94\%, respectively (Agatston {\textquestiondown}or=100); 30\%, 98\%, 79\%, and 87\%, respectively (Agatston {\textquestiondown}or=1,000). Per-patient values for CTCA were 100\%, 98\%, 97\%, and 100\%, respectively (p {\textexclamdown} 0.05). CTCA detected 65\% prevalence of all CAD (48\% non-obstructive), while CACS detected 37\% prevalence of all CAD (21\% non-obstructive) (p {\textexclamdown} 0.05)., CONCLUSION: CACS proved inadequate for the detection of obstructive and non-obstructive CAD compared with CTCA. CTCA has a high diagnostic accuracy for the detection of non-obstructive and obstructive CAD in high-risk asymptomatic patients with inconclusive or unfeasible stress test results.},
  keywords = {*Calcinosis/ep [Epidemiology],*Calcinosis/ra [Radiography],*Coronary Angiography/sn [Statistics & Numerical D,*Coronary Artery Disease/ep [Epidemiology],*Coronary Artery Disease/ra [Radiography],*Tomography,Adult,Aged,Female,Humans,Italy/ep [Epidemiology],Male,Mendeley Import (Dec 08),Middle Aged,Prevalence,Risk Assessment,Risk Factors,X-Ray Computed/sn [Statistics & Numer,Young Adult}
}

