@article{Feldt1961-je,
  title = {The Use of Extreme Groups to Test for the Presence of a Relationship},
  author = {Feldt, Leonard S},
  year = {1961},
  month = sep,
  journal = {Psychometrika},
  volume = {26},
  number = {3},
  pages = {307--316},
  publisher = {Springer-Verlag},
  abstract = {Experimenters in psychology frequently investigate the relationship between two variables by selecting extreme groups on the first measure and comparing their mean scores on the second. This paper considers the efficacy of this procedure from the criterion of the power of the statistical tests. Optimal cutting points for the extreme groups are defined, and the power of the difference approach is compared to that of significance tests for the productmoment correlation coefficient.},
  keywords = {Mendeley Import (Dec 08)}
