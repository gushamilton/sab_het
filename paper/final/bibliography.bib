  title = {Association of Prior Lymphopenia with Mortality in Pneumonia: A Cohort Study in {{UK}} Primary Care},
  author = {Hamilton, Fergus and Arnold, David and Payne, Rupert},
  year = {2021},
  month = jan,
  journal = {Br. J. Gen. Pract.},
