@article{Yoshida1994-tc,
  title = {Hypercalcemia Caused by {{PTH-rP}} Associated with Lung Metastasis from Urinary Bladder Carcinoma: An Autopsied Case},
  author = {Yoshida, T and Suzumiya, J and Katakami, H and Kimura, N and Hisano, S and Kikuchi, M and Okumura, M},
  year = {1994},
  journal = {Internal medicine (Tokyo, Japan)},
  volume = {33},
  number = {11},
  pages = {673--676},
  publisher = {First Department of Internal Medicine, School of Medicine, Fukuoka University.},
  address = {JAPAN},
  abstract = {We analyzed the parathyroid-related protein (PTH-rP) content in tissue specimens obtained from a 61-year-old man with hypercalcemia associated with lung metastasis from urinary bladder carcinoma using radioimmunoassay and immunohistochemistry. Radioimmunoassay showed that the PTH-rP content was higher in metastatic lung tumor tissue than in non-tumorous lung tissue. Immunohistochemical analysis revealed the presence of PTH-rP in tumor cells. Furthermore, proliferation of osteoclasts was found in bone marrow at autopsy. The results suggest that PTH-rP induced humoral hypercalcemia of malignancy in a patient with urinary bladder cancer.},
  keywords = {*Carcinoma,*Hypercalcemia/et [Etiology],*Lung Neoplasms/co [Complications],*Lung Neoplasms/sc [Secondary],*Neoplasm Proteins/an [Analysis],*Proteins/an [Analysis],*Urinary Bladder Neoplasms/pa [Pathology],Bone Marrow/pa [Pathology],Carcinoma,Humans,Lung Neoplasms/ch [Chemistry],Lung Neoplasms/pa [Pathology],Lung/ch [Chemistry],Lung/pa [Pathology],Male,Mendeley Import (Dec 08),Middle Aged,Osteoclasts/pa [Pathology],Parathyroid Hormone-Related Protein,Radioimmunoassay,Transitional Cell/ch [Chemistry],Transitional Cell/co [Complications],Transitional Cell/pa [Pathology],Transitional Cell/sc [Secondary]}
}

