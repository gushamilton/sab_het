@article{Ohigashi2003-nx,
  title = {Topical Treatment with 22-Oxacalcitriol ({{OCT}}), a New Vitamin {{D}} Analogue, Caused Severe Hypercalcemia with Exacerbation of Chronic Renal Failure in a Psoriatic Patient with Diabetic Nephropathy; a Case Report and Analysis of the Potential for Hypercalcemia},
  author = {Ohigashi, Sawako and Tatsuno, Ichiro and Uchida, Daigaku and Higurashi, Mayumi and Hoshimoto, Saori and Seki, Naoto and Hashimoto, Natoake and Saito, Yasushi},
  year = {2003},
  journal = {Internal medicine (Tokyo, Japan)},
  volume = {42},
  number = {12},
  pages = {1202--1205},
  publisher = {Department of Clinical Cell Biology (Second Department of Medicine), Chiba University Graduate School of Medicine, Chiba.},
  address = {Japan},
  abstract = {Vitamin D has been used for topical treatment of psoriasis, and 22-oxacalcitriol (OCT), shown to be less calcemic, was developed for the topical treatment of psoriasis in Japan. Recently, we treated a psoriatic patient with diabetic nephropathy who developed severe hypercalcemia with exacerbation of chronic renal failure by the use of topical OCT. Analysis of the reported cases demonstrated that both the severity of psoriasis and renal dysfunction are critical factors in the induction of hypercalcemia in the topical treatment of psoriasis. Therefore, we must pay attention to the severity of psoriasis, especially when complicated by renal function impairment. Regular monitoring of Ca and renal function is essential to avoid life-threatening hypercalcemia from the topical treatment with vitamin D analogues.},
  keywords = {*Calcitriol/ae [Adverse Effects],*Dermatologic Agents/ae [Adverse Effects],*Diabetic Nephropathies/co [Complications],*Hypercalcemia/ci [Chemically Induced],*Kidney Failure,*Psoriasis/dt [Drug Therapy],Calcitriol/aa [Analogs & Derivatives],Calcitriol/ad [Administration & Dosage],Chronic/ci [Chemically Induced],Dermatologic Agents/ad [Administration & Dosage],Humans,Male,Mendeley Import (Dec 08),Middle Aged,Psoriasis/co [Complications]}
}

