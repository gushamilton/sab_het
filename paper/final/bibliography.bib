@article{&na;ConcurrentOralSessions2014,
  title = {Concurrent Oral Sessions},
  author = {{\&na;}},
  year = {2014},
  month = jul,
  journal = {Transplantation},
  volume = {98},
  number = {SUPPL. 1},
  pages = {16--50},
  publisher = {Ovid Technologies (Wolters Kluwer Health)},
  abstract = {The aim of the present study was the investigation of association between single nucleotide polymorphisms (SNPs) in genes coding for molecules involved in the physiopathology of ischemia-reperfusion injury and the occurrence of delayed graft function (DGF). Using a prioritization system (SNPLogic - www.snplogic. org), based on SNP's potential to influence gene expression and their allelic frequencies in Caucasian populations, we selected SNPs in the following genes: ATF3, BAX, BCL2, CLCN6, CX3CL1, CXCL1, CXCL10, EDN1, EPAS1, FABP1, GSTP1, HAVCR1, HMOX1, ICAM1, IL8, JAG1, LGALS3, MCPH1, NGAL, NOS2, PARP1, SELP, SHROOM3, SPATA5L1, STC1, TLR4, UMOD and VEGFA. The study included 579 transplants (Tx) with kidneys from deceased donors, performed in a single center. SNPs were determined in 312 D and 466 recipients of predominantly Caucasian ancestry. DGF was defined as the need for dialysis in the first week after transplantation and occurred in 303 Tx. TaqMan OpenArrayTM System was used to genotype 29 SNPs in 28 genes. Statistics included Fisher's exact and Mann-Whitney tests, and multiple regression analyses. Significance was set at pC intron 2 in VEGFA of donors (AA/AC vs CC genotypes: p=0.0004, OR=2.310, 95\%CI=1.465-3.643) and the SNP rs1871042, +2778 T{$>$}C intron 6 in GSTP1 of recipients (TT/TC vs CC genotypes: p=0.0066, OR=1.680, 95\%CI=1.159-2.435) were associated with DGF. These two SNPs are located at predicted transcription factors binding sites. From an initial analysis of clinical data, we selected the variables that differed between Tx with and without DGF and a subsequent multiple regression analysis showed that only donor serum creatinine (Cr) {$>$}1.5 mg/dL before kidney removal remained associated with DGF (p=0.0005, OR=1.544, 95\% CI=1.304-1.829). A posterior multiple regression analysis including the final Cr of the donor and the VEGFA and GSTP1 SNPs revealed that the three variables were independently associated with DGF. In summary, out of 29 SNPs investigated, only one SNP in the gene VEGFA (vascular endothelial growth factor A ) of the donor, and one SNP in the gene GSTP1 (glutathione S-transferases P1) of the recipient were found to be significantly associated with DGF.},
  langid = {english},
  keywords = {*genetic polymorphism,*kidney graft,*transplantation,binding site,Caucasian,clinical study,creatinine blood level,delayed graft function,dialysis,donor,gene,gene expression,gene frequency,genotype,glutathione transferase,human,intron,kidney,multiple regression,neutrophil gelatinase associated lipocalin,ovid_export_ris.ris,pathophysiology,population,rank sum test,recipient,reperfusion injury,single nucleotide polymorphism,statistics,transcription factor,vasculotropin A}
}

@article{1000_Genomes_Project_Consortium2015-ae,
  title = {A Global Reference for Human Genetic Variation},
  author = {{1000 Genomes Project Consortium} and Auton, Adam and Brooks, Lisa D and Durbin, Richard M and Garrison, Erik P and Kang, Hyun Min and Korbel, Jan O and Marchini, Jonathan L and McCarthy, Shane and McVean, Gil A and Abecasis, Gon{\c c}alo R},
  year = {2015},
  month = oct,
  journal = {Nature},
  volume = {526},
  number = {7571},
  pages = {68--74},
  publisher = {Nature Publishing Group},
  abstract = {The 1000 Genomes Project set out to provide a comprehensive description of common human genetic variation by applying whole-genome sequencing to a diverse set of individuals from multiple populations. Here we report completion of the project, having reconstructed the genomes of 2,504 individuals from 26 populations using a combination of low-coverage whole-genome sequencing, deep exome sequencing, and dense microarray genotyping. We characterized a broad spectrum of genetic variation, in total over 88 million variants (84.7 million single nucleotide polymorphisms (SNPs), 3.6 million short insertions/deletions (indels), and 60,000 structural variants), all phased onto high-quality haplotypes. This resource includes {\textquestiondown}99\% of SNP variants with a frequency of {\textquestiondown}1\% for a variety of ancestries. We describe the distribution of genetic variation across the global sample, and discuss the implications for common disease studies.},
  langid = {english},
  keywords = {Genetic variation,Genomics,Mendeley Import (Dec 08)}
}

