  title = {Hemin Inhibits {{NLRP3}} Inflammasome Activation in Sepsis-Induced Acute Lung Injury, Involving Heme Oxygenase-1},
  author = {Luo, Yun-Peng and Jiang, Lei and Kang, Kai and Fei, Dong-Sheng and Meng, Xiang-Lin and Nan, Chuan-Chuan and Pan, Shang-Ha and Zhao, Ming-Ran and Zhao, Ming-Yan},
