  journal = {Postgraduate Medical Journal},
  volume = {63},
  number = {743},
  pages = {745--750},
  publisher = {Department of Surgery, University of Cape Town, South Africa.},
  address = {ENGLAND},
  abstract = {A prospective screen for hypercalcaemia in 58,053 hospital in-patients was conducted over 12 months. The incidence of hypercalcaemia was 0.6\%, being transient in 19.2\% of patients and sustained in the remainder. The most common causes in the sustained group were malignancy (45\%) and primary hyperparathyroidism (16.5\%). The incidence of primary hyperparathyroidism was 78/100,000 hospital in-patients, and its discovery was directly attributable to the survey in over half the cases.},
  langid = {english},
  keywords = {*Hypercalcemia/ep [Epidemiology],Adult,Humans,Hypercalcemia,Hypercalcemia: epidemiology,Hypercalcemia: etiology,Hypercalcemia/et [Etiology],Hyperparathyroidism,Hyperparathyroidism: complications,Hyperparathyroidism: epidemiology,Hyperparathyroidism/co [Complications],Hyperparathyroidism/ep [Epidemiology],Inpatients,Mendeley Import (Dec 08)/hypercalcaemia SS,Mendeley Import (Dec 08)/hypercalcaemia SS/studies,Middle Aged,Neoplasms,Neoplasms: complications,Neoplasms/co [Complications],Prospective Studies,South Africa}
}

