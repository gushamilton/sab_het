@article{dominguez-andresLongtermReprogrammingInnate2019,
  title = {Long-Term Reprogramming of the Innate Immune System},
  author = {{Dominguez-Andres}, Jorge and Netea, Mihai G},
  year = {2019},
  month = feb,
  journal = {J. Leukoc. Biol.},
  volume = {105},
  number = {2},
  pages = {329--338},
  publisher = {Wiley},
  abstract = {During the last few years, a growing body of evidence has shown that immunological memory is not an exclusive trait of lymphocytes, as many inflammatory insults can alter the functionality and the responsiveness of the innate immune system in the long term. Innate immune cells, such as monocytes, macrophages, dendritic cells, and NK cells can be influenced by the encounters with inflammatory stimuli, undergoing functional reprogramming and developing changed responses to subsequent chellenges. The long-term reprogramming depends on the rewiring of cell metabolism and epigenetic processes, and they stay at the basis of induction of both innate immune memory (also termed trained immunity) and innate immune tolerance. Here, we review the central role that the effects of this long-term reprogramming of innate immune cells plays in a number of clinically relevant conditions such as vaccination, atherosclerosis, sepsis, and cancer.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english},
  keywords = {atherosclerosis,cancer,epigenetics,inflammation,Innate immune system,metabolism,reprogramming,sepsis,trained immunity,vaccination}
}

