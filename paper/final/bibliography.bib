@article{ayaresd.AbstractsIPITAIXACTS20152015,
  title = {Abstracts of the {{IPITA-IXA-CTS}} 2015 Joint Congress {{November}} 15-19, 2015, {{Melbourne}}, {{Australia}}},
  author = {{Ayares D.} and {Vaught T.} and {Ball S.} and {Ramsoondar J.} and {Kuravi K.} and {Butler S.} and {Sorrells L.} and {Borchers H.} and {Morrill B.} and {Dandro A.} and {Monahan J.} and {Walters A.} and {Bianchi J.} and {Phelps C.}},
  year = {2015},
  month = nov,
  journal = {Xenotransplantation},
  volume = {22},
  number = {SUPPL. 1},
  pages = {S2--S47},
  publisher = {Wiley},
  abstract = {Background and Significance: Knockout of the a1,3-galactosyl transferase gene (GTKO) resulted in the elimination of hyperacute rejection (HAR), and prolonged survival of xenografts in non-human primate studies. Donor pigs with multiple transgenic modifications, including human genes expressing complement regulatory proteins and anticoagulants, and immunosuppressive genes, will be required for successful clinical application of xenolungs and other organs. Multi-transgenic pigs have been produced using 2A technology, with provision for tissue-specific or ubiquitous expression of sets of bi-cistronic transgenes. This technology supports both multi-transgenic donor pig production and multi-transgene transmission in a breeding herd. Method(s): Multi-cistronic ``2A'' vectors were used for production of 6-GE pigs, employing 4-gene vectors transfected into well-characterized GTKO.hCD46 cells that were then used for somatic cell nuclear transfer. More than 15 multi-cistronic vectors were generated and used to produce pigs with different combinations of these bioactive transgenes. Genotype was determined by Southern analysis. Gene expression was monitored by flow cytometry of PBMCs and endothelial cells, and in cells and organs by immunohistochemistry, Q-PCR, and Western blot analysis. Bioactivity assays specific to the transgenes were utilized to quantitate and characterize complement inhibition, platelet aggregation, activated protein C formation, ATPase activity, Factor Xa cleavage, mixed lymphocyte reaction, and apoptosis. Results and Conclusion(s): Building on the GTKO platform, pigs were produced with 6 genetic modifications including constitutive high-level expression of complement regulatory genes hCD46 and hCD55, combined with endothelial-specific or ubiquitous expression of human anti-coagulant genes [thrombomodulin (TBM), endothelial protein C receptor (EPCR), CD39, and tissue factor pathway inhibitor (TFPI)], immunosuppressive genes (porcine cytotoxic T lymphocyte-associated protein-4 and class II MHC dominant negative), and/or human anti-inflammation transgenes (heme oxygenase-1, A20, and CD47). Pigs with the expected genotype and robust expression of all transgenes were identified in these assays and used in both ex vivo and in vivo models of xenotransplantation. Efficacy of transplantation with transgenic pig hearts has been established in baboons, using a previously developed and robustly expressing 3-gene pig heart (GTKOCD46TBM) as donor, with survival and organ functionality extending to {$>$}900 days. Recently, orthotopic kidney transplant with a 6-gene transgenic pig kidney (GTKO.CD46.DAF.EPCR.TBM.CD39) survived for 135 days, providing the longest-ever life supporting organ function. While lungs are more of a challenge, multi-cistronic pig lungs (GTKO.CD46.DAF.EPCR.TFPI.CD47) have survived for 8 days in the baboon model. Recent procedural developments in transplant and donor recipient maintenance show promise for extending this support even further. In addition, to further enhance efficacy, bi-allelic N-glycolylneuraminic acid (NeuGc) knockout pigs have been generated using zinc finger nucleases and are currently being tested in our xenoTx models. Discovery of the optimal gene mix, with efficacious transgene expression levels and support of advantageous synergistic effects in a healthy viable pig will provide a major step towards the ultimate goal of clinical application.},
  langid = {english},
