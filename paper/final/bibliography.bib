@article{dwyerDownregulationAminolevulinateSynthase2009,
  title = {Down-Regulation of Aminolevulinate Synthase, the Rate-Limiting Enzyme for Heme Biosynthesis in {{Alzheimer}}'s Disease},
  author = {Dwyer, Barney E and Smith, Mark A and Richardson, Sandy L and Perry, George and Zhu, Xiongwei},
  year = {2009},
  month = aug,
