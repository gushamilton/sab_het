  journal = {Int. J. Stroke},
  volume = {10},
  number = {2\_suppl},
  pages = {77--438},
  publisher = {SAGE Publications},
  abstract = {HMOX1 codes for HO1 enzyme, which degrades heme into bilirubin, iron and carbon monoxide, and maintains normal vascular function e.g. by acting as an antioxidant and modulator of vascular tone. We have previously shown HMOX1 is over-expressed in symptomatic carotid stenosis (CS). HMOX1 promoter contains GTn-repeat suggested to modulate HMOX1 expression: longer repeats have lower expression and weaker enzymatic efficacy during oxidative stress. We investigated whether HMOX1 promoter polymorphism associates with symptomatic CS and the risk of future thromboembolic events. HMOX1 was genotyped in 85 CS patients and 964 population controls. Plaques were collected in endarterectomy and scored macroscopically for ulceration. Patients were divided into asymptomatic and symptomatic groups according to whether they had had ipsilateral ischemic symptoms during their lifetime and followed for a median of 12.7 years for thromboembolic events. HMOX1 was highly polymorphic with 22 alleles which therefore were classified as long ({$>$}GT30), intermediate (GT30) and short (},
  langid = {english},
  keywords = {*atherosclerosis,*cardiovascular disease,*cerebrovascular accident,*European,*heme oxygenase 1,*organization,*promoter region,allele,antioxidant,apolipoprotein B,apolipoprotein B100,atherogenesis,cardiovascular risk,carotid atherosclerosis,confidence interval,death,enzyme,hazard ratio,heart infarction,high risk population,human,male,ovid_export_ris.ris,phospholipid,polymerase chain reaction,population,prospective study,risk,tandem repeat,ultrasound}
}

