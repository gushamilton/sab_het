@article{cohen-wolkowiezPopulationPharmacokineticsPiperacillin2012,
  title = {Population Pharmacokinetics of Piperacillin Using Scavenged Samples from Preterm Infants},
  author = {{Cohen-Wolkowiez}, Michael and Benjamin, Jr, Daniel K and Ross, Ashley and James, Laura P and Sullivan, Janice E and Walsh, Michele C and Zadell, Arlene and Newman, Nancy and White, Nicole R and Kashuba, Angela D M and Ouellet, Daniele},
  year = {2012},
  month = jun,
  journal = {Ther. Drug Monit.},
  volume = {34},
  number = {3},
  pages = {312--319},
  abstract = {OBJECTIVES: Piperacillin is often used in preterm infants for intra-abdominal infections; however, dosing has been derived from small single-center studies excluding extremely preterm infants at a highest risk for these infections. We evaluated the population pharmacokinetics (PK) of piperacillin using targeted sparse sampling and scavenged samples obtained from preterm infants {\textbackslash}leq 32 weeks of gestational age at birth and 70\%) of infants did not meet predefined pharmacodynamic efficacy targets. CONCLUSIONS: Scavenged PK sampling is a minimal-risk approach that can provide meaningful information related to the development of PK models but not dosing recommendations for piperacillin. The utility of scavenged sampling in providing definitive dosing recommendations may be drug dependent and needs to be further explored.},
  langid = {english}
}

