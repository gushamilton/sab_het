@article{klemettim.m.ScientificAbstracts2014,
  title = {Scientific {{Abstracts}}},
  author = {{Klemetti M.M.} and {Kaartokallio T.} and {Lakkisto P.} and {Laivuori H.}},
  year = {2014},
  month = mar,
  journal = {Reprod. Sci.},
  volume = {21},
  number = {3\_suppl},
  pages = {71A--418A},
  publisher = {SAGE Publications Inc},
  abstract = {INTRODUCTION: Pre-eclampsia (PE) is a hypertensive pregnancy disorder, characterized by metabolic abnormalities similar to the metabolic syndrome. Prior PE increases cardiovascular disease (CVD) and type 2 diabetes (T2DM) risk. Heme oxygenase-1 (HO-1) is an anti-oxidant and anti-inflammatory stress-response enzyme. During pregnancy, HO-1 seems to be cytoprotective in the placenta, as the over-expression of HO-1 inhibits the production of antiangiogenic factors. HO-1 might also protect the maternal endothelium facilitating adaptation to pregnancy. The GTn short length allele (S, =25 repeats). The L allele has been linked to elevated T2DM and CVD risks. We studied whether the long GTn allele of the HMOX1 is associated with PE or its sub-phenotypes. METHOD(S): We genotyped the GTn repeat polymorphism in 759 PE and 779 control women using DNA fragment analysis. PE was defined according to the American College of Obstetricians and Gynecologists' criteria. PE diagnosed at 34+0 gestational weeks or later was defined as late-onset. Birth weights {$<$}-2.0 SD units were classified as small-for-dates (SFD). The statistical methods used were the Mann-Whitney U-test and the Chi square test. RESULT(S): There was no association between the long allele of the GTn repeat of the HMOX1 and PE. In subgroup analyzes, the LL genotype was associated with non-severe PE (p=0.037) and the L allele with non-severe (p=0.011), non-recurrent (p=0.046) and late-onset (p=0.019) PE, and with PE without a SFD infant (p=0.030). The LL genotype was associated with PE in women who smoked before (p=0.032) or during (p{$<$}0.001) pregnancy and the L allele with PE in women who smoked during pregnancy (p=0.013). CONCLUSION(S): According to one hypothesis, abnormal placentation typically characterizes early-onset PE while maternal metabolic risk factors may be more significant in late-onset PE. The association of the GTn long allele with the late-onset, less severe PE is in agreement with the previous associations of this polymorphism with T2DM and CVD and shared metabolic risk factors. Smoking could protect subjects with the S allele against PE by inhibiting the production of antiangiogenic factors.},
  langid = {english},
  keywords = {*gynecological examination,*heme oxygenase 1,*preeclampsia,*promoter region,*society,adaptation,allele,birth weight,cardiovascular disease,chi square test,college,DNA,DNA fragment,endothelium,enzyme,female,gene,genotype,gynecologist,human,hypothesis,infant,metabolic syndrome X,non insulin dependent diabetes mellitus,obstetrician,ovid_export_ris.ris,oxidizing agent,phenotype,placenta,pregnancy,pregnancy disorder,rank sum test,reproduction,risk,risk factor,smoking,statistical analysis,stress}
}

@article{klickovicHumanPharmacokineticsHigh2014,
  title = {Human Pharmacokinetics of High Dose Oral Curcumin and Its Effect on Heme Oxygenase-1 Expression in Healthy Male Subjects},
  author = {Klickovic, Uros and Doberer, Daniel and Gouya, Ghazaleh and Aschauer, Stefan and Weisshaar, Stefan and Storka, Angela and Bilban, Martin and Wolzt, Michael},
  year = {2014},
  month = jan,
  journal = {Biomed Res. Int.},
  volume = {2014},
  pages = {458592},
  publisher = {Hindawi Publishing Corporation (410 Park Avenue, 15th Floor, 287 pmb, New York NY 10022, United States)},
  address = {United States},
  abstract = {PURPOSE: Heme oxygenase-1 (HO-1) has been proposed to exert pharmacological benefits by its antioxidative and anti-inflammatory effects. HO-1 expression may be affected by the GT length polymorphism in the promoter region of the HO-1 gene. We investigated the inducibility of HO-1 by orally administered curcumin in healthy male subjects and its correlation with the GT length polymorphism. METHODS: In an open label uncontrolled phase-1 pilot study, ten male subjects received 12 g of oral curcumin. To investigate the effects of the GT length polymorphism on the inducibility of HO-1, five subjects with homozygous short and five with homozygous long GT genotypes were studied. Plasma concentrations of curcumin, bilirubin, HO-1 mRNA, and protein expression in peripheral blood mononuclear cells (PBMCs) were analyzed over 48 hours. RESULTS: At a detection limit of 1 {\textmu}g/mL curcumin could not be detected in plasma of any subject. Compared to baseline, HO-1 mRNA and protein levels were not induced in PBMCs at any time point up to 48 hours. There was no correlation between any of the parameters and GT length polymorphism. CONCLUSIONS: Oral curcumin administration has low bioavailability and does not induce HO-1 on mRNA or protein level in PBMCs.},
  langid = {english},
  keywords = {*curcumin/cr [Drug Concentration],*curcumin/ct [Clinical Trial],*curcumin/pk [Pharmacokinetics],*curcumin/po [Oral Drug Administration],*heme oxygenase 1/ec [Endogenous Compound],adult,area under the curve,article,bilirubin blood level,bilirubin glucuronide/ec [Endogenous Compound],bilirubin/ec [Endogenous Compound],drug bioavailability,drug blood level,drug megadose,gene frequency,genotype,gt length polymorphism,homozygote,human,limit of detection,male,maximum plasma concentration,messenger RNA/ec [Endogenous Compound],middle aged,normal human,open study,ovid_export_ris.ris,patient safety,peripheral blood mononuclear cell,phase 1 clinical trial,pilot study,protein blood level,protein expression,protein polymorphism,real time polymerase chain reaction,time to maximum plasma concentration,young adult}
}

@article{kloekHostGeneticVariability2019,
  title = {Host Genetic Variability and Pneumococcal Disease: A Systematic Review and Meta-Analysis},
  author = {Kloek, Anne T and Brouwer, Matthijs C and {van de Beek}, Diederik},
  year = {2019},
  month = sep,
  journal = {BMC Med. Genomics},
  volume = {12},
  number = {1},
  pages = {130},
  abstract = {BACKGROUND: Pneumonia, sepsis, meningitis, and empyema due to Streptococcus pneumoniae is a major cause of morbidity and mortality. We provide a systemic overview of genetic variants associated with susceptibility, phenotype and outcome of community acquired pneumococcal pneumonia (CAP) and invasive pneumococcal disease (IPD). METHODS: We searched PubMed for studies on the influence of host genetics on susceptibility, phenotype, and outcome of CAP and IPD between Jan 1, 1983 and Jul 4, 2018. We listed methodological characteristics and when genetic data was available we calculated effect sizes. We used fixed or random effect models to calculate pooled effect sizes in the meta-analysis. RESULTS: We identified 1219 studies of which 60 studies involving 15,358 patients were included. Twenty-five studies (42\%) focused on susceptibility, 8 (13\%) on outcome, 1 (2\%) on disease phenotype, and 26 (43\%) on multiple categories. We identified five studies with a hypothesis free approach of which one resulted in one genome wide significant association in a gene coding for lincRNA with pneumococcal disease susceptibility. We performed 17 meta-analyses of which two susceptibility polymorphisms had a significant overall effect size: variant alleles of MBL2 (odds ratio [OR] 1{$\cdot$}67, 95\% confidence interval [CI] 1{$\cdot$}04-2{$\cdot$}69) and a variant in CD14 (OR 1{$\cdot$}77, 95\% CI 1{$\cdot$}18-2{$\cdot$}66) and none of the outcome polymorphisms. CONCLUSIONS: Studies have identified several host genetics factors influencing risk of pneumococcal disease, but many result in non-reproducible findings due to methodological limitations. Uniform case definitions and pooling of data is necessary to obtain more robust findings.},
  langid = {english},
  keywords = {Host genetic variability,Meta-analysis,Pneumococcal disease,Systematic review}
}

