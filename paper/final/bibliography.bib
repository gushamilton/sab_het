@article{Belardetti2009-ls,
  title = {A Fluorescence-Based High-Throughput Screening Assay for the Identification of {{T-type}} Calcium Channel Blockers},
  author = {Belardetti, Francesco and Tringham, Elizabeth and Eduljee, Cyrus and Jiang, Xinpo and Dong, Haiheng and Hendricson, Adam and Shimizu, Yoko and Janke, Diana L and Parker, David and Mezeyova, Janette and Khawaja, Afsheen and Pajouhesh, Hassan and Fraser, Robert A and Arneric, Stephen P and Snutch, Terrance P},
