@article{huCausalEffectsGenetically2021,
  title = {Causal {{Effects}} of {{Genetically Predicted Iron Status}} on {{Sepsis}}: {{A Two-Sample Bidirectional Mendelian Randomization Study}}},
  author = {Hu, Yuanlong and Cheng, Xiaomeng and Mao, Huaiyu and Chen, Xianhai and Cui, Yue and Qiu, Zhanjun},
  year = {2021},
  month = nov,
  journal = {Front Nutr},
  volume = {8},
  pages = {747547},
  abstract = {Background/Aim: Several observational studies showed a significant association between elevated iron status biomarkers levels and sepsis with the unclear direction of causality. A two-sample bidirectional mendelian randomization (MR) study was designed to identify the causal direction between seven iron status traits and sepsis. Methods: Seven iron status traits were studied, including serum iron, ferritin, transferrin saturation, transferrin, hemoglobin, erythrocyte count, and reticulocyte count. MR analysis was first performed to estimate the causal effect of iron status on the risk of sepsis and then performed in the opposite direction. The multiplicative random-effects and fixed-effects inverse-variance weighted, weighted median-based method and MR-Egger were applied. MR-Egger regression, MR pleiotropy residual sum and outlier (MR-PRESSO), and Cochran's Q statistic methods were used to assess heterogeneity and pleiotropy. Results: Genetically predicted high levels of serum iron (OR = 1.21, 95\%CI = 1.13-1.29, p = 3.16 {\textbackslash}times 10-4), ferritin (OR = 1.32, 95\%CI = 1.07-1.62, p =0.009) and transferrin saturation (OR = 1.14, 95\%CI = 1.06-1.23, p = 5.43 {\textbackslash}times 10-4) were associated with an increased risk of sepsis. No significant causal relationships between sepsis and other four iron status biomarkers were observed. Conclusions: This present bidirectional MR analysis suggested the causal association of the high iron status with sepsis susceptibility, while the reverse causality hypothesis did not hold. The levels of transferrin, hemoglobin, erythrocytes, and reticulocytes were not significantly associated with sepsis. Further studies will be required to confirm the potential clinical value of such a prevention and treatment strategy.},
  langid = {english},
  keywords = {bidirectional mendelian randomization analyses,infection,iron metabolism,iron status,sepsis}
}

