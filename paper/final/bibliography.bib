@article{gulesserianClinicalRestenosisCoronary2005,
  title = {Clinical Restenosis after Coronary Stent Implantation Is Associated with the Heme Oxygenase-1 Gene Promoter Polymorphism and the Heme Oxygenase-1 +{{99G}}/{{C}} Variant},
  author = {Gulesserian, Talin and Wenzel, Catharina and Endler, Georg and {Sunder-Plassmann}, Raute and Marsik, Claudia and Mannhalter, Christine and Iordanova, Nelly and Gy{\"o}ngy{\"o}si, Mariann and Wojta, Johann and Mustafa, Stefan and Wagner, Oswald and Huber, Kurt},
  year = {2005},
  month = sep,
  journal = {Clin. Chem.},
  volume = {51},
  number = {9},
  pages = {1661--1665},
  publisher = {American Association for Clinical Chemistry Inc. (2101 L Street NW, Suite 202, Washington DC 20037-1526, United States)},
  address = {United States},
  abstract = {BACKGROUND: Vascular remodeling after percutaneous coronary stent implantation frequently leads to restenosis. Heme oxygenase 1 (HO-1) is involved in the generation of the endogenous antioxidant bilirubin and carbon monoxide, both of which exert antiinflammatory and antiproliferative effects. The aim of the present study was to evaluate the influence of genetic risk factors combined with the conventional risk factors on the development of coronary restenosis after percutaneous coronary intervention (PCI) with stent implantation. METHODS: The HO-1 gene GT dinucleotide repeat promoter polymorphism and HO-1 +99G/C variant were evaluated in 199 patients with coronary artery disease after coronary stent implantation and control angiography at 6 months after the intervention. Coronary restenosis was confirmed by quantitative angiography. RESULTS: Carriers of the long allele of the HO-1 gene promoter ({$>$}29 repeats) had a significantly higher risk of developing restenosis after PCI than noncarriers [odds ratio (OR)=1.9; 95\% confidence interval (95\% CI), 1.0-3.4; P=0.04]. Interestingly, the allele longer than 29 repeats conferred a significantly higher risk of developing restenosis (OR=3.4; 95\% CI, 1.2-9.1; P=0.017) in nonsmokers than in smokers (OR=2.0; 95\% CI, 0.7-5.2; P=0.18). CONCLUSIONS: The long allele of the HO-1 gene promoter ({$>$}29 repeats) polymorphism, which leads to low HO-1 inducibility, may represent an independent prognostic marker for restenosis after PCI and stent implantation. The effect of the {$>$}29 repeat allele is attenuated in smokers, who have chronic exogenous CO exposure.},
  langid = {english},
  keywords = {*coronary artery obstruction/su [Surgery],*coronary artery obstruction/th [Therapy],*coronary stent,*heme oxygenase 1/ec [Endogenous Compound],*restenosis/co [Complication],*restenosis/di [Diagnosis],*restenosis/et [Etiology],adult,aged,allele,angiocardiography,antioxidant/ec [Endogenous Compound],article,bilirubin/ec [Endogenous Compound],carbon monoxide/ec [Endogenous Compound],controlled study,dinucleotide repeat,DNA polymorphism,enzyme induction,female,genetic risk,genomic DNA,human,hyperlipidemia,hypertension,major clinical study,male,ovid_export_ris.ris,percutaneous coronary intervention,polymerase chain reaction,prognosis,promoter region,smoking}
}

@article{gullaakPolymorphismHemeOxygenase12016,
  title = {Polymorphism of the Heme Oxygenase-1 ({{HO-1}}) Promoter and Cytokines Expression in Acute Pancreatitis},
  author = {{Gulla A K} and {Gulbinas A} and {Barauskas G} and {Dambrauskas Z}},
  year = {2016},
  journal = {Pancreas},
  volume = {45},
  number = {10},
  pages = {1509},
  publisher = {{Lippincott Williams and Wilkins}},
  address = {Netherlands},
  abstract = {Introduction: Heme oxygenase-1 (HO-1) is an anti-oxidative, antiinflammatory, and cytoprotective enzyme that is induced in response to cellular stress. The HO-1 promoter contains (GT)n dinucleotide repeats and is highly polymorphic. In this study we hypothesized that different expression of HO-1 determined by the number of GT repeats is associated with different expression of cytokines thusmay predict severe onset and course of acute pancreatitis (AP). Method(s): AP patients (n= 40) and matched healthy controls (n= 28) were studied. Genomic DNA and mRNA were extracted from peripheral blood samples of patients and control groups. The HO-1 promoter region with the GT repeats was PCR amplified with fluorescent tagged primers, while mRNA expression by QRT-PCR. A short allele was defined as = 27 repeats. Clinical data on study cohort was incorporated for the statistical analysis. Result(s): The subjects were categorized into 3 groups based on the genotype results: one short and one long allele (S/L), two short alleles (S/S) and two long alleles (L/L). The presence of: S/L -42.3\%, L/L- 47.2\%, S/S- 10.5\% was recorded in AP group. The levels of 15 different cytokines were measured and ninety percent of patients who were carriers of L/L genotype had increased levels of CD14 (p{$<$}0.003) levels compared to controls. These subjects were also at higher risk for developing severe acute pancreatitis. Conclusion(s): The polymorphism of the GT repeats in the HO-1 promoter region, L/L genotype, may be a risk factor for altering cytokines and associated with severe course and outcome of acute pancreatitis.},
  keywords = {*acute pancreatitis,*cytokine,*gene expression,*gene mutation,*genetic polymorphism,*heme oxygenase 1,*promoter region,blood,CD14 antigen,clinical article,clinical trial,control group,controlled study,disease carrier,disease course,endogenous compound,gene frequency,genetic susceptibility,genomic DNA,genotype,human,human tissue,messenger RNA,ovid_export_ris.ris,polymerase chain reaction,population based case control study,risk factor,statistical analysis}
}

@article{gullaAssociationGTnPolymorphism2017,
  title = {Association between the ({{GT}})n Polymorphism of the {{HSP-32}} ({{HO-1}}), {{HSP-70}} and {{HSP-90}} and Acute Pancreatitis},
  author = {Gulla, Aiste and Gulbinas, Antanas and Dambrauskas, Zilvinas},
  year = {2017},
  month = jul,
  journal = {Pancreatology},
  volume = {17},
  number = {3},
  pages = {S82},
  publisher = {Elsevier BV},
  address = {Netherlands},
  abstract = {Introduction: Heat shock proteins (HSPs)-molecular chaperones that can be induced in response to cellular stress. The HSP-32 (HO-1), HSP-70 and HSP-90 promoter contains (GT)n dinucleotide repeats and is highly polymorphic. In this study we hypothesized that different expression of HSPs associated with the occurrence of acute pancreatitis thus may predict severe onset and course of AP. Aim(s): To evaluate the relationship between heat shock proteins and course of AP. Patients \& methods: AP patients (n = 131) and age- and sex-matched healthy controls (n= 33) were studied. Genomic DNA and mRNA were extracted and HSPs promoter region with the GT repeatswas PCR amplified with fluorescent tagged primers, while mRNA expression by QRT-PCR. For HSP-32 a short allelewas defined as{$>$}=27GT repeats, whereas a long allele {$>$}= 27 repeats. For HSP-70, HSP-90 patients were divided into wild type alleles (WT/WT), both mutant alleles (Mut/Mut), and mixed type (WT/Mut). Clinical data on study cohort was incorporated for the statistical analysis. Result(s): Subjects were divided 3 groups based on the HSP-32 genotype: one short and one long allele (S/L), two short alleles (S/S) and two long alleles (L/L). Patients with necrotizing disease and HO-1 promoter polymorphism more frequently had LL genotype. These subjects were also at higher risk for developing severe acute pancreatitis. The data of the HSP-70 and HSP-90 polymorphism is currently being prepared for further analysis. Conclusion(s): The polymorphism of the GT repeats in the HSP-32(HO-1), HSP-70, HSP-90 promoter region may be a risk factor associated with severe course and different outcome of acute pancreatitis.},
  keywords = {*acute pancreatitis,*gene mutation,*genetic association,*heat shock protein 70,*heat shock protein 90,*heme oxygenase 1,adult,cohort analysis,conference abstract,controlled study,DNA polymorphism,endogenous compound,female,gene expression,gene frequency,genetic susceptibility,genomic DNA,genotype,human,major clinical study,male,messenger RNA,ovid_export_ris.ris,promoter region,real time polymerase chain reaction,risk factor,wild type}
}

@article{gullaHemeOxygenase1Gene2014,
  title = {Heme Oxygenase-1 Gene Promoter Polymorphism Is Associated with the Development of Necrotizing Acute Pancreatitis},
  author = {Gulla, Aiste and Evans, Barry J and Navenot, Jean Marc and Pundzius, Juozas and Barauskas, Giedrius and Gulbinas, Antanas and Dambrauskas, Zilvinas and Arafat, Hwyda and Wang, Zi-Xuan},
  year = {2014},
  month = nov,
  journal = {Pancreas},
  volume = {43},
  number = {8},
  pages = {1271--1276},
  publisher = {{Lippincott Williams and Wilkins (E-mail: kathiest.clai@apta.org)}},
  address = {United States},
  abstract = {OBJECTIVES: Acute pancreatitis is a severe and frequently life-threatening disease, which can lead to pancreatic necrosis, acute lung injury, systemic inflammatory response syndrome, and other complications. In this study, we hypothesized that the expression of heme oxygenase-1 determined by the number of guanidinium thiocyanate (GT) repeats can influence the occurrence of acute pancreatitis. METHODS: Patients with acute pancreatitis (n = 131) and age- and sex-matched healthy controls (n = 108) were studied. The polymerase chain reaction products were analyzed by ABI 3130 genetic analyzer and the exact size of the polymerase chain reaction products was determined by GeneMapper software. A short allele was defined as containing 27 GT repeats or fewer, whereas a long allele was more than 27 repeats. RESULTS: The subjects were categorized into 3 groups on the basis of the genotype results: 1 short and 1 long, 2 short, and 2 long alleles (L/L). Patients with necrotizing disease more frequently were carriers of LL genotype compared with those who had edematous acute pancreatitis. Furthermore, logistic regression analysis revealed that the presence of L/L allele type doubles the risk for developing pancreatic necrosis in patients with acute pancreatitis. CONCLUSIONS: The polymorphism of the GT repeats in the heme oxygenase-1 promoter region may be a risk factor for developing severe and necrotizing acute pancreatitis.},
  langid = {english},
  keywords = {*Dinucleotide Repeats,*Heme Oxygenase-1/ge [Genetics],*Pancreatitis,*Polymorphism,*Promoter Regions,Acute Disease,Acute Necrotizing/bl [Blood],Acute Necrotizing/ep [Epidemiology],Acute Necrotizing/et [Etiology],Acute Necrotizing/ge [Genetics],Adult,Aged,Alcoholic/co [Complications],Cholelithiasis/co [Complications],Dietary Fats/ae [Adverse Effects],Disease Progression,Edema/bl [Blood],Edema/ep [Epidemiology],Edema/ge [Genetics],Female,Genetic,Genetic Predisposition to Disease,Genetic/ge [Genetics],Genotype,Heme Oxygenase-1/bl [Blood],Humans,Incidence,Male,Middle Aged,ovid_export_ris.ris,Pancreatitis,Pancreatitis/bl [Blood],Pancreatitis/ep [Epidemiology],Pancreatitis/et [Etiology],Pancreatitis/ge [Genetics],Prospective Studies,Risk Factors}
}

@article{gullaHemeOxygenase1Polymorphism2019,
  title = {Heme {{Oxygenase-1 Polymorphism Is Associated With}} the {{Development}} of {{Necrotic Acute Pancreatitis Via Vascular Cell Adhesion Molecule-1}} and the {{E-Selectin Expression Regulation Pathway}}},
  author = {Gulla, Aiste and Gulbinas, Antanas and Dambrauskas, Zilvinas and Strupas, Kestutis},
  year = {2019},
  month = jul,
  journal = {Pancreas},
  volume = {48},
  number = {6},
  pages = {787--791},
  publisher = {{Lippincott Williams and Wilkins (E-mail: kathiest.clai@apta.org)}},
  address = {United States},
  abstract = {OBJECTIVES: Severe acute pancreatitis can lead to systemic complications. Here, we explore the mechanisms based on our previous study associated with the deregulation of heme oxygenase-1 (HO-1) and development of severe acute pancreatitis. METHODS: Acute pancreatitis patients (n = 135) and age- and sex-matched healthy controls (n = 108) were studied. The polymerase chain reaction products were analyzed with an ABI 3130 genetic analyzer and GeneMapper software. A short allele was defined {\textbackslash}leq27 dinucleotide (GT) repeats, whereas a long allele was defined {$>$}27 GT. Levels of 12 different cytokines in blood serum were measured by enzyme-linked immunosorbent assay. All samples in this study were consistently stored in -80{$^\circ$}C. RESULTS: Patients with the long long genotype expressed E-selectin and vascular cell adhesion molecule-1 at statistically significantly higher levels in serum compared with short short genotype or short long genotypes. Vascular cell adhesion molecule-1 and E-selectin serum levels significantly correlate with the total allele length of the HO-1 promoter region. CONCLUSION: Polymorphism of the GT repeats in the HO-1 promoter region may be a risk factor for developing acute necrotizing pancreatitis due to deregulation of the immune response.},
  langid = {english},
  keywords = {*acute hemorrhagic pancreatitis,*endothelial leukocyte adhesion molecule 1/ec [Endogenous Compound],*heme oxygenase 1/ec [Endogenous Compound],*protein polymorphism,*vascular cell adhesion molecule 1/ec [Endogenous Compound],acute abdomen,adiponectin/ec [Endogenous Compound],adult,article,clinical outcome,computer assisted tomography,controlled study,dinucleotide repeat,dinucleotide/ec [Endogenous Compound],enzyme linked immunosorbent assay,female,gelatinase B/ec [Endogenous Compound],genetic analysis,genetic analyzer,human,immune deficiency,intercellular adhesion molecule 1/ec [Endogenous Compound],interleukin 10/ec [Endogenous Compound],interleukin 1beta/ec [Endogenous Compound],interleukin 6/ec [Endogenous Compound],interleukin 8/ec [Endogenous Compound],major clinical study,male,myeloperoxidase/ec [Endogenous Compound],observational study,ovid_export_ris.ris,PADGEM protein/ec [Endogenous Compound],polymerase chain reaction,priority journal,promoter region,prospective study,protein blood level,protein expression,regulatory mechanism,risk factor}
}

