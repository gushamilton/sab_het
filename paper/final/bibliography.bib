@article{johnstonec.n.MRSAACRJointConference2011,
  title = {{{MRS-AACR Joint Conference}} on {{Metastasis}} 2010},
  author = {{Johnstone C.N.} and {Lucas E.} and {Kusdra L.} and {Goga A.} and {Anderson R.L.}},
  year = {2011},
  month = feb,
  journal = {Clin. Exp. Metastasis},
  volume = {28},
  number = {2},
  pages = {157--259},
  publisher = {{Springer Science and Business Media LLC}},
  abstract = {Some microRNAs can influence tumor progression by functioning as metastasis promoting genes or metastasis suppressor genes. To identify additional microRNAs capable of driving breast cancer metastasis in vivo, we employed a functional genomics screen using the '4T1' syngeneic (Balb/c) mouse model of breast cancer progression. Approximately 500 human microRNA sequences were subcloned into the pMSCVpuro retroviral vector and the resultant microRNA expression library transduced into fluorescent non-metastatic 67NRpMSCV mCherry and mildy-metastatic 66cl4-pMSCVmCherry cells. Control and microRNA library-transduced cell lines were implanted into the mammary fat pads of 20 Balb/c mice per cell line, and the resultant primary tumors resected approximately 21 days later. Mice were subsequently monitored for onset of local and distant relapse. Recurrent primary tumors and secondary organs, including any overt metastatic deposits, were collected and the microRNA inserts PCR-amplified from the integrated retrovirus, subcloned and sequenced. Results to date indicate an involvement of mir-141 in breast cancer metastasis. This will be tested in functional assays using cells with altered mir-141 levels. In an alternative approach, we examined two populations of metastatic MDA-MB-231 human breast cancer cells that exhibit different behavior in vitro and in vivo to elucidate processes involved in invasion and metastasis. A late-passage MDA-MB-231 (231 variant) population formed invasive clusters in 3D culture, whereas early-passage MDAMB231 (231) cells did not. Furthermore, 231v cells were more motile than 231 cells and showed enhanced tumorigenicity when grown as xenografts in nude mice, whereas in vitro proliferation and stress induced apoptosis were indistinguishable. Characterization of the two cell populations by array-based expression profiling revealed elevated expression of NF kappa B target genes in 231v cells (IL1A, IL1B, PTX3, NR4A2, HMOX1, FLIP). MicroRNA array also demonstrated induction (8-fold) of the NF kappa B target microRNAs, miR-146a and miR-146b. Further evaluation of a panel of breast cancer cell lines by qPCR revealed dramatic elevation of miR-146 in metastatic cell lines that display both epithelial-to-mesenchymal transition and high NF kappa B activity (MDA-MB-231, Hs578T, MDA-MB-436), compared to non-metastatic lines.},
  langid = {english},
  keywords = {*breast cancer,*cancer growth,*functional genomics,*metastasis,*microRNA,apoptosis,assay,cancer cell,cancer cell culture,carcinogenicity,cell line,cell population,epithelial mesenchymal transition,gene,human,immunoglobulin enhancer binding protein,in vitro study,library,model,mouse,nude mouse,ovid_export_ris.ris,population,primary tumor,relapse,Retrovirus,retrovirus vector,suppressor gene,tumor growth,xenograft}
}

