@article{reynoldss.2020PediatricEndocrine2020,
  title = {2020 Pediatric Endocrine Society ({{PES}}) Annual Meeting},
  author = {{Reynolds S.} and {Bikas A.} and {Patel A.} and {Torres M.C.M.} and {Jensen K.} and {Vasko V.}},
  year = {2020},
  journal = {Horm. Res. Paediatr.},
  volume = {93},
  number = {1},
  pages = {I--II},
  publisher = {S. Karger AG},
  address = {Netherlands},
  abstract = {Objectives Most pediatric medullary thyroid cancers (MTC) result from dominantly inherited or de novo activating mutations in the Rearrangedduring- transfection (RET) proto-oncogene. Our group previously demonstrated that RET-positive MTC-derived cells have abundant mitochondrial respiratory chain molecules that are increased in human MTCs as compared to normal thyroid tissue. In this study, we examined how inhibition of oxidative phosphorylation affects expression of genes controlling response to oxidative stress and DNA damage in MTC-derived cells. Methods Human MTC-derived TT cells (harboring C634W RET mutation) were grown in RPMI 1640 medium. Mitochondrial respiration was inhibited via silencing of cytochrome C oxidase subunit IV (COXIV) using either shRNA or treatment with potassium cyanide (KCN). Total RNA was extracted using the all prep DNA/RNA mini kit. The mRNA levels of genes involved in cellular response to oxidative stress and genes encoding molecules with established roles in cancer were examined using ``Oxidative Stress'' and ``Human Cancer PathwayFinder'' real-time PCR arrays (Qiagen). Results In MTC-derived TT cells, the downregulation of COXIV expression by shRNA or treatment with KCN resulted in overexpression of genes controlling ROS-generating systems. The mRNA levels of NADPH oxidases (DUOX1, DUOX2) were increased. Interestingly, the mRNA level of Forkhead Box M1 (FOXM1), which is reported to protect cancer cells from the adverse effects of oxidative stress, was decreased in COXIV deficient cells. Analysis of known cancer genes showed that inhibition of oxidative phosphorylation in MTC cells was associated with significant downregulation of genes controlling angiogenesis (KDR, AMPGPT2) and genes regulating cell cycle progression (MKI67, MCM2, E2F4). At the same time, expression of genes involved in the cell's response to DNA damage (DDIT3, HMOX1) were increased after COXIV silencing. In addition, inhibition of mitochondrial respiration demonstrated an increase in expression of apoptotic markers PUMA and NOXA. Conclusions While MTC accounts for only 4\% of thyroid cancer, it represents more than 15\% of thyroid cancer-related deaths. Tyrosine kinase inhibitors are approved for metastatic MTC treatment, but only lead to increased survival rates rather than remission. Our results suggest that targeting mitochondrial respiration may be an alternative treatment option in MTC patients.},
  copyright = {https://www.karger.com/Services/SiteLicenses},
  langid = {english},
  keywords = {*apoptosis,*cancer growth,*messenger RNA,*oxidative phosphorylation,*thyroid medullary carcinoma,adult,angiogenesis,cancer mortality,cancer patient,cancer survival,cell cycle progression,conference abstract,controlled study,cytochrome c oxidase,DNA damage response,DNA RNA hybridization,down regulation,dual oxidase,endogenous compound,forkhead box protein M1,gene mutation,gene overexpression,gene silencing,growth arrest and DNA damage inducible protein 153,heme oxygenase 1,human,human cell,Ki 67 antigen,minichromosome maintenance protein 2,mitochondrial respiration,ovid_export_ris.ris,oxidative stress,potassium cyanide,protein expression,protein Ret,protein tyrosine kinase inhibitor,PUMA protein,reactive oxygen metabolite,real time polymerase chain reaction,reduced nicotinamide adenine dinucleotide phosphate oxidase,remission,short hairpin RNA,survival rate,T.T cell line,tumor gene}
}

@article{rezel-pottsSepsisRecordingPrimary2020,
  title = {Sepsis Recording in Primary Care Electronic Health Records, Linked Hospital Episodes and Mortality Records: {{Population-based}} Cohort Study in {{England}}},
  author = {{Rezel-Potts}, Emma and Gulliford, Martin C and {Safe AB Study Group}},
  year = {2020},
  month = dec,
  journal = {PLoS One},
  volume = {15},
  number = {12},
  pages = {e0244764},
  abstract = {BACKGROUND: Sepsis is a growing concern for health systems, but the epidemiology of sepsis is poorly characterised. We evaluated sepsis recording across primary care electronic records, hospital episodes and mortality registrations. METHODS AND FINDINGS: Cohort study including 378 general practices in England from Clinical Practice Research Datalink (CPRD) GOLD database from 2002-2017 with 36,209,676 patient-years of follow-up with linked Hospital Episode Statistics (HES) and Office for National Statistics (ONS) mortality registrations. Incident sepsis episodes were identified for each source. Concurrent records from different sources were identified and age-standardised and age-specific incidence rates compared. Logistic regression analysis evaluated associations of gender, age-group, fifth of deprivation and period of diagnosis with concurrent sepsis recording. There were 20,206 first episodes of sepsis from primary care, 20,278 from HES and 13,972 from ONS. There were 4,117 (20\%) first HES sepsis events and 2,438 (17\%) mortality records concurrent with incident primary care sepsis records within 30 days. Concurrent HES and primary care records of sepsis within 30 days before or after first diagnosis were higher at younger or older ages and for patients with the most recent period of diagnosis. Those diagnosed during 2007:2011 were less likely to have a concurrent HES record given CPRD compared to those diagnosed during 2012-2017 (odd ratio 0.65, 95\% confidence interval 0.60-0.70). At age 85 and older, primary care incidence was 5.22 per 1,000 patient years (95\% CI 1.75-11.97) in men and 3.55 (0.87-9.58) in women which increased to 10.09 (4.86-18.51) for men and 7.22 (2.96-14.72) for women after inclusion of all three sources. CONCLUSION: Explicit recording of 'sepsis' is inconsistent across healthcare sectors with a high proportion of non-concurrent records. Incidence estimates are higher when linked data are analysed.},
  langid = {english}
}

