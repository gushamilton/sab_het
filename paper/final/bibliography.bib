@unpublished{cheungTradeOffsAntibacterialResistance2020,
  title = {Trade-{{Offs Between Antibacterial Resistance}} and {{Fitness Cost}} in the {{Production}} of {{Metallo-$\beta$-Lactamase}} by {{Enteric Bacteria Manifest}} as {{Sporadic Emergence}} of {{Carbapenem Resistance}} in a {{Clinical Setting}}},
  author = {Cheung, Ching Hei Phoebe and Alorabi, Mohammed and Hamilton, Fergus and Takebayashi, Yuiko and Mounsey, Oliver and Heesom, Kate J and Williams, Philip B and Martin Williams, O and Albur, Maha and MacGowan, Alasdair P and Avison, Matthew B},
  year = {2020},
  month = oct,
  journal = {bioRxiv},
  abstract = {Abstract Meropenem is a clinically important antibacterial reserved for treatment of multi-resistant infections. In meropenem-resistant bacteria of the family Enterobacteriales, NDM-1 is considerably more common than IMP-1, despite both metallo-{$\beta$}-lactamases (MBLs) hydrolysing meropenem with almost identical kinetics. We show that blaNDM-1 consistently confers meropenem resistance in wild-type Enterobacteriales, but blaIMP-1 does not. The reason is higher blaNDM-1 expression because of its stronger promoter. However, the cost of meropenem resistance is reduced fitness of blaNDM-1 positive Enterobacteriales because of amino acid starvation. In parallel, from a clinical case, we identified multiple Enterobacter spp. isolates carrying a plasmid-encoded blaNDM-1 having a modified promoter region. This modification lowered MBL production to a level associated with zero fitness cost but, consequently, the isolates were not meropenem resistant. However, we identified a Klebsiella pneumoniae isolate from this same clinical case carrying the same blaNDM-1 plasmid. This isolate was meropenem resistant despite low-level NDM-1 production because of a ramR mutation, reducing envelope permeability. Overall, therefore, we show how the resistance/fitness trade-off for MBL carriage can be resolved. The result is sporadic emergence of meropenem resistance in a clinical setting.},
  langid = {english}
}

@article{cheungTradeOffsAntibacterialResistance2021,
  title = {Trade-{{Offs}} between {{Antibacterial Resistance}} and {{Fitness Cost}} in the {{Production}} of {{Metallo-$\beta$-Lactamases}} by {{Enteric Bacteria Manifest}} as {{Sporadic Emergence}} of {{Carbapenem Resistance}} in a {{Clinical Setting}}},
  author = {Cheung, Ching Hei Phoebe and Alorabi, Mohammed and Hamilton, Fergus and Takebayashi, Yuiko and Mounsey, Oliver and Heesom, Kate J and Williams, Philip B and Williams, O Martin and Albur, Mahableshwar and MacGowan, Alasdair P and Avison, Matthew B},
  year = {2021},
  month = jul,
  journal = {Antimicrob. Agents Chemother.},
  volume = {65},
  number = {8},
  pages = {e0241220},
  abstract = {Meropenem is a clinically important antibacterial reserved for treatment of multiresistant infections. In meropenem-resistant bacteria of the family Enterobacterales, NDM-1 is considerably more common than IMP-1, despite both metallo-{$\beta$}-lactamases (MBLs) hydrolyzing meropenem with almost identical kinetics. We show that blaNDM-1 consistently confers meropenem resistance in wild-type Enterobacterales, but blaIMP-1 does not. The reason is higher blaNDM-1 expression because of its stronger promoter. However, the cost of meropenem resistance is reduced fitness of blaNDM-1-positive Enterobacterales. In parallel, from a clinical case, we identified multiple Enterobacter spp. isolates carrying a plasmid-encoded blaNDM-1 having a modified promoter region. This modification lowered MBL production to a level associated with zero fitness cost, but, consequently, the isolates were not meropenem resistant. However, we identified a Klebsiella pneumoniae isolate from this same clinical case carrying the same blaNDM-1 plasmid. This isolate was meropenem resistant despite low-level NDM-1 production because of a ramR mutation reducing envelope permeability. Overall, therefore, we show how the resistance/fitness trade-off for MBL carriage can be resolved. The result is sporadic emergence of meropenem resistance in a clinical setting.},
  langid = {english},
  keywords = {Enterobacter,Klebsiella,meropenem,NDM-1,RamA}
}

@article{Chew2020-ls,
  title = {Clinical Evaluation of Serological {{IgG}} Antibody Response on the {{Abbott Architect}} for Established {{SARS-CoV-2}} Infection},
  author = {Chew, Ka Lip and Tan, Shaun S and Saw, Sharon and Pajarillaga, Anastacia and Zaine, Suzzana and Khoo, Candy and Wang, Weixuan and Tambyah, Paul and Jureen, Roland and Sethi, Sunil K},
  year = {2020},
  month = jun,
  journal = {Clin. Microbiol. Infect.},
  abstract = {OBJECTIVE: This study aimed to evaluated the diagnostic performance of the Abbott Architect SARS-CoV-2 IgG assay in COVID-19 patients. METHODS: Residual sera from 177 symptomatic COVID-19 positive patients, and 163 non-COVID-19 patients were tested for antibody with the Abbott SARS-CoV-2 IgG assay (Abbott Diagnostics, Chicago, US). Clinical records for COVID-19 patients were reviewed to determine the time from onset of clinical illness to testing. RESULTS: Specificity of the assay was 100.0\% (95\% CI: 97.1 - 100.0\%). The clinical sensitivity of the assay varied depending on time from onset of symptoms, increasing with longer periods since onset of clinical illness. The clinical sensitivity at {$\leq$}6 days was 8.6\% (7/81; 95\% CI: 3.8 - 17.5\%), 7-13 days: 43.6\% (17/39; 95\% CI: 28.2 - 60.2\%), 14-20 days: 84.0\% (21/25; 95\% CI: 63.1 - 94.7\%), and {$\geq$}21 days: 84.4\% (27/32; 95\% CI: 66.5 - 94.1\%). Clinical sensitivity was higher in the {$\geq$}14 days group compared to {\textexclamdown}14. There were no differences between the 14-20 days and {$\geq$}21 days group; the combined clinical sensitivity for these groups ({$\geq$}14 days) was 84.2\% (49/57; 71.6 - 92.1\%). CONCLUSION: The Abbott SARS-CoV-2 IgG test has high specificity. Clinical sensitivity was limited in early stages of disease but improved from 14 days after onset of clinical infection.},
  langid = {english},
  keywords = {Abbott Architect,COVID-19,Immunoglobulin G,SARS-CoV-2,Serology}
}

@article{chewClinicalEvaluationSerological2020,
  title = {Clinical Evaluation of Serological {{IgG}} Antibody Response on the {{Abbott Architect}} for Established {{SARS-CoV-2}} Infection},
  author = {Chew, K L and Tan, S S and Saw, S and Pajarillaga, A and Zaine, S and Khoo, C and Wang, W and Tambyah, P and Jureen, R and Sethi, S K},
