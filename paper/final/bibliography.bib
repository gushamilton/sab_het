@article{Goldman1986-su,
  title = {Parathyroid Adenoma Causing Persistent Hypercalcaemia after Rhabdomyolysis-Induced Acute Renal Failure},
  author = {Goldman, M and Kinnaert, P and Fuss, M and Abramowicz, M and Van Geertruyden, J and Toussaint, C},
  year = {1986},
  journal = {Nephrology, dialysis, transplantation : official publication of the European Dialysis and Transplant Association - European Renal Association},
  volume = {1},
  number = {1},
  pages = {50--52},
  address = {GERMANY},
  abstract = {Persistent hypercalcaemia developed in a 26-year-old man after rhabdomyolysis-induced acute renal failure. Although several serum parathyroid values were normal following recovery of renal function, primary hyperparathyroidism was suspected after 9 months of prolonged hypercalcaemia. A single parathyroid adenoma was removed and serum calcium as well as serum parathyroid hormone returned to normal values. The persistence of increased serum calcium concentrations after rhabdomyolysis-induced acute renal failure should lead one to consider other causes of hypercalcaemia, and particularly primary hyperparathyroidism.},
  keywords = {*Acute Kidney Injury/et [Etiology],*Adenoma/co [Complications],*Hypercalcemia/et [Etiology],*Parathyroid Neoplasms/co [Complications],*Rhabdomyolysis/co [Complications],Adult,Carnitine O-Palmitoyltransferase/df [Deficiency],Humans,Male,Mendeley Import (Dec 08)}
}

