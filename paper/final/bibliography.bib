@article{grantGenomewideAssociationStudy2016,
  title = {A Genome-Wide Association Study of Pulmonary Tuberculosis in {{Morocco}}},
  author = {Grant, A V and Sabri, A and Abid, A and Abderrahmani Rhorfi, I and Benkirane, M and Souhi, H and Naji Amrani, H and {Alaoui-Tahiri}, K and Gharbaoui, Y and Lazrak, F and Sentissi, I and Manessouri, M and Belkheiri, S and Zaid, S and Bouraqadi, A and El Amraoui, N and Hakam, M and Belkadi, A and Orlova, M and Boland, A and Deswarte, C and Amar, L and Bustamante, J and {Boisson-Dupuis}, S and Casanova, J L and Schurr, E and El Baghdadi, J and Abel, L},
  year = {2016},
  month = mar,
  journal = {Hum. Genet.},
  volume = {135},
  number = {3},
  pages = {299--307},
  abstract = {Although epidemiological evidence suggests a human genetic basis of pulmonary tuberculosis (PTB) susceptibility, the identification of specific genes and alleles influencing PTB risk has proven to be difficult. Previous genome-wide association (GWA) studies have identified only three novel loci with modest effect sizes in sub-Saharan African and Russian populations. We performed a GWA study of 550,352 autosomal SNPs in a family-based discovery Moroccan sample (on the full population and on the subset with PTB diagnosis at {$<$}25 years), which identified 143 SNPs with p {$<$} 1 {\textbackslash}times 10(-4). The replication study in an independent case/control sample identified four SNPs displaying a p {$<$} 0.01 implicating the same risk allele. In the combined sample including 556 PTB subjects and 650 controls these four SNPs showed suggestive association (2 {\textbackslash}times 10(-6) {$<$} p {$<$} 4 {\textbackslash}times 10(-5)): rs358793 and rs17590261 were intergenic, while rs6786408 and rs916943 were located in introns of FOXP1 and AGMO, respectively. Both genes are involved in the function of macrophages, which are the site of latency and reactivation of Mycobacterium tuberculosis. The most significant finding (p = 2 {\textbackslash}times 10(-6)) was obtained for the AGMO SNP in an early ({$<$}25 years) age-at-onset subset, confirming the importance of considering age-at-onset to decipher the genetic basis of PTB. Although only suggestive, these findings highlight several avenues for future research in the human genetics of PTB.},
  langid = {english}
}

