  title = {Gene Polymorphisms in the Heme Degradation Pathway and Outcome of Severe Human Sepsis},
  author = {Sponholz, Christoph and Huse, Klaus and Kramer, Marcel and {Giamarellos-Bourboulis}, Evangelos J and Claus, Ralf A and Kern, Anna and Engel, Christoph and Kuhnt, Evelyn and Kiehntopf, Michael and Routsi, Christina and Mylona, Vassiliki and Tsangaris, Iraklis and Heinemann, Stefan H and Reinhart, Konrad and Platzer, Matthias and Bauer, Michael},
