@article{ijasAbstract2646Haptoglobin2012,
  title = {Abstract 2646: {{Haptoglobin}} 2 {{Allele Associates}} with {{Symptomatic Carotid Stenosis}} and {{Major Cardiovascular Events}}},
  author = {Ijas, Petra and Luoma, Petri and Saksi, Jani and Tuimala, Jarno and Nuotio, Krista and Soinne, Lauri and Jauhiainen, Matti and Kaste, Markku and Kovanen, Petri T and Lindsberg, Perttu J},
  year = {2012},
  month = feb,
  journal = {Stroke},
  volume = {43},
  number = {suppl\_1},
  pages = {A2646--A2646},
  publisher = {American Heart Association},
  abstract = {Objectives: Haptoglobin (Hp) is a plasma protein which binds free hemoglobin (Hb) protecting tissues from iron-induced oxidative damage and promoting Hb clearance via macrophage CD163 receptor. There are two common alleles for Hp (Hp 1 and Hp 2), which influence it's capacity to bind Hb and induce downstream signaling via CD163+ macrophages. We have previously shown that the CD163-heme oxygenase-1 (HO1) pathway is upregulated in symptomatic carotid stenosis (CS) and other groups have associated the Hp 2-2 genotype with cardiovascular complications in diabetics. Here, our objective was to study whether Hp polymorphism influences the risk of symptomatic CS and major cardiovascular events in the general population Methods: We genotyped Hp polymorphism in 90 patients with a high-grade CS ({$>$}= 70\%) from Helsinki Carotid Endarterectomy Study (HeCES) and in 1426 individuals with carotid ultrasound examination data from the Health 2000 Survey, an epidemiological cross-sectional health survey carried out in Finland in the year 2000 Results: In the Health 2000 population, the Hp genotype frequencies were 0.170 (Hp 1-1), 0.445 (Hp 1-2) and 0.386 (Hp 2-2) consistent with Hardy-Weinberg equilibrium and with those reported from caucasian populations. In the CS patients, the genotype frequencies were skewed towards the Hp 2-2 genotype but not significantly. However, among the patients with symptomatic CS (ipsilateral TIA or stroke), the frequency of Hp 2-2 genotype was significantly higher than in the control population (0.528 vs 0.386, P=0.044). Hp genotypes correlated with HO1 protein expression in the plaque (r=0.46, P= 0.038) but not with iron. In the Health 2000 population, Hp 2 allele was associated with an increased risk of major cardiovascular events (major coronary heart disease event, ischemic stroke or TIA; 13.3\% vs 8.3, P=0.032) and the increased risk was present regardless of diabetes. Hp 2 allele was not associated with carotid IMT or presence of plaques Conclusion(s): Hp 2 allele associates with the risk of symptomatic CS and major ischemic cardiovascular events. This is likely due to the defective ability of Hp 2 to block oxidative reactions mediated by iron/heme, to clear free Hb present in intraplaque hemorrhages as well as the effects of the Hb-Hp 2 complex on intracellular signaling cascades via the CD163 receptor.},
  keywords = {*allele,*arteriosclerosis,*carotid artery,*carotid artery obstruction,*cerebrovascular accident,*coronary artery disease,*gene expression,*haptoglobin,*nursing,aerobic metabolism,bleeding,brain ischemia,cardiovascular disease,carotid endarterectomy,Caucasian,diabetes mellitus,examination,Finland,genotype,health,health survey,heme oxygenase 1,hemoglobin,human,intracellular signaling,iron,ischemic heart disease,macrophage,ovid_export_ris.ris,patient,plasma protein,population,protein expression,receptor,risk,tissues,ultrasound}
}

@article{ijasHaptoglobin2Allele2013,
  title = {Haptoglobin 2 Allele Associates with Unstable Carotid Plaque and Major Cardiovascular Events},
  author = {Ij{\"a}s, Petra and Saksi, Jani and Soinne, Lauri and Tuimala, Jarno and Jauhiainen, Matti and Jula, Antti and K{\"a}h{\"o}nen, Mika and Kes{\"a}niemi, Y Antero and Kovanen, Petri T and Kaste, Markku and Lindsberg, Perttu J},
  year = {2013},
  month = oct,
  journal = {Atherosclerosis},
  volume = {230},
  number = {2},
  pages = {228--234},
  publisher = {Elsevier Ireland Ltd (P.O. Box 85, Limerick, Ireland)},
  address = {Ireland},
  abstract = {OBJECTIVE: Intraplaque hemorrhages (IPH) may predispose to unstable atherosclerotic disease and its atherothrombotic complications, ischemic stroke and coronary syndromes. However, the discriminative value of IPH has been limited in histological and imaging studies suggesting that confounding factors modulate the response to IPH. We studied whether common variants of haptoglobin (Hp), which facilitates the removal of free hemoglobin and protects tissues from heme-iron induced oxidative damage, would modify the inflammatory response to IPH and the risk of unstable carotid stenosis (CS) and major cardiovascular diseases. METHODS: We genotyped Hp polymorphism in 91 patients with a high-grade CS from Helsinki Carotid Endarterectomy Study (HeCES) and in 1417 individuals from Health 2000, a Finnish epidemiological cross-sectional health survey, and determined heme oxygenase-1 (HO1) expression in relation to Hp genotypes in carotid plaques. RESULTS: In the Health 2000 cohort, Hp genotype frequencies were 0.143 (hp1-1), 0.486 (hp1-2) and 0.371 (hp2-2) consistent with Hardy-Weinberg equilibrium and those reported from other Caucasian populations. Among patients with unstable CS, the frequency of hp2-2 genotype was higher than in the control population (0.516 vs. 0.371, P = 0.025). Hp genotypes correlated with HO1 expression in the plaque (r = 0.47, P = 0.027). In the Health 2000 cohort, hp2 allele was associated with an increased risk of major cardiovascular diseases (ischemic stroke, TIA, myocardial infarction, coronary heart disease) with an adjusted OR of 1.46 (95\% CI 1.03-2.06). CONCLUSION: Common haptoglobin variants modulate the inflammatory response to IPH and associate with the risk of unstable carotid stenosis and major ischemic cardiovascular events.},
  langid = {english},
  keywords = {*Cardiovascular Diseases/ge [Genetics],*Carotid Arteries/pa [Pathology],*Carotid Stenosis/ge [Genetics],*Haptoglobins/ge [Genetics],*Plaque,*Polymorphism,Aged,Alleles,Atherosclerotic/bl [Blood],Atherosclerotic/ge [Genetics],Cardiovascular Diseases/bl [Blood],Carotid,Carotid stenoses,Carotid Stenosis/bl [Blood],Cohort Studies,Cross-Sectional Studies,Endarterectomy,Female,Genetic,Genotype,Haptoglobins/me [Metabolism],Heme Oxygenase-1/me [Metabolism],Humans,Inflammation,Intraplaque hemorrhage,Male,Middle Aged,Myocardial infarction,ovid_export_ris.ris,Plaque,Risk,Stroke,Stroke/di [Diagnosis],Stroke/ge [Genetics]}
}

@article{Ijaz2006-jz,
  title = {Estimation of Ionized Calcium, Total Calcium and Albumin Corrected Calcium for the Diagnosis of Hypercalcaemia of Malignancy},
  author = {Ijaz, Aamir and Mehmood, Tariq and Qureshi, Ayaz Hussain and Anwar, Masood and Dilawar, Muhammad and Hussain, Iftikhar and Khan, Farooq Ahmad and Khan, Dilshad Ahmad and Hussain, Shujaat and Khan, Iqbal Ahmad},
  year = {2006},
