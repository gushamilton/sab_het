}

@article{choRoleNRF2Protection2002,
  title = {Role of {{NRF2}} in Protection against Hyperoxic Lung Injury in Mice},
  author = {Cho, Hye-Youn and Jedlicka, Anne E and Reddy, Sekhar P M and Kensler, Thomas W and Yamamoto, Masayuki and Zhang, Liu-Yi and Kleeberger, Steven R},
  year = {2002},
  month = feb,
  journal = {Am. J. Respir. Cell Mol. Biol.},
  volume = {26},
  number = {2},
  pages = {175--182},
  address = {United States},
  abstract = {NRF2 is a transcription factor important in the protection against carcinogenesis and oxidative stress through antioxidant response element (ARE)-mediated transcriptional activation of several phase 2 detoxifying and antioxidant enzymes. This study was designed to determine the role of NRF2 in the pathogenesis of hyperoxic lung injury by comparing pulmonary responses to 95-98\% oxygen between mice with site-directed mutation of the gene for NRF2 (Nrf2-/-) and wild-type mice (Nrf2+/+). Pulmonary hyperpermeability, macrophage inflammation, and epithelial injury in Nrf2-/- mice were 7.6-fold, 47\%, and 43\% greater, respectively, compared with Nrf2+/+ mice after 72 h hyperoxia exposure. Hyperoxia markedly elevated the expression of NRF2 mRNA and DNA-binding activity of NRF2 in the lungs of Nrf2+/+ mice. mRNA expression for ARE- responsive lung antioxidant and phase 2 enzymes was evaluated in both genotypes of mice to identify potential downstream molecular mechanisms of NRF2 in hyperoxic lung responses. Hyperoxia-induced mRNA levels of NAD(P)H:quinone oxidoreductase 1 (NQO1), glutathione-S-transferase (GST)-Ya and -Yc subunits, UDP glycosyl transferase (UGT), glutathione peroxidase-2 (GPx2), and heme oxygenase-1 (HO-1) were significantly lower in Nrf2-/- mice compared with Nrf2+/+ mice. Consistent with differential mRNA expression, NQO1 and total GST activities were significantly lower in Nrf2-/- mice compared with Nrf2+/+ mice after hyperoxia. Results demonstrated that NRF2 has a significant protective role against pulmonary hyperoxic injury in mice, possibly through transcriptional activation of lung antioxidant defense enzymes.},
  langid = {english},
  keywords = {*DNA-Binding Proteins/me [Metabolism],*Gene Expression Regulation,*Lung/en [Enzymology],*Oxygen/to [Toxicity],*Trans-Activators/me [Metabolism],Alveolar/me [Metabolism],Animals,Antioxidants/me [Metabolism],Bronchoalveolar Lavage Fluid/ch [Chemistry],DNA-Binding Proteins/ge [Genetics],Enzymologic/ph [Physiology],Epithelial Cells/me [Metabolism],Knockout,Leucine Zippers,Lung Injury,Lung/cy [Cytology],Lung/pp [Physiopathology],Macrophages,Messenger/me [Metabolism],Mice,NF-E2-Related Factor 2,Nuclear Proteins/ge [Genetics],Nuclear Proteins/me [Metabolism],ovid_export_ris.ris,Oxidation-Reduction,RNA,Tissue Extracts/ch [Chemistry],Trans-Activators/ge [Genetics]}
}

@article{chotivanichHemoglobinBalancedPolymorphism2002,
  title = {Hemoglobin {{E}}: A Balanced Polymorphism Protective against High Parasitemias and Thus Severe {{P}} Falciparum Malaria},
  author = {Chotivanich, Kesinee and Udomsangpetch, Rachanee and Pattanapanyasat, Kovit and Chierakul, Wirongrong and Simpson, Julie and Looareesuwan, Sornchai and White, Nicholas},
  year = {2002},
  month = aug,
  journal = {Blood},
  volume = {100},
  number = {4},
  pages = {1172--1176},
  abstract = {Hemoglobin E is very common in parts of Southeast Asia. The possible malaria protective effects of this and other inherited hemoglobin abnormalities prevalent in Thailand were assessed in a mixed erythrocyte invasion assay. In vitro, starting at 1\% parasitemia, Plasmodium falciparum preferentially invaded normal (HbAA) compared to abnormal hemoglobin (HbH, AE, EE, HCS, beta-thalassemia E) red cells (HRBCs). The median (range) ratio of parasitization of HRBCs (n = 109) compared to the controls of different major blood groups was 0.40 (0.08, 0.98), less than half that of the normal red cells (NRBCs) compared to their controls 0.88 (0.53, 1.4; P =.001). The median (range) parasitemia in the HRBCs was 2\% (0.1\%-9\%) compared to 5.2\% (1.2\%-16.3\%) in the NRBCs (P =.001). The proportion of the RBC population that is susceptible to malaria parasite invasion can be described by a selectivity index (SI; observed number of multiply invaded RBCs/number predicted). The heterozygote AE cells differed markedly from all the other cells tested with invasion restricted to approximately 25\% of the RBCs; the median (range) SI was 3.8 (1-15) compared with 0.75 (0.1-0.9) for EE RBCs (P {$<$}.01). Despite their microcytosis, AE cells are functionally relatively normal in contrast to the RBCs from the other hemoglobinopathies studied. These findings suggest that HbAE erythrocytes have an unidentified membrane abnormality that renders the majority of the RBC population relatively resistant to invasion by P falciparum. This would not protect from uncomplicated malaria infections but would prevent the development of heavy parasite burdens and is consistent with the ``Haldane'' hypothesis of heterozygote protection against severe malaria for hemoglobin E.},
  langid = {english},
  keywords = {mandel}
}

@article{Chou1995-ck,
  title = {Mutations in the Human {{Ca}}(2+)-Sensing-Receptor Gene That Cause Familial Hypocalciuric Hypercalcemia},
  author = {Chou, Y H and Pollak, M R and Brandi, M L and Toss, G and Arnqvist, H and Atkinson, A B and Papapoulos, S E and Marx, S and Brown, E M and Seidman, J G and Al, Et},
  year = {1995},
  journal = {American journal of human genetics},
  volume = {56},
  number = {5},
  pages = {1075--1079},
  publisher = {Liver Research Unit, Chang Gung Memorial Hospital, Taoyuan, Taiwan.},
  address = {UNITED STATES},
  abstract = {We report five novel mutations in the human Ca(2+)-sensing-receptor gene that cause familial hypocalciuric hypercalcemia (FHH) or neonatal severe hyperparathyroidism. Each gene defect is a missense mutation (228Arg--{\textquestiondown}Gln, 139Thr--{\textquestiondown}Met, 144Gly--{\textquestiondown}Glu, 63Arg--{\textquestiondown}Met, and 67Arg--{\textquestiondown}Cys) that encodes a nonconservative amino acid alteration. These mutations are each predicted to be in the Ca(2+)-sensing receptor's large extracellular domain. In three families with FHH linked to the Ca(2+)-sensing-receptor gene on chromosome 3 and in unrelated individuals probands with FHH, mutations were not detected in protein-coding sequences. On the basis of these data and previous analyses, we suggest that there are a wide range of mutations that cause FHH. Mutations that perturb the structure and function of the extracellular or transmembrane domains of the receptor and those that affect noncoding sequences of the Ca(2+)-sensing-receptor gene can cause FHH.},
  keywords = {*Hypercalcemia/ge [Genetics],*Point Mutation,*Receptors,Calcium-Sensing,Calcium/me [Metabolism],Calcium/ur [Urine],Cell Surface/ge [Genetics],Humans,Mendeley Import (Dec 08),Protein Conformation,Receptors}
}

@article{choudhuryCoverZincOxide2017,
  title = {From the {{Cover}}: {{Zinc}} Oxide {{Nanoparticles-Induced Reactive Oxygen Species Promotes Multimodal Cyto-}} and {{Epigenetic Toxicity}}},
  author = {Choudhury, Samrat Roy and Ordaz, Josue and Lo, Chiao-Ling and Damayanti, Nur P and Zhou, Feng and Irudayaraj, Joseph},
  year = {2017},
  month = mar,
  journal = {Toxicol. Sci.},
  volume = {156},
  number = {1},
  pages = {261--274},
  publisher = {Oxford University Press (E-mail: jnl.info@oup.co.uk)},
  address = {United Kingdom},
  abstract = {In this study we evaluated and correlated the cytotoxic effects of zinc oxide nanoparticles (ZnO-NPs) to the epigenetic modifications, using human embryonic kidney (HEK-293) cells as a model system. Imaging of singlet and total reactive oxygen species (ROS) in ZnO-NPs-treated live cells was performed followed by the evaluation of its effects on cytoskeletal, mitochondrial, and nuclear integrity, and on the expression of ROS responsive genes. Next, we determined the global and locus-specific changes in DNA-methylation at the 3 global genomic repeat sequences namely LINE-1, subtelomeric D4Z4 and pericentromeric NBL2, and at the promoter of selected ROS responsive genes (AOX1, HMOX1, NCF2, SOD3). Our studies revealed severe actin depolymerization, increased release of mitochondrial cytochrome C, and nuclear enlargement in ZnO-NPs-treated cells. At the epigenetic level, we observed global reduction in 5-methylcytosine and increase in 5-hydroxymethylcytosine content. Additionally, we observed significant increase in the expression of Ten-Eleven Translocation (TET)-methylcytosine dioxygenase genes but not in the expression of DNA-methyltransferases (DNMTs). Based on our findings, we suggest that ZnO-NPs induce abundant increase in ROS to promote multimodal structural and functional anomalies in cells. Most importantly, ZnO-NP-induced ROS may promote global hypomethylation in cells by triggering the expression of TET-enzymes, avoiding DNMT interferences. Global DNA demethylation is considered to be the hallmark of the majority of cancers and once acquired this could be propagated to future progenies. The present study, hence, can be used as a platform for the assessment of epigenomic toxicity of ZnO-NPs in humans in the light of its use in commercial products.},
  langid = {english},
  keywords = {*DNA Demethylation/de [Drug Effects],*Epigenesis,*Hepatocytes/de [Drug Effects],*Metal Nanoparticles/to [Toxicity],*Oxidative Stress/de [Drug Effects],*Reactive Oxygen Species/ag [Agonists],*Zinc Oxide/to [Toxicity],5-Methylcytosine/aa [Analogs & Derivatives],5-Methylcytosine/me [Metabolism],Actin Cytoskeleton/de [Drug Effects],Carcinogens,Cell Membrane/de [Drug Effects],Cell Membrane/me [Metabolism],Cell Membrane/ul [Ultrastructure],Cell Nucleus Size/de [Drug Effects],Cell Survival/de [Drug Effects],cytotoxicity,DNA-methylation.,Electron,Environmental/ch [Chemistry],Environmental/to [Toxicity],Enzymologic/de [Drug Effects],epigenetics,Gene Expression Regulation,Genetic/de [Drug Effects],HEK293 Cells,Hepatocytes/me [Metabolism],Hepatocytes/ul [Ultrastructure],Humans,Metal Nanoparticles/ul [Ultrastructure],Microscopy,Nucleic Acid/de [Drug Effects],ovid_export_ris.ris,Oxidoreductases/ge [Genetics],Oxidoreductases/me [Metabolism],Promoter Regions,Reactive Oxygen Species/me [Metabolism],Repetitive Sequences,Scanning,Transmission,Zinc Oxide/ch [Chemistry],ZnO-nanoparticles}
}

