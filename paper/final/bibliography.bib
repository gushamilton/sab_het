@article{Grinsell2009-ba,
  title = {At the Bottom of the Differential Diagnosis List: Unusual Causes of Pediatric Hypertension},
  author = {Grinsell, Matthew M and Norwood, Victoria F},
  year = {2009},
  journal = {Pediatric nephrology (Berlin, Germany)},
  volume = {24},
  number = {11},
  pages = {2137--2146},
  publisher = {Department of Pediatrics, University of Virginia, Charlottesville, 22903, USA.},
  address = {Germany},
  abstract = {Hypertension affects 1-5\% of children and adolescents, and the incidence has been increasing in association with obesity. However, secondary causes of hypertension such as renal parenchymal diseases, congenital abnormalities and renovascular disorders still remain the leading cause of pediatric hypertension, particularly in children under 12 years old. Other less common causes of hypertension in children and adolescents, including immobilization, burns, illicit and prescription drugs, dietary supplements, genetic disorders, and tumors will be addressed in this review.},
