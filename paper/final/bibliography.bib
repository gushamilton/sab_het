@article{Perlino1981-qn,
  title = {Metronidazole vs Clindamycin Treatment of Anerobic Pulmonary Infection. {{Failure}} of Metronidazole Therapy},
  author = {Perlino, C A},
  year = {1981},
  month = oct,
  journal = {Archives of Internal Medicine},
  volume = {141},
  number = {11},
  pages = {1424--1427},
  abstract = {Metronidazole has important in vitro bactericidal activity against strict anaerobic bacteria and has been used successfully in the treatment of infection due to these organisms. In this randomized study, the efficacy of metronidazole was compared with clindamycin in the treatment of patients with anaerobic lung abscess or necrotizing pneumonia. Six patients with lung abscesses and one with necrotizing pneumonia received metronidazole; six patients with lung abscesses, three with necrotizing pneumonia, and one with pneumonia and empyema received clindamycin. Three patients with lung abscesses and one with necrotizing pneumonia failed to respond to metronidazole treatment. One clindamycin-treated patient died of causes unrelated to antibiotic therapy. The results of this study suggest that metronidazole treatment of anaerobic pulmonary infections is less effective than currently available therapy.},
  langid = {english}
}

