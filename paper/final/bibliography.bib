@article{feingold139AssociationRenal2012,
  title = {139 Association between Renal Function and Genetic Polymorphisms in Pediatric Heart Transplant Recipients},
  author = {Feingold, B and Brooks, M M and Zeevi, A and Ohmann, E L and Burckart, G J and Ferrell, R E and Chinnock, R and Canter, C and Addonizio, L and Bernstein, D and Kirklin, J K and Naftel, D C and Webber, S A},
  year = {2012},
  month = apr,
  journal = {J. Heart Lung Transplant.},
  volume = {31},
  number = {4},
  pages = {S55--S56},
  publisher = {Elsevier BV},
  abstract = {Purpose: Common genetic variations influence rejection, infection, drug metabolism and side effect profiles after pediatric heart transplantation (HTx). Reports in adults suggest that genetic background may also influence renal function post-HTx. In this 6-center study we investigated the association of genetic polymorphisms (GP) in a panel of candidate genes on renal function in 453 pediatric HTx recipients. Methods and Materials: We performed genotyping for functional GPs in: ACE, CYP3A5, ABCB1, TNFalpha, TGFbeta1, IL4, IL6, IL10, IL1RN, IL15RA, HO-1, NOS2, FAS, and FASL. Renal function was determined annually up to 8.5 yrs after HTx by calculation of estimated glomerular filtration rate (eGFR) using the new Schwartz formula. Mixed effects and Cox proportional hazard models were used to assess recipient characteristics (sex, race, age at HTx) and the effect of GPs on longitudinal eGFR and time to eGFR{$<$}60 mL/min/1.73m2. Result(s): Age at HTx was 6.2 +/- 6.1 yrs (33\% {$<$}12 mo old). Follow-up was 5.1 +/- 2.5 yrs. The cohort was 58\% male, 60\% white, 13\% black, and 23\% Hispanic. CNI use at 1 yr post-HTx was 56\% CyA / 43\% Tac. Older age at HTx and black race were independently associated with lower eGFR (adjusted for time post-HTx) and eGFR{$<$}60 mL/min/1.73m2. Of GPs assessed only FASL (C-843T) T allele (p=0.014) and HO-1 (A326G) G allele (p=0.0017) were associated with decreased renal function in univariate analyses. After adjusting for age and race, these associations were attenuated [FASL (p=0.075) and HO-1 (p=0.053)]. We found no associations of any other GPs, including TGFbeta1, CYP3A5, ABCB1, and ACE, with post-HTx renal function. Conclusion(s): In this multicenter, large sample of pediatric HTx recipients we found no strong associations between GPs in 19 candidate genes and post-HTx renal function. Our findings contradict reported associations of GPs with renal dysfunction in adult (CYP3A5) and pediatric (TGFbeta) HTx recipients and suggest that genotyping for these GPs will not facilitate individualized immunosuppression for the purpose of protecting long-term renal function.},
  langid = {english},
  keywords = {*genetic polymorphism,*graft recipient,*heart,*heart graft,*kidney function,*lung transplantation,*society,adult,allele,drug metabolism,follow up,gene,genetic variability,genotype,glomerulus filtration rate,heart transplantation,Hispanic,immunosuppressive treatment,infection,male,Negro,ovid_export_ris.ris,proportional hazards model,recipient,side effect,univariate analysis}
}

@article{feingoldRenalFunctionGenetic2012,
  title = {Renal Function and Genetic Polymorphisms in Pediatric Heart Transplant Recipients},
  author = {Feingold, Brian and Brooks, Maria M and Zeevi, Adriana and Ohmann, Erin L and Burckart, Gilbert J and Ferrell, Robert E and Chinnock, Richard and Canter, Charles and Addonizio, Linda and Bernstein, Daniel and Kirklin, James K and Naftel, David C and Webber, Steven A},
  year = {2012},
  month = sep,
  journal = {J. Heart Lung Transplant.},
  volume = {31},
  number = {9},
  pages = {1003--1008},
  address = {United States},
  abstract = {BACKGROUND: Common genetic variations influence rejection, infection, drug metabolism, and side effect profiles after pediatric heart transplantation. Reports in adults suggest that genetic background may influence post-transplant renal function. In this multicenter study, we investigated the association of genetic polymorphisms (GPs) in a panel of candidate genes on renal function in 453 pediatric heart transplant recipients. METHODS: We performed genotyping for functional GPs in 19 candidate genes. Renal function was determined annually after transplantation by calculation of the estimated glomerular filtration rate (eGFR). Mixed-effects and Cox proportional hazard models were used to assess recipient characteristics and the effect of GPs on longitudinal eGFR and time to eGFR {$<$} 60 mL/min/1.73m(2). RESULTS: Mean age at transplantation was 6.2 {\textbackslash}pm 6.1 years. Mean follow-up was 5.1 {\textbackslash}pm 2.5 years. Older age at transplant and black race were independently associated with post-transplant renal dysfunction. Univariate analyses showed FASL (C-843T) T allele (p = 0.014) and HO-1 (A326G) G allele (p = 0.0017) were associated with decreased renal function. After adjusting for age and race, these associations were attenuated (FASL, p = 0.075; HO-1, p = 0.053). We found no associations of other GPs with post-transplant renal function, including GPs in TGF{$\beta$}1, CYP3A5, ABCB1, and ACE. CONCLUSIONS: In this multicenter, large, sample of pediatric heart transplant recipients, we found no strong associations between GPs in 19 candidate genes and post-transplant renal function. Our findings contradict reported associations of CYP3A5 and TGF{$\beta$}1 with renal function and suggest that genotyping for these GPs will not facilitate individualized immunosuppression for the purpose of protecting renal function after pediatric heart transplantation.},
  langid = {english},
  keywords = {*Heart Transplantation,*Kidney/ph [Physiology],*Polymorphism,Child,Female,Genetic,Humans,Infant,Male,ovid_export_ris.ris,Preschool,Prospective Studies}
}

@article{Felderbauer2005-sc,
  title = {Identification of a Novel Calcium-Sensing Receptor Gene Mutation Causing Familial Hypocalciuric Hypercalcemia by Single-Strand Conformation Polymorphism Analysis},
  author = {Felderbauer, P and Hoffmann, P and Klein, W and Bulut, K and Ansorge, N and Epplen, J T and Schmitz, F and Schmidt, W E},
  year = {2005},
  journal = {Experimental and clinical endocrinology \& diabetes : official journal, German Society of Endocrinology [and] German Diabetes Association},
  volume = {113},
  number = {1},
  pages = {31--34},
  publisher = {Department of Internal Medicine I, St. Josef Hospital, Ruhr-University of Bochum, Germany. peter.felderbauer@rub.de},
  address = {Germany},
  abstract = {Calcium-sensing receptor gene (CASR) mutations that alter the function of the G protein coupled Ca (2+)-sensing receptor are reported in patients with familial hypocalciuric hypercalcemia (FHH), autosomal dominant hypocalcemia (ADH), and neonatal severe hyperparathyroidism (NSHPT). In search for novel disease causing mutations in the CASR gene, we screened exons 2 - 7 of the CASR gene of a family with FHH using single-strand conformation polymorphism analysis. We identified a novel CASR mutation (c.518 T {\textquestiondown} C; L173 P) in exon 4 encoding for the extracellular domain of the Ca (2+)-sensing receptor. This region seems to represent a hot spot within the CASR gene with at least 13 reported disease causing mutations thus far.},
  keywords = {*Hypercalcemia/ge [Genetics],*Hypocalcemia/ge [Genetics],*Mutation,*Receptors,Adult,Calcium-Sensing/ge [Genetics],Case-Control Studies,Cytosine,Heterozygote,Humans,Male,Mendeley Import (Dec 08),Pedigree,Polymorphism,Single-Stranded Conformational,Thymine}
}

