@article{Wada1992-bd,
  title = {Parathyroid Hormone-Related Protein as a Cause of Hypercalcemia in a {{B-cell}} Type Malignant Lymphoma},
  author = {Wada, S and Kitamura, H and Matsuura, Y and Katayama, Y and Ohkawa, H and Kugai, N and Motoyoshi, K and Fuse, Y and Nagata, N},
  year = {1992},
  journal = {Internal medicine (Tokyo, Japan)},
  volume = {31},
  number = {8},
  pages = {968--972},
  publisher = {Third Department of Internal Medicine, National Defense Medical College, Saitama, Japan.},
  address = {JAPAN},
  abstract = {Hypercalcemia occurred in a patient with non-Hodgkin's (B-cell type) lymphoma when generalized lymphadenopathy developed. Despite low normal plasma parathyroid hormone (PTH), nephrogenous cAMP (NcAMP) was not suppressed, and serum and urine PTH-related protein (PTH-rP) levels were elevated. The plasma level of 1,25(OH)2D was within normal range. The combined chemotherapies successfully reduced the tumor size, serum Ca, PTH-rP, and lactic dehydrogenase. Serum osteocalcin was suppressed while the patient was hypercalcemic, and increased after chemotherapy. In the extract of the tumor tissue obtained post mortem, bioactivity stimulating the production of cAMP in osteoblasts was demonstrated along with the immunoreactive PTH-rP. This is the first report of a B-cell lymphoma producing PTH-rP and its association with humoral hypercalcemia of malignancy.},
  keywords = {*Hypercalcemia/et [Etiology],*Lymphoma,*Proteins/ph [Physiology],Aclarubicin/tu [Therapeutic Use],Adult,Alkaline Phosphatase/bl [Blood],Antineoplastic Combined Chemotherapy Protocols,B-Cell/co [Complications],B-Cell/dt [Drug Therapy],B-Cell/me [Metabolism],Calcitriol/bl [Blood],Cisplatin/tu [Therapeutic Use],Creatinine/bl [Blood],Cyclic AMP/bl [Blood],Cytarabine/aa [Analogs & Derivatives],Cytarabine/tu [Therapeutic Use],Etoposide/tu [Therapeutic Use],Glomerular Filtration Rate,Humans,Hydroxycholecalciferols/bl [Blood],Hydroxyproline/bl [Blood],Hypercalcemia/dt [Drug Therapy],Ifosfamide/tu [Therapeutic Use],L-Lactate Dehydrogenase/bl [Blood],Lymphoma,Male,Mendeley Import (Dec 08),Osteocalcin/bl [Blood],Parathyroid Hormone-Related Protein,Parathyroid Hormone/bl [Blood],Prednisolone/tu [Therapeutic Use],Procarbazine/tu [Therapeutic Use]}
}

