@article{Mohammed2010-gs,
  title = {An Unusual Cause of a Mediastinal Mass},
  author = {Mohammed, Abdul Rafi and Rea, Rustam and Ubhi, Chas},
  year = {2010},
  journal = {BMJ case reports},
  volume = {2010},
  publisher = {Department of Endocrinology \& Medicine, Derby Hospitals NHS Foundation Trust, Derby, UK. drmohdrafi@doctors.net.uk},
  address = {England},
  abstract = {Primary hyperparathyroidism (PHPT) is a disorder resulting in hypercalcaemia due to autonomous over secretion of parathyroid hormone. Mediastinal parathyroid adenoma is a rare disorder which can present with a widened mediastinum on a plain film. Its always important to check calcium level in patients who present with a mediastinal mass to rule out PHPT. Recognition of this disorder is crucial to prevent long-term sequelae. The authors report an interesting case and discuss further about it, which would be of help both to a specialist and a general physician.},
  keywords = {*Hyperparathyroidism,*Mediastinal Neoplasms/di [Diagnosis],*Mediastinal Neoplasms/et [Etiology],Biopsy,Diagnosis,Differential,Humans,Hyperparathyroidism,Male,Mediastinal Neoplasms/su [Surgery],Mendeley Import (Dec 08),Middle Aged,Primary/co [Complications],Primary/di [Diagnosis],Primary/su [Surgery],Radiography,Thoracic,Tomography,X-Ray Computed}
}

@article{mohammedkaHO1MiceAre2014,
  title = {{{HO-1-}}/- Mice Are Susceptible to {{MRSA}} Empyema Due to Poor Pleural {{TLR9}} Response},
  author = {{Mohammed K A} and {Gahlot S} and {Nasreen N} and {Sadikot R T} and {Johnson J A} and {Sahn S A}},
  year = {2014},
  journal = {Am. J. Respir. Crit. Care Med.},
  volume = {189},
  number = {MeetingAbstracts},
  publisher = {American Thoracic Society},
  abstract = {Pneumonia is the most common cause of infection-related mortality. Methicillin-resistant S. aureus (MRSA) an emerging pathogen now accounts for more than 55\% of S. aureus -related infections. MRSA causes necrotizing pneumonia and pleural empyema. The host innate immune system recognizes the invading pathogens via Toll Like Receptors (TLRs) and TRL signaling induces innate and adaptive immune responses. Recently CpG-DNA induced TLR9 activation has been demonstrated to provide protection against various infections. Moreover, beta-defensins the natural antibiotics expressed in multiple tissues most notably by the leukocytes and by the cells of epithelial surfaces render protection against resistant infections. Besides, Hemeoxygenase-1 (HO-1), an inducible stress protein, confers cytoprotection against oxidative stress and has physiological role in heme degradation is known to enhance host innate immunity against bacterial infections. Defective HO-1 expression due to polymorphism was found to be associated with increased susceptibility to pneumonia. HO-1 influences a number of cellular processes, including growth, fibrosis, inflammation, and apoptosis. However, it is still unclear whether HO-1 regulates TLR expression and modulates the host innate defenses during MRSA empyema. We hypothesized that HO-1 regulates host innate immune functions via modulating TLR expression, signaling in MRSA infections and empyema. HO-1+/+ and HO-1-/- pleural mesothelial cells (PMC) were infected with MRSA (1:10, MOI) in the presence or absence of Cobalt Protoporphyrin (CoPP- a pharmacological HO-1 inducer) or CORM-2 (a Carbon monoxide donor) and Zinc Protoporphyrin (ZnPP- a pharmacological HO-1 inhibitor) for 6h. Relative gene expression for mTLR9 and mBD14 were determined by real-time PCR. In vivo, HO-1-/- and HO-1+/+ mice were inoculated with MRSA intra-pleurally and euthanized overtime. Host bacteremia was measured by CFU-assay and Histochemical immunostianing was performed for TLR9 expression in lung sections. TLR9 protein expression was measured by western blotting and flow cytometry. MRSA infection induces HO-1 expression in PMCs. A differential expression of TLR9 was observed in HO-1+/+ and HO-1 -/- PMCs in response to MRSA infection in vitro. Mechanistically, TLR9 expression was regulated by HO-1 activity. Subsequently, mBD14 was found to be HO-1/TLR9 dependent. In MRSA infection HO-+/+ mice comparatively high expression of TLR9 and MBD14 were noticed in PMCs as compared to HO-1-/- mice. HO-1-/- PMCs were unable to clear the intracellular bacteria in vivo and in vitro. The present study suggested that HO-1 is associated with TLR9 expression and manifest in the development of methicillin-resistant Staphylococcus aureus (MRSA) sepsis or empyema.},
  keywords = {*American,*empyema,*methicillin resistant Staphylococcus aureus,*mouse,*society,adaptive immunity,antibiotic agent,apoptosis,bacteremia,bacterial infection,bacterium,beta defensin,carbon monoxide,cell protection,CFU counting,colony forming unit,DNA,donor,fibrosis,flow cytometry,gene expression,heat shock protein,heme,in vitro study,infection,inflammation,innate immunity,leukocyte,lung,mesothelium cell,methicillin resistant Staphylococcus aureus infection,meticillin,mortality,ovid_export_ris.ris,oxidative stress,pathogenesis,pleura empyema,pneumonia,protection,protein expression,protoporphyrin cobalt,protoporphyrin zinc,real time polymerase chain reaction,tissues,toll like receptor,Western blotting}
}

