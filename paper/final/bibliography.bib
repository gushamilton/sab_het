@article{Takahashi2020-yg,
  title = {Sex Differences in Immune Responses That Underlie {{COVID-19}} Disease Outcomes},
  author = {Takahashi, Takehiro and Ellingson, Mallory K and Wong, Patrick and Israelow, Benjamin and Lucas, Carolina and Klein, Jon and Silva, Julio and Mao, Tianyang and Oh, Ji Eun and Tokuyama, Maria and Lu, Peiwen and Venkataraman, Arvind and Park, Annsea and Liu, Feimei and Meir, Amit and Sun, Jonathan and Wang, Eric Y and {Casanovas-Massana}, Arnau and Wyllie, Anne L and Vogels, Chantal B F and Earnest, Rebecca and Lapidus, Sarah and Ott, Isabel M and Moore, Adam J and Anastasio, Kelly and Askenase, Michael H and Batsu, Maria and Beatty, Hannah and Bermejo, Santos and Bickerton, Sean and Brower, Kristina and Bucklin, Molly L and Cahill, Staci and Campbell, Melissa and Cao, Yiyun and Courchaine, Edward and Datta, Rupak and DeIuliis, Giuseppe and Geng, Bertie and Glick, Laura and Handoko, Ryan and Kalinich, Chaney and {Khoury-Hanold}, William and Kim, Daniel and Knaggs, Lynda and Kuang, Maxine and Kudo, Eriko and Lim, Joseph and Linehan, Melissa and {Lu-Culligan}, Alice and Malik, Amyn A and Martin, Anjelica and Matos, Irene and McDonald, David and Minasyan, Maksym and Mohanty, Subhasis and Muenker, M Catherine and Naushad, Nida and Nelson, Allison and Nouws, Jessica and {Nunez-Smith}, Marcella and Obaid, Abeer and Ott, Isabel and Park, Hong-Jai and Peng, Xiaohua and Petrone, Mary and Prophet, Sarah and Rahming, Harold and Rice, Tyler and Rose, Kadi-Ann and Sewanan, Lorenzo and Sharma, Lokesh and Shepard, Denise and Silva, Erin and Simonov, Michael and Smolgovsky, Mikhail and Song, Eric and Sonnert, Nicole and Strong, Yvette and Todeasa, Codruta and Valdez, Jordan and Velazquez, Sofia and Vijayakumar, Pavithra and Wang, Haowei and Watkins, Annie and White, Elizabeth B and Yang, Yexin and Shaw, Albert and Fournier, John B and Odio, Camila D and Farhadian, Shelli and Dela Cruz, Charles and Grubaugh, Nathan D and Schulz, Wade L and Ring, Aaron M and Ko, Albert I and Omer, Saad B and Iwasaki, Akiko and {Yale IMPACT research team}},
  year = {2020},
  month = aug,
  journal = {Nature},
  abstract = {A growing body of evidence indicates sex differences in the clinical outcomes of coronavirus disease 2019 (COVID-19)1--5. However, whether immune responses against SARS-CoV-2 differ between sexes, and whether such differences explain male susceptibility to COVID-19, is currently unknown. In this study, we examined sex differences in viral loads, SARS-CoV-2-specific antibody titers, plasma cytokines, as well as blood cell phenotyping in COVID-19 patients. By focusing our analysis on patients with moderate disease who had not received immunomodulatory medications, our results revealed that male patients had higher plasma levels of innate immune cytokines such as IL-8 and IL-18 along with more robust induction of non-classical monocytes. In contrast, female patients mounted significantly more robust T cell activation than male patients during SARS-CoV-2 infection, which was sustained in old age. Importantly, we found that a poor T cell response negatively correlated with patients' age and was associated with worse disease outcome in male patients, but not in female patients. Conversely, higher innate immune cytokines in female patients associated with worse disease progression, but not in male patients. These findings reveal a possible explanation underlying observed sex biases in COVID-19, and provide an important basis for the development of a sex-based approach to the treatment and care of men and women with COVID-19.}
}

@article{takahashiCooperationTranscriptionFactor2002,
  title = {Co-Operation of the Transcription Factor Hepatocyte Nuclear Factor-4 with {{Sp1}} or {{Sp3}} Leads to Transcriptional Activation of the Human Haem Oxygenase-1 Gene Promoter in a Hepatoma Cell Line},
  author = {Takahashi, Shigeru and Matsuura, Naomi and Kurokawa, Takako and Takahashi, Yuji and Miura, Takashi},
  year = {2002},
  month = nov,
  journal = {Biochem. J},
  volume = {367},
  number = {Pt 3},
  pages = {641--652},
  publisher = {Portland Press Ltd (59 Portland Place, London W1N 3AJ, United Kingdom)},
  address = {United Kingdom},
  abstract = {We reported previously that the 5'-flanking region (nucleotides -1976 to -1655) of the human haem oxygenase-1 ( hHO-1 ) gene enhances hHO-1 promoter activity in human hepatoma HepG2 cells, but not in HeLa cells [Takahashi, Takahashi, Ito, Nagano, Shibahara and Miura (1999) Biochim. Biophys. Acta 1447, 231-235]. To define more precisely the regulatory elements involved, in the present study we have functionally dissected this region and localized the enhancer to a 50 bp fragment (-1793 to -1744). Site-direct mutagenesis analysis revealed that two regions were responsible for this enhancer activity, i.e. a hepatocyte nuclear factor-4 (HNF-4) homologous region and a GC box motif homologous region. Mutation in either region alone moderately decreased enhancer activity. However, mutations in both regions reduced promoter activity to the basal level. Electrophoretic mobility-shift assays demonstrated that the P5-2 fragment (-1793 to -1744) interacted with at least two nuclear factors, i.e. HNF-4 and Sp1/Sp3. Co-transfection experiments using Drosophila SL2 cells revealed that HNF-4 and Sp1/Sp3 synergistically stimulated the enhancer activity of the P5-2 fragment. These results indicate that co-operation of HNF-4 with Sp1 or Sp3 leads to the activation of hHO-1 gene expression in hepatoma cells.},
  langid = {english},
  keywords = {*gene expression,*gene product/ec [Endogenous Compound],*genetic transcription,*heme oxygenase 1/ec [Endogenous Compound],*liver cell carcinoma,*nuclear factor I/ec [Endogenous Compound],*transcription factor Sp1/ec [Endogenous Compound],*transcription factor Sp3/ec [Endogenous Compound],*transcription factor/ec [Endogenous Compound],article,controlled study,DNA flanking region,enhancer region,gel mobility shift assay,gene control,gene function,gene insertion,gene location,gene mutation,genetic transfection,hepatocyte nuclear factor 4/ec [Endogenous Compound],human,human cell,nucleotide/ec [Endogenous Compound],ovid_export_ris.ris,priority journal,promoter region,protein motif,regulatory mechanism,sequence homology,transcription initiation}
}

@article{takahashiSexDifferencesImmune2020,
  title = {Sex Differences in Immune Responses That Underlie {{COVID-19}} Disease Outcomes},
  author = {Takahashi, Takehiro and Ellingson, Mallory K and Wong, Patrick and Israelow, Benjamin and Lucas, Carolina and Klein, Jon and Silva, Julio and Mao, Tianyang and Oh, Ji Eun and Tokuyama, Maria and Lu, Peiwen and Venkataraman, Arvind and Park, Annsea and Liu, Feimei and Meir, Amit and Sun, Jonathan and Wang, Eric Y and {Casanovas-Massana}, Arnau and Wyllie, Anne L and Vogels, Chantal B F and Earnest, Rebecca and Lapidus, Sarah and Ott, Isabel M and Moore, Adam J and {Yale IMPACT Research Team} and Shaw, Albert and Fournier, John B and Odio, Camila D and Farhadian, Shelli and Dela Cruz, Charles and Grubaugh, Nathan D and Schulz, Wade L and Ring, Aaron M and Ko, Albert I and Omer, Saad B and Iwasaki, Akiko},
  year = {2020},
  month = dec,
  journal = {Nature},
  volume = {588},
  number = {7837},
  pages = {315--320},
  abstract = {There is increasing evidence that coronavirus disease 2019 (COVID-19) produces more severe symptoms and higher mortality among men than among women1-5. However, whether immune responses against severe acute respiratory syndrome coronavirus (SARS-CoV-2) differ between sexes, and whether such differences correlate with the sex difference in the disease course of COVID-19, is currently unknown. Here we examined sex differences in viral loads, SARS-CoV-2-specific antibody titres, plasma cytokines and blood-cell phenotyping in patients with moderate COVID-19 who had not received immunomodulatory medications. Male patients had higher plasma levels of innate immune cytokines such as IL-8 and IL-18 along with more robust induction of non-classical monocytes. By contrast, female patients had more robust T cell activation than male patients during SARS-CoV-2 infection. Notably, we found that a poor T cell response negatively correlated with patients' age and was associated with worse disease outcome in male patients, but not in female patients. By contrast, higher levels of innate immune cytokines were associated with worse disease progression in female patients, but not in male patients. These findings provide a possible explanation for the observed sex biases in COVID-19, and provide an important basis for the development of a sex-based approach to the treatment and care of male and female patients with COVID-19.},
  langid = {english}
}

@article{Takano2009-wk,
  title = {Superior in Vitro Activity of Carbapenems over Anti-Methicillin-Resistant {{Staphylococcus}} Aureus ({{MRSA}}) and Some Related Antimicrobial Agents for Community-Acquired {{MRSA}} but Not for Hospital-Acquired {{MRSA}}},
  author = {Takano, Tomomi and Higuchi, Wataru and Yamamoto, Tatsuo},
  year = {2009},
  month = feb,
  journal = {Journal of Infection and Chemotherapy},
  volume = {15},
  number = {1},
  pages = {54--57},
  abstract = {Eighty-eight strains of Panton-Valentine leukocidin (PVL)-positive and -negative community-acquired methicillin-resistant Staphylococcus aureus (CA-MRSA) and 152 strains of hospital-acquired MRSA (HA-MRSA) were examined for susceptibility to carbapenems, oxacillin, and other antimicrobial agents. CA-MRSA strains were more susceptible to carbapenems (MIC(90), 1-4 microg/ml) than HA-MRSA strains (MIC(90), 32-64 microg/ml). Among the carbapenems examined, CA-MRSA strains were most susceptible to imipenem (MIC(50), 0.12 microg/ml; MIC(90), 1 microg/ml). A similar tendency was observed with oxacillin, but less markedly (MIC(90): 32 microg/ml for CA-MRSA and {\textquestiondown} or =256 microg/ml for HA-MRSA). This difference was also observed between CA-MRSA and HA-MRSA in susceptibility levels to cephems, erythromycin, clindamycin, and levofloxacin, but not to ampicillin, vancomycin, teicoplanin, linezolid, and arbekacin. The data indicate that, in terms of MIC(50) or MIC(90) values, CA-MRSA is 64-256 times more susceptible to imipenem than HA-MRSA, and for CA-MRSA, some carbapenems, e.g., imipenem, show better in vitro activity than anti-MRSA or some related agents.},
  langid = {english},
  keywords = {Mendeley Import (Dec 08)}
}

