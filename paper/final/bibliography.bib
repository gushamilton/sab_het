@article{Abbas2007-hh,
  title = {Mediastinal Parathyroid Adenoma Causing Primary Hyperparathyroidism},
  author = {Abbas, Farhat and Biyabani, Syed Raziuddin and Memon, Amanullah and Talati, Jamsheer},
  year = {2007},
  journal = {Journal of the Pakistan Medical Association},
  volume = {57},
  number = {2},
  pages = {93--95},
  publisher = {Department of Surgery, The Aga Khan University, Karachi.},
  address = {Pakistan},
  abstract = {An ectopically placed parathyroid adenoma in the anterior mediastinum is a rare cause of persistent or recurrent primary hyperparathyroidism (PHPT) and is recognized as an important cause of failed primary neck exploration. We encountered 3 such cases amongst 70 surgically treated patients with PHPT (4.3\%) over a 20-year period. In 2 cases, the offending adenoma could be removed at first exploration whereas in the 3rd case, it was successfully removed with mediastinal exploration after 2 failed neck explorations. In established cases of PHPT with equivocal preoperative localization studies or negative neck explorations, an ectopically placed parathyroid adenoma should be considered and once localized, should be surgically removed for cure.},
  keywords = {*Adenoma/pa [Pathology],*Hyperparathyroidism,*Parathyroid Neoplasms/pa [Pathology],*Thymus Neoplasms/pa [Pathology],Adenoma/co [Complications],Adenoma/su [Surgery],Adult,Bone/et [Etiology],Fractures,Humans,Hypercalcemia/et [Etiology],Male,Mendeley Import (Dec 08),Parathyroid Neoplasms/co [Complications],Parathyroid Neoplasms/su [Surgery],Primary/et [Etiology],Recurrence,Reoperation,Treatment Failure}
}

