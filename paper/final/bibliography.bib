@article{gregorekGTMicrosatelliteRepeats2013,
  title = {{{GT}} Microsatellite Repeats in the Heme Oxygenase-1 Gene Promoter Associated with Abdominal Aortic Aneurysm in {{Croatian}} Patients},
  author = {Gregorek, Andrea Crkvenac and Gornik, Kristina Crkvenac and Polancec, Darija Stupin and Dabelic, Sanja},
  year = {2013},
  month = jun,
  journal = {Biochem. Genet.},
  volume = {51},
  number = {5-6},
  pages = {482--492},
  publisher = {Springer New York (233 Spring Street, New York NY 10013-1578, United States)},
  address = {United States},
  abstract = {Abdominal aortic aneurysm (AAA) is a complex genetic disorder caused by the interplay of genetic and environmental risk factors. The number of (GT)(n) repeats in the heme oxygenase-1 (HO-1) gene promoter modulates transcription of this enzyme, which might have anti-inflammatory, antioxidant, antiapoptotic, and antiproliferative effect. The distribution of alleles and genotypes in Croatian individuals genotyped for the (GT)(n) HO-1 polymorphism was similar to that in other European populations. Frequency of the short (S) alleles (GT {$<$} 25) was higher in AAA patients (41.9\%) than in non-AAA individuals (28.2\%, p = 0.0026) because there were more SL heterozygotes among the AAA patients. The SL genotype appeared to increase the risk for AAA, but the increase was not statistically significant after adjustment for age, sex, smoking, hypertension, and hyperlipidemia (OR = 1.53, 95\% CI 0.90-3.09, p = 0.062). These findings contradict those of the only other study performed so far on the association of (GT)(n) HO-1 polymorphism and AAA.},
  langid = {english},
  keywords = {*abdominal aorta aneurysm,*heme oxygenase 1/ec [Endogenous Compound],*promoter region,adult,aged,allele,antiinflammatory activity,antioxidant activity,antiproliferative activity,apoptosis,article,controlled study,Croatian,disease association,environmental factor,ethnic group,female,genetic polymorphism,genotype,heredity,heterozygote,human,hyperlipidemia,hypertension,major clinical study,male,microsatellite marker,ovid_export_ris.ris,risk factor,smoking,variable number of tandem repeat}
}

@article{gregorovaPostacuteCOVID19Associated2020,
  title = {Post-Acute {{COVID-19}} Associated with Evidence of Bystander {{T-cell}} Activation and a Recurring Antibiotic-Resistant Bacterial Pneumonia},
  author = {Gregorova, Michaela and Morse, Daniel and Brignoli, Tarcisio and Steventon, Joseph and Hamilton, Fergus and Albur, Mahableshwar and Arnold, David and Thomas, Matthew and Halliday, Alice and Baum, Holly and Rice, Christopher and Avison, Matthew B and Davidson, Andrew D and Santopaolo, Marianna and Oliver, Elizabeth and Goenka, Anu and Finn, Adam and Wooldridge, Linda and Amulic, Borko and Boyton, Rosemary J and Altmann, Daniel M and Butler, David K and McMurray, Claire and Stockton, Joanna and Nicholls, Sam and Cooper, Charles and Loman, Nicholas and Cox, Michael J and Rivino, Laura and Massey, Ruth C},
  year = {2020},
  month = dec,
  journal = {Elife},
  volume = {9},
  abstract = {Here, we describe the case of a COVID-19 patient who developed recurring ventilator-associated pneumonia caused by Pseudomonas aeruginosa that acquired increasing levels of antimicrobial resistance (AMR) in response to treatment. Metagenomic analysis revealed the AMR genotype, while immunological analysis revealed massive and escalating levels of T-cell activation. These were both SARS-CoV-2 and P. aeruginosa specific, and bystander activated, which may have contributed to this patient's persistent symptoms and radiological changes.},
  langid = {english},
  keywords = {human,infectious disease,metagenomics,microbiology,Pseudomonas aeruginosa,SARS-CoV-2,t-cells activation}
}

@article{gregsonAnalyticalChallengesWhen2022,
  title = {Analytical Challenges When Sampling and Characterising Exhaled Aerosol},
  author = {Gregson, Florence K A and Sheikh, Sadiyah and Archer, Justice and Symons, Henry E and Walker, Jim S and Haddrell, Allen E and Orton, Christopher M and Hamilton, Fergus W and Brown, Jules M and Bzdek, Bryan R and Reid, Jonathan P},
  year = {2022},
  month = jan,
  journal = {Aerosol Sci. Technol.},
  volume = {56},
  number = {2},
  pages = {160--175},
  publisher = {Taylor \& Francis},
  abstract = {AbstractRespiratory particles produced by breathing, coughing, and speaking or generated during medical procedures serve as important routes for disease transmission. Characterizing the number of particles generated as well as their size distribution is fundamental for guiding policy on infection control. However, sampling such particles carries inherent challenges. Respiratory particles are polydisperse in size, temporally and spatially variable, and emitted in very low concentrations, usually lower than the preexisting aerosol concentration in indoor environments. In addition, they are typically emitted in a highly dynamic, warm and humid jet, leading to further rapid processes, such as dispersion and evaporation. Here, we discuss important considerations for sampling respiratory aerosol, focusing on sampling particles 5??m diameter) that are so low in concentration that they may require hours of sampling time to be accurately quantified. We explore the relationship between the flow rates of the exhalation and the sampling instrument and the consequent quantification of particle flux. We also discuss the transport and evaporation dynamics of liquid particles within respiratory jets, and their impacts on conducting aerosol sampling studies.}
}

@article{gregsonComparingAerosolConcentrations2021,
