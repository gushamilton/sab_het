@article{Schulze1982-op,
  title = {Rhabdomyolysis as a Cause of Acute Renal Failure},
  author = {Schulze, V E Jr},
  year = {1982},
  journal = {Postgraduate medicine},
  volume = {72},
  number = {6},
  pages = {145--148},
  address = {UNITED STATES},
  abstract = {Traumatic rhabdomyolysis with myoglobinuria and renal failure has been recognized for many years. In the past decade, rhabdomyolysis has been found to have various nontraumatic causes as well, including genetic conditions, metabolic disorders, exercise, toxins, infections, and drugs. Characteristic clinical and laboratory features include muscle tenderness, pigmenturia with urine that is orthotoluidine (Hematest) positive, greatly elevated creatine kinase levels, and often, renal failure. Treatment consists of fluid replacement and establishment of adequate urine flow early. If acute renal failure occurs, it should be treated appropriately. Particularly important are reversal of hyperkalemia and withholding of calcium during the hypocalcemic phase to prevent exacerbation of hypercalcemia later.},
  keywords = {*Acute Kidney Injury/et [Etiology],*Muscular Diseases/co [Complications],*Myoglobinuria/co [Complications],Acute Kidney Injury/di [Diagnosis],Acute Kidney Injury/pc [Prevention & Control],Acute Kidney Injury/pp [Physiopathology],Fluid Therapy,Furosemide/tu [Therapeutic Use],Humans,Hyperkalemia/co [Complications],Hyperkalemia/dt [Drug Therapy],Hypocalcemia/co [Complications],Mendeley Import (Dec 08),Muscular Diseases/di [Diagnosis],Muscular Diseases/et [Etiology],Muscular Diseases/th [Therapy],Myoglobinuria/di [Diagnosis],Myoglobinuria/et [Etiology],Myoglobinuria/th [Therapy],Renal Dialysis}
}

