@article{Lipman1999-nk,
  title = {Continuous Infusion Ceftazidime in Intensive Care: A Randomized Controlled Trial},
  author = {Lipman, J and Gomersall, C D and Gin, T and Joynt, G M and Young, R J},
  year = {1999},
  month = feb,
  journal = {Journal of Antimicrobial Chemotherapy},
  volume = {43},
  number = {2},
  pages = {309--311},
  abstract = {We randomized 18 critically ill patients to receive ceftazidime 6 g/day by continuous infusion or bolus dosing (2 g 8 hourly), each with a loading dose of 12 mg/kg ceftazidime. During the first 8 h, plasma ceftazidime concentration fell below 40 mg/L in only one patient (trough 38 mg/L) from the infusion group, compared with eight from the bolus group (2-33 mg/L) for periods ranging from 73 to 369 min. Thereafter all infusion patients remained above 40 mg/L for 40 h of study versus 20-30\% of bolus patients. The pharmacokinetic and pharmacodynamic characteristics of ceftazidime suggest that continuous infusions should be clinically investigated in outcome studies.},
  langid = {english},
  keywords = {Adult[checkword],article,bolus injection,Ceftazidime [administration & dosage] [blood],ceftazidime/cr [Drug Concentration],ceftazidime/ct [Clinical Trial],ceftazidime/pd [Pharmacology],ceftazidime/pk [Pharmacokinetics],cephalosporin derivative/cr [Drug Concentration],cephalosporin derivative/ct [Clinical Trial],cephalosporin derivative/pd [Pharmacology],cephalosporin derivative/pk [Pharmacokinetics],Cephalosporins [administration & dosage] [blood],clinical article,clinical trial,continuous infusion,controlled clinical trial,controlled study,Critical Care,critical illness,drug blood level,human,Humans[checkword],Infusions,intensive care,Intravenous,Mendeley Import (Dec 08)/CI vs EI,Middle Aged[checkword],pharmacodynamics,randomized controlled trial,Sr-inj}
}

