@article{askenaziGeneticPolymorphismsHemeoxygenase2015,
  title = {Genetic Polymorphisms of Heme-Oxygenase 1 ({{HO-1}}) May Impact on Acute Kidney Injury, Bronchopulmonary Dysplasia, and Mortality in Premature Infants},
  author = {Askenazi, David J and Halloran, Brian and Patil, Neha and Keeling, Susan and Saeidi, Behtash and Koralkar, Rajesh and Ambalavanan, Namasivayam},
  year = {2015},
  month = jun,
  journal = {Pediatr. Res.},
  volume = {77},
  number = {6},
  pages = {793--798},
  publisher = {Nature Publishing Group (Houndmills, Basingstoke, Hampshire RG21 6XS, United Kingdom)},
  address = {United Kingdom},
  abstract = {BACKGROUND: Heme oxygenase 1 (HO1) catalyzes heme degradation, and offers protection for several organs, including the kidney. Genetic polymorphisms of HO-1 are associated with poor clinical outcomes in several populations. POPULATION: We prospectively enrolled 117 premature infants (birth weight {\textbackslash}leq1,200 g or postgestational age {\textbackslash}leq31 wk) and evaluated two DNA genetic variants proximal to the promoter region of HO-1 (GT(n) repeats, and -413T{$>$}A SNP). We evaluated how these polymorphisms affect two clinical outcomes: (i) Acute Kidney Injury (AKI)-rise in serum creatinine (SCr) {\textbackslash}geq 0.3 mg/dl or {\textbackslash}geq 150-200\% from lowest previous value, (ii) the composite of mortality and bronchopulmonary dysplasia (BPD) defined as receipt of oxygen at 36 wk postmenstrual age. RESULTS: AKI occurred in 34/117 (29\%) of neonates; 12/117 (10\%) died; 29/105 (28\%) survivors had BPD. Neonates with TT genotype at 413T{$>$}A before the HO-1 promoter had higher rates of AKI (P A genetic alteration had lower incidence of AKI. Further studies using larger cohorts are needed to better understand these relationships.},
  langid = {english},
  keywords = {*acute kidney failure,*genetic polymorphism,*heme oxygenase 1/ec [Endogenous Compound],*infant mortality,*lung dysplasia,*prematurity,article,cause of death,clinical article,clinical evaluation,cohort analysis,controlled study,creatinine blood level,creatinine/ec [Endogenous Compound],female,genetic analysis,genetic association,genetic variability,genotype,gestational age,human,infant,male,newborn assessment,outcome assessment,ovid_export_ris.ris,priority journal,promoter region,prospective study,survival rate,tandem repeat,umbilical artery catheterization}
