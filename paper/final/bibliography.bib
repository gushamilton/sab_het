  title = {Time to Blood Culture Positivity: {{An}} Independent Predictor of Infective Endocarditis and Mortality in Patients with {{Staphylococcus}} Aureus Bacteraemia},
  author = {Sim{\'e}on, S and Le Moing, V and Tubiana, S and Duval, X and Fournier, D and Lavigne, J-P and Erpelding, M-L and Gustave, C-A and Desage, S and Chirouze, C and Vandenesch, F and Tattevin, P and {VIRSTA/AEPEI Study Group}},
  year = {2019},
  month = apr,
  journal = {Clin. Microbiol. Infect.},
