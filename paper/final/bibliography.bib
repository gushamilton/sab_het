  volume = {42},
  number = {9},
  pages = {772--776},
  abstract = {Meningococcal disease is an infection caused by Neisseria meningitidis. Genetic factors contribute to host susceptibility and progression to disease, but the genes responsible for disease development are largely unknown. We report here a genome-wide association study for host susceptibility to meningococcal disease using 475 individuals with meningococcal disease (cases) and 4,703 population controls from the UK. We performed, in Western European and South European cohorts (consisting of 968 cases and 1,376 controls), two replication studies for the most significant SNPs. A cluster of complement factor SNPs replicated independently in both cohorts, including SNPs within complement factor H (CFH) (rs1065489 (p.936D},
  langid = {english},
  keywords = {mandel}
