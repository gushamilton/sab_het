@article{hamdy10YearOutcomesMonitoring2016,
  title = {10-{{Year Outcomes}} after {{Monitoring}}, {{Surgery}}, or {{Radiotherapy}} for {{Localized Prostate Cancer}}},
  author = {Hamdy, Freddie C and Donovan, Jenny L and Lane, J Athene and Mason, Malcolm and Metcalfe, Chris and Holding, Peter and Davis, Michael and Peters, Tim J and Turner, Emma L and Martin, Richard M and Oxley, Jon and Robinson, Mary and Staffurth, John and Walsh, Eleanor and Bollina, Prasad and Catto, James and Doble, Andrew and Doherty, Alan and Gillatt, David and Kockelbergh, Roger and Kynaston, Howard and Paul, Alan and Powell, Philip and Prescott, Stephen and Rosario, Derek J and Rowe, Edward and Neal, David E and {ProtecT Study Group}},
