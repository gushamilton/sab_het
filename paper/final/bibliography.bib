@article{linehanMolecularPathwaysFumarate2013,
  title = {Molecular Pathways: {{Fumarate}} Hydratase-Deficient Kidney Cancer--Targeting the {{Warburg}} Effect in Cancer},
  author = {Linehan, W Marston and Rouault, Tracey A},
  year = {2013},
  month = jul,
  journal = {Clin. Cancer Res.},
  volume = {19},
  number = {13},
  pages = {3345--3352},
  publisher = {American Association for Cancer Research Inc. (615 Chestnut Street, 17th Floor, Philadelphia PA 19106-3483, United States)},
  address = {United States},
  abstract = {Hereditary leiomyomatosis and renal cell carcinoma (HLRCC) is a hereditary cancer syndrome in which affected individuals are at risk for development of cutaneous and uterine leiomyomas and an aggressive form of type II papillary kidney cancer. HLRCC is characterized by germline mutation of the tricarboxylic acid (TCA) cycle enzyme, fumarate hydratase (FH). FH-deficient kidney cancer is characterized by impaired oxidative phosphorylation and a metabolic shift to aerobic glycolysis, a form of metabolic reprogramming referred to as the Warburg effect. Increased glycolysis generates ATP needed for increased cell proliferation. In FH-deficient kidney cancer, levels of AMP-activated protein kinase (AMPK), a cellular energy sensor, are decreased resulting in diminished p53 levels, decreased expression of the iron importer, DMT1, leading to low cellular iron levels, and to enhanced fatty acid synthesis by diminishing phosphorylation of acetyl CoA carboxylase, a rate-limiting step for fatty acid synthesis. Increased fumarate and decreased iron levels in FH-deficient kidney cancer cells inactivate prolyl hydroxylases, leading to stabilization of hypoxia-inducible factor (HIF)-1{$\alpha$} and increased expression of genes such as VEGF and glucose transporter 1 (GLUT1) to provide fuel needed for rapid growth demands. Several therapeutic approaches for targeting the metabolic basis of FH-deficient kidney cancer are under development or are being evaluated in clinical trials, including the use of agents such as metformin, which would reverse the inactivation of AMPK, approaches to inhibit glucose transport, lactate dehydrogenase A (LDHA), the antioxidant response pathway, the heme oxygenase pathway, and approaches to target the tumor vasculature and glucose transport with agents such as bevacizumab and erlotinib. These same types of metabolic shifts, to aerobic glycolysis with decreased oxidative phosphorylation, have been found in a wide variety of other cancer types. Targeting the metabolic basis of a rare cancer such as FH-deficient kidney cancer will hopefully provide insights into the development of effective forms of therapies for other, more common forms of cancer.},
  langid = {english},
  keywords = {*hereditary leiomyomatosis and renal cell carcinoma/dt [Drug Therapy],*hereditary leiomyomatosis and renal cell carcinoma/et [Etiology],*hereditary leiomyomatosis and renal cell carcinoma/su [Surgery],*kidney carcinoma/dt [Drug Therapy],*kidney carcinoma/et [Etiology],*kidney carcinoma/su [Surgery],*leiomyomatosis/dt [Drug Therapy],*leiomyomatosis/et [Etiology],*leiomyomatosis/su [Surgery],acetyl coenzyme A carboxylase/ec [Endogenous Compound],adenosine triphosphate/ec [Endogenous Compound],adenylate kinase,aerobic glycolysis,aerobic metabolism,antioxidant activity,bevacizumab/ct [Clinical Trial],bevacizumab/dt [Drug Therapy],bevacizumab/pd [Pharmacology],bortezomib/cb [Drug Combination],bortezomib/dt [Drug Therapy],bortezomib/pd [Pharmacology],cell level,cell proliferation,cisplatin/cb [Drug Combination],cisplatin/dt [Drug Therapy],cisplatin/pd [Pharmacology],citric acid cycle,drug research,drug targeting,englerin A/pd [Pharmacology],enzyme deficiency,enzyme inactivation,erlotinib/ct [Clinical Trial],erlotinib/dt [Drug Therapy],erlotinib/pd [Pharmacology],fatty acid synthesis,fatty acid/ec [Endogenous Compound],fh gene,frameshift mutation,fumarate hydratase/ec [Endogenous Compound],fumaric acid/ec [Endogenous Compound],gene,gene deletion,gene mutation,germ line,glucose transport,glucose transporter 1/ec [Endogenous Compound],glucose/ec [Endogenous Compound],heme oxygenase/ec [Endogenous Compound],hereditary leiomyomatosis and renal cell carcinoma/dt [Drug Therapy],human,hydroxymethylglutaryl coenzyme A reductase kinase/ec [Endogenous Compound],hypoxia inducible factor 1alpha/ec [Endogenous Compound],hypoxia inducible factor 2alpha/ec [Endogenous Compound],inhibition kinetics,iron/ec [Endogenous Compound],kelch like ECH associated protein 1/ec [Endogenous Compound],kidney carcinoma/dt [Drug Therapy],lactate dehydrogenase/ec [Endogenous Compound],leiomyomatosis/dt [Drug Therapy],metformin/dt [Drug Therapy],metformin/pd [Pharmacology],missense mutation,natural resistance associated macrophage protein 2/ec [Endogenous Compound],nephrectomy,nonhuman,ovid_export_ris.ris,oxidative phosphorylation,pathogenesis,priority journal,procollagen proline 2 oxoglutarate 4 dioxygenase/ec [Endogenous Compound],protein expression,protein p53/ec [Endogenous Compound],reactive oxygen metabolite/ec [Endogenous Compound],review,sesquiterpene derivative/pd [Pharmacology],signal transduction,transcription factor Nrf2/ec [Endogenous Compound],tricarboxylic acid/ec [Endogenous Compound],tumor vascularization,unclassified drug,vasculotropin/ec [Endogenous Compound]}
}

@article{liNextGenerationSequencing2021,
  title = {A next Generation Sequencing Combined Genome-Wide Association Study Identifies Novel Tuberculosis Susceptibility Loci in {{Chinese}} Population},
  author = {Li, Mo and Hu, Yi and Zhao, Baihui and Chen, Luan and Huang, Hailiang and Huai, Cong and Zhang, Xiaoqing and Zhang, Jinghong and Zhou, Wei and Shen, Lu and Zhen, Qi and Li, Bao and Wang, Wenjun and He, Lin and Qin, Shengying},
  year = {2021},
  month = jul,
  journal = {Genomics},
  volume = {113},
  number = {4},
  pages = {2377--2384},
  abstract = {The genetic factors of tuberculosis (TB) susceptibility have been widely recognized. Here we performed a two-stage study in 616 TB patients and 709 healthy controls to systematically identify the genetic markers of TB susceptibility. In the discovery stage, we identified 93 single nucleotide polymorphisms (SNPs) and 3 human leucocyte antigen (HLA) class II alleles that had potential associations with TB susceptibility. In the validation stage, we confirmed that 6 nominally significant SNPs, including 2 novel missense variants at RAB17 and DCTN4 (odds ratio (OR) = 1.40, P = 4.98 {\textbackslash}times 10-3 and OR = 2.30, P = 3.17 {\textbackslash}times 10-2 respectively), were associated with the predisposition to TB. Moreover, our study found that HLA-II allele DQA1*05:05 (P = 0.0011, OR = 1.44, 95\%CI = 1.15-1.77) was a TB susceptibility locus for the first time. This study comprehensively investigated the genetic variants that were associated with TB susceptibility and provided insight into the tuberculosis pathogenesis.},
  langid = {english},
  keywords = {Genetic susceptibility,Genome-wide association study,Human leucocyte antigen,Tuberculosis,Whole-exome sequencing}
}

@article{linFarInfraredTherapy2008,
  title = {Far Infrared Therapy Inhibits Vascular Endothelial Inflammation via the Induction of Heme Oxygenase-1},
  author = {Lin, Chih-Ching and Liu, Xiao-Ming and Peyton, Kelly and Wang, Hong and Yang, Wu-Chang and Lin, Shing-Jong and Durante, William},
  year = {2008},
  month = apr,
  journal = {Arterioscler. Thromb. Vasc. Biol.},
  volume = {28},
  number = {4},
  pages = {739--745},
  address = {United States},
  abstract = {OBJECTIVE: Survival of arteriovenous fistulas (AVFs) in hemodialysis patients is associated with both far infrared (FIR) therapy and length polymorphisms of the heme oxygenase-1 (HO-1) promoter. In this study, we evaluated whether there is an interaction between FIR radiation and HO-1 in regulating vascular inflammation. METHODS AND RESULTS: Treatment of cultured human umbilical vein endothelial cells (ECs) with FIR radiation stimulated HO-1 protein, mRNA, and promoter activity. HO-1 induction was dependent on the activation of the antioxidant responsive element/NF-E2-related factor-2 complex, and was likely a consequence of heat stress. FIR radiation also inhibited tumor necrosis factor (TNF)-alpha-mediated expression of E-selectin, vascular cell adhesion molecule-1, intercellular cell adhesion molecule-1, monocyte chemoattractant protein-1, interleukin-8, and the cytokine-mediated adhesion of monocytes to ECs. The antiinflammatory action of FIR was mimicked by bilirubin, and was reversed by the HO inhibitor, tin protoporphyrin-IX, or by the selective knockdown of HO-1. Finally, the antiinflammatory effect of FIR was also observed in patients undergoing hemodialysis. CONCLUSIONS: These results demonstrate that FIR therapy exerts a potent antiinflammatory effect via the induction of HO-1. The ability of FIR therapy to inhibit inflammation may play a critical role in preserving blood flow and patency of AVFs in hemodialysis patients.},
  langid = {english},
  keywords = {*Endothelium,*Heme Oxygenase-1/bi [Biosynthesis],*Inflammation/pc [Prevention & Control],*Infrared Rays/tu [Therapeutic Use],Aged,Cells,Cultured,Endothelial Cells/me [Metabolism],Endothelial Cells/re [Radiation Effects],Enzyme Induction/re [Radiation Effects],Female,Gene Expression/re [Radiation Effects],Genetic,Heme Oxygenase-1/ge [Genetics],Humans,Inflammation Mediators/me [Metabolism],Inflammation/en [Enzymology],Inflammation/ge [Genetics],Intercellular Adhesion Molecule-1/bi [Biosynthesis],Male,Messenger/ge [Genetics],Messenger/me [Metabolism],Middle Aged,Mutation,NF-E2-Related Factor 2/ge [Genetics],NF-E2-Related Factor 2/me [Metabolism],ovid_export_ris.ris,Promoter Regions,Prospective Studies,Renal Dialysis,RNA,Transfection,Tumor Necrosis Factor-alpha/pd [Pharmacology],Vascular Cell Adhesion Molecule-1/bi [Biosynthesis],Vascular/me [Metabolism],Vascular/re [Radiation Effects]}
}

