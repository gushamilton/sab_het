@article{allenImpactPiperacillinTazobactamDosing2023,
  title = {Impact of {{Piperacillin-Tazobactam Dosing}} in {{Septic Shock Patients Using Real-World Evidence}}: {{An Observational}}, {{Retrospective Cohort Study}}},
  author = {Allen, John M and Surajbali, Devi and Q Nguyen, Dalena and Kuczek, Jolanta and Tran, Maithi and Hachey, Brianna and Feild, Carinda and Shoulders, Bethany R and Smith, Steven M and Voils, Stacy A},
  year = {2023},
