  publisher = {Department of Dermatology, Necker-Enfants Malades Hospital, Assistance Publique-Hopitaux de Paris, Paris, France. emmanuel.mahe@apr.aphp.fr},
  address = {England},
  abstract = {BACKGROUND: Subcutaneous fat necrosis (SFN) of the newborn is a rare acute transient hypodermatitis that develops within the first weeks of life in term infants. It often follows a difficult delivery. Prognosis is generally good except for the development of hypercalcaemia in severe cases. Only several case reports or small patients series have been published.{\textbackslash}textbackslashn{\textbackslash}textbackslashnOBJECTIVES: To evaluate risk factors, complications and outcomes of SFN in 16 consecutive patients seen from 1996 to 2002 in our Department of Paediatric Dermatology.{\textbackslash}textbackslashn{\textbackslash}textbackslashnMETHODS: On a case-report form created for the study, we recorded putative risk factors concerning the mother, pregnancy and delivery, clinical aspects of SFN, and early and late outcomes. The study was conducted in two stages: the first was a retrospective analysis of the observations and the second analysed data collected on children and their parents during a new consultation (n=10).{\textbackslash}textbackslashn{\textbackslash}textbackslashnRESULTS: All the children were born at term. Lesions appeared a mean of 4 days after delivery. Three-quarters of the children had diffuse SFN. Risk factors identified were newborn failure to thrive (12/16), forceps delivery (7/16), maternal high blood pressure (3/10) and/or diabetes (2/10), and newborn cardiac surgery (1/16). Putative novel risk factors were macrosomia (7/16), exposure to active (4/10) or passive (3/10) smoking during pregnancy, putative or known maternal, paternal or newborn risk factors for thrombosis (5/10), and dyslipidaemia (2/10). Complications were hypercalcaemia (9/16), pain (4/16), dyslipidaemia (1/16), renal insufficiency (1/16) and late subcutaneous atrophy (6/6).{\textbackslash}textbackslashn{\textbackslash}textbackslashnCONCLUSIONS: This study on 16 newborns with SFN provides new information. Familial or newborn risk factors for thrombosis are frequent. Macrosomia, familial dyslipidaemia and smoking should be evaluated. The main complications identified were severe pain, hypercalcaemia and subcutaneous atrophy.},
  keywords = {Fat Necrosis,Fat Necrosis: etiology,Fat Necrosis: pathology,Female,Humans,Hypercalcemia,Hypercalcemia: complications,Infant,Life Style,Male,Mendeley Import (Dec 08),Newborn,Prognosis,Retrospective Studies,Risk Factors,Subcutaneous Fat,Subcutaneous Fat: pathology}
}

@article{Mahevas2009-bz,
  title = {Renal Sarcoidosis: Clinical, Laboratory, and Histologic Presentation and Outcome in 47 Patients},
  author = {Mahevas, Matthieu and Lescure, Francois Xavier and Boffa, Jean-Jacques and Delastour, Victoire and Belenfant, Xavier and Chapelon, Catherine and Cordonnier, Carole and Makdassi, Raifat and Piette, Jean-Charles and Naccache, Jean-Marc and Cadranel, Jacques and Duhaut, Pierre and Choukroun, Gabriel and Ducroix, Jean Pierre and Valeyre, Dominique},
  year = {2009},
  journal = {Medicine},
  volume = {88},
  number = {2},
  pages = {98--106},
  publisher = {Department of Internal Medicine, Amiens Nord Hospital, Amiens, France. mahevasm@yahoo.fr},
  address = {United States},
  abstract = {We conducted the current study to investigate the clinical, laboratory, and histologic features at presentation and the outcome of renal sarcoidosis (RS). Exhaustive retrospective data were collected by the French Sarcoidosis Group. Forty-seven adult patients were assessed (30 male/17 female, M/F ratio: 1.76). Median estimated glomerular filtration rate (eGFR) was 20.5 mL/min per 1.73 m(2) (range, 4-93 mL/min per 1.73 m(2)). Moderate proteinuria was found in 31 (66\%) patients (median, 0.7 g/24 h; range, 0-2.7 g/24 h), microscopic hematuria in 11 (21.7\%) patients, aseptic leukocyturia in 13 (28.7\%) patients. Fifteen of 47 (32\%) patients had hypercalcemia ({\textquestiondown}2.75 mmol/L). Eleven of the 22 (50\%) patients diagnosed between June and September had hypercalcemia compared with only 4 of the 25 (16\%) cases diagnosed during the other months (p {\textexclamdown} 0.001). Thirty-seven patients presented with noncaseating granulomatous interstitial nephritis (GIN), and 10 with interstitial nephritis without granulomas. Apart from hypercalcemia, the clinical phenotype was also remarkable for the high frequency of fever at presentation. All patients initially received prednisone (median duration, 18 mo), 10 received intravenous pulse methylprednisolone. eGFR increased from 20 +/- 19 to 44 +/- 24.7 mL/min per 1.73 m(2) at 1 month (p {\textexclamdown} 0.001, n = 38), to 47 +/- 19.9 mL/min per 1.73 m(2) at 1 year (p {\textexclamdown} 0.001, n = 46), to 49.13 +/- 25 mL/min per 1.73 m(2) at last follow-up (p {\textexclamdown} 0.001, n = 47). A complete response to therapy at 1 year and at last follow-up was strongly correlated with complete response at 1 month (p {\textexclamdown} 0.01). Renal function improvement was inversely related to initial histologic fibrosis score. A complete response to therapy at 1 year was strongly correlated with hypercalcemia at presentation (p = 0.003). Relapses were purely renal (n = 3) and purely extrarenal (n = 10) or both (n = 4), often a long time after presentation, with in some cases severe cardiac or central nervous system involvement. We conclude that hypercalcemia and fever at presentation are often associated with RS; RS is most often and permanently responsive to corticosteroid treatment, but some degree of persistent renal failure is highly frequent and its degree of severity in the long run is well predicted from both histologic fibrotic renal score and response obtained at 1 month.},
  keywords = {*Kidney Diseases/di [Diagnosis],*Sarcoidosis/di [Diagnosis],Acute Kidney Injury/et [Etiology],Adult,Aged,Biopsy,CD4-CD8 Ratio,Female,Fever/et [Etiology],Fibrosis,Fine-Needle,France,Glomerular Filtration Rate,Glucocorticoids/tu [Therapeutic Use],Granuloma/et [Etiology],Hematuria/et [Etiology],Humans,Hypercalcemia/et [Etiology],Interstitial/et [Etiology],Kidney Diseases/dt [Drug Therapy],Kidney/pa [Pathology],Leukocytes,Lymphocytosis/et [Etiology],Male,Mendeley Import (Dec 08),Methylprednisolone/tu [Therapeutic Use],Middle Aged,Nephritis,Prednisone/tu [Therapeutic Use],Proteinuria/et [Etiology],Retrospective Studies,Sarcoidosis/dt [Drug Therapy],Urine/cy [Cytology],Young Adult}
}

