  number = {4},
  pages = {347--348},
  publisher = {American Medical Association},
  abstract = {So far, performance measures for real time systems did not receive much attention. An assessment of the few existing benchmarking methods for real time systems will reveal that they are highly inappropriate. Taking a closer look into the fundamental issues of real time systems it will become clear, that for hard real time systems qualitative characteristics are much more important than quantitative measures. The major qualitative performance criteria are compiled. Systems fulfiling the qualitative aspects may then be compared on the basis of costs.},
