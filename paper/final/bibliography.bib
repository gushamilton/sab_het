  title = {Characterization of {{Congenital Sideroblastic Anemia Model Due}} to {{ABCB7 Defects}}: {{How Do Defects}} in {{Iron-Sulfur Cluster Metabolism Lead}} to {{Ring Sideroblast Formation}}?},
  author = {Fujiwara, Tohru and Suzuki, Chie and Ochi, Tetsuro and Ono, Koya and Saito, Kei and Fukuhara, Noriko and Onishi, Yasushi and Yokoyama, Hisayuki and Fujimaki, Shinichi and Nakamura, Yukio and Harigae, Hideo},
