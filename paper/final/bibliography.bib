@article{gilbertUrinaryTractInfections2006,
  title = {Urinary Tract Infections in Patients with Chronic Renal Insufficiency},
  author = {Gilbert, David N},
  year = {2006},
  month = mar,
  journal = {Clin. J. Am. Soc. Nephrol.},
  volume = {1},
  number = {2},
  pages = {327--331},
  abstract = {Despite an increasing population of patients with chronic renal insufficiency, the literature on the management of urinary tract infections (UTI) in these patients is sparse. Patients with underlying diabetes are a specific population at risk. Antimicrobial treatment of UTI requires adequate serum, renal, parenchymal, and urine concentrations of drugs with antibacterial activity versus the etiologic organism. Sulfamethoxazole and nitrofurantoin are examples of drugs with low and likely inadequate urine concentrations in patients with creatinine clearances of {$<$}50 ml/min. Urine concentrations of ciprofloxacin and levofloxacin remain sufficient as renal function fails, whereas the concentrations of gemifloxacin and moxifloxacin are too low to predict efficacy. More investigative work is needed in the management of UTI in patients with poor renal function.},
  langid = {english},
  keywords = {key_articles_infection}
}

@article{Gilchrist2008-ji,
  title = {Characterization of the 5-{{HT2b}} Receptor in Evaluation of Aequorin Detection of Calcium Mobilization for Miniaturized {{GPCR}} High-Throughput Screening},
  author = {Gilchrist, Mark A 2nd and Cacace, Angela and Harden, David G},
  year = {2008},
  journal = {Journal of biomolecular screening},
  volume = {13},
  number = {6},
  pages = {486--493},
  publisher = {{HTS CoE, Pfizer Global Research and Development, Groton, Connecticut 06340, USA. mark.gilchrist@pfizer.com}},
  address = {United States},
  abstract = {Fluorescent detection of calcium mobilization has been used successfully to identify modulators of G-protein-coupled receptors (GPCRs); however, inherent issues with fluorescence may limit its potential for high-throughput screening miniaturization. The data presented here demonstrate that the calcium-sensitive photoprotein aequorin (AequoScreen), when compared with FLUO-4 in the same cellular background, allows for miniaturization of functional kinetic calcium flux assays, in which the rank order of potency and efficacy was maintained for a series of diverse small-molecule modulators. Small-volume ({\textexclamdown}10 microL) 384- and 1536-well aequorin assays were implemented by integration of acoustic dispensing (Echo 550) and kinetic flash luminometry (CyBi Lumax). The enhanced high signal-to-background ratios observed relative to fluorescence were readily manipulated by altering per-well cell densities and yielded acceptable screening statistics in miniaturized format for both agonist and antagonist screening scenarios. In addition, the authors demonstrate the feasibility of using agonist concentrations less than EC(50) in a miniaturized antagonist assay. These features, coupled with improved sample handling, should enhance sensitivity and provide the benefits of miniaturization including cost reduction and throughput gains.},
  keywords = {*Aequorin/me [Metabolism],*Calcium/me [Metabolism],*Luminescent Agents/me [Metabolism],*Receptor,*Receptors,5-HT2B/me [Metabolism],Animals,Biological Assay,CHO Cells,Cricetinae,Cricetulus,Drug Evaluation,Feasibility Studies,G-Protein-Coupled/ag [Agonists],G-Protein-Coupled/ai [Antagonists & Inh,G-Protein-Coupled/de [Drug Effects],G-Protein-Coupled/me [Metabolism],Humans,Mendeley Import (Dec 08),Miniaturization,Preclinical,Receptors,Serotonin}
}

