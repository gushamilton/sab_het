@article{diaoEndogenousInterleukin6Plays2005,
  title = {Endogenous Interleukin-6 Plays a Crucial Protective Role in Streptococcal Toxic Shock Syndrome via Suppression of Tumor Necrosis Factor Alpha Production},
  author = {Diao, Hongyan and Kohanawa, Masashi},
  year = {2005},
  month = jun,
  journal = {Infect. Immun.},
  volume = {73},
  number = {6},
  pages = {3745--3748},
  abstract = {During a Streptococcus pyogenes infection in interleukin-6 (IL-6)-deficient mice, there is elevation of serum tumor necrosis factor alpha (TNF-alpha) levels, muscular necrosis, and death compared with infection of C57BL/6 mice. Anti-TNF-alpha monoclonal antibody treatment decreased mortality and muscular necrosis in the infected IL-6-deficient mice. These results suggest that IL-6 plays a crucial protective role via suppression of TNF-alpha production in S. pyogenes infection.},
  langid = {english}
}

@article{dickHaemOxygenase1Genotype2005,
  title = {Haem Oxygenase-1 Genotype and Cardiovascular Adverse Events in Patients with Peripheral Artery Disease},
  author = {Dick, P and Schillinger, M and Minar, E and Mlekusch, W and Amighi, J and Sabeti, S and Schlager, O and Raith, M and Endler, G and Mannhalter, C and Wagner, O and Exner, M},
  year = {2005},
  month = dec,
  journal = {Eur. J. Clin. Invest.},
  volume = {35},
  number = {12},
  pages = {731--737},
  publisher = {Blackwell Publishing Ltd (9600 Garsington Road, Oxford OX4 2XG, United Kingdom)},
  address = {United Kingdom},
  abstract = {BACKGROUND: A functional GT dinucleotide length polymorphism in the haem oxygenase-1 (HO-1) gene promoter is thought to be involved in the pathogenesis of cardiovascular disease. Short ({$<$} 25) (GT)n repeats are suggested to facilitate enhanced HO-1 up-regulation in response to injury and confer potent anti-inflammatory and antioxidative effects. MATERIALS AND METHODS: We investigated the association between the HO-1 GT-polymorphism and cardiovascular outcome in 472 patients with advanced peripheral artery disease. Cardiovascular risk profile and DNA samples for determination of the HO-1 genotype (carrier vs. noncarrier of a short (GT)n repeat allele) were obtained at baseline, and patients were followed for median 21 months for the occurrence of coronary events (myocardial infarction, percutaneous coronary interventions and coronary artery bypass graft), cerebrovascular events (stroke or carotid revascularization) and all-cause mortality. RESULTS: Coronary events occurred in 48 patients (9\%), cerebrovascular events in 40 patients (9\%) and 59 patients (13\%) died. In total, 173 major adverse cardiovascular events (MACE) occurred in 133 patients (28\%). Carriers of the short (GT)n repeat allele had a 0.46-fold reduced adjusted hazard ratio for coronary events (P = 0.016) as compared to noncarriers. No significant difference was found for cerebrovascular events, mortality and overall MACE. CONCLUSION: Apparently, the HO-1 genotype exerts potentially protective effects against coronary adverse events in patients with peripheral artery disease. Homozygous and heterozygous carriers of {$<$} 25 (GT)n repeats had lower rates of myocardial infarction, percutaneous coronary interventions and coronary bypass operations compared to patients with longer (GT)n repeats.},
  langid = {english},
  keywords = {*artery disease,*cardiovascular disease,*dinucleotide/ec [Endogenous Compound],*guanine/ec [Endogenous Compound],*heme oxygenase 1/ec [Endogenous Compound],*thymidine/ec [Endogenous Compound],adult,aged,allelism,antiinflammatory activity,antioxidant activity,article,cardiovascular risk,carotid artery,cerebrovascular disease,coronary artery bypass graft,DNA determination,female,genotype,hazard assessment,heart infarction,heterozygote,homozygote,human,injury,major clinical study,male,mortality,nucleotide repeat,nucleotide sequence,ovid_export_ris.ris,pathogenesis,percutaneous coronary intervention,priority journal,promoter region,protection,revascularization,sequence analysis,stroke,upregulation}
}

@article{diengIntegrativeGenomicAnalysis2020,
  title = {Integrative Genomic Analysis Reveals Mechanisms of Immune Evasion in {{P}}. Falciparum Malaria},
  author = {Dieng, Mame Massar and Diawara, A{\"i}ssatou and Manikandan, Vinu and Tamim El Jarkass, Hala and Serm{\'e}, Samuel Sindi{\'e} and Sombi{\'e}, Salif and Barry, A{\"i}ssata and Coulibaly, Sam Aboubacar and Diarra, Amidou and Drou, Nizar and Arnoux, Marc and Yousif, Ayman and Tiono, Alfred B and Sirima, Sodiomon B and Soulama, Issiaka and Idaghdour, Youssef},
  year = {2020},
  month = oct,
  journal = {Nat. Commun.},
  volume = {11},
  number = {1},
  pages = {5093},
  abstract = {The mechanisms behind the ability of Plasmodium falciparum to evade host immune system are poorly understood and are a major roadblock in achieving malaria elimination. Here, we use integrative genomic profiling and a longitudinal pediatric cohort in Burkina Faso to demonstrate the role of post-transcriptional regulation in host immune response in malaria. We report a strong signature of miRNA expression differentiation associated with P. falciparum infection (127 out of 320 miRNAs, B-H FDR 5\%) and parasitemia (72 miRNAs, B-H FDR 5\%). Integrative miRNA-mRNA analysis implicates several infection-responsive miRNAs (e.g., miR-16-5p, miR-15a-5p and miR-181c-5p) promoting lymphocyte cell death. miRNA cis-eQTL analysis using whole-genome sequencing data identified 1,376 genetic variants associated with the expression of 34 miRNAs (B-H FDR 5\%). We report a protective effect of rs114136945 minor allele on parasitemia mediated through miR-598-3p expression. These results highlight the impact of post-transcriptional regulation, immune cell death processes and host genetic regulatory control in malaria.},
  langid = {english}
}

@article{Dietel1987-ff,
  title = {Abnormal Calcium Distribution in Human Parathyroid Adenomas as Possible Cause of Primary Hyperparathyroidism},
  author = {Dietel, M and Arps, H and Niendorf, A and Schafer, H J and Holzel, F},
  year = {1987},
  journal = {Hormone and metabolic research = Hormon- und Stoffwechselforschung = Hormones et metabolisme},
  volume = {19},
  number = {4},
  pages = {177--181},
  address = {GERMANY, WEST},
  abstract = {Current knowledge suggests that normal parathyroid glands and parathyroid adenomas have different sensitivities to environmental calcium. In search for morphological equivalents, 5 normal human and 10 porcine parathyroid glands, as well as 10 human parathyroid adenomas were investigated with regard to intracellular and extracellular calcium distribution. The glands were incubated for 2, 4, 6 and 20 h in tissue cultures using HAM's F10 medium with various calcium concentrations. For visualization of the calcium distribution in the tissue the method of pyroantimonate precipitation was applied. Specificity of the reaction was controlled by X-ray microanalysis. Shifts of the calcium pyroantimonate precipitates were quantitated by morphometry using an area-counting system. The results demonstrate that in normal parathyroid glands calcium precipitates are distributed randomly. Incubation of normal glands in medium with low calcium concentration (0.6 mM) provoked reduced amounts of intracellular and extracellular calcium complexes. When the incubations were performed in medium with high calcium content (2.6 mM), calcium accumulated inside parathyroid and stroma cells. In contrast to normal parathyroid glands, parathyroid adenomas fixed immediately after surgery showed an atypical calcium distribution with low amounts of intracellular and high amounts of extracellular calcium grains. The data suggest that in normal parathyroid glands the intracellular calcium concentration follows the extracellular environmental calcium concentration. Thus, calcium modulates parathyroid hormone (PTH) secretion via intracellular regulatory mechanisms. In parathyroid adenomas the calcium transport via the tumor cell membrane appears to be disturbed resulting in lowered intracellular calcium levels. This is remarkable since the environmental calcium concentration is elevated due to the hypercalcemia of primary hyperparathyroidism.(ABSTRACT TRUNCATED AT 250 WORDS)},
  keywords = {*Adenoma/me [Metabolism],*Calcium/me [Metabolism],*Hyperparathyroidism/et [Etiology],*Parathyroid Neoplasms/me [Metabolism],Adenoma/co [Complications],Animals,Electron Probe Microanalysis,Histocytochemistry,Humans,Mendeley Import (Dec 08),Parathyroid Glands/me [Metabolism],Parathyroid Neoplasms/co [Complications],Swine}
}

