  langid = {english},
  keywords = {Denmark,Denmark: epidemiology,diagnosis,Female,Humans,Incidence,Liver Neoplasms,Liver Neoplasms: classification,Liver Neoplasms: diagnosis,Liver Neoplasms: epidemiology,Liver Neoplasms: pathology,Male,Mendeley Import (Dec 08),Registries,Sex Factors}
