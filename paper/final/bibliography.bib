@article{valenciaTransancestralFinemappingMHC2022,
  title = {Trans-Ancestral Fine-Mapping of {{MHC}} Reveals Key Amino Acids Associated with Spontaneous Clearance of Hepatitis {{C}} in {{HLA-DQ$\beta$1}}},
  author = {Valencia, Ana and Vergara, Candelaria and Thio, Chloe L and Vince, Nicolas and Douillard, Venceslas and Grifoni, Alba and Cox, Andrea L and Johnson, Eric O and Kral, Alex H and Goedert, James J and Mangia, Alessandra and Piazzolla, Valeria and Mehta, Shruti H and Kirk, Gregory D and Kim, Arthur Y and Lauer, Georg M and Chung, Raymond T and Price, Jennifer C and Khakoo, Salim I and Alric, Laurent and Cramp, Matthew E and Donfield, Sharyne M and Edlin, Brian R and Busch, Michael P and Alexander, Graeme and Rosen, Hugo R and Murphy, Edward L and Wojcik, Genevieve L and Carrington, Mary and Gourraud, Pierre-Antoine and Sette, Alessandro and Thomas, David L and Duggal, Priya},
