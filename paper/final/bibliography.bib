  year = {2016},
  month = apr,
  journal = {Gastroenterology},
  volume = {150},
  number = {4},
  pages = {S691},
  publisher = {Elsevier BV},
  abstract = {Nonsteroidal anti-inflammatory drugs (NSAIDs) can cause epithelial cell damage in the stomach, intestine, and colon. NSAIDs are reported to induce autophagy and apoptosis in intestinal epithelial cells; however, their role in cell damage is poorly understood. To examine the role of autophagy in cell damage, we used autophagy-related gene Atg5-conditional knockout mice, in which the Atg5 gene is only knocked out in intestinal epithelial cells. In an indomethacin (IM)-induced gastrointestinal ulcer mouse model, intestinal epithelium damage was reduced in Atg5-conditional knockout mice compared with wild-type mice. IM-induced damage in IEC6 rat intestinal epithelial cells was reduced when Atg5 was silenced (IEC6shAtg5 cells). Western blot analyses indicated that IM-induced apoptosis decreased, and the potent, oxidative stress-related extracellular signal-regulated kinase (ERK)/nuclear factor-erythroid2-like2 (Nrf2)/heme oxygenase-1 (HO-1) signaling pathway was upregulated in IEC6shAtg5 cells. An experiment using a reactive oxygen species (ROS)-sensitive fluorescent dye in IEC6shAtg5 cells revealed that the amount of ROS at the baseline and the rate of increase after IM treatment were lower than in intact IEC6 cells. The mitochondrial membrane potential at the baseline and the reduction rate in IM-treated IEC6shAtg5 cells were lower than in intact IEC6 cells, indicating that autophagy deficiency increased ROS production caused by mitochondrial disturbance. Furthermore, MnTMPyP, a manganesesuperoxide dismutase mimetic, significantly inhibited IM-induced autophagy and subsequent apoptosis as well as activation of the ERK/Nrf2/HO-1 pathway. These data suggest that autophagy deficiency and subsequent activation of the ERK/Nrf2/HO-1 pathway diminished IM-induced, apoptosis-mediated intestinal epithelial cell damage, and genetic analyses of single nucleotide polymorphisms in autophagyrelated genes could predict NSAID-induced intestinal injury.},
  keywords = {*autophagy.,*gastrointestinal disease,*indometacin,apoptosis,cell damage,digestive system ulcer,epithelium cell,fluorescent dye,gene,genetic analysis,heme oxygenase 1,intestine,intestine epithelium,intestine epithelium cell,intestine injury,knockout mouse,mitochondrial membrane potential,mitogen activated protein kinase,mouse,mouse model,nonsteroid antiinflammatory agent,nuclear factor,ovid_export_ris.ris,oxidative stress,rat,reactive oxygen metabolite,single nucleotide polymorphism,stomach,Western blotting,wild type mouse}
}

@inproceedings{haraExpressionHemeOxygenase12012,
  title = {Expression of Heme Oxygenase-1 in Acute Fibrinous and Organizing Pneumonia Patients},
  booktitle = {D53. {{INTERSTITIAL LUNG DISEASE CASE REPORTS}}: {{SOMETIMES THE HOOF BEATS INDICATE ZEBRAS}}},
  author = {Hara, Yuu and Shinkai, Masaharu and Kanoh, Soichiro and Goto, Hideto and Yoshikawa, Sumiko and Yamaguchi, Nobuhiro and Shinoda, Masahiro and Watanabe, Keisuke and Moriyama, Yusuke and Fujikura, Yuji and Mikita, Kei and Kawano, Syuichi and Misawa, Kazuhisa and Ishigatsubo, Yoshiaki and Kawana, Akihiko and Matsubara, Osamu and Kaneko, Takeshi},
  year = {2012},
  month = may,
  volume = {185},
  publisher = {American Thoracic Society},
  abstract = {Background Acute fibrinous and organizing pneumonia (AFOP) was first described by Beasley in 2002, as the variant of DAD (diffuse alveolar damage). AFOP is very rare pathological entity and only about 10 cases of AFOP has been published for the last 5 years. Heme oxygenase-1 (HO-1) is the stress-inducible protein having the role of protection of lung cells and is expressed in alveolar machrophages in healthy lung tissue. In ARDS patients, however, HO-1 is expressed in epithelial, endothelial cells and fibroblasts of the lung tissue unlike that of healthy individuals. Method We reviewed the clinical features of 3 cases of AFOP and studied the expression and cellular distribution of HO-1 in AFOP patients using the monoclonal antibody for HO-1. Results The average age was 62 years old and all cases were male. P/F ratios were 205, 305 and 350. Serum surfactant protein A levels were 42, 104 and 78.8 ng/mL. Serum surfactant protein D levels were 21.6, 226 and 229 ng/mL. HRCT findings were consolidation + GGO (Fig 1A), GGO (Fig 1B) and nodular opacities (Fig 1C). Biopsy specimens in all cases revealed that the numerous fibrin balls (FBs) without eosinophils, hyaline membranes, and hemosiderin-laden machrophages in the involved areas (Fig2A, B) and the expression of HO-1 in machrophages within FBs (Fig 2C) and type pneumocytes in the histochemical stain of anti-HO-1 antibody (Fig 2D). Conclusion Unlike the healthy lung tissues, HO-1 expressed in machrophages within FBs and type pneumocytes in AFOP patients. These findings suggested that HO-1influenced the pathophysiology of AFOP. (Figure Presented).},
  keywords = {*American,*heme oxygenase 1,*human,*organizing pneumonia,*patient,*society,adult respiratory distress syndrome,antibody,biopsy,cellular distribution,clinical feature,endothelium cell,eosinophil,fibrin,fibroblast,hemosiderin,hyalin,lung alveolus cell,lung parenchyma,male,membrane,monoclonal antibody,ovid_export_ris.ris,pathophysiology,protection,protein,serum,stain,surfactant protein A,surfactant protein D}
}

@article{haraInductionHemeOxygenase11999,
  title = {Induction of Heme Oxygenase-1 as a Response in Sensing the Signals Evoked by Distinct Nitric Oxide Donors},
  author = {Hara, E and Takahashi, K and Takeda, K and Nakayama, M and Yoshizawa, M and Fujita, H and Shirato, K and Shibahara, S},
  year = {1999},
  month = jul,
  journal = {Biochem. Pharmacol.},
  volume = {58},
  number = {2},
  pages = {227--236},
  publisher = {Elsevier Inc. (360 Park Avenue South, New York NY 10010, United States)},
  address = {United States},
  abstract = {To gain insights into the cellular responses evoked by nitric oxide (NO), we have studied the effects of NO donors with distinct chemistries on the expression of heme oxygenase-1 mRNA by northern blot analysis. The expression levels of heme oxygenase-1 mRNA were increased significantly in DLD-1 human colorectal adenocarcinoma cells by treatment with each of three NO donors: sodium nitroprusside (SNP), S-nitroso-L-glutathione (GSNO), and 3-morpholinosydnonimine (SIN-1). A combination of SIN-1 plus SNP or GSNO additively increased heme oxygenase-1 mRNA expression, whereas synergistic induction was seen with SNP plus GSNO. The SNP-mediated induction was not affected noticeably by extracellular superoxide dismutase, catalase, or mannitol, while the induction by SIN-1 was attenuated by superoxide dismutase. Thus, the SNP-mediated induction of heme oxygenase-1 mRNA expression may be independent of reactive oxygen species, and the induction by SIN-1 is mediated partly by peroxynitrite, which is generated by immediate reaction of NO and superoxide anion. Transient transfection assays suggested that treatment with SNP, but not with GSNO or SIN-1, increased the expression of a reporter gene through a cis-acting element, including the cadmium-responsive element, of the human heme oxygenase-1 gene. These results suggest that SNP induces heme oxygenase-1 mRNA expression through a mechanism different from that for GSNO or SIN-1. We therefore propose that induction of heme oxygenase-1 represents a common cellular response in sensing the signals evoked by distinct NO donors.},
  langid = {english},
  keywords = {*Heme Oxygenase (Decyclizing)/bi [Biosynthesis],*Nitric Oxide Donors/pd [Pharmacology],*Signal Transduction/de [Drug Effects],Adenocarcinoma/en [Enzymology],Adenocarcinoma/pa [Pathology],Colorectal Neoplasms/en [Enzymology],Colorectal Neoplasms/pa [Pathology],Cultured,Drug Synergism,Enzyme Induction/de [Drug Effects],Gene Expression Regulation,Genetic/de [Drug Effects],Glutathione/aa [Analogs & Derivatives],Glutathione/pd [Pharmacology],Heme Oxygenase (Decyclizing)/ge [Genetics],Heme Oxygenase-1,Humans,Membrane Proteins,Messenger/bi [Biosynthesis],Messenger/ge [Genetics],Molsidomine/aa [Analogs & Derivatives],Molsidomine/pd [Pharmacology],Neoplastic/de [Drug Effects],Nitroprusside/pd [Pharmacology],Nitroso Compounds/pd [Pharmacology],ovid_export_ris.ris,Promoter Regions,RNA,S-Nitrosoglutathione,Tumor Cells}
}

@article{Haralambieva2013-sb,
  title = {The Genetic Basis for Interindividual Immune Response Variation to Measles Vaccine: New Understanding and New Vaccine Approaches},
  author = {Haralambieva, Iana H and Ovsyannikova, Inna G and Pankratz, V Shane and Kennedy, Richard B and Jacobson, Robert M and Poland, Gregory A},
  year = {2013},
  month = jan,
  journal = {Expert Review of Vaccines},
  volume = {12},
  number = {1},
  pages = {57--70},
  abstract = {The live-attenuated measles vaccine is effective, but measles outbreaks still occur in vaccinated populations. This warrants elucidation of the determinants of measles vaccine-induced protective immunity. Interindividual variability in markers of measles vaccine-induced immunity, including neutralizing antibody levels, is regulated in part by host genetic factor variations. This review summarizes recent advances in our understanding of measles vaccine immunogenetics relative to the perspective of developing better measles vaccines. Important genetic regulators of measles vaccine-induced immunity, such as HLA class I and HLA class II genotypes, single nucleotide polymorphisms in cytokine/cytokine receptor genes (IL12B, IL12RB1, IL2, IL10) and the cell surface measles virus receptor CD46 gene, have been identified and independently replicated. New technologies present many opportunities for identification of novel genetic signatures and genetic architectures. These findings help explain a variety of immune response-related phenotypes and promote a new paradigm of 'vaccinomics' for novel vaccine development.},
  langid = {english}
}

@article{Haralambieva2015-yn,
  title = {Variability in Humoral Immunity to Measles Vaccine: {{New}} Developments},
  author = {Haralambieva, Iana H and Kennedy, Richard B and Ovsyannikova, Inna G and Whitaker, Jennifer A and Poland, Gregory A},
  year = {2015},
  month = dec,
  journal = {Trends in Molecular Medicine},
  volume = {21},
  number = {12},
  pages = {789--801},
  abstract = {Despite the existence of an effective measles vaccine, resurgence in measles cases in the USA and across Europe has occurred, including in individuals vaccinated with two doses of the vaccine. Host genetic factors result in inter-individual variation in measles vaccine-induced antibodies, and play a role in vaccine failure. Studies have identified HLA (human leukocyte antigen) and non-HLA genetic influences that individually or jointly contribute to the observed variability in the humoral response to vaccination among healthy individuals. In this exciting era, new high-dimensional approaches and techniques including vaccinomics, systems biology, GWAS, epitope prediction and sophisticated bioinformatics/statistical algorithms provide powerful tools to investigate immune response mechanisms to the measles vaccine. These might predict, on an individual basis, outcomes of acquired immunity post measles vaccination.},
  langid = {english}
}

