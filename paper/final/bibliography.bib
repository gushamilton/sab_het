@article{Bachulis1975-ub,
  title = {Diagnosis and Treatment of Early Hyperparathyroidism with a Comment on the Value of Selective Angiographic Localization of Adenomas},
  author = {Bachulis, B L and Haugen, O D},
  year = {1975},
  journal = {The American surgeon},
  volume = {41},
