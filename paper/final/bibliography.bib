@article{Wolverson1981-sf,
  title = {Diagnosis of Parathyroid Adenoma by Computed Tomography},
  author = {Wolverson, M K and Sundaram, M and Eddelston, B and Prendergast, J},
  year = {1981},
  journal = {Journal of computer assisted tomography},
  volume = {5},
  number = {6},
  pages = {818--821},
  address = {UNITED STATES},
  abstract = {A diagnosis of cervical parathyroid adenoma was made at computed tomography (CT) in two patients not initially suspected of having primary hyperparathyroidism. In each case, the lesion appeared as an oval shaped mass indenting and deforming the posterior surface of one lobe of the thyroid gland. In one patient, the lesion was sharply contrasted by iodine-containing thyroid tissue, which appeared denser than the adenoma. The significance of these findings is discussed as well as some of the problems encountered in the CT diagnosis of parathyroid adenoma.},
  keywords = {*Adenoma/ra [Radiography],*Parathyroid Neoplasms/ra [Radiography],*Tomography,Adenoma/co [Complications],Adult,Aged,Humans,Hypercalcemia/et [Etiology],Male,Mendeley Import (Dec 08),Parathyroid Neoplasms/co [Complications],X-Ray Computed}
