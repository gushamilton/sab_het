@article{fusserSpontaneousMutagenesisCsbm2011,
  title = {Spontaneous Mutagenesis in {{Csb}}(m/m){{Ogg1}}{$^-$}(/){$^-$} Mice Is Attenuated by Dietary Resveratrol},
  author = {Fusser, Markus and Nesse, Gaute J and Khobta, Andriy and Xia, Ning and Li, Huige and Klungland, Arne and Epe, Bernd},
  year = {2011},
  month = jan,
  journal = {Carcinogenesis},
  volume = {32},
  number = {1},
  pages = {80--85},
  publisher = {Oxford University Press (Great Clarendon Street, Oxford OX2 6DP, United Kingdom)},
  address = {United Kingdom},
  abstract = {Oxidative DNA modifications such as 7,8-dihydro-8-oxoguanine (8-oxoG) are generated endogenously in apparently all living cells. The defect of the repair of 8-oxoG in Csb(m/m)Ogg1{$^-$}(/){$^-$} mice results in elevated basal levels of these lesions and increased frequencies of spontaneous mutations, which initiate tumorigenesis in the liver if cell proliferation is stimulated. Here, we describe that the phytoalexin resveratrol, applied either for 7 days per gavage (100 mg/kg body wt) or for 3-9 months in the diet (0.04\% ad libitum), reduces the endogenous oxidative DNA base damage in the livers of the Csb(m/m)Ogg1{$^-$}(/){$^-$} mice by 20-30\% (P {$<$} 0.01). A small but consistent effect is also observed in the wild-type animals. The spontaneous mutation frequencies determined in the lacI gene of BigBlue{\textregistered} Csb(m/m)Ogg1{$^-$}(/){$^-$} mice are concomitantly reduced by resveratrol to similar extents. Mechanistically, the protection is caused by an induction of the antioxidant defense system since (i) hepatocytes isolated from all resveratrol-treated animals were less susceptible to the generation of single-strand breaks and to cell killing by H{$_2$}O{$_2$}, (ii) messenger RNA levels of superoxide dismutases 1 and 2 (SOD1 and SOD2) heme oxygenase-1 and glutathione peroxidase were significantly upregulated after the short-term treatment and (iii) mutations primarily ascribed to the oxidative base modification 8-oxoG (G:C to T:A transversions) were more strongly suppressed than G:C to A:T transitions ascribed to spontaneous deamination. The results thus demonstrate that spontaneous somatic mutation rates resulting from endogenous oxidative DNA damage can be reduced by application of an exogenous agent.},
  langid = {english},
  keywords = {*8 oxoguanine dna glycosylase 1/ec [Endogenous Compound],*DNA glycosyltransferase/ec [Endogenous Compound],*phytoalexin/pd [Pharmacology],*phytoalexin/po [Oral Drug Administration],*resveratrol/pd [Pharmacology],*resveratrol/po [Oral Drug Administration],*spontaneous mutation,animal cell,animal experiment,animal tissue,article,attenuation,beta actin/ec [Endogenous Compound],catalase/ec [Endogenous Compound],cell isolation,cell killing,cell proliferation,cell viability,controlled study,copper zinc superoxide dismutase/ec [Endogenous Compound],deamination,DNA base/ec [Endogenous Compound],DNA damage,DNA modification,DNA repair,gene expression,gene frequency,genotype,glutathione peroxidase 1/ec [Endogenous Compound],heme oxygenase 1/ec [Endogenous Compound],hydrogen peroxide,liver,liver cell,manganese superoxide dismutase/ec [Endogenous Compound],messenger RNA/ec [Endogenous Compound],mouse,mutation rate,nonhuman,ovid_export_ris.ris,oxidative stress,priority journal,reactive oxygen metabolite/ec [Endogenous Compound],RNA 18S/ec [Endogenous Compound],short course therapy,single stranded DNA break,sirtuin 1/ec [Endogenous Compound],somatic mutation,tissue factor pathway inhibitor/ec [Endogenous Compound],transcription factor Nrf2/ec [Endogenous Compound],unclassified drug,upregulation}
}

@article{fuwInhibitionProteasomeInhibitorinduced2014,
  title = {Inhibition of Proteasome Inhibitor-Induced Heme Oxygenase-1 Expression by the Mutation of Parkinson-Related Gene {{PINK1}}},
  author = {{Fu W} and {Chien W} and {Sheng X} and {Lee M}},
  year = {2014},
  journal = {Basic Clin. Pharmacol. Toxicol.},
  volume = {115},
  number = {SUPPL. 1},
  pages = {266--267},
  publisher = {Blackwell Publishing Ltd},
  abstract = {Background: Parkinson's disease (PD) is one of the most common neurodegenerative diseases. The etiology of PD is still not fully clarified. Mitochondrial dysfunction, oxidative stress, ubiquitin proteasome system impairment and abnormal protein accumulation have been proposed to play a major role in the pathogenesis of PD. Mutation in human PTEN induced protein kinase 1 (PINK1) gene is responsible for the second most common form of recessive Parkinson disease. Method(s): A stable pool expressing recombinant PINK1 G309D mutant in SH-SY5Y cells was established. We utilized the Western blotting, quantitative real time-PCR and immunofluorescent staining to examine the heme oxygenase-1 (HO-1) expression, Nrf2 induction and nuclear translocation and protein kinase activation induced by the proteasome inhibitor, MG132, in the PINK1 G309D mutant cells. Result(s): It was found that treatment with 1 muM MG132 for 24 h significantly induced the expression of HO-1 in control SH-SY5Y cells. However, the induction of HO-1 in response to proteasome inhibition was impaired by the expression of recombinant PINK1 G309D mutation. We further examined the influence of PINK1 G309D mutation on Nrf2 activation, the critical factor in the regulation of inducible expression of antioxidants. It was demonstrated that MG132 induced the expression of Nrf2 on the both protein and mRNA levels, and the effect was also abrogated by the PINK1 G309D mutation. By using nucleus fractionation and immunofluorescent staining, it was observed that Nrf2 accumulated in the nucleus following proteasome inhibition, which was reduced by the transfection of PINK1 G309D mutation. In addition, the MG132-induced HO-1 induction was Akt- and p38 MAPK-dependent, and was inhibited by the application of the free radical scavenger, N-acetyl-L-cysteine. The phosphorylation of p38 MAPK and Akt following treatment of MG132 was inhibited in cells expressing the PINK1 G309D mutant. We also found that the MG132- induced neuronal death was enhanced by PINK1 G309D mutation. Conclusion(s): These results reveal a novel pathway by which G309D mutation impairs the neuroprotective function of PINK1 under the stress of proteasome inhibition, which may be related to the pathogenesis of PD.},
  keywords = {*clinical pharmacology,*gene,*heme oxygenase 1,*mutation,*proteasome inhibitor,acetylcysteine,antioxidant,benzyloxycarbonylleucylleucylleucinal,cell mutant,death,degenerative disease,etiology,fractionation,genetic transfection,human,immunofluorescence test,implantable cardiac monitor,messenger RNA,mutant,ovid_export_ris.ris,oxidative stress,Parkinson disease,pathogenesis,phosphorylation,proteasome,protein,protein kinase,real time polymerase chain reaction,scavenger,ubiquitin,Western blotting}
}

@article{fuxmanbassExtracellularDNAMajor2010,
  title = {Extracellular {{DNA}}: A Major Proinflammatory Component of {{Pseudomonas}} Aeruginosa Biofilms},
  author = {Fuxman Bass, Juan I and Russo, Daniela M and Gabelloni, Maria L and Geffner, Jorge R and Giordano, Mirta and Catalano, Mariana and Zorreguieta, Angeles and Trevani, Anal{\'i}a S},
  year = {2010},
  month = jun,
  journal = {J. Immunol.},
  volume = {184},
  number = {11},
  pages = {6386--6395},
  abstract = {We previously demonstrated that extracellular bacterial DNA activates neutrophils through a CpG- and TLR9-independent mechanism. Biofilms are microbial communities enclosed in a polymeric matrix that play a critical role in the pathogenesis of many infectious diseases. Because extracellular DNA is a key component of biofilms of different bacterial species, the aim of this study was to determine whether it plays a role in the ability of biofilms to induce human neutrophil activation. We found that degradation of matrix extracellular DNA with DNase I markedly reduced the capacity of Pseudomonas aeruginosa biofilms to induce the release of the neutrophil proinflammatory cytokines IL-8 and IL-1beta ({$>$}75\%); reduced the upregulation of neutrophil activation markers CD18, CD11b, and CD66b (p {$<$} 0.001); reduced the number of bacteria phagocytosed per neutrophil contacting the biofilm; and reduced the production of neutrophil extracellular traps. Consistent with these findings, we found that biofilms formed by the lasI rhlI P. aeruginosa mutant strain, exhibiting a very low content of matrix extracellular DNA, displayed a lower capacity to stimulate the release of proinflammatory cytokines by neutrophils, which was not decreased further by DNase I treatment. Together, our findings support that matrix extracellular DNA is a major proinflammatory component of P. aeruginosa biofilms.},
  langid = {english}
}

@article{gabayComparisonLipidLipidassociated2016,
  title = {Comparison of Lipid and Lipid-Associated Cardiovascular Risk Marker Changes after Treatment with Tocilizumab or Adalimumab in Patients with Rheumatoid Arthritis},
  author = {Gabay, Cem and McInnes, Iain B and Kavanaugh, Arthur and Tuckwell, Katie and Klearman, Micki and Pulley, Jennifer and Sattar, Naveed},
  year = {2016},
  month = oct,
  journal = {Ann. Rheum. Dis.},
  volume = {75},
  number = {10},
  pages = {1806--1812},
  abstract = {OBJECTIVE: Compare changes in lipids and lipid-associated cardiovascular (CV) risk markers in patients with rheumatoid arthritis (RA) treated with tocilizumab or adalimumab. METHODS: Post-hoc analysis was performed in patients with RA who received tocilizumab intravenously every 4 weeks or adalimumab subcutaneously every 2 weeks for 24 weeks in the ADACTA trial. Lipid and lipid-associated CV risk biomarkers, including high-density lipoprotein-associated serum amyloid-A (HDL-SAA), secretory phospholipase A2 IIA (sPLA2 IIA) and lipoprotein(a) (Lp(a)), were measured at baseline and at week 8. RESULTS: The study included 162 patients treated with tocilizumab and 162 patients treated with adalimumab; HDL-SAA and sPLA2 IIA were measured in a subpopulation of 87 and 97 patients, respectively. Greater increases in mean low-density lipoprotein cholesterol (LDL-C) (0.46 mmol/L (95\% CI 0.30 to 0.62)), high-density lipoprotein cholesterol (HDL-C) (0.07 mmol/L (0.001 to 0.14)), total cholesterol (TC) (0.67 mmol/L (0.47 to 0.86)), triglycerides (0.24 mmol/L (0.10 to 0.38)) and TC:HDL ratio (0.27 (0.12 to 0.42)) occurred with tocilizumab from baseline to 8 weeks. HDL-SAA, sPLA2 IIA and Lp(a) decreased more with tocilizumab than adalimumab. Median changes from baseline to week 8 were -3.2 and -1.1 mg/L (p=0.0077) for HDL-SAA and -4.1 and -1.3 ng/mL (p{$<$}0.0001) for sPLA2 IIA; difference in adjusted means was -7.12 mg/dL (p{$<$}0.0001) for Lp(a). Similar results were observed in efficacy responders and non-responders per American College of Rheumatology and European League against Rheumatism criteria. CONCLUSION: LDL-C and HDL-C increased more with tocilizumab than adalimumab. HDL-SAA, sPLA2 IIA and Lp(a) decreased more with tocilizumab. Lipid change effects of interleukin-6 and tumour necrosis factor (TNF) inhibition, manifest by their net impact on lipids and lipoproteins, are not synonymous; the clinical significance is unclear and requires further study. TRIAL REGISTRATION NUMBER: NCT01119859.; post-results.},
  langid = {english},
  keywords = {Cardiovascular Disease,Inflammation,Lipids,Rheumatoid Arthritis}
}

@article{Gabbett2006-tp,
  title = {Neonatal Severe Hyperparathyroidism: An Important Clue to the Aetiology},
  author = {Gabbett, Michael T and Jones, Kristi and Cowell, Christopher T and Sillence, David O and Wilson, Meredith J},
  year = {2006},
  journal = {Journal of paediatrics and child health},
  volume = {42},
  number = {12},
  pages = {813--816},
  publisher = {Department of Clinical Genetics, The Children's Hospital at Westmead, Sydney, NSW, Australia. Michael\_Gabbett@health.qld.gov.au},
  address = {Australia},
  abstract = {Neonatal severe hyperparathyroidism is a rare condition that presents as striking hyperparathyroidism, hypercalcaemia, and metabolic bone disease. The aetiology needs to be determined soon after diagnosis to direct appropriate management and to determine an accurate prognosis. Taking a family history is a valuable clinical tool in paediatric medicine. Presented here is the case of a neonate presenting with severe hyperparathyroidism. Obtaining the family history, coupled with basic parental studies, enabled a rapid aetiological diagnosis, which allowed for conservative management.},
  keywords = {*Hypercalcemia/ge [Genetics],*Hyperparathyroidism/et [Etiology],Birth Weight,Family,Female,Humans,Hypercalcemia/th [Therapy],Hyperparathyroidism/th [Therapy],Infant,Mendeley Import (Dec 08),Newborn,Pregnancy,Thorax/ab [Abnormalities]}
}

