@article{ishigakiHLAAutoimmuneRisk2022,
  title = {{{HLA}} Autoimmune Risk Alleles Restrict the Hypervariable Region of {{T}} Cell Receptors},
  author = {Ishigaki, Kazuyoshi and Lagattuta, Kaitlyn A and Luo, Yang and James, Eddie A and Buckner, Jane H and Raychaudhuri, Soumya},
  year = {2022},
  month = apr,
  journal = {Nat. Genet.},
  volume = {54},
  number = {4},
  pages = {393--402},
  abstract = {Polymorphisms in the human leukocyte antigen (HLA) genes strongly influence autoimmune disease risk. HLA risk alleles may influence thymic selection to increase the frequency of T cell receptors (TCRs) reactive to autoantigens (central hypothesis). However, research in human autoimmunity has provided little evidence supporting the central hypothesis. Here we investigated the influence of HLA alleles on TCR composition at the highly diverse complementarity determining region 3 (CDR3), which confers antigen recognition. We observed unexpectedly strong HLA-CDR3 associations. The strongest association was found at HLA-DRB1 amino acid position 13, the position that mediates genetic risk for multiple autoimmune diseases. We identified multiple CDR3 amino acid features enriched by HLA risk alleles. Moreover, the CDR3 features promoted by the HLA risk alleles are more enriched in candidate pathogenic TCRs than control TCRs (for example, citrullinated epitope-specific TCRs in patients with rheumatoid arthritis). Together, these results provide genetic evidence supporting the central hypothesis.},
  langid = {english}
}

@article{ishigakiMultiancestryGenomewideAssociation2022,
  title = {Multi-Ancestry Genome-Wide Association Analyses Identify Novel Genetic Mechanisms in Rheumatoid Arthritis},
  author = {Ishigaki, Kazuyoshi and Sakaue, Saori and Terao, Chikashi and Luo, Yang and Sonehara, Kyuto and Yamaguchi, Kensuke and Amariuta, Tiffany and Too, Chun Lai and Laufer, Vincent A and Scott, Ian C and Viatte, Sebastien and Takahashi, Meiko and Ohmura, Koichiro and Murasawa, Akira and Hashimoto, Motomu and Ito, Hiromu and Hammoudeh, Mohammed and Emadi, Samar Al and Masri, Basel K and Halabi, Hussein and Badsha, Humeira and Uthman, Imad W and Wu, Xin and Lin, Li and Li, Ting and Plant, Darren and Barton, Anne and Orozco, Gisela and Verstappen, Suzanne M M and Bowes, John and MacGregor, Alexander J and Honda, Suguru and Koido, Masaru and Tomizuka, Kohei and Kamatani, Yoichiro and Tanaka, Hiroaki and Tanaka, Eiichi and Suzuki, Akari and Maeda, Yuichi and Yamamoto, Kenichi and Miyawaki, Satoru and Xie, Gang and Zhang, Jinyi and Amos, Christopher I and Keystone, Edward and Wolbink, Gertjan and {van der Horst-Bruinsma}, Irene and Cui, Jing and Liao, Katherine P and Carroll, Robert J and Lee, Hye-Soon and Bang, So-Young and Siminovitch, Katherine A and {de Vries}, Niek and Alfredsson, Lars and {Rantap{\"a}{\"a}-Dahlqvist}, Solbritt and Karlson, Elizabeth W and Bae, Sang-Cheol and Kimberly, Robert P and Edberg, Jeffrey C and Mariette, Xavier and Huizinga, Tom and Dieud{\'e}, Philippe and Schneider, Matthias and Kerick, Martin and Denny, Joshua C and {BioBank Japan Project} and Matsuda, Koichi and Matsuo, Keitaro and Mimori, Tsuneyo and Matsuda, Fumihiko and Fujio, Keishi and Tanaka, Yoshiya and Kumanogoh, Atsushi and Traylor, Matthew and Lewis, Cathryn M and Eyre, Stephen and Xu, Huji and Saxena, Richa and Arayssi, Thurayya and Kochi, Yuta and Ikari, Katsunori and Harigai, Masayoshi and Gregersen, Peter K and Yamamoto, Kazuhiko and Louis Bridges, Jr, S and Padyukov, Leonid and Martin, Javier and Klareskog, Lars and Okada, Yukinori and Raychaudhuri, Soumya},
  year = {2022},
  month = nov,
  journal = {Nat. Genet.},
  volume = {54},
  number = {11},
  pages = {1640--1651},
  abstract = {Rheumatoid arthritis (RA) is a highly heritable complex disease with unknown etiology. Multi-ancestry genetic research of RA promises to improve power to detect genetic signals, fine-mapping resolution and performances of polygenic risk scores (PRS). Here, we present a large-scale genome-wide association study (GWAS) of RA, which includes 276,020 samples from five ancestral groups. We conducted a multi-ancestry meta-analysis and identified 124 loci (P {$<$} 5 {\textbackslash}times 10-8), of which 34 are novel. Candidate genes at the novel loci suggest essential roles of the immune system (for example, TNIP2 and TNFRSF11A) and joint tissues (for example, WISP1) in RA etiology. Multi-ancestry fine-mapping identified putatively causal variants with biological insights (for example, LEF1). Moreover, PRS based on multi-ancestry GWAS outperformed PRS based on single-ancestry GWAS and had comparable performance between populations of European and East Asian ancestries. Our study provides several insights into the etiology of RA and improves the genetic predictability of RA.},
  langid = {english}
}

@article{ishikawaImportanceHistidineResidue1992,
