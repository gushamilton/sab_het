@article{Barkan1980-xy,
  title = {Primary Hyperparathyroidism: Possible Cause of Primary Hyperaldosteronism in a 60-Year-Old Woman},
  author = {Barkan, A and Marilus, R and Winkelsberg, G and Yeshurun, D and Blum, I},
  year = {1980},
  journal = {The Journal of clinical endocrinology and metabolism},
  volume = {51},
  number = {1},
  pages = {144--147},
  address = {UNITED STATES},
  abstract = {Hypertension and hypokalemia were found in a 60-yr-old woman suffering from primary hyperparathyroidism. Laboratory investigations in this patient disclosed 1) elevated levels of plasma aldosterone (PA) which could not be suppressed by a high sodium diet alone or in combination with fludrocortisone (Florinef); 2) a decline of the elevated PA levels after 4 h of ambulation; and 3) low PRA which was unresponsive to stimulation by a low sodium diet coupled with diuretic-induced volume depletion and 4 h of ambulation. These findings were consistent with the diagnosis of primary hyperaldosteronism. Extirpation of a parathyroid adenoma reduced the patient's serum calcium level to normal, and subsequently, a normalization of her blood pressure, serum electrolytes, PA, and PRA were observed. On the basis of these data is is suggested that in this case hyperaldosteronism may have been caused directly or indirectly by primary hyperparathyroidism.},
  keywords = {*Hyperaldosteronism/et [Etiology],*Hyperparathyroidism/co [Complications],Adenoma/su [Surgery],Female,Fludrocortisone/tu [Therapeutic Use],Humans,Hyperaldosteronism/dh [Diet Therapy],Hyperaldosteronism/th [Therapy],Hypercalcemia/co [Complications],Hyperparathyroidism/su [Surgery],Hypertension/et [Etiology],Hypokalemia/et [Etiology],Mendeley Import (Dec 08),Middle Aged,Parathyroid Neoplasms/su [Surgery],Renin/bl [Blood],Sodium/tu [Therapeutic Use]}
}

