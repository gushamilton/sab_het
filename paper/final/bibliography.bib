  author = {Ueno, Munehisa and Ohigashi, Takashi and Nakashima, Jun and Nonaka, Shoichi and Deguchi, Nobuhiro and Murai, Masaru},
  year = {2002},
  journal = {Scandinavian journal of urology and nephrology},
  volume = {36},
  number = {2},
  pages = {149--151},
  publisher = {Department of Urology, Keio University School of Medicine, Tokyo, Japan. camtmune@saitama-med.ac.jp},
  address = {Sweden},
  abstract = {A 69-year-old male patient was diagnosed with right-sided renal cell carcinoma and humoral hypercalcemia of malignancy caused by an excessive production of parathyroid hormone-related protein. The hypercalcemia led to acute tubular necrosis, so the patient had to be put on hemodialysis. The renal failure was accompanied by hyponatremic encephalopathy. Rapid correction of the hyponatremia might have initiated central pontine myelinolysis.},
