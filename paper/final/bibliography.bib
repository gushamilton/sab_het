@article{major-smithAvonLongitudinalStudy2021,
  title = {The {{Avon Longitudinal Study}} of {{Parents}} and {{Children}} - {{A}} Resource for {{COVID-19}} Research: {{Antibody}} Testing Results, {{April}} - {{June}} 2021},
