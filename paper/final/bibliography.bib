@article{Koltin2011-px,
  title = {Mild Infantile Hypercalcemia: Diagnostic Tests and Outcomes},
  author = {Koltin, Dror and Rachmiel, Marianna and Wong, Betty Y L and Cole, David E C and Harvey, Elizabeth and Sochett, Etienne},
  year = {2011},
  journal = {The Journal of pediatrics},
  volume = {159},
  number = {2},
  pages = {215--21.e1},
  publisher = {Division of Endocrinology, The Hospital for Sick Children, Toronto, Ontario, Canada.},
  address = {United States},
  abstract = {OBJECTIVE: To assess outcome in a cohort of patients with infantile hypercalcemia followed over 3 years., STUDY DESIGN: Patients (n = 32) presenting to the calcium clinic between July 2002 and September 2008 were studied. In addition to tests of calcium phosphate metabolism, serum insulin-like growth factor-1, calcitonin, urine citrate, and calcium-sensing receptor gene analysis were obtained., RESULTS: Mean age at presentation was 6.0 +/- 6.3 months. Mean calcium level was 11.4 +/- 0.7 mg/dL (2.84 +/- 0.17 mmol/L). A recognized cause was found in 14\% and a probable cause in 14\% of the cohort. Those with nephrocalcinosis (n = 11) had significantly lower mean weight SDS and higher mean calcium levels. The biochemical profile of those in whom no cause could be determined included nonsuppressed parathyroid hormone with either normal or increased 1,25(OH)(2)D. Hypercalcemia resolved in 20 patients. However, in approximately a third, there was persistence in hypercalcemia, hypercalciuria, or nephrocalcinosis., CONCLUSIONS: The addition of 1,25(OH)(2)D and calcium-sensing receptor mutation analysis to a panel of investigations may improve diagnostic yield. Clinical outcome is overall good, however, one-third need ongoing follow-up. Copyright 2011 Mosby, Inc. All rights reserved.},
  keywords = {*Calcium Phosphates/bl [Blood],*Calcium/bl [Blood],*Hypercalcemia/di [Diagnosis],*Insulin-Like Growth Factor I/me [Metabolism],Calcium-Sensing/ge [Genetics],Child,Chromatography,Disease Progression,DNA Mutational Analysis,Female,Follow-Up Studies,High Pressure Liquid,Humans,Hypercalcemia/bl [Blood],Hypercalcemia/ge [Genetics],Infant,Male,Mendeley Import (Dec 08),Mutation,Newborn,Parathyroid Hormone/bl [Blood],Preschool,Radioimmunoassay,Receptors,Retrospective Studies,Severity of Illness Index,Spectrophotometry,Time Factors}
}

