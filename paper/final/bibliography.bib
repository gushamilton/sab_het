  keywords = {Adolescent,Adult,Aged,Calcium,Calcium: blood,Chronic,Chronic: complications,Female,Hospitalization,Humans,hypercalcaemia SS,Hypercalcemia,Hypercalcemia: blood,Hypercalcemia: etiology,Hyperparathyroidism,Hyperparathyroidism: complications,Kidney Failure,Kidney Transplantation,Male,Middle Aged,Neoplasms,Neoplasms: complications,Postoperative Complications,Renal Dialysis,Renal Dialysis: adverse effects,Retrospective Studies,studies}
}

@article{Flajnik2004-fq,
  title = {Evolution of Innate and Adaptive Immunity: Can We Draw a Line?},
  author = {Flajnik, Martin F and Du Pasquier, Louis},
  year = {2004},
  month = dec,
  journal = {Trends in Immunology},
  volume = {25},
  number = {12},
  pages = {640--644},
  publisher = {Elsevier},
  abstract = {Several recent findings in the field of comparative immunology have reinforced the importance of examining the molecular and functional features of immune systems in a variety of organisms. Particularly exciting are the discoveries of a new gene rearrangement mechanism in lampreys and a somatic diversification of mollusk immune genes. These immune features being found in animals previously believed only to have innate immunity, as well as the flood of information on immune genes, molecules and mechanisms in many different creatures, have prompted us to revisit the artificial dichotomy between adaptive and innate immune systems. Although we draw no startling conclusions, we hope to encourage different thought patterns when viewing immune systems.},
  langid = {english},
  keywords = {read}
}

