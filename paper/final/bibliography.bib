@article{kannoNovelSmallMolecule2012,
  title = {A Novel Small Molecule, {{N-}}(4-(2-Pyridyl)(1,3-Thiazol-2-Yl))-2-(2,4,6-Trimethylphenoxy) Acetamide, Selectively Protects against Oxidative Stress-Induced Cell Death by Activating the {{Nrf2-ARE}} Pathway: Therapeutic Implications for {{ALS}}},
  author = {Kanno, Takuya and Tanaka, Kazunori and Yanagisawa, Yoshiko and Yasutake, Kaori and Hadano, Shinji and Yoshii, Fumihito and Hirayama, Noriaki and Ikeda, Joh-E},
  year = {2012},
  month = dec,
  journal = {Free Radic. Biol. Med.},
  volume = {53},
  number = {11},
  pages = {2028--2042},
  publisher = {Elsevier Inc. (360 Park Avenue South, New York NY 10010, United States)},
  address = {United States},
  abstract = {Antioxidant defense is crucial in restoring cellular redox homeostasis. Recent findings have suggested that oxidative stress plays pivotal roles in the pathogenesis of many neurodegenerative diseases. Thus, an anti-oxidative stress remedy might be a promising means for the treatment of such disorders. In this study, we employed a novel ligand-based virtual screening system and identified a novel small molecule, N-(4-(2-pyridyl)(1,3-thiazol-2-yl))-2-(2,4,6-trimethylphenoxy) acetamide (CPN-9), which selectively suppressed oxidative stress-induced cell death in a cell-type-independent manner. CPN-9 upregulates NF-E2-related factor 2 (Nrf2), a key transcriptional regulator of the expression of phase II detoxification enzymes and antioxidant proteins, and Nrf2-regulated factors such as heme oxygenase-1 (HO-1), NAD(P)H quinone oxidoreductase 1 (NQO1), and glutamate-cysteine ligase modifier subunit (GCLM). The CPN-9-mediated upregulation of HO-1, NQO1, and GCLM was abolished by Nrf2 knockdown. Moreover, the antioxidant N-acetylcysteine reduced the protective effect of CPN-9 against oxidative stress-induced cell death with concomitant diminishing of Nrf2 nuclear translocation. These results indicate that CPN-9 exerts its activity via the reactive oxygen species-dependent activation of the Nrf2 signaling pathway in cultured cells. It is noteworthy that the postonset systemic administration of CPN-9 to a transgenic ALS mouse model carrying the H46R mutation in the human Cu/Zn superoxide dismutase (SOD1) gene sustained motor functions and delayed disease progression after onset. Collectively, CPN-9 is a novel Nrf2 activator and a neuroprotective candidate for the treatment of neurodegenerative diseases, including ALS.},
  langid = {english},
  keywords = {*acetamide derivative/an [Drug Analysis],*acetamide derivative/pd [Pharmacology],*antioxidant responsive element,*cell death,*n [4 (2 pyridyl)(1,*oxidative stress,*transcription factor Nrf2,3 thiazol 2 yl)] 2 (2,4,6 trimethylphenoxy)/an [Drug Analysis],6 trimethylphenoxy)/pd [Pharmacology],activating transcription factor 3/ec [Endogenous Compound],algorithm,animal experiment,article,catalase/ec [Endogenous Compound],cell protection,cell viability,concentration response,controlled study,copper zinc superoxide dismutase/ec [Endogenous Compound],cytoplasm,disease course,drug detoxification,drug efficacy,drug screening,enolase/ec [Endogenous Compound],female,glucose transporter 1/ec [Endogenous Compound],glutamate cysteine ligase/ec [Endogenous Compound],glutathione peroxidase 1/ec [Endogenous Compound],glutathione reductase/ec [Endogenous Compound],glutathione synthase/ec [Endogenous Compound],glutathione transferase M1/ec [Endogenous Compound],glutathione transferase/ec [Endogenous Compound],heme oxygenase 1/ec [Endogenous Compound],human,human cell,hypoxia inducible factor 1alpha/ec [Endogenous Compound],kelch like ECH associated protein 1/ec [Endogenous Compound],lipid peroxidation,lipid peroxide/ec [Endogenous Compound],male,mouse,nonhuman,ovid_export_ris.ris,peroxiredoxin 1/ec [Endogenous Compound],priority journal,promoter region,protein p21/ec [Endogenous Compound],protein secondary structure,quantitative structure activity relation,reduced nicotinamide adenine dinucleotide phosphate/ec [Endogenous Compound],signal transduction,thioredoxin reductase 1/ec [Endogenous Compound],transgenic mouse,unclassified drug,upregulation,vasculotropin A/ec [Endogenous Compound]}
}

@article{kansanene.AbstractsArteriosclerosisThrombosis2010,
  title = {Abstracts: {{Arteriosclerosis}}, {{Thrombosis}}, and {{Vascular Biology}} 2010 {{Scientific Sessions}}},
  author = {{Kansanen E.} and {Bonacci G.} and {Jyrkkanen H.-K.} and {Schopfer F.J.} and {Woodcock S.R.} and {Yla-Herttuala S.} and {Freeman B.A.} and {Levonen A.-L.}},
  year = {2010},
  month = nov,
  journal = {Arterioscler. Thromb. Vasc. Biol.},
  volume = {30},
  number = {11},
  pages = {e183--e321},
  publisher = {American Heart Association},
  abstract = {Objective: Nitro-fatty acids (nitro-FAs) are electrophilic signaling mediators formed in vivo via NO-dependent reactions. Nitro-FAs signal via mechanisms that inhibit platelet and neutrophil activation, NF-kappaB-mediated proinflammatory reactions and vascular smooth muscle cell proliferation, as well as potently inducing anti-inflammatory heme oxygenase-1 gene expression. Nitro-FAs mediate beneficial cardiovascular actions in vivo, inhibiting neointimal hyperplasia after endoluminal vessel injury and myocardial ischemia-reperfusion injury in murine models. Transcriptional profiling of human endothelial cells responses to 9-and 10-nitro-octadecenoic acid (nitro-OA) was performed by microarray analysis. The endothelial cell transcriptome revealed that nitro-OA activates two distinct transcriptional response pathways, one being activation of the transcription factor Nrf2 and the other involving HSF-mediated gene transcription. We now report the molecular mechanisms by which nitro-FAs activate Nrf2 signaling responses, focusing on the hypothesis that post-translational modification of Keap1 cysteines occurs by Michael addition of nitro-FAs to Keap1, and that this event is a significant component of Nrf2 activation and cardiovascular signaling by nitro-FAs. Result(s): We identified the most nitro-OA-reactive Keap1 cysteine residues by mass spectrometry (MS) and found that nitro-OA covalently adducts C38, C226, C257, C273, C288 and C489. In addition, we show by MS-based ``capture'' of adducted nitro-FAs, via an exchange reaction with added betaME, that nitro-OA binds to Keap1 at nanomolar concentrations in a cellular milieu. Notably, the mutation of the highly-reactive C151 of Keap1 did not affect nitro-OA binding. We also utilized reporter gene expression analysis to reveal the functional role of Keap1 C151 and found that, in contrast to a ``classical'' Nrf2-reactive electrophile (the cruciferous vegetable constituent sulforaphane), nitro-OA activated Nrf2-dependent responses independent of adduction with Keap1 C151. Conclusion(s): Keap1 is a critical molecular target for nitro-FAs in Nrf2 activation. Moreover, Keap1 C151-independent activation of Nrf2 contributes to the protective effects of nitro-FAs in the vasculature.},
  langid = {english},
  keywords = {*arteriosclerosis,*cysteine,*fatty acid,*thrombosis,*vascular biology,acid,adduction,cell proliferation,electrophile,electrophilicity,endothelium cell,gene expression,genetic transcription,heart muscle ischemia,heme oxygenase 1,human,hyperplasia,hypothesis,injury,leukocyte activation,mass spectrometry,Michael addition,microarray analysis,model,mutation,ovid_export_ris.ris,reperfusion injury,reporter gene,smooth muscle fiber,sulforaphane,thrombocyte,transcription factor Nrf2,transcriptome,vascular smooth muscle,vascularization,vegetable}
}

@article{kanuajNitricOxideMediates2012,
  title = {Nitric Oxide Mediates Arachidonic Acid and Prostaglandin {{E2-induced}} Cerebral Vasodilation Independent of Carbon Monoxide},
  author = {{Kanu A J} and {Leffler C W}},
  year = {2012},
  journal = {FASEB J.},
  volume = {26},
  number = {Meeting Abstracts},
  publisher = {FASEB},
  abstract = {Nitric oxide mediates arachidonic acid and prostaglandin E2- induced cerebral vasodilation independent of carbon monoxide Carbon monoxide (CO) and nitric oxide (NO) are endogenously produced gaseous signaling molecules that can be involved in regulation of cerebral circulation. PGE2 has been reported to increase NO production. Moreover, NO has been shown to be required as a permissive factor for CO-induced cerebral vasodilation. NO also stimulates CO production in cerebral microvessels. Therefore, AA and PGE2 generated in cerebral microvessels may increase cerebrovascular dilation either through NO or CO. In this study we tested this hypothesis by examining the effect of NO synthase inhibitors on the cerebrovascular response to AA and PGE2. Experiments were performed on anesthetized newborn pigs with closed cranial windows. In experiments with PGE2, indomethacin (5mg/kg i.v.) was administered to inhibit COX. Application of AA (10-7 -10 -5 M) or PGE2 (10-7 10-5 M) on cerebral vessels increased pial arteriolar diameter, which was blocked by both inhibitor of nitric oxide synthase, L-NNA (1x10-6 M) and heme oxygenase (HO) inhibitor chromium mesoporphyrin (CrMP) (2x10-5 M). Sodium nitroprusside (SNP) (1x10-9 -10 -6 M)-induced cerebral vasodilation was not blocked by either L-NNA or CrMP. These data suggest that NO mediated AA- and PGE2-induced cerebral vasodilation is independent of CO in newborn piglets.},
  keywords = {*arachidonic acid,*carbon monoxide,*nitric oxide,*prostaglandin,*vasodilatation,brain blood vessel,brain circulation,chromium,heme oxygenase inhibitor,hypothesis,indometacin,mesoporphyrin,microvasculature,newborn,nitric oxide synthase,nitroprusside sodium,ovid_export_ris.ris,piglet,prostaglandin E2,swine,synthetase}
}

@article{Kanwar2007-gn,
  title = {Misdiagnosis of Community-Acquired Pneumonia and Inappropriate Utilization of Antibiotics: Side Effects of the 4-h Antibiotic Administration Rule},
  author = {Kanwar, Manreet and Brar, Navkiranjot and Khatib, Riad and Fakih, Mohamad G},
  year = {2007},
  month = jun,
  journal = {Chest},
  volume = {131},
  number = {6},
  pages = {1865--1869},
  abstract = {BACKGROUND: The 2003 Infectious Diseases Society of America guidelines for community-acquired pneumonia (CAP) recommend the initiation of antibiotic therapy within 4 h of hospitalization. This quality indicator has been linked to the incentive compensation of third-party payers to hospitals. We evaluated the impact of this recommendation on the diagnosis of CAP and the utilization of antibiotics. METHODS: All patients with a hospital admission diagnosis of CAP before publication of the guidelines (January to June 2003) and after publication of the guidelines (January-June 2005) were included. We collected data on clinical signs and symptoms on presentation, chest radiograph findings, blood cultures prior to therapy with antibiotics, time to antibiotic administration, pneumonia severity index (PSI) score, confusion, urea, respiratory rate, BP, and age {\textquestiondown}or= 65 years (CURB-65), and mortality. RESULTS: A total of 518 patients were included in the study. More patients in 2005 had a hospital admission diagnosis of CAP without radiographic abnormalities compared to 2003 (2005, 91 patients [28.5\%]; 2003, 41 patients [20.6\%]; p = 0.04), and more patients received antibiotics within 4 h of triage (2005, 210 patients [65.8\%]; 2003, 107 patients [53.8\%]; p = 0.007). Blood cultures prior to antibiotic administration increased (2005, 220 patients [69.6\%]; 2003, 93 patients [46.7\%]; p {\textexclamdown} 0.001). However, the final diagnosis of CAP dropped to 58.9\% in 2005 from 75.9\% in 2003 (p {\textexclamdown} 0.001). The mean (+/- SD) antibiotic utilization per patient increased to 1.66 +/- 0.54 in 2005 compared to 1.39 +/- 0.58 in 2003 (p {\textexclamdown} 0.001). There were no significant differences in PSI or CURB-65 scores, or mortality. CONCLUSIONS: Linking antibiotic administration within 4 h of hospital admission (as a quality indicator) to financial compensation may result in an inaccurate diagnosis of CAP, inappropriate utilization of antibiotics, and thus less than optimal care.},
  langid = {english},
  keywords = {Antibiotics,Mendeley Import (Dec 08),Pneumonia,Practice,sepsis,toread}
}

@article{kanwarMisdiagnosisCommunityacquiredPneumonia2007,
  title = {Misdiagnosis of Community-Acquired Pneumonia and Inappropriate Utilization of Antibiotics: Side Effects of the 4-h Antibiotic Administration Rule},
