@article{Mussig2007-po,
  title = {Somatostatin Receptor Expression in a Parathyroid Hormone-Related Peptide-Secreting Pancreatic Neuroendocrine Tumour Causing Severe Hypercalcaemia},
  author = {M{\"u}ssig, Karsten and Petersenn, Stephan and Wehrmann, Manfred and Horger, Marius and Vierling, Peter and H{\"a}ring, Hans Ulrich and Gallwitz, Baptist},
  year = {2007},
  journal = {European Journal of Gastroenterology and Hepatology},
  volume = {19},
  number = {8},
  pages = {719--723},
  publisher = {Department of Endocrinology, University Hospital of Internal Medicine, University of Tubingen, Germany. Karsten.Muessig@med.uni-tuebingen.de},
  address = {England},
  abstract = {BACKGROUND: Humoral hypercalcaemia is a common complication of malignancy with parathyroid hormone-related protein (PTHrP) as a major cause. Breast and lung cancer are relatively common sources of ectopic PTHrP secretion leading to increased osteoclastic bone resorption. CASE REPORT: We report the rare case of a 40-year-old man with severe hypercalcaemia due to a PTHrP-secreting poorly differentiated endocrine carcinoma of the pancreas. On immunohistochemistry, the tumour was positive for PTHrP and somatostatin receptors sst1, sst2, and sst3, whereas sst4 and sst5 were not detected. We demonstrate the transient improvement of hypercalcaemia after adding octreotide to the treatment mainstays in hypercalcaemia of malignancy (fluid repletion, administration of bisphosphonates, loop diuretics, and glucocorticoids). CONCLUSION: To the best of our knowledge, this is the first report showing somatostatin receptor expression in a PTHrP-secreting pancreatic neuroendocrine tumour.  2007 Lippincott Williams \& Wilkins, Inc.},
  keywords = {Humoral hypercalcaemia,Mendeley Import (Dec 08),Neuroendocrine tumour,Octreotide,Pancreas,Parathyroid hormone-related peptide,Somatostatin receptors}
}

