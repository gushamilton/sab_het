@article{millsIFITM3SusceptibilityRespiratory2014,
  title = {{{IFITM3}} and Susceptibility to Respiratory Viral Infections in the Community},
  author = {Mills, Tara C and Rautanen, Anna and Elliott, Katherine S and Parks, Tom and Naranbhai, Vivek and Ieven, Margareta M and Butler, Christopher C and Little, Paul and Verheij, Theo and Garrard, Chris S and Hinds, Charles and Goossens, Herman and Chapman, Stephen and Hill, Adrian V S},
  year = {2014},
  month = apr,
  journal = {J. Infect. Dis.},
  volume = {209},
  number = {7},
  pages = {1028--1031},
  abstract = {Interferon-inducible transmembrane proteins 1, 2, and 3 (IFITM 1,2, and 3) are viral restriction factors that mediate cellular resistance to several viruses. We have genotyped a possible splice-site altering single-nucleotide polymorphism (rs12252) in the IFITM3 gene in 34 patients with H1N1 influenza and severe pneumonia, and {$>$}5000 individuals comprising patients with community-acquired mild lower respiratory tract infection and matched controls of Caucasian ancestry. We found evidence of an association between rs12252 rare allele homozygotes and susceptibility to mild influenza (in patients attending primary care) but could not confirm a previously reported association between this single-nucleotide polymorphism and susceptibility to severe H1N1 infection.},
  langid = {english},
  keywords = {association study,genetics,H1N1,IFITM3,infectious disease,Influenza,LRTI,mandel,Virus}
}

@article{millsVariantsMannosebindingLectin2015,
  title = {Variants in the {{Mannose-binding Lectin Gene MBL2}} Do Not {{Associate With Sepsis Susceptibility}} or {{Survival}} in a {{Large European Cohort}}},
  author = {Mills, Tara C and Chapman, Stephen and Hutton, Paula and Gordon, Anthony C and Bion, Julian and Chiche, Jean-Daniel and Holloway, Paul A H and St{\"u}ber, Frank and Garrard, Chris S and Hinds, Charles J and Hill, Adrian V S and Rautanen, Anna and {ESICM/ECCRN GenOSept Investigators}},
  year = {2015},
