  title = {Nonneutralizing Antibodies Binding to the Surface Glycoprotein of Lymphocytic Choriomeningitis Virus Reduce Early Virus Spread},
  author = {Hangartner, Lars and Zellweger, Rapha{\"e}l M. and Giobbi, Mattia and Weber, Jacqueline and Eschli, Bruno and McCoy, Kathy D. and Harris, Nicola and Recher, Mike and Zinkernagel, Rolf M. and Hengartner, Hans},
