@article{pelulloP026PilotStudy2019,
  title = {P026 {{A}} Pilot Study on Oxidative Stress in Cystic Fibrosis: The Involvement of {{miR125b}} and {{HO-1}}},
  author = {Pelullo, M and Megiorni, F and Cimino, G and Pizzuti, A and Quattrucci, S and Screpanti, I and Talora, C and Cialfi, S},
  year = {2019},
  month = jun,
  journal = {J. Cyst. Fibros.},
  volume = {18},
  number = {Supplement 1},
  pages = {S64},
  publisher = {Elsevier BV},
  address = {Netherlands},
  abstract = {Introduction: Oxidative stress implications were recognized and accepted in the physiopathology of Cystic Fibrosis (CF). The CFTR defects in ionic transport disrupt the intracellular redox balance causing CF pathologic hallmarks. Therefore, oxidative stress together with detoxification genes and miRNAs aberrant expression could be associated with clinical outcome. Objective(s): The aim of this study is the discovery of prognostic markers and/or potential therapeutic targets to improve CF patient's cure. Method(s): CF Patients (n = 13) with the DELTAF508 mutation but several clinical status compared to healthy individuals. Total RNA of nasal brushing was extracted for consecutive expression analysis by quantitative real time PCR, using TaqMan chemistry. Result(s): In this pilot study, we analyzed the existence of a correlation among CFTR, miR-125b, NRF2 and oxidative stress genes in CF patients. The mRNA levels of the NRF2 gene and its targets NQO1 and GST-T1 were increased together with the peculiar downmodulation of CFTR levels. Furthermore, CF patients with chronic P. aeruginosa (PA) lung infection were stratified in two groups based on FEV1{$>$} or 60\% (r = 0,74 p {$<$} 0,001 and r = 0,057 p {$<$} 0,001 respectively). Conclusion(s): In CF patients, the antioxidant response is activated but impaired as shown by upregulation of NRF2 and its targets NQO1 and GST-T1. ROS levels might be too high to be counteracted and give rise to lung injury. Moreover, the correlation of HO-1 and miR-125b expressions with a better FEV1 values prompt us to hypothesize that these factors could explain the wide CF phenotypic variability as an additional control level over the CFTR gene mutations and could be identified as prognostic markers.Copyright {\textbackslash}copyright 2019 European Cystic Fibrosis Society. All rights reserved},
  copyright = {http://www.elsevier.com/open-access/userlicense/1.0/},
  langid = {english},
  keywords = {*cystic fibrosis,*heme oxygenase 1,*microRNA 125b,*oxidative stress,*pilot study,adult,antioxidant,azo reductase,chemistry,clinical article,conference abstract,controlled study,cystic fibrosis transmembrane conductance regulator,endogenous compound,female,forced expiratory volume,gene expression,gene mutation,genetic marker,human,lung infection,lung injury,male,messenger RNA,nose,ovid_export_ris.ris,protein expression,quantitative analysis,reactive oxygen metabolite,real time polymerase chain reaction,transcription factor Nrf2,upregulation}
}

