  volume = {112},
  number = {8},
  pages = {796--799},
  publisher = {Department of Radiology, Shinshu University School of Medicine, Matsumoto, Japan.},
  address = {ENGLAND},
  abstract = {Radiological findings including ultrasonography, computed tomography (CT) and Tc-99m sestamibi scintigraphy of a patient with multilocular giant parathyroid adenoma which caused hypercalcaemic crisis are presented. The location of the tumour by grey scale sonography, CT and Tc-99m sestamibi scintigraphy was not certain because the tumour was uncommon in shape, location, size and internal structure. Whereas, increased flow in the solid portion of the mass was demonstrated on power Doppler sonography, which proved to reflect abundant vessels in the adenoma in pathological findings.},
