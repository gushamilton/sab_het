  keywords = {*autoimmune hemolytic anemia/di [Diagnosis],*autoimmune hemolytic anemia/dt [Drug Therapy],*autoimmune hemolytic anemia/su [Surgery],*autoimmune hemolytic anemia/th [Therapy],*heme oxygenase 1/ec [Endogenous Compound],*hyperbilirubinemia,acute disease,adolescent,alanine aminotransferase/ec [Endogenous Compound],albumin/ec [Endogenous Compound],alkaline phosphatase/ec [Endogenous Compound],allele,anamnesis,article,bilirubin/ec [Endogenous Compound],case report,catalysis,cholinesterase/ec [Endogenous Compound],cyclophosphamide/do [Drug Dose],cyclophosphamide/dt [Drug Therapy],cyclosporin/dt [Drug Therapy],dinucleotide repeat,DNA polymorphism,dose response,enzyme degradation,erythrocyte transfusion,genetic association,genetic linkage,Gilbert disease,glucocorticoid/dt [Drug Therapy],glucuronosyltransferase,hemoglobin/ec [Endogenous Compound],heterozygosity,heterozygote,human,immunoglobulin/dt [Drug Therapy],immunoglobulin/iv [Intravenous Drug Administration],laboratory test,lactate dehydrogenase/ec [Endogenous Compound],liver necrosis/di [Diagnosis],male,microsatellite marker,ovid_export_ris.ris,pancytopenia/di [Diagnosis],priority journal,promoter region,reticulocytosis/di [Diagnosis],rituximab/dt [Drug Therapy],spherocytosis/di [Diagnosis],splenectomy,treatment failure}
