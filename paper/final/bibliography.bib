@article{Bhalla2005-la,
  title = {Hypercalcemia Caused by Iatrogenic Hypervitaminosis {{A}}},
  author = {Bhalla, Karan and Ennis, David M and Ennis, Elizabeth D},
  year = {2005},
  journal = {Journal of the American Dietetic Association},
  volume = {105},
  number = {1},
  pages = {119--121},
  publisher = {Baptist Health System, 840 Montclair Rd, Suite 317, Birmingham, AL 35213, USA. karan.bhalla@bhsala.com},
  address = {United States},
  abstract = {Vitamin A toxicity produces protean clinical manifestations involving a wide variety of tissues and systems. Hypercalcemia can occasionally be associated with high vitamin A levels, but is rare. In this report we describe a patient who was receiving a commercially prepared enteral feeding formula for 2 years. He developed asymptomatic hypercalcemia and had serum vitamin A levels several fold above normal. Subsequently, a custom-made enteral feed was used which contained negligible amounts of vitamin A. Several months later, vitamin A levels diminished substantially and serum calcium levels returned to normal.},
  keywords = {*Enteral Nutrition/ae [Adverse Effects],*Hypercalcemia/et [Etiology],*Hypervitaminosis A/co [Complications],*Iatrogenic Disease,Aged,Humans,Hypercalcemia/bl [Blood],Hypervitaminosis A/bl [Blood],Male,Mendeley Import (Dec 08),Miller Fisher Syndrome/th [Therapy],Vitamin A/ad [Administration & Dosage],Vitamin A/bl [Blood]}
}

