@article{Jolley2015-ue,
  title = {Validation and Optimisation of an {{ICD-10-coded}} Case Definition for Sepsis Using Administrative Health Data},
  author = {Jolley, Rachel J and Quan, Hude and Jett{\'e}, Nathalie and Sawka, Keri Jo and Diep, Lucy and Goliath, Jade and Roberts, Derek J and Yipp, Bryan G and Doig, Christopher J},
  year = {2015},
