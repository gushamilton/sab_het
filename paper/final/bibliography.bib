@article{Clarke2017-bz,
  title = {Characterisation of the Opposing Effects of {{G6PD}} Deficiency on Cerebral Malaria and Severe Malarial Anaemia},
  author = {Clarke, Geraldine M and Rockett, Kirk and Kivinen, Katja and Hubbart, Christina and Jeffreys, Anna E and Rowlands, Kate and Jallow, Muminatou and Conway, David J and Bojang, Kalifa A and Pinder, Margaret and Usen, Stanley and {Sisay-Joof}, Fatoumatta and Sirugo, Giorgio and Toure, Ousmane and Thera, Mahamadou A and Konate, Salimata and Sissoko, Sibiry and Niangaly, Amadou and Poudiougou, Belco and Mangano, Valentina D and Bougouma, Edith C and Sirima, Sodiomon B and Modiano, David and {Amenga-Etego}, Lucas N and Ghansah, Anita and Koram, Kwadwo A and Wilson, Michael D and Enimil, Anthony and Evans, Jennifer and Amodu, Olukemi K and Olaniyan, Subulade and Apinjoh, Tobias and Mugri, Regina and Ndi, Andre and Ndila, Carolyne M and Uyoga, Sophie and Macharia, Alexander and Peshu, Norbert and Williams, Thomas N and Manjurano, Alphaxard and Sep{\'u}lveda, Nuno and Clark, Taane G and Riley, Eleanor and Drakeley, Chris and Reyburn, Hugh and Nyirongo, Vysaul and Kachala, David and Molyneux, Malcolm and Dunstan, Sarah J and Phu, Nguyen Hoan and Quyen, Nguyen Ngoc and Thai, Cao Quang and Hien, Tran Tinh and Manning, Laurens and Laman, Moses and Siba, Peter and Karunajeewa, Harin and Allen, Steve and Allen, Angela and Davis, Timothy Me and Michon, Pascal and Mueller, Ivo and Molloy, S{\'i}le F and Campino, Susana and Kerasidou, Angeliki and Cornelius, Victoria J and Hart, Lee and Shah, Shivang S and Band, Gavin and Spencer, Chris Ca and Agbenyega, Tsiri and Achidi, Eric and Doumbo, Ogobara K and Farrar, Jeremy and Marsh, Kevin and Taylor, Terrie and Kwiatkowski, Dominic P and {MalariaGEN Consortium}},
  year = {2017},
  month = jan,
  journal = {Elife},
  volume = {6},
  abstract = {Glucose-6-phosphate dehydrogenase (G6PD) deficiency is believed to confer protection against Plasmodium falciparum malaria, but the precise nature of the protective effecthas proved difficult to define as G6PD deficiency has multiple allelic variants with different effects in males and females, and it has heterogeneous effects on the clinical outcome of P. falciparum infection. Here we report an analysis of multiple allelic forms of G6PD deficiency in a large multi-centre case-control study of severe malaria, using the WHO classification of G6PD mutations to estimate each individual's level of enzyme activity from their genotype. Aggregated across all genotypes, we find that increasing levels of G6PD deficiency are associated with decreasing risk of cerebral malaria, but with increased risk of severe malarial anaemia. Models of balancing selection based on these findings indicate that an evolutionary trade-off between different clinical outcomes of P. falciparum infection could have been a major cause of the high levels of G6PD polymorphism seen in human populations.},
  langid = {english},
  keywords = {epidemiology,evolutionary biology,G6PD deficiency,genetic association,genomics,global health,human,infectious disease,selection}
}

