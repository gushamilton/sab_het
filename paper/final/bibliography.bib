@article{chopray.Esid2014Oral2014,
  title = {Esid 2014 Oral Presentations},
  author = {{Chopra Y.} and {Nivargi S.} and {Ramzan M.} and {Sharma R.} and {Katewa S.} and {Yadav S.}},
  year = {2014},
  month = oct,
  journal = {J. Clin. Immunol.},
  volume = {34 Suppl 2},
  number = {Suppl 2},
  pages = {139--515},
  publisher = {Springer New York LLC},
  abstract = {Introduction: - Primary Immunodeficiency disorders (PID) are under-diagnosed and under - reported in the developing world like ours. On reviewing published Indian data on PID we came across only 4 large series reporting a total of 386 cases only with mortality as high as 51\%.We are hereby presenting our own experience over last 15 months. Method(s): -We retrospectively analysed 23 children registered in our PID clinic from January 2013 to April 2014. Result(s): -M: F was 17:6. Mean age was 6.02 years (3 mon -15 yrs).Three children had x - linked agammaglobunemia and are doing well on intravenous immunoglobulin.One child had pure red cell aplasia with IgM deficiency and responded well to prednisolone. One had congenital neutropenia and is being managed with G-CSF.Hyper IgE syndrome (DOCK 8 mutation) was seen in three children. ALPS was seen in three children and are doing well on mycophenolate, steroids and sirolimus (one case). Three children (2 males, 1 female) were diagnosed as case of Heme-oxygenase-1 deficiency with autoinflammatory syndrome. Four children underwent BMT (2 matched sibling, 2 haploidentical) for Aplastic anemia with CVID, Chediak Higashi syndrome, X-linked severe combined immunodeficiency and DOCK 8 mutation respectively and two (SCID and Dock 8) died of fulminant sepsis. Hemophagocytic lymphohistiocytosis (Three acquired and One familial) was managed as per HLH 2004 protocol. Overall survival was 90.9\% (20/22) with one lost to follow up. Conclusion(s): - This is a small series shows that improvement in survival is possible with early diagnosis and appropriate management.},
  langid = {english},
  keywords = {*diseases,*European,*immune deficiency,*India,*society,aplastic anemia,autoinflammatory disease,Chediak Higashi syndrome,child,early diagnosis,female,follow up,heme oxygenase 1,hemophagocytic syndrome,hospital,human,immunoglobulin E,immunoglobulin M deficiency,Indian,male,mortality,mutation,mycophenolic acid,neutropenia,overall survival,ovid_export_ris.ris,prednisolone,pure red cell anemia,rapamycin,sepsis,sibling,steroid,survival,syndrome X,X linked severe combined immunodeficiency}
}

@article{Chora2007-ab,
  title = {Heme Oxygenase--1 and Carbon Monoxide Suppress Autoimmune Neuroinflammation},
  author = {Chora, {\^A}ngelo A and Fontoura, Paulo and Cunha, Andreia and Pais, Teresa F and Cardoso, S{\'i}lvia and Ho, Peggy P and Lee, Lowen Y and Sobel, Raymond A and Steinman, Lawrence and Soares, Miguel P},
  year = {2007},
  month = feb,
  journal = {Journal of Clinical Investigation},
  volume = {117},
  number = {2},
  pages = {438--447},
  publisher = {The American Society for Clinical Investigation},
  abstract = {Heme oxygenase--1 (HO-1, encoded by HMOX1) dampens inflammatory reactions via the catabolism of heme into CO, Fe, and biliverdin. We report that expression of HO-1 dictates the pathologic outcome of experimental autoimmune encephalomyelitis (EAE), a model of multiple sclerosis (MS). Induction of EAE in Hmox1--/-- C57BL/6 mice led to enhanced CNS demyelination, paralysis, and mortality, as compared with Hmox1+/+ mice. Induction of HO-1 by cobalt protoporphyrin IX (CoPPIX) administration after EAE onset reversed paralysis in C57BL/6 and SJL/J mice and disease relapse in SJL/J mice. These effects were not observed using zinc protoporphyrin IX, which does not induce HO-1. CoPPIX protection was abrogated in Hmox1--/-- C57BL/6 mice, indicating that CoPPIX acts via HO-1 to suppress EAE progression. The protective effect of HO-1 was associated with inhibition of MHC class II expression by APCs and inhibition of Th and CD8 T cell accumulation, proliferation, and effector function within the CNS. Exogenous CO mimicked these effects, suggesting that CO contributes to the protective action of HO-1. In conclusion, HO-1 or exposure to its end product CO counters autoimmune neuroinflammation and thus might be used therapeutically to treat MS.}
}

@article{choraHemeOxygenase1Carbon2007,
  title = {Heme Oxygenase-1 and Carbon Monoxide Suppress Autoimmune Neuroinflammation},
  author = {Chora, Angelo A and Fontoura, Paulo and Cunha, Andreia and Pais, Teresa F and Cardoso, S{\'i}lvia and Ho, Peggy P and Lee, Lowen Y and Sobel, Raymond A and Steinman, Lawrence and Soares, Miguel P},
