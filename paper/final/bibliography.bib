@article{zhuResistanceAntixenogeneicResponse2008,
  title = {Resistance to Anti-Xenogeneic Response by Combining Alpha-{{Gal}} Silencing with {{HO-1}} Upregulation},
  author = {Zhu, Min and Zhang, Wei and Liu, Fang and Wang, Lu and Liu, Bin and Chen, Dong and Zhu, Xue-Hai and Zhang, Wei-Jie and Ichim, Thomas E and Chen, Zhi-Shui and Zhou, Ping and Chen, Shi and Chen, Gang},
