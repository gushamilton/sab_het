  number = {2},
  pages = {299--310},
  abstract = {Spontaneous clearance of acute hepatitis C virus (HCV) infection is associated with single nucleotide polymorphisms (SNPs) on the MHC class II. We fine-mapped the MHC region in European (n = 1,600; 594 HCV clearance/1,006 HCV persistence) and African (n = 1,869; 340 HCV clearance/1,529 HCV persistence) ancestry individuals and evaluated HCV peptide binding affinity of classical alleles. In both populations, HLA-DQ{$\beta$}1Leu26 (p valueMeta = 1.24 {\textbackslash}times 10-14) located in pocket 4 was negatively associated with HCV spontaneous clearance and HLA-DQ{$\beta$}1Pro55 (p valueMeta = 8.23 {\textbackslash}times 10-11) located in the peptide binding region was positively associated, independently of HLA-DQ{$\beta$}1Leu26. These two amino acids are not in linkage disequilibrium (r2 {$<$} 0.1) and explain the SNPs and classical allele associations represented by rs2647011, rs9274711, HLA-DQB1{$\ast$}03:01, and HLA-DRB1{$\ast$}01:01. Additionally, HCV persistence classical alleles tagged by HLA-DQ{$\beta$}1Leu26 had fewer HCV binding epitopes and lower predicted binding affinities compared to clearance alleles (geometric mean of combined IC50 nM of persistence versus clearance; 2,321 nM versus 761.7 nM, p value = 1.35 {\textbackslash}times 10-38). In summary, MHC class II fine-mapping revealed key amino acids in HLA-DQ{$\beta$}1 explaining allelic and SNP associations with HCV outcomes. This mechanistic advance in understanding of natural recovery and immunogenetics of HCV might set the stage for much needed enhancement and design of vaccine to promote spontaneous clearance of HCV infection.},
  langid = {english},
  keywords = {fine-mapping,GWAS,HCV clearance,hepatitis C virus,HLA imputation,HLA-DQ1,host genetics,infection,MHC,trans-ancestral}
}

@article{valenzuelaHighDoseAntibioticCement2022,
  title = {High-{{Dose Antibiotic Cement Spacers Independently Increase}} the {{Risk}} of {{Acute Kidney Injury}} in {{Revision}} for {{Periprosthetic Joint Infection}}: {{A Prospective Randomized Controlled Clinical Trial}}},
  author = {Valenzuela, Michael M and Odum, Susan M and Griffin, William L and Springer, Bryan D and Fehring, Thomas K and Otero, Jesse E},
  year = {2022},
  month = jun,
  journal = {J. Arthroplasty},
  volume = {37},
  number = {6S},
  pages = {S321--S326},
  publisher = {Elsevier BV},
  abstract = {BACKGROUND: Standard treatment for periprosthetic joint infection (PJI) involves 2-stage exchange with placement of an antibiotic-impregnated cement spacer (ACS). Conflicting evidence exists on the role of ACS in development of acute kidney injury (AKI) after first-stage surgery. In this randomized clinical trial, we aimed to compare the incidence of AKI between the first-stage of a planned 2-stage exchange vs 1-stage exchange. This study design isolates the effect of the ACS in otherwise identical treatment groups. METHODS: The primary outcome variable was AKI, defined as a creatinine {\textbackslash}geq1.5 times baseline or an increase of {\textbackslash}geq0.3 mg/dL. Risk factors for AKI were evaluated using bivariate statistical tests and multivariable logistic regression. RESULTS: Patients who underwent the first stage of a planned 2-stage exchange were significantly more likely to develop AKI compared with the 1-stage exchange group (15 [22.7\%] vs 4 [6.6\%], P = .011). On multivariable regression analysis, ACS placement (odds ratio 7.48, 95\% confidence limit 1.77-31.56) and chronic kidney disease (odds ratio 3.84, 95\% confidence limit 1.22-12.08) were independent risk factors for AKI. CONCLUSION: Our study provides evidence that high-dose antibiotic cement spacers for treatment of PJI are an independent risk factor for AKI. Therefore, efforts to minimize nephrotoxicity should be employed in revision for PJI when possible.},
  langid = {english},
  keywords = {acute kidney injury,antibiotic spacer,one-stage exchange,periprosthetic joint infection,two-stage exchange}
}

@article{valettePrioritizationCandidateCausal2021,
  title = {Prioritization of Candidate Causal Genes for Asthma in Susceptibility Loci Derived from {{UK Biobank}}},
  author = {Valette, Kim and Li, Zhonglin and {Bon-Baret}, Valentin and Chignon, Arnaud and B{\'e}rub{\'e}, Jean-Christophe and Eslami, Aida and Lamothe, Jennifer and Gaudreault, Nathalie and Joubert, Philippe and Obeidat, Ma'en and {van den Berge}, Maarten and Timens, Wim and Sin, Don D and Nickle, David C and Hao, Ke and Labb{\'e}, Catherine and Godbout, Krystelle and C{\^o}t{\'e}, Andr{\'e}anne and Laviolette, Michel and Boulet, Louis-Philippe and Mathieu, Patrick and Th{\'e}riault, S{\'e}bastien and Boss{\'e}, Yohan},
  year = {2021},
  month = jun,
  journal = {Commun Biol},
  volume = {4},
  number = {1},
  pages = {700},
  abstract = {To identify candidate causal genes of asthma, we performed a genome-wide association study (GWAS) in UK Biobank on a broad asthma definition (n = 56,167 asthma cases and 352,255 controls). We then carried out functional mapping through transcriptome-wide association studies (TWAS) and Mendelian randomization in lung (n = 1,038) and blood (n = 31,684) tissues. The GWAS reveals 72 asthma-associated loci from 116 independent significant variants (PGWAS {$<$} 5.0E-8). The most significant lung TWAS gene on 17q12-q21 is GSDMB (PTWAS = 1.42E-54). Other TWAS genes include TSLP on 5q22, RERE on 1p36, CLEC16A on 16p13, and IL4R on 16p12, which all replicated in GTEx lung (n = 515). We demonstrate that the largest fold enrichment of regulatory and functional annotations among asthma-associated variants is in the blood. We map 485 blood eQTL-regulated genes associated with asthma and 50 of them are causal by Mendelian randomization. Prioritization of druggable genes reveals known (IL4R, TSLP, IL6, TNFSF4) and potentially new therapeutic targets for asthma.},
  langid = {english}
}

