  author = {Kinnaert, P and Van Hooff, I and Schoutens, A and Bergmann, P and Fuss, M and Dratwa, M and Vienne, A and Pasteels, J L and {van Geertruyden}, J and Vanherweghem, J L},
  year = {1989},
  journal = {World journal of surgery},
  volume = {13},
