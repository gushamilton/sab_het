@article{rudnickaAnalysisPolymorphismHepatic2017,
  title = {Analysis of Polymorphism and Hepatic Expression of Duodenal Cytochrome b in Chronic Hepatitis {{C}}},
  author = {Rudnicka, Alina and Woziwodzka, Anna and Wr{\'o}blewska, Anna and Rybicka, Magda and Bielawski, Krzysztof P and Sikorska, Katarzyna and Bernat, Agnieszka},
  year = {2017},
  month = feb,
  journal = {J. Gastroenterol. Hepatol.},
  volume = {32},
  number = {2},
  pages = {482--486},
  publisher = {Blackwell Publishing (E-mail: info@asia.blackpublishing.com.au)},
  address = {Australia},
  abstract = {BACKGROUND AND AIM: Pathological iron overload is commonly found in chronic hepatitis C (CHC) patients and considered as a negative prognostic factor of the disease. A single nucleotide polymorphism (SNP) rs884409 in duodenal cytochrome b gene (CYBRD1) is implicated in the pathogenesis of hemochromatosis. In our study we investigated the impact of the CYBRD1 genotype and expression on iron overload in CHC patients. METHODS: Liver biopsy specimens and whole blood samples from 243 patients with CHC were included in the study. Iron deposits in hepatocytes, serum markers of iron overload, and expression profile of gene-regulators of iron homeostasis were analyzed. Genotyping and analysis of gene expression of the CYBRD1 were performed. The frequency of SNP and the expression levels of CYBRD1 were compared between the groups of patients with and without markers of iron overload. RESULTS: The single nucleotide variant rs884409 G was associated with elevated serum iron levels, increased markers of liver inflammation, and oxidative stress. Hepatic expression of CYBRD1 was associated with the expression of Tfr2, Id1, and HO-1 genes, serum ferritin levels, and with increased iron accumulation in liver. CONCLUSION: These results implicate CYBRD1 involvement in iron homeostasis in CHC.},
  langid = {english},
  keywords = {*Cytochrome b Group/ge [Genetics],*Hepatitis C,*Iron/me [Metabolism],*Liver/me [Metabolism],*Oxidoreductases/ge [Genetics],*Polymorphism,CHC,Chronic/me [Metabolism],CYBRD1,Cytochrome b Group/me [Metabolism],Female,Gene Expression/ge [Genetics],Hemochromatosis/ge [Genetics],Humans,iron overload,Iron Overload/ge [Genetics],Male,Middle Aged,ovid_export_ris.ris,Oxidative Stress/ge [Genetics],Oxidoreductases/me [Metabolism],Single Nucleotide,SNP}
}

@article{ruedaHO1PromoterPolymorphism2007,
  title = {{{HO-1}} Promoter Polymorphism Associated with Rheumatoid Arthritis},
  author = {Rueda, Blanca and Oliver, Javier and Robledo, Gema and {L{\'o}pez-Nevot}, Miguel A and Balsa, Alejandro and {Pascual-Salcedo}, Dora and {Gonz{\'a}lez-Gay}, Miguel A and {Gonz{\'a}lez-Escribano}, Maria F and Mart{\'i}n, Javier},
  year = {2007},
  month = dec,
  journal = {Arthritis Rheum.},
  volume = {56},
  number = {12},
  pages = {3953--3958},
  publisher = {{John Wiley and Sons Inc. (P.O.Box 18667, Newark NJ 07191-8667, United States)}},
  address = {United States},
  abstract = {OBJECTIVE: To investigate the role of the HO-1 gene as a novel functional candidate gene for rheumatoid arthritis (RA). METHODS: We performed a case-control study including 736 RA patients and 846 healthy controls of Spanish Caucasian origin. Two putative functional HO-1 promoter polymorphisms, a (GT)(n) microsatellite and a -413 A/T single-nucleotide polymorphism (SNP), were selected as genetic markers and genotyped using polymerase chain reaction-based methods. In addition, the intracellular expression of heme oxygenase 1 (HO-1) was determined in healthy individuals with different (GT)(n) genotypes. RESULTS: The distribution of HO-1 (GT)(n) short (S) alleles (25 GT repeats) revealed a significant protective effect of S (GT)(n) alleles (P = 0.019) (odds ratio [OR] 0.8, 95\% confidence interval [95\% CI] 0.7-0.9) and the SS (GT)(n) genotype (P = 0.002) (OR 0.6, 95\% CI 0.4-0.9). In contrast, the -413 HO-1 promoter SNP did not yield any statistically significant deviation between RA patients and controls, considering either allele or genotype frequencies. The haplotype analysis showed a strong protective effect of the S/A haplotype (P = 7 x 10(-7), corrected P [P(corr)] = 3 x 10(-6)) (OR 0.4, 95\% CI 0.3-0.6), whereas the L/A haplotype showed the opposite tendency (P = 0.008, P(corr) = 0.03) (OR 1.2, 95\% CI 1.0-1.4). In addition, we demonstrated that monocytes from individuals carrying the SS (GT)(n) genotype showed a significantly higher percentage of HO-1 expression than did cells from LL homozygous individuals (P = 0.0003). CONCLUSION: In this study, we identified the HO-1 (GT)(n) microsatellite as a new genetic marker involved in RA genetics in our population.},
  langid = {english},
  keywords = {*heme oxygenase 1/ec [Endogenous Compound],*rheumatoid arthritis,adult,aged,allele,article,controlled study,disease association,disease course,DNA polymorphism,enzyme localization,female,gene function,genetic variability,genotype,haplotype,human,major clinical study,male,microsatellite DNA/ec [Endogenous Compound],monocyte,ovid_export_ris.ris,polymerase chain reaction,priority journal,protein expression,single nucleotide polymorphism,statistical significance}
}

@article{ruizm.o.Abstracts23rdEuropean2009,
  title = {Abstracts of the 23rd {{European Immunogenetics}} and {{Histocompatibility Conference}}. {{Ulm}}, {{Germany}}. {{May}} 9-12, 2009},
  author = {{Ruiz M.O.} and {Baleotti W.} and {Gamberini M.} and {Braccialli A.A.} and {Lopes L.B.} and {Castilho L.} and {Fabron A.}},
  year = {2009},
  month = may,
  journal = {Tissue Antigens},
  volume = {73},
  number = {5},
  pages = {385--523},
  publisher = {Blackwell Publishing Ltd},
  abstract = {Genetic factors predisposing to autoimmune diseases, polymorphism in several genes have been studied in autoimmune hemolytic anemia heme oxygenase-1 (HO-1) gene promoter, TP53 tumor suppressor gene, CTLA-4 exon 1 and negative association between HLA-DQ6 in patients with evidence for hemolysis. The major histocompatibility complex (MHC) acts as a marker for self during T-cell ontogeny and is associated with the pathogenesis of many autoimmune diseases. Autoimmune hemolytic anemia (AIHA) is an immune disorder caused by antibodies directed against unmodified autologous red cells. We studied the involvement of HLA class I and II alleles A, B and DRB1 in idiopathic autoimmune hemolytic anemia Brazilian patients. DNA was extracted from blood of patients with AIHA, and the loci A, B and DRB1 type determined by a PCR and single-strand oligonucleotide probe hybridization assay. Using a case-control design, we compared the frequency of allelic genotype in 15 patients with AIHA to 439 ethnically matched controls. Both HLA class I and II studied showed significant differences between the patients and control group. The alleles A*74, B*35 and DRB1*01 of patient versus control groups showed frequencies of 6\% vs 0.8\% with elevated relative risk [OR] = 7.5 (A*74); 23\% vs 11.6\% [OR] = 2.0 (B*35) and 16.07\% vs 8.2\% [OR] = 2 (DRB1*01), suggesting that HLA loci -A, -B and DRB1 may contribute to the etiology of idiopathic autoimmune hemolytic anemia. These data are preliminary and the sample numbers will be increased.},
  langid = {english},
  keywords = {*autoimmune hemolytic anemia,*histocompatibility,*immunogenetics,*patient,allele,antibody,assay,autoimmune disease,blood,control group,cytotoxic T lymphocyte antigen 4,DNA,erythrocyte,etiology,exon,gene,genotype,heme oxygenase 1,hemolysis,heredity,hybridization,major histocompatibility complex,marker,oligonucleotide probe,ontogeny,ovid_export_ris.ris,pathogenesis,promoter region,risk factor,T lymphocyte,tumor suppressor gene}
}

