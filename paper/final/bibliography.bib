@article{Nikolov2009-tb,
  title = {Impact of Disturbances of Calcium and Phosphate Metabolism on Vascular Calcification and Clinical Outcomes in Patients with Chronic Kidney Disease},
  author = {Nikolov, Igor G and Mozar, Anais and Drueke, Tilman B and Massy, Ziad A},
  year = {2009},
  journal = {Blood purification},
  volume = {27},
  number = {4},
  pages = {350--359},
  publisher = {{INSERM ERI-12, University of Picardie and Amiens University Hospital, Av. Rene Laennec, Amiens, France.}},
  address = {Switzerland},
  abstract = {Chronic kidney disease (CKD) is frequently complicated by arterial calcification. The latter is part of the associated mineral and bone disorder (CKD-MBD). Hypercalcemia and hyperphosphatemia have long been known to play a major role in the occurrence of vascular and other soft tissue calcification in patients with CKD, together with endocrine disturbances including vitamin D, parathyroid hormone, fibroblast growth factor-23, and klotho. In addition, many other systemic and local promoters, including inflammation and uremic toxins, contribute to the occurrence of vascular calcification, despite a powerful defense system made up of systemic and local inhibitors, as demonstrated in elegant experimental studies done in vitro and in vivo. Most importantly, several reports have shown that both hyperphosphatemia and hypophosphatemia, and to a lesser degree hypercalcemia and hypocalcemia, are associated with an increased relative risk of mortality in patients with CKD. However, all these reports were observational in nature and must therefore be considered as hypothesis generating. It remains to be demonstrated in prospective randomized trials whether normalization of serum phosphorus and/or calcium leads to better patient outcome. In order to improve outcome in patients with CKD-MBD, early medical intervention is of utmost importance. Copyright (c) 2009 S. Karger AG, Basel.},
  keywords = {*Calcium/me [Metabolism],*Kidney Diseases/me [Metabolism],*Phosphates/me [Metabolism],Calcinosis/et [Etiology],Humans,Kidney Diseases/co [Complications],Kidney Diseases/mo [Mortality],Kidney Diseases/pa [Pathology],Mendeley Import (Dec 08),Vascular Diseases/et [Etiology],Vascular Diseases/pa [Pathology]}
}

