@article{Adler1998-zx,
  title = {Mitral Annular Calcium Detected by Transthoracic Echocardiography Is a Marker for High Prevalence and Severity of Coronary Artery Disease in Patients Undergoing Coronary Angiography},
  author = {Adler, Y and Herz, I and Vaturi, M and Fusman, R and {Shohat-Zabarski}, R and Fink, N and Porter, A and Shapira, Y and Assali, A and Sagie, A},
  year = {1998},
  journal = {The American journal of cardiology},
  volume = {82},
  number = {10},
  pages = {1183--1186},
  publisher = {Department of Cardiology, Rabin Medical Center, Beilinson Campus, Petah Tiqva, Israel.},
  address = {UNITED STATES},
  abstract = {This study tests the hypothesis that mitral annular calcium (MAC) detected by transthoracic echocardiography (TTE) is a marker for high prevalence and severity of coronary artery disease (CAD) in patients undergoing coronary angiography. Pathological studies have suggested that there is an association between MAC and calcific deposits in coronary arteries; however, there are no clinical data to support this association. One hundred sixty-five patients with MAC (101 women and 64 men; mean age 71 +/- 8 years) who underwent cardiac catheterization with coronary angiography for various reasons were compared with 147 age-matched controls without MAC who underwent coronary angiography for the same indications during the same period. MAC was defined as a dense, localized, highly reflective area at the base of the posterior mitral leaflet detected by TTE. Obstructive CAD was defined as either {\textquestiondown} or = 50\% reduction of the internal diameter of the left main coronary artery or {\textquestiondown} or = 70\% reduction of the internal diameter of the left anterior descending, right coronary, or left circumflex artery distribution. Compared with controls, the MAC group had a significantly higher prevalence of CAD (89\% vs 75\%, p = 0.001) and higher rates of 3-vessel disease (45\% vs 24\%, p = 0.001) and left main CAD (13\% vs 5\%, p = 0.009). Nonsignificant CAD was more common in the control group (25\% vs 11\%, p = 0.001). Multivariate analysis identified MAC (p = 0.0002), indications for cardiac angiography (p = 0.02), sex (p = 0.03), and diabetes mellitus (p = 0.03) as independent predictors for the presence and severity of obstructive CAD. MAC detected by TTE may be a marker for high prevalence and severity of CAD in patients undergoing coronary angiography.},
  keywords = {80 and over,Adult,Aged,Biomarkers,Calcinosis,classification,complications,Coronary Angiography,Coronary Disease,Echocardiography,Female,Heart Valve Diseases,Humans,Male,Mendeley Import (Dec 08),Middle Aged,Mitral Valve,Multivariate Analysis,pathology,Prevalence,Risk Factors,Severity of Illness Index,Sex Factors,ultrasonography}
}

@misc{adlerMitralAnnularCalcium1998,
  title = {Mitral Annular Calcium Detected by Transthoracic Echocardiography Is a Marker for High Prevalence and Severity of Coronary Artery Disease in Patients Undergoing Coronary Angiography},
  author = {Adler, Y and Herz, I and Vaturi, M and Fusman, R and {Shohat-Zabarski}, R and Fink, N and Porter, A and Shapira, Y and Assali, A and Sagie, A},
  year = {1998},
  journal = {The American journal of cardiology},
  volume = {82},
  number = {10},
  pages = {1183--1186},
  publisher = {Department of Cardiology, Rabin Medical Center, Beilinson Campus, Petah Tiqva, Israel.},
  address = {UNITED STATES},
  abstract = {This study tests the hypothesis that mitral annular calcium (MAC) detected by transthoracic echocardiography (TTE) is a marker for high prevalence and severity of coronary artery disease (CAD) in patients undergoing coronary angiography. Pathological studies have suggested that there is an association between MAC and calcific deposits in coronary arteries; however, there are no clinical data to support this association. One hundred sixty-five patients with MAC (101 women and 64 men; mean age 71 +/- 8 years) who underwent cardiac catheterization with coronary angiography for various reasons were compared with 147 age-matched controls without MAC who underwent coronary angiography for the same indications during the same period. MAC was defined as a dense, localized, highly reflective area at the base of the posterior mitral leaflet detected by TTE. Obstructive CAD was defined as either {$>$} or = 50\% reduction of the internal diameter of the left main coronary artery or {$>$} or = 70\% reduction of the internal diameter of the left anterior descending, right coronary, or left circumflex artery distribution. Compared with controls, the MAC group had a significantly higher prevalence of CAD (89\% vs 75\%, p = 0.001) and higher rates of 3-vessel disease (45\% vs 24\%, p = 0.001) and left main CAD (13\% vs 5\%, p = 0.009). Nonsignificant CAD was more common in the control group (25\% vs 11\%, p = 0.001). Multivariate analysis identified MAC (p = 0.0002), indications for cardiac angiography (p = 0.02), sex (p = 0.03), and diabetes mellitus (p = 0.03) as independent predictors for the presence and severity of obstructive CAD. MAC detected by TTE may be a marker for high prevalence and severity of CAD in patients undergoing coronary angiography.},
  keywords = {80 and over,Adult,Aged,Biomarkers,Calcinosis,classification,complications,Coronary Angiography,Coronary Disease,Echocardiography,Female,Heart Valve Diseases,Humans,Male,Mendeley Import (Dec 08),Middle Aged,Mitral Valve,Multivariate Analysis,pathology,Prevalence,Risk Factors,Severity of Illness Index,Sex Factors,ultrasonography}
}

@article{Adrie2017-ux,
  title = {Persistent Lymphopenia Is a Risk Factor for {{ICU-acquired}} Infections and for Death in {{ICU}} Patients with Sustained Hypotension at Admission},
  author = {Adrie, Christophe and Lugosi, Maxime and Sonneville, Romain and Souweine, Bertrand and Ruckly, St{\'e}phane and Cartier, Jean-Charles and {Garrouste-Orgeas}, Mait{\'e} and Schwebel, Carole and Timsit, Jean-Fran{\c c}ois and {OUTCOMEREA study group}},
  year = {2017},
  month = dec,
  journal = {Ann. Intensive Care},
  volume = {7},
  number = {1},
  pages = {30},
  abstract = {BACKGROUND: Severely ill patients might develop an alteration of their immune system called post-aggressive immunosuppression. We sought to assess the risk of ICU-acquired infection and of mortality according to the absolute lymphocyte count at ICU admission and its changes over 3 days. METHODS: Adults in ICU for at least 3 days with a shock or persistent low blood pressure were extracted from a French ICU database and included. We evaluated the impact of the absolute lymphocyte count at baseline and its change at day 3 on the incidence of ICU-acquired infection and on the 28-day mortality rate. We categorized lymphocytes in 4 groups: above 1.5 {\texttimes} 103 cells/{\textmu}L; between 1 and 1.5 {\texttimes} 103 cells/{\textmu}L; between 0.5 and 1 {\texttimes} 103 cells/{\textmu}L; and below 0.5 {\texttimes} 103 cells/{\textmu}L. RESULTS: A total of 753 patients were included. The median lymphocyte count was 0.8 {\texttimes} 103 cells/{\textmu}L [0.51-1.29]. A total of 174 (23\%) patients developed infections; the 28-day mortality rate was 21\% (161/753). Lymphopenia at admission was associated with ICU-acquired infection (p {\textexclamdown} 0.001) but not with 28-day mortality. Independently of baseline lymphocyte count, the absence of lymphocyte count increase at day 3 was associated with ICU-acquired infection (sub-distribution hazard ratio sHR: 1.37 [1.12-1.67], p = 0.002) and with 28-day mortality (sHR: 1.67 [1.37-2.03], p {\textexclamdown} 0.0001). CONCLUSION: Lymphopenia at ICU admission and its persistence at day 3 were associated with an increased risk of ICU-acquired infection, while only persisting lymphopenia predicted increased 28-day mortality. The lymphocyte count at ICU admission and at day 3 could be used as a simple and reproductive marker of post-aggressive immunosuppression.},
  langid = {english},
  keywords = {Absolute lymphocyte count,ICU,Immunosuppression,Infection,Nosocomial,Shock,Survival}
}

