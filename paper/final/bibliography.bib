@article{infanteGenegeneInteractionHeme2010,
  title = {Gene-Gene Interaction between Heme Oxygenase-1 and Liver {{X}} Receptor-Beta and {{Alzheimer}}'s Disease Risk},
  author = {Infante, Jon and {Rodr{\'i}guez-Rodr{\'i}guez}, Eloy and Mateo, Ignacio and Llorca, Javier and {V{\'a}zquez-Higuera}, Jos{\'e} Luis and Berciano, Jos{\'e} and Combarros, Onofre},
  year = {2010},
  month = apr,
  journal = {Neurobiol. Aging},
  volume = {31},
  number = {4},
  pages = {710--714},
  publisher = {Elsevier Inc. (360 Park Avenue South, New York NY 10010, United States)},
  address = {United States},
  abstract = {Increasing cellular cholesterol levels results in high amyloid beta (Abeta) synthesis, which is central to the pathogenesis of Alzheimer's disease (AD). Heme oxygenase-1 (HO-1) stimulates oxidation of glial cholesterol to oxysterols, and increased oxysterol concentrations may protect neural tissues by activation of liver X receptor-beta (LXR-beta), which induces transcription of genes associated with reduction of cellular cholesterol concentrations and decrease of Abeta formation. Underexpression of HO-1 in concert with underexpression of LXR-beta would result in increased cholesterol accumulation, induction of Abeta production, and increased AD risk. We examined a functional polymorphism in the HO-1 promoter region (-413, rs2071746), and three LXR-beta polymorphisms in introns 2 (rs2695121), 5 (rs1052533), and 7 (rs1405655), in a group of 414 Spanish AD cases and 442 controls. Subjects carrying both the HO-1 (-413) TT genotype and the LXR-beta (intron 2) TT genotype (OR=2.63), LXR-beta (intron 5) AA genotype (OR=1.90), or LXR-beta (intron 7) TT genotype (OR=1.75) had a higher risk of developing AD than subjects without these risk genotypes. Considering synergistic effects between polymorphisms in cellular cholesterol efflux-related genes may help in determining the risk profile for AD.},
  langid = {english},
  keywords = {*Alzheimer Disease/ge [Genetics],*Cholesterol/me [Metabolism],*Epistasis,*Genetic Predisposition to Disease/ge [Genetics],*Heme Oxygenase-1/ge [Genetics],*Orphan Nuclear Receptors/ge [Genetics],80 and over,Aged,Alzheimer Disease/me [Metabolism],Alzheimer Disease/pp [Physiopathology],DNA Mutational Analysis,Female,Gene Expression Regulation/ph [Physiology],Genetic Markers/ge [Genetics],Genetic Testing,Genetic/ge [Genetics],Genotype,Heme Oxygenase-1/me [Metabolism],Humans,Introns/ge [Genetics],Liver X Receptors,Male,Middle Aged,ovid_export_ris.ris,Polymorphism,Promoter Regions}
}

@article{infanteSynergisticEffectTwo2010,
  title = {Synergistic Effect of Two Oxidative Stress-Related Genes (Heme Oxygenase-1 and {{GSK3$\beta$}}) on the Risk of {{Parkinson}}'s Disease},
  author = {Infante, J and {Garc{\'i}a-Gorostiaga}, I and {S{\'a}nchez-Juan}, P and Sierra, M and {Mart{\'i}n-Gurpegui}, J L and Terrazas, J and Mateo, I and {Rodr{\'i}guez-Rodr{\'i}guez}, E and Berciano, J and Combarros, O},
  year = {2010},
  month = may,
  journal = {Eur. J. Neurol.},
  volume = {17},
  number = {5},
  pages = {760--762},
  publisher = {Wiley},
  address = {United Kingdom},
  abstract = {BACKGROUND: Oxidative stress is a central factor in the pathogenesis of Parkinson's disease (PD). Heme oxygenase-1 (HO-1) is an antioxidant protein expressed in response to oxidative challenge, and its expression levels are inversely correlated with glycogen synthase kinase-3beta (GSK3beta) activity. Underexpression of HO-1 in concert with an upregulation of GSK3beta would result in a less effective antioxidant response and might increase the risk of PD. METHODS: We examined two functional polymorphism in the promoter regions of HO-1 (-413, rs2071746) and GSK3beta (-157, rs6438552) in a group of 251 Spanish patients with PD and 234 controls. RESULTS: Subjects carrying both the HO-1 (-413, rs2071746) TT genotype and the GSK3beta (-157, rs6438552) TT genotype had a four times higher risk of developing PD than subjects without these genotypes (adjusted by age and sex OR = 4.12; 95\% CI = 1.45-11.71; Bonferroni corrected P = 0.024). CONCLUSIONS: Considering synergistic effects between polymorphisms in oxidative stress-related genes may help in determining the risk profile for PD.},
  langid = {english},
  keywords = {*Genetic Predisposition to Disease/ge [Genetics],*Glycogen Synthase Kinase 3/ge [Genetics],*Heme Oxygenase-1/ge [Genetics],*Oxidative Stress/ge [Genetics],*Parkinson Disease/en [Enzymology],*Parkinson Disease/ge [Genetics],80 and over,Adult,Aged,Cohort Studies,Female,Gene Frequency/ge [Genetics],Genetic/ge [Genetics],Genotype,Glycogen Synthase Kinase 3 beta,Humans,Male,Middle Aged,ovid_export_ris.ris,Polymorphism,Promoter Regions,Risk Assessment}
}

