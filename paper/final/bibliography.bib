@article{ibukiMicrosatellitePolymorphismHeme2018,
  title = {Microsatellite Polymorphism in the {{Heme}} Oxygenase-1 Gene Promoter Is Associated with Dermal Collagen Density in {{Japanese}} Obese Male Subjects},
  author = {Ibuki, Ai and Minematsu, Takeo and Yoshida, Mikako and Iizaka, Shinji and Matsumoto, Masaru and Sugama, Junko and Sanada, Hiromi},
  year = {2018},
  month = jul,
  journal = {PLoS One},
  volume = {13},
  number = {7},
  pages = {e0199994},
  publisher = {Public Library of Science (E-mail: plos@plos.org)},
  address = {United States},
  abstract = {We previously reported elevated oxidative stress-related mechanical vulnerabilities of the skin as sparse distributions of hyperechoic areas. Although this helped establish a personalized skin care system to prevent skin disorders related to mechanical stress, obesity-related skin vulnerability involves individual differences. Here, we hypothesized that individual differences are caused by polymorphisms of GT repetitive sequences in the heme oxygenase1 (HMOX1) promoter region, which encodes an antioxidant enzyme. This cross-sectional study enrolled healthy male volunteers in a walking classroom aimed at weight control. Subjects with a body mass index {$<$}25 kg/m2 were classified as non-obese and those with body mass index {\textbackslash}geq25 kg/m2 were classified as obese. Subject skin was categorized into sparse dermis or normal groups according to the distribution of hyperechoic areas by high-resolution skin ultrasonography (20 MHz). Genomic DNA and mRNA extracted from three body hairs with attached follicle cells were used to analyze GT repetitive sequences of the HMOX1 promoter, HMOX1 mRNA expression levels, and oxidative stress levels (8-hydroxy-2'-deoxyguanosine). Classifications of GT repetitive sequence of HMOX1 promoter were Short ({$<$}27 times) and Long ({\textbackslash}geq27 times). Higher numbers of subjects with sparse dermis were in the obese group compared with the non-obese group. In obese subjects, the number of subjects that had the Long allele of the HMOX1 promoter with sparse dermis was significantly higher compared with the normal group, whereas no association was observed between the polymorphism and ultrasonographic features in non-obese subjects. Thus, HMOX1 polymorphisms detected a risk of low collagen density in Japanese obese male subjects.},
  langid = {english},
  keywords = {*collagen/ec [Endogenous Compound],*genetic association,*genetic polymorphism,*heme oxygenase 1/ec [Endogenous Compound],*Hmox1 gene,*microsatellite DNA/ec [Endogenous Compound],*obesity,*promoter region,8 hydroxydeoxyguanosine,adult,allele,article,body mass,body weight control,clinical article,controlled study,cross sectional study,disease classification,echography,enzyme activity,gene expression,gene frequency,gene sequence,genetic risk,genomic DNA/ec [Endogenous Compound],genomics,genotype,hair follicle cell,human,human cell,Japanese (people),male,messenger RNA/ec [Endogenous Compound],microsatellite marker,ovid_export_ris.ris,oxidative stress,reference value,reverse transcription polymerase chain reaction,RNA extraction,volunteer,waist circumference,walking}
}

@article{Ichikawa2007-mw,
  title = {A Homozygous Missense Mutation in Human {{KLOTHO}} Causes Severe Tumoral Calcinosis},
  author = {Ichikawa, Shoji and Imel, Erik A and Kreiter, Mary L and Yu, Xijie and Mackenzie, Donald S and Sorenson, Andrea H and Goetz, Regina and Mohammadi, Moosa and White, Kenneth E and Econs, Michael J},
  year = {2007},
  journal = {The Journal of clinical investigation},
  volume = {117},
  number = {9},
  pages = {2684--2691},
  publisher = {Department of Medicine, Indiana University School of Medicine, Indianapolis, Indiana 46202-5121, USA.},
  address = {United States},
  abstract = {Familial tumoral calcinosis is characterized by ectopic calcifications and hyperphosphatemia due to inactivating mutations in FGF23 or UDP-N-acetyl-alpha-D-galactosamine:polypeptide N-acetylgalactosaminyltransferase 3 (GALNT3). Herein we report a homozygous missense mutation (H193R) in the KLOTHO (KL) gene of a 13-year-old girl who presented with severe tumoral calcinosis with dural and carotid artery calcifications. This patient exhibited defects in mineral ion homeostasis with marked hyperphosphatemia and hypercalcemia as well as elevated serum levels of parathyroid hormone and FGF23. Mapping of H193R mutation onto the crystal structure of myrosinase, a plant homolog of KL, revealed that this histidine residue was at the base of the deep catalytic cleft and mutation of this histidine to arginine should destabilize the putative glycosidase domain (KL1) of KL, thereby attenuating production of membrane-bound and secreted KL. Indeed, compared with wild-type KL, expression and secretion of H193R KL were markedly reduced in vitro, resulting in diminished ability of FGF23 to signal via its cognate FGF receptors. Taken together, our findings provide what we believe to be the first evidence that loss-of-function mutations in human KL impair FGF23 bioactivity, underscoring the essential role of KL in FGF23-mediated phosphate and vitamin D homeostasis in humans.},
  keywords = {*Calcinosis/ge [Genetics],*Calcinosis/pa [Pathology],*Glucuronidase/me [Metabolism],*Homozygote,*Mutation,*Neoplasms/ge [Genetics],*Neoplasms/pa [Pathology],Adolescent,Amino Acid Sequence,Animals,Base Sequence,Calcinosis/me [Metabolism],Cell Line,Crystallography,Female,Fibroblast Growth Factors/me [Metabolism],Glucuronidase/ch [Chemistry],Glucuronidase/ge [Genetics],Humans,Mendeley Import (Dec 08),Missense/ge [Genetics],Models,Molecular,Molecular Sequence Data,Neoplasms/me [Metabolism],Protein,Protein Binding,Protein Structure,Sequence Alignment,Signal Transduction,Structural Homology,Tertiary,X-Ray}
}

