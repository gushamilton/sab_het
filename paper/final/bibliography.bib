@article{curjuricHMOX1GSTVariants2010,
  title = {{{HMOX1}} and {{GST}} Variants Modify Attenuation of {{FEF25}}--75\% Decline Due to {{PM10}} Reduction},
  author = {Curjuric, I and Imboden, M and Schindler, C and Downs, S H and Hersberger, M and Liu, S L J and Matyas, G and Russi, E W and Schwartz, J and Thun, G A and Rochat, T and {Probst-Hensch}, N M},
