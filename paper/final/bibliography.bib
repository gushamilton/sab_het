  author = {Gaitanidis, Apostolos and Kaafarani, Haytham M A and Christensen, Mathias A and Breen, Kerry and Mendoza, April and Fagenholz, Peter J and Velmahos, George C and Farhat, Maha R},
  year = {2021},
