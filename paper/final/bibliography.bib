@article{Ansari1989-ev,
  title = {Human Immune Responsiveness to {{Lolium}} Perenne Pollen Allergen {{Lol}} p {{III}} (Rye {{III}}) Is Associated with {{HLA-DR3}} and {{DR5}}},
  author = {Ansari, A A and Freidhoff, L R and Meyers, D A and Bias, W B and Marsh, D G},
  year = {1989},
  month = may,
  journal = {Human Immunology},
  volume = {25},
  number = {1},
  pages = {59--71},
  abstract = {A well-characterized allergen of Lolium perenne (perennial rye grass) pollen, Lol p III, has been used as a model antigen to study the genetic control of the human immune response. Associations between HLA type and IgE or IgG antibody (Ab) responsiveness to Lol p III were studied in two groups of skin-test-positive Caucasoid adults (N = 135 and 67). We found by nonparametric and parametric analyses that immune responsiveness to Lol p III was significantly associated with HLA-DR3 and DR5. No association was found between any DQ type and immune responsiveness to Lol p III. Geometric mean IgE or IgG Ab levels to Lol p III were not different between B8+, DR3+ subjects and B8-, DR3+ subjects, showing that HLA-B8 had no influence on the association. Lol p III IgG Ab data obtained on subjects after grass antigen immunotherapy showed that 100\% of DR3 subjects and 100\% of DR5 subjects were Ab+. A comparison of all the available protein sequences of DRB gene products showed that the first hypervariable region of DR3 and DR5 (and DRw6), and no other region, contains the sequence Glu9-Tyr-Ser-Thr-Ser13. Our observations are consistent with the possibility that immune responsiveness to the allergen Lol p III is associated with this amino acid sequence in the first hypervariable region of the DR beta 1 polypeptide chain.},
  langid = {english}
}

@article{ansariGenometogenomeAnalysisHighlights2017,
  title = {Genome-to-Genome Analysis Highlights the Effect of the Human Innate and Adaptive Immune Systems on the Hepatitis {{C}} Virus},
  author = {Ansari, M Azim and Pedergnana, Vincent and L C Ip, Camilla and Magri, Andrea and Von Delft, Annette and Bonsall, David and Chaturvedi, Nimisha and Bartha, Istvan and Smith, David and Nicholson, George and McVean, Gilean and Trebes, Amy and Piazza, Paolo and Fellay, Jacques and Cooke, Graham and Foster, Graham R and {STOP-HCV Consortium} and Hudson, Emma and McLauchlan, John and Simmonds, Peter and Bowden, Rory and Klenerman, Paul and Barnes, Eleanor and Spencer, Chris C A},
  year = {2017},
  month = may,
  journal = {Nat. Genet.},
  volume = {49},
  number = {5},
  pages = {666--673},
  abstract = {Outcomes of hepatitis C virus (HCV) infection and treatment depend on viral and host genetic factors. Here we use human genome-wide genotyping arrays and new whole-genome HCV viral sequencing technologies to perform a systematic genome-to-genome study of 542 individuals who were chronically infected with HCV, predominantly genotype 3. We show that both alleles of genes encoding human leukocyte antigen molecules and genes encoding components of the interferon lambda innate immune system drive viral polymorphism. Additionally, we show that IFNL4 genotypes determine HCV viral load through a mechanism dependent on a specific amino acid residue in the HCV NS5A protein. These findings highlight the interplay between the innate immune system and the viral genome in HCV control.},
  langid = {english},
  keywords = {mandel}
}

