@article{tairaImprovementHemeOxygenase1based2015,
  title = {Improvement of Heme Oxygenase-1-Based Heme Sensor for Quantifying Free Heme in Biological Samples},
  author = {Taira, Junichi and Nakashima, Yukinori and Yoshihara, Shun and Koga, Shinya and Sueda, Shinji and Komatsu, Hideyuki and Higashimoto, Yuichiro and Takahashi, Toru and Tanioka, Nohito and Shimizu, Hiroko and Morimatsu, Hiroshi and Sakamoto, Hiroshi},
  year = {2015},
  month = nov,
  journal = {Anal. Biochem.},
  volume = {489},
  pages = {50--52},
  publisher = {Academic Press Inc. (E-mail: apjcs@harcourt.com)},
  address = {United States},
  abstract = {We recently reported a novel heme sensor using fluorescently labeled heme oxygenase-1; however, its inherent enzyme activity would be a potential obstacle in quantifying heme in biological samples. Here, we found that mutation of the catalytically important residue, Asp140, with histidine in the sensor not only diminished the heme degradation activity but also increased heme binding affinity. The sensor with a visible fluorophore was also found to be beneficial to avoid background emission from endogenous substance in biological samples. By using the improved heme sensor, we succeeded in quantifying free heme in rat hepatic samples for the first time.},
  langid = {english},
  keywords = {*Fluorescent Dyes/ch [Chemistry],*Heme Oxygenase (Decyclizing)/me [Metabolism],*Heme/an [Analysis],*Microsomes,*Mutant Proteins/me [Metabolism],*Rhodamines/ch [Chemistry],*Sulfonic Acids/ch [Chemistry],Acetates/ch [Chemistry],Amino Acid Substitution,Animals,Biological sample,Biosensing Techniques,Catalytic Domain,Chromones/ch [Chemistry],Cysteine/ch [Chemistry],Fluorescence,Fluorescent labeling,Free heme,Heme degradation,Heme Oxygenase (Decyclizing)/ch [Chemistry],Heme Oxygenase (Decyclizing)/ge [Genetics],Heme oxygenase-1,Heme/me [Metabolism],Hydrolysis,Japan,Kinetics,Liver/me [Metabolism],Mutant Proteins/ch [Chemistry],ovid_export_ris.ris,Peptide Fragments,Rats,Recombinant Proteins/ch [Chemistry],Recombinant Proteins/me [Metabolism],Spectrometry,Spectrophotometry,Titrimetry,Ultraviolet}
