@article{mozzoniHemeOxygenase12005,
  title = {{[Heme oxygenase 1 expression in foundry workers]}},
  author = {Mozzoni, P and De Palma, G and Scotti, E and Andreoli, R and Folesani, G and Maninil, P and Apostoli, P and Mutti, A},
  year = {2005},
  journal = {G. Ital. Med. Lav. Ergon.},
  volume = {27},
  number = {3},
  pages = {322--325},
  publisher = {Tipografia PI-ME Editrice Srl (Via Vigentina 136, Pavia 27100, Italy)},
  address = {Italy},
  abstract = {Heme oxygenase 1 (HO-1) catalyses the oxidation of heme to biliverdin, and its expression is induced by oxidative stress. This study was aimed at assessing the role of metabolic polymorphisms (CYP1A1, CYP1B1, GSTM1, GSTP1, EPHX) in the modulation of HO-1 gene expression in 37 foundry workers. Blood and urine samples were obtained at the beginning (BS) and at the end (ES) of work shift, in February (T1) and June (T2). Urinary 1-hydroxypyrene (1-OHP) was measured as a tracer of PAH exposure. HO-1 gene expression in ES samples normalized to BS values (HO-1 ES/BS) was higher at T2 respect to T1. HO-1 gene induction was related to ES 1-OHP when considering either T2 samples or the combination of the two samplings. HO-1 ES/BS was significantly increased in subjects with at least a mutant allele for GSTP1 as compared to subjects with GSTP1AA genotype (1.23 +/- 0.002 vs 0.88 +/- 0.002, p {$<$} 0.05). Only in subjects with at least one vari.nt allele for GSTP1, a positive correlation between HO-1 ET/IT expression and 1-OHP FT levels was observed (r2 = 0.21, p = 0.016). The present study demonstrates a correlation between PAH exposure, as assessed by urinary 1-OHP, and the induction of HO-1 expression. Such a correlation seems to be limited to subjects bearing variant alleles for GSTP1. At the same exposure levels, these subjects showed a greater expression of HO-1 FT as compared to subjects with GSTP1 wild type genotype, possibly due to a higher oxidative stress in the subjects expressing the mutant GSTP1-1 isoform, which could imply a limited scavenging capacity.},
  langid = {italian},
  keywords = {*foundry,*heme oxygenase 1/ec [Endogenous Compound],*oxidative stress,1 hydroxypyrene/ec [Endogenous Compound],allele,biliverdin/ec [Endogenous Compound],clinical article,conference paper,cytochrome P450 1A1/ec [Endogenous Compound],cytochrome P450 1B1/ec [Endogenous Compound],epoxide hydrolase/ec [Endogenous Compound],gene expression,gene induction,genetic polymorphism,genotype,glutathione transferase M1/ec [Endogenous Compound],glutathione transferase P1/ec [Endogenous Compound],glutathione transferase/ec [Endogenous Compound],heme/ec [Endogenous Compound],human,ovid_export_ris.ris,oxidation,polycyclic aromatic hydrocarbon,unclassified drug}
}

@article{Mu2019-ww,
  title = {Reconstruction of the Genomes of {{Drug-Resistant}} Pathogens for Outbreak Investigation through Metagenomic Sequencing},
  author = {Mu, Andre and Kwong, Jason C and Isles, Nicole S and {Gon{\c c}alves da Silva}, Anders and Schultz, Mark B and Ballard, Susan A and Lane, Courtney R and Carter, Glen P and Williamson, Deborah A and Seemann, Torsten and Stinear, Timothy P and Howden, Benjamin P},
  year = {2019},
  month = jan,
  journal = {mSphere},
  volume = {4},
  number = {1},
  abstract = {Culture-independent methods that target genome fragments have shown promise in identifying certain pathogens, but the holy grail of comprehensive pathogen genome detection from microbiologically complex samples for subsequent forensic analyses remains a challenge. In the context of an investigation of a nosocomial outbreak, we used shotgun metagenomic sequencing of a human fecal sample and a neural network algorithm based on tetranucleotide frequency profiling to reconstruct microbial genomes and tested the same approach using rectal swabs from a second patient. The approach rapidly and readily detected the genome of Klebsiella pneumoniae carbapenemase (KPC)-producing K. pneumoniae in the patient fecal specimen and in the rectal swab sample, achieving a level of strain resolution that was sufficient for confident transmission inference during a highly clonal outbreak. The analysis also detected previously unrecognized colonization of the patient by vancomycin-resistant Enterococcus faecium, another multidrug-resistant bacterium.IMPORTANCE The study results reported here perfectly demonstrate the power and promise of clinical metagenomics to recover genome sequences of important drug-resistant bacteria and to rapidly provide rich data that inform outbreak investigations and treatment decisions, independently of the need to culture the organisms.},
  langid = {english},
  keywords = {antimicrobial resistance,Klebsiella pneumoniae,Mendeley Import (Dec 08),metagenomics,microbiome,vancomycin-resistant enterococci}
}

@unpublished{muBootRangesFlexibleGeneration2022,
  title = {{{bootRanges}}: {{Flexible}} Generation of Null Sets of Genomic Ranges for Hypothesis Testing},
  author = {Mu, Wancen and Davis, Eric and Lee, Stuart and Dozmorov, Mikhail and Phanstiel, Douglas H and Love, Michael I},
  year = {2022},
  month = sep,
  journal = {bioRxiv},
  abstract = {bootRanges provides fast functions for generation of bootstrapped genomic ranges representing the null sets in enrichment analysis. We show that shuffling or permutation schemes may result in overly narrow test statistics null distributions, while creating new ranges sets with a block bootstrap preserves local genomic correlation structure and generates more reliable null distributions. It can also be used in more complex analyses, such as accessing correlations between cis-regulatory elements (CREs) and genes across cell types or providing optimized thresholds, e.g. log fold change (logFC) from differential analysis. The bootRanges functions are available in the R/Bioconductor package nullranges at . \#\#\# Competing Interest Statement The authors have declared no competing interest.},
  langid = {english}
}

@article{muckenthalerm.FourthCongressInternational2011,
  title = {Fourth Congress of the International {{BioIron}} Society ({{IBIS}}) Biennial World Meeting ({{BioIron}} 2011) May 22 - 26, 2011 {{Sheraton Vancouver}} Wall Centre Hotel {{Vancouver}}, {{BC}}, {{Canada}}},
  author = {{Muckenthaler M.} and {Greil J.} and {Verga-Falzacappa M.} and {Echner N.} and {Behnisch W.} and {Immenschuh S.} and {Balla J.} and {Tsukahara H.} and {Schneider M.} and {Janka G.} and {Claus M.} and {Longerich T.} and {Heimpel H.} and {Kulozik A.}},
  year = {2011},
  month = sep,
  journal = {Am. J. Hematol.},
  volume = {86},
  number = {9},
  pages = {E1--E150},
  publisher = {Wiley},
  abstract = {Brain iron is increased in many types of neurodegeneration including stroke, intracerebral hemorrhage and Alzheimer's disease (AD). The heme-binding protein hemopexin has been shown to protect the brain from heme toxicity in mice models of stroke and ICH. In stroke, this is in part via the induction and activity of heme oxygenase-1. Dysfunction of the regulation of the amyloid precursor protein (APP) in neurons is known to be a major contributing factor to the pathogenesis of AD. Importantly, recent evidence supports that APP expression is inextricably linked with iron homeostasis in human neuroblastoma cells, considered good models of human neurons. Human APP is induced by iron in models of human neurons via an iron-responsive element (IRE) in the 5'UTR of hAPP mRNA; APP is a ferroxidase required for export of potentially toxic iron; and there is a reciprocal relationship between the expression of APP and that of the iron transporter DMT1, e.g. overexpression of APP with the Swedish mutation increases DMT1 levels. The hemopexin heme transport system is known to link heme and iron metabolism. Here, we use heme-hemopexin as a model of microbleeds in aging brain. We have investigated the effects of heme catabolism, which releases iron intracellularly, on the regulation of hAPP expression after endocytosis of heme-hemopexin complexes by human neuroblastoma SHSY5Y cells. hAPP is induced ca.2-fold when SHSY5Y cells are incubated with heme-hemopexin (10-25microM) and ca.1.6-fold by ferric ammonium citrate (300microM) for up to 17h. Additional experiments using desferal, an iron chelator, and 5'IRE constructs of hAPP provide evidence that iron and the IRE are needed for APP regulation by heme-hemopexin. The effects of heme and activation of signaling pathways on APP metabolism is also being investigated. Furthermore, heme-hemopexin is shown to be stable in the presence of reactive oxygen species and to retain its biological, protective function. This contrasts with the susceptibility of the hemoglobin-haptoglobin complex. We conclude that heme and its iron are required for hAPP induction by heme-hemopexin. The APP-IRE is a strong candidate site for translational regulation by heme-hemopexin. Hemopexin protects neurons from heme toxicity and oxidative stress, and the brain in a mouse stroke model. hAPP has a region that is similar to the ferroxidase site of ferritin and has ferroxidase activity. We therefore propose that since neurons normally express low levels of ferritin, ferroxidase activity provided by APP for iron export and transferrin loading is an additional important means of cyto-protection by heme-hemopexin in the short-term for brain neurons.},
  langid = {english},
  keywords = {*brain nerve cell,*hemopexin,*homeostasis,*iron,*neuroprotection,*society,aging,Alzheimer disease,amyloid precursor protein,binding protein,brain,brain hemorrhage,catabolism,ceruloplasmin,chelating agent,deferoxamine mesylate,endocytosis,ferric ammonium citrate,ferritin,haptoglobin,heme,heme oxygenase 1,hemoglobin,human,iron metabolism,iron responsive element,messenger RNA,metabolism,model,mouse,mutation,nerve cell,nerve degeneration,neuroblastoma,neuroblastoma cell,ovid_export_ris.ris,oxidative stress,pathogenesis,protection,reactive oxygen metabolite,stroke,toxicity,transferrin}
}

@article{muckenthalerRedCarpetIron2017,
  title = {A {{Red Carpet}} for {{Iron Metabolism}}},
  author = {Muckenthaler, Martina U and Rivella, Stefano and Hentze, Matthias W and Galy, Bruno},
  year = {2017},
  month = jan,
  journal = {Cell},
  volume = {168},
  number = {3},
  pages = {344--361},
  publisher = {Elsevier BV},
  abstract = {200 billion red blood cells (RBCs) are produced every day, requiring more than 2 {\textbackslash}times 1015 iron atoms every second to maintain adequate erythropoiesis. These numbers translate into 20 mL of blood being produced each day, containing 6 g of hemoglobin and 20 mg of iron. These impressive numbers illustrate why the making and breaking of RBCs is at the heart of iron physiology, providing an ideal context to discuss recent progress in understanding the systemic and cellular mechanisms that underlie the regulation of iron homeostasis and its disorders.},
  copyright = {https://www.elsevier.com/open-access/userlicense/1.0/},
  langid = {english}
}

@article{Mudde1987-rc,
  title = {Ectopic Production of 1,25-Dihydroxyvitamin {{D}} by {{B-cell}} Lymphoma as a Cause of Hypercalcemia},
  author = {Mudde, A H and {van den Berg}, H and Boshuis, P G and Breedveld, F C and Markusse, H M and Kluin, P M and Bijvoet, O L and Papapoulos, S E},
  year = {1987},
  journal = {Cancer},
  volume = {59},
  number = {9},
  pages = {1543--1546},
  address = {UNITED STATES},
  abstract = {A patient with long-standing rheumatoid arthritis developed hypercalcemia (3.13 mmol/l) and was subsequently found to have a B-cell lymphoma (centroblastic type). The hypercalcemia was associated with high circulating concentrations of 1,25-dihydroxyvitamin D (235 pmol/l) and both abnormalities were corrected with treatment. A lymph node was excised before treatment and was incubated in vitro with either labeled or unlabeled 25-hydroxyvitamin D3. After purification of the extract and chromatography on three different HPLC systems, material comigrating with authentic 1,25-dihydroxyvitamin D3 was identified. This was shown to bind to a specific chick intestinal cytosol receptor and to dilute in parallel with synthetic 1,25-dihydroxyvitamin D3 in the receptor binding assay. In conclusion, hypercalcemia in malignant B-cell lymphoma can be due to extrarenal production of 1,25-dihydroxyvitamin D by lymphomatous tissue.},
  keywords = {*Calcitriol/bi [Biosynthesis],*Hormones,*Hypercalcemia/et [Etiology],*Lymphoma,Arthritis,B-Lymphocytes,Ectopic/bi [Biosynthesis],Humans,Lymphoma,Male,Mendeley Import (Dec 08),Middle Aged,Non-Hodgkin/co [Complications],Non-Hodgkin/me [Metabolism],Rheumatoid/co [Complications]}
}

