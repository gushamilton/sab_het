@article{ozenHemeOxygenase1Deficiency2018,
  title = {Heme Oxygenase-1 Deficiency Results in Splenic {{T-cell}} Dysregulation in Offspring of Mothers Exposed to Late Gestational Inflammation},
  author = {Ozen, Maide and Zhao, Hui and Kalish, Flora and Yang, Yang and Folkins, Ann and Burd, Irina and Wong, Ronald J and Stevenson, David K},
  year = {2018},
  month = may,
  journal = {Am. J. Reprod. Immunol.},
  volume = {79},
  number = {5},
  pages = {e12829},
  address = {Denmark},
  abstract = {PROBLEM: Infection during pregnancy can disrupt regulatory/effector immune system balance, resulting in adverse pregnancy and fetal-neonatal outcomes. Heme oxygenase-1 (HO-1) is a major regulatory enzyme in the immune system. We observed maternal immune response dysregulation during late gestational inflammation (LGI), which may be mediated by HO-1. Here, we extend these studies to examine the immune response of offspring. METHOD OF STUDY: Pregnant wild-type (Wt) and HO-1 heterozygote (Het) dams were treated with lipopolysaccharide (LPS) or vehicle at E15.5. Pups' splenic immune cells were characterized using flow cytometry. RESULTS: CD3+ CD4+ CD25+ (Tregs) and CD3+ CD8+ (Teffs) T cells in Wt and Het were similar in control neonates and increased with age. We showed not only age- but also genotype-specific and long-lasting T-cell dysregulation in pups after maternal LGI. The persistent immune dysregulation, mediated by HO-1 deficiency, was reflected as a decrease in Treg FoxP3 and CD3+ CD8+ T cells, and an increase in CD4+ /CD8+ T-cell and Treg/Teff ratios in Hets compared with Wt juvenile mice after maternal exposure to LGI. CONCLUSION: Maternal exposure to LGI can result in dysregulation of splenic T cells in offspring, especially in those with HO-1 deficiency. We speculate that these immune alterations are the basis of adverse outcomes in neonates from mothers exposed to low-grade (subclinical) infections.},
  langid = {english},
  keywords = {*CD4-Positive T-Lymphocytes/im [Immunology],*CD8-Positive T-Lymphocytes/im [Immunology],*Heme Oxygenase-1/df [Deficiency],*Infant,*Inflammation/im [Immunology],*Pregnancy Complications/im [Immunology],*Spleen/im [Immunology],CD4-Positive T-Lymphocytes/me [Metabolism],CD8-Positive T-Lymphocytes/me [Metabolism],Diseases/im [Immunology],Diseases/me [Metabolism],Female,Fetal Diseases/im [Immunology],Fetal Diseases/me [Metabolism],heme oxygenase-1,Humans,Infant,Inflammation/me [Metabolism],maternal inflammation,Mother-Child Relations,neonatal immune response,Newborn,ovid_export_ris.ris,Pregnancy,Pregnancy Complications/me [Metabolism],Regulatory/im [Immunology],Regulatory/me [Metabolism],Spleen/me [Metabolism],T-Lymphocytes}
}

@article{ozenm.HemeOxygenase1Deficiency2018,
  title = {Heme Oxygenase-1 Deficiency Results in t-Cell Dysregulation in Offspring of Mothers Exposed to Late Gestational Inflammation},
  author = {{Ozen M.} and {Zhao H.} and {Kalish F.} and {Yang Y.} and {Wong R.J.} and {Stevenson D.K.}},
  year = {2018},
  journal = {Reprod. Sci.},
  volume = {25},
  number = {1},
  pages = {248A--249A},
  publisher = {SAGE Publications Inc.},
  address = {Netherlands},
  abstract = {INTRODUCTION: Maternal infection during pregnancy can result in adverse fetal and neonatal outcomes. An imbalance of regulatory and effector immune cells is implicated in a number of diseases including pregnancy-related complications. Heme-oxygenase-1 (HO-1) is a major regulatory enzyme in innate and adaptive immune systems. Previously, we have shown a dysregulation of maternal immune cell response in our model of late gestational inflammation that may be mediated by HO-1. Here, we extend these studies to examine the immune response of offspring using this model. METHOD(S): Pregnant wildtype (Wt) and HO-1 heterozygote (HO-1 Het) dams were injected IP with lipopolysaccharide (LPS, E. coli, 90 mug/kg) at E15.5 and monitored for signs of systemic infection. After delivery, pups were genotyped and sacrificed at PN12 and PN25. Spleens were harvested and immune cell populations identified using flow cytometry. Genotype-and age-matched pups from untreated dams served as controls. RESULT(S): In pups from control Wt and HO-1 Het dams, percentages of CD3+CD4+CD25+ T cells (Tregs) and CD3+CD8+ T cells were comparable between Wt (n=12) and HO-1 Het (n=6) spleens at PN12, and significantly increased at PN25 in both genotypes (Wt: n=6; HO-1 Het: n=7), but was more pronounced in Wt spleens. In pups from LPS-treated dams (Wt-LPS, HO-1 Het-LPS), Tregs and CD3+CD8+ T cells significantly increased in both Wt-LPS (n=8) and HO-1 Het-LPS (n=4) spleens, while FoxP3 expression decreased at PN12 compared to genotype-matched controls. At PN25, Wt-LPS (n=5) spleens had significantly less Tregs and CD3+CD8+ T cells compared to age-matched Wt controls; while in HO-1 Het-LPS (n=3) spleens, CD3+CD8+ T cells significantly decreased but Tregs were similar compared to age-matched Het controls and Wt pups from LPS treated dams. However, at PN25, FoxP3 expression was significantly decreased in HO-1 Het-LPS compared to Wt-LPS. CONCLUSION(S): We have demonstrated that maternal exposure to late gestational inflammation can result in a dysregulation of T cells in offspring, and to a greater degree in those with a deficiency of HO-1. We speculate that these immune alterations are the basis of adverse outcomes in neonates from mothers exposed to low-grade (subclinical) infections.},
  keywords = {*CD4+ CD25+ T lymphocyte,*heme oxygenase 1,*mother,*progeny,*sepsis,adult,adverse outcome,animal cell,animal experiment,animal model,asymptomatic infection,CD3 antigen,CD8+ T lymphocyte,cell population,conference abstract,controlled study,endogenous compound,female,flow cytometry,genetic association,genotype,heterozygote,immunocompetent cell,intraperitoneal drug administration,lipopolysaccharide,maternal exposure,newborn,nonhuman,outcome assessment,ovid_export_ris.ris,pregnancy,regulatory T lymphocyte,spleen,transcription factor FOXP3}
}

@article{ozonoAssessmentOxidativeStress2007,
  title = {{[Assessment of oxidative stress in patients with atherosclerosis focusing on heme oxygenase]}},
  author = {Ozono, Ryoji and Brydun, Andrei and Watari, Yuichiro and Yamamoto, Yoshimasa and Ohshima, Tetsuya},
  year = {2007},
  month = aug,
  journal = {Rinsho Byori},
  volume = {55},
  number = {8},
  pages = {758--763},
  address = {Japan},
  abstract = {Excessive oxidative stress plays an important role in the mechanism of atherosclerosis. An increased level of reactive oxygen speices (ROS) within the vascular endothelium eventually impedes the vasodilatative and cytoprotective actions of nitric oxide (NO). Such a condition is considered to be an early feature of atherosclerosis, and is physiologically detectable as a decrease in endothelium-dependent vasodilatation. Increased intracellular ROS levels are involved in the mechanisms of hypertension, diabetes, and hyperlipidemia, all of which are major risk factors of atherosclerosis; therefore, the assessment of ``oxidative status'' is obviously relevant to clinical medicine. However, most of the currently available clinical tests just measure oxidized waste. Considering that the ROS level is determined by the balance between production and elimination, assessment of the ability to eliminate ROS may be a major determinant of the oxidative state and may be useful to assess individual susceptibility to atherosclerotic diseases. Focusing on heme oxygenase (HO)-1, one of the major stress defense mechanisms, we found that the capacity to upregulate HO-1 mRNA is tightly associated with the severity of coronary artery disease. Furthermore, individual differences in stress-induced HO-1 levels were determined by HO-1 gene polymorphism. We propose that clinical use of the HO-1 expression profile as a measure of tolerability against oxidative stress may be relevant in the early diagnosis of atherosclerotic diseases.},
  langid = {japanese},
  keywords = {*Arteriosclerosis/me [Metabolism],*Heme Oxygenase (Decyclizing)/me [Metabolism],*Oxidative Stress/ph [Physiology],Animals,Arteriosclerosis/di [Diagnosis],Humans,ovid_export_ris.ris}
}

@article{Ozturk2008-co,
  title = {Solid Pseudopapillary Tumor of the Pancreas as a Cause of Recurrent Pancreatitis},
  author = {Ozturk, Y and Soylu, O Bekem and Gurcu, B and Ortac, R and Cakmakci, H and Coker, A},
  year = {2008},
  journal = {Acta gastro-enterologica Belgica},
  volume = {71},
  number = {4},
  pages = {390--392},
  publisher = {Dokuz Eylul University Faculty of Medicine, Department of Pediatrics, Inciralti 35340, Izmir, Turkey.},
  address = {Belgium},
  abstract = {Solid pseudopapillary tumor (SPT) of the pancreas is a rare pancreatic tumor mostly seen in young women. We here report a twelve-year-old girl presenting with recurrent attacks of pancreatitis. No history of a systemic disease, trauma, drug usage or infection was present. All other etiologic factors like familial, hypertriglyceridemia, hypercalcemia, cystic fibrosis, medications were excluded. On abdominal ultrasound a heterogeneous mass was noticed at the tail of pancreas. Computerized tomography and magnetic resonance imaging proved that the mass was cystic. The mass was surgically removed. The diagnosis was pancreatic solid cystic papillary epithelial neoplasm. Although acute pancreatitis due to SPT was exceptionally reported, this is the first description of SPT leading to recurrent pancreatitis especially in children.},
  keywords = {*Cystadenoma,*Pancreatic Neoplasms/pa [Pathology],*Pancreatitis/et [Etiology],Child,Cystadenoma,Female,Humans,Mendeley Import (Dec 08),Pancreatic Neoplasms/su [Surgery],Pancreatitis/pa [Pathology],Pancreatitis/su [Surgery],Papillary/pa [Pathology],Papillary/su [Surgery],Recurrence}
}

