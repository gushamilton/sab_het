@article{wangProtectiveEffectsLowdose2008,
  title = {Protective Effects of Low-Dose Carbon Monoxide against Renal Fibrosis Induced by Unilateral Ureteral Obstruction},
  author = {Wang, Lin and Lee, Ji-Yang Sophie and Kwak, Joon Hyeok and He, Yanjuan and Kim, Sung Il and Choi, Mary E},
  year = {2008},
  month = mar,
  journal = {Am. J. Physiol. Renal Physiol.},
  volume = {294},
  number = {3},
  pages = {F508--17},
  publisher = {American Physiological Society (9650 Rockville Pike, Bethesda MD 20814-3991, United States)},
  address = {United States},
  abstract = {Tubulointerstitial fibrosis is a hallmark of chronic progressive kidney disease leading to end-stage renal failure. An endogenous product of heme oxygenase activity, carbon monoxide (CO), has been shown to exert cytoprotection against tissue injury. Here, we explored the effects of exogenous administration of low-dose CO in an in vivo model of renal fibrosis induced by unilateral ureteral obstruction (UUO) and examined whether CO can protect against kidney injury. UUO in mice leads to increased extracellular matrix (ECM) deposition and tubulointerstitial fibrosis within 4 to 7 days. Kidneys of mice exposed to low-dose CO, however, had markedly reduced ECM deposition after UUO. Moreover, low-dose CO treatment inhibited the induction of alpha-smooth muscle actin (alpha-SMA) and major ECM proteins, type 1 collagen and fibronectin, in kidneys after UUO. In contrast, these anti-fibrotic effects of CO treatment were abrogated in mice carrying null mutation of Mkk3, suggesting involvement of the MKK3 signaling pathway in mediating the CO effects. Additionally, in vitro CO exposure markedly inhibited TGF-beta(1)-induced expression of alpha-SMA, collagen, and fibronectin in renal proximal tubular epithelial cells. Our findings suggest that low-dose CO exerts protective effects, via the MKK3 pathway, to inhibit development of renal fibrosis in obstructive nephropathy.},
  langid = {english},
  keywords = {*Antimetabolites/tu [Therapeutic Use],*Carbon Monoxide/tu [Therapeutic Use],*Kidney Diseases/pc [Prevention & Control],*Mitogen-Activated Protein Kinases/me [Metabolism],*Ureteral Obstruction/co [Complications],Actins/me [Metabolism],Administration,Animals,Antimetabolites/ad [Administration & Dosage],Carbon Monoxide/ad [Administration & Dosage],Collagen Type I/me [Metabolism],Epithelial Cells/me [Metabolism],Extracellular Matrix/me [Metabolism],Fibronectins/me [Metabolism],Fibrosis/et [Etiology],Fibrosis/pc [Prevention & Control],Inbred C57BL,Inhalation,Kidney Diseases/et [Etiology],Kidney Diseases/pa [Pathology],Kidney Tubules,Male,MAP Kinase Kinase 3/me [Metabolism],MAP Kinase Signaling System/ph [Physiology],Mice,ovid_export_ris.ris,Proximal/me [Metabolism],Transforming Growth Factor beta/me [Metabolism]}
}

