@article{girelliIronMetabolismInfections2021,
  title = {Iron Metabolism in Infections: {{Focus}} on {{COVID-19}}},
  author = {Girelli, Domenico and Marchi, Giacomo and Busti, Fabiana and Vianello, Alice},
  year = {2021},
  month = jul,
  journal = {Semin. Hematol.},
  volume = {58},
  number = {3},
  pages = {182--187},
  abstract = {Iron is a micronutrient essential for a wide range of metabolic processes in virtually all living organisms. During infections, a battle for iron takes place between the human host and the invading pathogens. The liver peptide hepcidin, which is phylogenetically and structurally linked to defensins (antimicrobial peptides of the innate immunity), plays a pivotal role by subtracting iron to pathogens through its sequestration into host cells, mainly macrophages. While this phenomenon is well studied in certain bacterial infections, much less is known regarding viral infections. Iron metabolism also has implications on the functionality of cells of the immune system. Once primed by the contact with antigen presenting cells, lymphocytes need iron to sustain the metabolic burst required for mounting an effective cellular and humoral response. The COVID-19 pandemic has boosted an amount of clinical and translational research over the possible influences of nutrients on SARS-CoV-2 infection, in terms of either susceptibility or clinical course. Here we review the intersections between iron metabolism and COVID-19, belonging to the wider domain of the so-called ``nutritional immunity''. A better understanding of such connections has potential broad implications, either from a mechanistic standpoint, or for the development of more effective strategies for managing COVID-19 and possible future pandemics.},
  langid = {english},
  keywords = {COVID-19,Ferritin,Hepcidin,Immunity,Iron}
}

@article{girnitadmBacterialViralInfections2009,
  title = {Bacterial and Viral Infections Are Impacted by Different Genetic Polymorphisms - a Multicenter Pediatric Heart Transplant Study},
  author = {{Girnita D M} and {Brooks M} and {Webber S} and {Burckart G} and {Ferrell R} and {Chinnock R} and {Canter C} and {Addonizio L} and {Bernstein D} and {Kirklin J} and {Naftel D} and {Girnita A L} and {Zeevi A}},
  year = {2009},
  journal = {Am. J. Transplant},
  volume = {9},
  number = {SUPPL. 2},
  pages = {196},
  publisher = {Blackwell Publishing Ltd},
  abstract = {Infections remain a leading cause of morbidity and mortality after pediatric heart transplantation (PHTX). We have previously shown that genetic polymorphisms (GP) of cytokines and growth factors impact the rejection profi le. In this study we examined the role of GP on the rate and type of infection (bacterial and viral). Method(s): 414 PHTX recipients, from six medical centers, with a mean follow-up of 5.25 years were analyzed for time to first infection and time to late infections ({$>$}60 days post-TX) using Cox regression. GP considered were: TNF-alpha?A-308G; INF-gamma?T+874A; IL-10 G-1082A; IL-4 C-590T; IL-5 T-746C; IL-6 G-174C; TGFbeta-1 T+869C, C+915G; VEGF A-2578C, C-460T, G+405C; Fas A-670G; FasL C-843T; Granzyme B A-295G, Q-55R; CTLA-4 A-49G; 60CT A/G, HO (heme oxygenaze)-1 A-326G. Result(s): One hundred and thirty patients (31.4\%) were diagnosed with at least one bacterial infection, while 150 patients (36.2\%) exhibited a viral infection. The impact of GP was adjusted for two demographic risk factors, race and age. Recipient black race was marginally associated with higher infection rates while younger age at the time of TX was a strong consistent risk factor for infection. Increased risk for viral infections was observed in carriers of CTLA-4 +49 A allele and INF-gamma?+874 A/A (low phenotype). For bacterial infections, patients who exhibited Granzyme B -295 A/A and HO-1-326 G allele had increased risk of infection (Table 1). \{Table presented\} Conclusion(s): Viral infections may be infl uenced by GP associated with adaptive immunity that negatively impact anti-viral T cell function (IFN-gamma?low and CTLA-4 high). In contrast, bacterial infection may be associated with GP that affect innate immunity such as Granzyme B (a molecule expressed also by NK and neutrophils) and HO-1 (a cytoprotective enzyme with anti-infl ammatory and anti-oxidant properties) that may impare the phagocytic activity of macrophages.},
  keywords = {*genetic polymorphism,*heart graft,*transplantation,*virus infection,adaptive immunity,allele,bacterial infection,cell function,cytokine,cytotoxic T lymphocyte antigen 4,enzyme,follow up,granzyme B,growth factor,heart transplantation,heme,infection,infection rate,innate immunity,interferon,interleukin 10,interleukin 4,interleukin 5,interleukin 6,macrophage,morbidity,mortality,Negro,neutrophil,ovid_export_ris.ris,oxidizing agent,patient,phagocytosis,phenotype,proportional hazards model,recipient,risk,risk factor,T lymphocyte,vasculotropin,vasculotropin A}
}

@article{Gislefoss2017-zo,
  title = {Effect of Multiple Freeze-Thaw Cycles on Selected Biochemical Serum Components},
  author = {Gislefoss, Randi E and Lauritzen, Marianne and Langseth, Hilde and M{\o}rkrid, Lars},
  year = {2017},
  month = jun,
  journal = {Clinical Chemistry and Laboratory Medicine},
  volume = {55},
  number = {7},
  pages = {967--973},
  abstract = {BACKGROUND: To maintain the best performance a frozen serum sample should be thawed once to prevent repeated freeze-thaw cycles. Archival biobanks often have one tube of a sample available, causing repeated freeze-thaw cycles when the sample is used in multiple research projects. In this study, we investigated potential effects of freeze-thaw cycles on several biochemical components in serum. METHODS: Serum from 40 fasting donors of both genders, aged 30-60 years, were frozen at -25 {$^\circ$}C. Aliquots of the 40 different samples went through 1, 2, 3, 4, 5 and 10 thaws, respectively. They were analyzed after 3 month of storage for 15 serum components including electrolytes and metabolites, proteins and enzymes, lipids, hormones and vitamins. One-way analyses of variance (ANOVA) with repeated measurements and equivalence tests were used to examine differences in component levels. RESULTS: Albumin, aspartate-aminotransferase (ASAT), cholesterol, creatinine, C-reactive protein, glucose, immunoglobulin G, potassium, testosterone, triglycerides, urea and vitamin B12 levels did not show significant difference for pairwise comparisons after 10 repeated thaws. Although albumin, ASAT, bilirubin, potassium, sodium, testosterone and thyroid stimulating hormone (TSH) showed overall statistically significant changes in serum levels, only bilirubin, sodium and TSH were significant for the pairwise comparisons investigated. Clinical significance were shown for albumin, ASAT, bilirubin, sodium and testosterone. CONCLUSIONS: Twelve components (albumin, ASAT, cholesterol, creatinine, C-reactive protein, glucose, immunoglobulin G, potassium, testosterone, triglycerides, urea and vitamin B12) were robust to 10 repeated thaws compared to baseline level. Three components (bilirubin, sodium and TSH) showed statistical significant difference for pairwise comparisons, however, TSH was not clinically affected.},
  langid = {english},
  keywords = {biobank,biochemical component,freeze-thaw cycles,serum}
}

