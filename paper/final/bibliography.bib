@article{siNovelMAFMissense2019,
  title = {A Novel {{MAF}} Missense Mutation Leads to Congenital Nuclear Cataract by Impacting the Transactivation of Crystallin and Noncrystallin Genes},
  author = {Si, Nuo and Song, Zixun and Meng, Xiaolu and Li, Xinru and Xiao, Wei and Zhang, Xue},
  year = {2019},
  month = apr,
  journal = {Gene},
  volume = {692},
  pages = {113--118},
  publisher = {Elsevier B.V.},
  address = {Netherlands},
  abstract = {The transcription factor v-maf avain musculoaponeurotic fibrosarcoma oncogene homolog (MAF) plays an important role in lens development. It contains a unique extended homology region (EHR) in the DNA binding domain. MAF mutations are associated with phenotypically distinct forms of congenital cataract and show different effects on the transactivation of target genes. Mutations in the MAF EHR region were rarely reported and their corresponding phenotype and impact on target genes' transactivation were not evaluated. A three- generation Chinese family with congenital cataract was recruited. The patients in the family present non-syndromic congenital nuclear and lamellar opacities. A novel MAF mutation (c.812 T {$>$} A, p.Val271Glu) was identified by targeted next-generation sequencing. The mutation is in highly conserved EHR region of MAF and co-segregates with the cataract in the family. It is predicted to be pathogenic by multiple algorithms and is absent in a control population. Dual luciferase activity assay shows the mutation significantly impair the transcriptional activity of four crystallin genes (CRYAA, CRYBA4, CRYBA1, and CRYGA) and two non-crystallin genes (HMOX1 and KDELR2). Herein, we report a novel missense mutation in the MAF EHR region of the DNA binding domain in a family with congenital cataract. The mutation is associated with non-syndromic bilateral nuclear cataract and impacts the transactivation of cataract associated genes involved in lens structure and stress response.},
  langid = {english},
  keywords = {*congenital cataract/cn [Congenital Disorder],*congenital cataract/et [Etiology],*crystallin gene,*crystallin/ec [Endogenous Compound],*MAF gene,*missense mutation,*noncrystallin gene,*transactivation,*transcription factor Maf/ec [Endogenous Compound],adenine/ec [Endogenous Compound],algorithm,article,Congenital cataract,controlled study,CRYAA gene,CRYBA1 gene,CRYBA4 gene,CRYGA gene,Crystallins,Extended homology region,family study,gene,gene targeting,genetic association,genetic conservation,genetic disorder/cn [Congenital Disorder],genetic disorder/et [Etiology],glutamic acid/ec [Endogenous Compound],Han Chinese,heme oxygenase 1/ec [Endogenous Compound],hmox1 gene,human,human cell,kdelr2 gene,MAF,next generation sequencing,Noncrystallins,ovid_export_ris.ris,phenotype,population research,prediction,priority journal,protein DNA binding,protein domain,thymine/ec [Endogenous Compound],valine/ec [Endogenous Compound]}
}

@article{siokasGeneticRiskFactors2020,
  title = {Genetic {{Risk Factors}} for {{Essential Tremor}}: {{A Review}}},
  author = {Siokas, Vasileios and Aloizou, Athina-Maria and Tsouris, Zisis and Liampas, Ioannis and Aslanidou, Paraskevi and Dastamani, Metaxia and Brotis, Alexandros G and Bogdanos, Dimitrios P and Hadjigeorgiou, Georgios M and Dardiotis, Efthimios},
  year = {2020},
  month = jun,
  journal = {Tremor Other Hyperkinet. Mov.},
  volume = {10},
  pages = {4},
  publisher = {{Center for Digital Research and Scholarship (E-mail: info@cdrs.columbia.edu )}},
  address = {United States},
  abstract = {HIGHLIGHTS: In the current review, we thoroughly reviewed 74 identified articles regarding genes and genetic loci that confer susceptibility to ET. Over 50 genes/genetic loci have been examined for possible association with ET, but consistent results failed to be reported raising the need for collaborative multiethnic studies. BACKGROUND: Essential tremor (ET) is a common movement disorder, which is mainly characterized by bilateral tremor (postural and/or kinetic) in the upper limbs, with other parts of the body possibly involved. While the pathophysiology of ET is still unclear, there is accumulating evidence indicating that genetic variability may be heavily involved in ET pathogenesis. This review focuses on the role of genetic risk factors in ET susceptibility. METHODS: The PubMed database was searched for articles written in English, for studies with humans with ET, controls without ET, and genetic variants. The terms ``essential tremor'' and ``polymorphism'' (as free words) were used during search. We also performed meta-analyses for the most examined genetic variants. RESULTS: Seventy four articles concerning LINGO1, LINGO2, LINGO4, SLC1A2, STK32B, PPARGC1A, CTNNA3, DRD3, ALAD, VDR, HMOX1, HMOX2, LRRK1,LRRK2, GBA, SNCA, MAPT, FUS, CYPsIL17A, IL1B, NOS1, ADH1B, TREM2, RIT2, HNMT, MTHFR, PPP2R2B, GSTP1, PON1, GABA receptors and GABA transporter, HS1BP3, ADH2, hSKCa3 and CACNL1A4 genes, and ETM genetic loci were included in the current review. Results from meta-analyses revealed a marginal association for the STK32B rs10937625 and a marginal trend for association (in sensitivity analysis) for the LINGO1 rs9652490, with ET. DISCUSSION: Quite a few variants have been examined for their possible association with ET. LINGO1 rs9652490 and STK32B rs10937625 appear to influence, to some extent, ET susceptibility. However, the conflicting results and the lack of replication for many candidate genes raise the need for collaborative multiethnic studies.},
  langid = {english},
  keywords = {*essential tremor,*genetic risk,age,alpha catenin/ec [Endogenous Compound],alpha synuclein/ec [Endogenous Compound],Caucasian,dopamine 3 receptor/ec [Endogenous Compound],essential tremor,excitatory amino acid transporter 2/ec [Endogenous Compound],gene locus,genetic association,genetic polymorphism,genetic susceptibility,genetic variability,genome-wide association study,glucosylceramidase/ec [Endogenous Compound],Han Chinese,heme oxygenase 1/ec [Endogenous Compound],heme oxygenase 2/ec [Endogenous Compound],human,hyperkinetic movements,immunoglobulin domain,leucine rich repeat kinase 2/ec [Endogenous Compound],lingo1 protein/ec [Endogenous Compound],liposarcoma,movement disorders,North American,ovid_export_ris.ris,peroxisome proliferator activated receptor gamma coactivator 1alpha/ec [Endogenous Compound],porphobilinogen synthase/ec [Endogenous Compound],priority journal,protein serine threonine kinase/ec [Endogenous Compound],review,RNA binding protein FUS/ec [Endogenous Compound],single nucleotide polymorphism,STK32B protein/ec [Endogenous Compound],systematic review,tau protein/ec [Endogenous Compound],tremor,unclassified drug,variant,vitamin D receptor/ec [Endogenous Compound]}
}

