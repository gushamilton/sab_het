@article{pechlanerHemeOxygenase1Gene2015,
  title = {Heme Oxygenase-1 Gene Promoter Microsatellite Polymorphism Is Associated with Progressive Atherosclerosis and Incident Cardiovascular Disease},
  author = {Pechlaner, Raimund and Willeit, Peter and Summerer, Monika and Santer, Peter and Egger, Georg and Kronenberg, Florian and Demetz, Egon and Weiss, G{\"u}nter and Tsimikas, Sotirios and Witztum, Joseph L and Willeit, Karin and Iglseder, Bernhard and Paulweber, Bernhard and Kedenko, Lyudmyla and Haun, Margot and Meisinger, Christa and Gieger, Christian and {M{\"u}ller-Nurasyid}, Martina and Peters, Annette and Willeit, Johann and Kiechl, Stefan},
  year = {2015},
  month = jan,
  journal = {Arterioscler. Thromb. Vasc. Biol.},
  volume = {35},
  number = {1},
  pages = {229--236},
  publisher = {{Lippincott Williams and Wilkins (E-mail: kathiest.clai@apta.org)}},
  address = {United States},
  abstract = {OBJECTIVE: The enzyme heme oxygenase-1 (HO-1) exerts cytoprotective effects in response to various cellular stressors. A variable number tandem repeat polymorphism in the HO-1 gene promoter region has previously been linked to cardiovascular disease. We examined this association prospectively in the general population. APPROACH AND RESULTS: Incidence of stroke, myocardial infarction, or vascular death was registered between 1995 and 2010 in 812 participants of the Bruneck Study aged 45 to 84 years (49.4\% males). Carotid atherosclerosis progression was quantified by high-resolution ultrasound. HO-1 variable number tandem repeat length was determined by polymerase chain reaction. Subjects with {\textbackslash}geq32 tandem repeats on both HO-1 alleles compared with the rest of the population (recessive trait) featured substantially increased cardiovascular disease risk (hazard ratio [95\% confidence interval], 5.45 [2.39, 12.42]; P{$<$}0.0001), enhanced atherosclerosis progression (median difference in atherosclerosis score [interquartile range], 2.1 [0.8, 5.6] versus 0.0 [0.0, 2.2] mm; P=0.0012), and a trend toward higher levels of oxidized phospholipids on apolipoprotein B-100 (median oxidized phospholipids/apolipoprotein B level [interquartile range], 11364 [4160, 18330] versus 4844 [3174, 12284] relative light units; P=0.0554). Increased cardiovascular disease risk in those homozygous for {\textbackslash}geq32 repeats was also detected in a pooled analysis of 7848 participants of the Bruneck, SAPHIR, and KORA prospective studies (hazard ratio [95\% confidence interval], 3.26 [1.50, 7.33]; P=0.0043). CONCLUSIONS: This study found a strong association between the HO-1 variable number tandem repeat polymorphism and cardiovascular disease risk confined to subjects with a high number of repeats on both HO-1 alleles and provides evidence for accelerated atherogenesis and decreased antioxidant defense in this vascular high-risk group.},
  langid = {english},
  keywords = {*Atherosclerosis/en [Enzymology],*Atherosclerosis/ge [Genetics],*Cardiovascular Diseases/en [Enzymology],*Cardiovascular Diseases/ge [Genetics],*Heme Oxygenase-1/ge [Genetics],*Minisatellite Repeats,*Polymorphism,*Promoter Regions,80 and over,Aged,Apolipoprotein B-100/bl [Blood],atherosclerosis,Atherosclerosis/bl [Blood],Atherosclerosis/di [Diagnosis],Atherosclerosis/mo [Mortality],Austria/ep [Epidemiology],cardiovascular disease,Cardiovascular Diseases/bl [Blood],Cardiovascular Diseases/di [Diagnosis],Cardiovascular Diseases/mo [Mortality],Disease Progression,Female,Genetic,Genetic Markers,genetic polymorphism,Genetic Predisposition to Disease,Heterozygote,Homozygote,Humans,Incidence,Male,Middle Aged,Myocardial Infarction/en [Enzymology],Myocardial Infarction/ge [Genetics],Myocardial Infarction/mo [Mortality],ovid_export_ris.ris,Oxidation-Reduction,Phenotype,Phospholipids/bl [Blood],Proportional Hazards Models,Prospective Studies,risk factor,Risk Factors,Stroke/en [Enzymology],Stroke/ge [Genetics],Stroke/mo [Mortality]}
}

@article{pechlanerr.Abstracts2015,
  title = {Abstracts},
  author = {{Pechlaner R.} and {Willeit P.} and {Summerer M.} and {Santer P.} and {Egger G.} and {Kronenberg F.} and {Demetz E.} and {Weiss G.} and {Tsimikas S.} and {Witztum J.} and {Willeit K.} and {Iglseder B.} and {Paulweber B.} and {Kedenko L.} and {Haun M.} and {Gieger C.} and {Muller-Nurasyid M.} and {Peters A.} and {Willeit J.} and {Kiechl S.}},
