@article{hazletth.f.PosterSessionAbstracts2017,
  title = {Poster Session Abstracts},
  author = {{Hazlett H.F.} and {Armstrong D.A.} and {Dessaint J.A.} and {Nymon A.} and {Ringelberg C.S.} and {Ashare A.}},
  year = {2017},
  month = sep,
  journal = {Pediatr. Pulmonol.},
  volume = {52},
  number = {S47},
  pages = {S214--S516},
  publisher = {Wiley},
  address = {Netherlands},
  abstract = {Cystic fibrosis (CF) is a genetic disease caused by mutations of the CF transmembrane conductance regulator (CFTR), resulting in a multitude of pathologies including chronic polymicrobial pulmonary infection and inflammation. Iron is an essential resource needed for the establishment and growth of lung pathogens. Immune cell withholding of iron plays a critical role in suppressing pathogen growth during infection. In recent clinical studies, hepcidin, a hormone critical to regulating iron absorption and macrophage iron recycling, has been found to be elevated during early stage pulmonary exacerbation (Gifford AH, et al. Clin Transl Sci. 2012;5(4):368- 73). The importance of iron metabolism in CF has been demonstrated, whereby dysregulated iron sequestration in CF bronchial epithelial cells (CFBEs) contributes to the growth and biofilm-formation of Pseudomonas aeruginosa (Moreau-Marquis S, et al. Am J Physiol Lung Cell Mol Physiol. 2008;295(1):L25-37). Although it has been shown that CFTR mutations alter iron metabolism in CFBEs, the impact of CFTR mutation on immune cell iron metabolism remains uncharacterized. The objective of this work is to examine modulation of iron-related gene expression in primary human peripheral blood monocytes (PBMs) of CF patients compared to healthy subjects (WT). Total RNA was isolated and gene expression profiling assayed via the NanoString nCounter gene expression assay and droplet digital polymerase chain reaction (ddPCR). Through this analysis, numerous genes were shown to have significantly altered expression levels, including IL-10, CCL8, and SAA1. Among those genes related to iron homeostasis, SLC11A1, which encodes for the iron-transporter natural resistance-associated macrophage protein 1 (Nramp1), was found to be decreased in CF PBMs. Additionally, the expression of genes encoding for the bacterial siderophore-binding protein lipocalin 2 (LCN2) and the heme catalysis enzyme heme oxygenase 1 (HO-1) were also found to be down-regulated. Interleukins (IL)-6, -10, and tumor necrosis factor alpha (TNFalpha) have been shown to modulate iron regulatory gene expression (Habib A, Finn AV. Front Pharmacol. 2014;5:195). Secretion of these cytokines by WT or CF PBMs was measured via ELISA and 41-Plex assay in response to bacterial lipopolysaccharide (LPS). Interestingly, CF PBMs expressed elevated IL-10 but no significant differences in secreted IL-6 or TNFalpha. Additionally, WT monocyte derived macrophages (MDMs) treated with the CFTR inhibitor-172 were found to also have significantly decreased HO-1 gene expression. These preliminary findings provide a promising lead for future research into the role of altered iron metabolism of CF innate immune cells and dysfunctional bacterial responses.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english},
  keywords = {*cystic fibrosis,*immunocompetent cell,*iron,*macrophage,*monocyte,*regulator gene,adult,bacterium lipopolysaccharide,biofilm,bronchus,catalysis,controlled study,cystic fibrosis transmembrane conductance regulator,droplet digital polymerase chain reaction,endogenous compound,enzyme linked immunosorbent assay,female,gene expression assay,gene expression profiling,gene mutation,heme,heme oxygenase 1,hepcidin,hormone,human,human cell,interleukin 10,interleukin 6,interleukin derivative,iron absorption,iron homeostasis,iron metabolism,lung alveolus cell,lung disease,male,modulation,monocyte chemotactic protein 2,natural resistance associated macrophage protein 1,neutrophil gelatinase associated lipocalin,nonhuman,ovid_export_ris.ris,Pseudomonas aeruginosa,recycling,siderophore,tumor necrosis factor}
}

