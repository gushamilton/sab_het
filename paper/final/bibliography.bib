@article{huiExhaledAirDispersion2019,
  title = {Exhaled Air Dispersion during High-Flow Nasal Cannula Therapy versus {{CPAP}} via Different Masks},
  author = {Hui, David S and Chow, Benny K and Lo, Thomas and Tsang, Owen T Y and Ko, Fanny W and Ng, Susanna S and Gin, Tony and Chan, Matthew T V},
  year = {2019},
  month = apr,
  journal = {Eur. Respir. J.},
  volume = {53},
  number = {4},
  abstract = {BACKGROUND: High-flow nasal cannula (HFNC) is an emerging therapy for respiratory failure but the extent of exhaled air dispersion during treatment is unknown. We examined exhaled air dispersion during HFNC therapy versus continuous positive airway pressure (CPAP) on a human patient simulator (HPS) in an isolation room with 16 air changes{$\cdot$}h-1. METHODS: The HPS was programmed to represent different severity of lung injury. CPAP was delivered at 5-20 cmH2O via nasal pillows (Respironics Nuance Pro Gel or ResMed Swift FX) or an oronasal mask (ResMed Quattro Air). HFNC, humidified to 37{$^\circ$}C, was delivered at 10-60 L{$\cdot$}min-1 to the HPS. Exhaled airflow was marked with intrapulmonary smoke for visualisation and revealed by laser light-sheet. Normalised exhaled air concentration was estimated from the light scattered by the smoke particles. Significant exposure was defined when there was {\textbackslash}geq20\% normalised smoke concentration. RESULTS: In the normal lung condition, mean{\textbackslash}pmsd exhaled air dispersion, along the sagittal plane, increased from 186{\textbackslash}pm34 to 264{\textbackslash}pm27 mm and from 207{\textbackslash}pm11 to 332{\textbackslash}pm34 mm when CPAP was increased from 5 to 20 cmH2O via Respironics and ResMed nasal pillows, respectively. Leakage from the oronasal mask was negligible. Mean{\textbackslash}pmsd exhaled air distances increased from 65{\textbackslash}pm15 to 172{\textbackslash}pm33 mm when HFNC was increased from 10 to 60 L{$\cdot$}min-1. Air leakage to 620 mm occurred laterally when HFNC and the interface tube became loose. CONCLUSION: Exhaled air dispersion during HFNC and CPAP via different interfaces is limited provided there is good mask interface fitting.},
  langid = {english}
}

@article{huk.AASLDAbstracts2012,
  title = {{{AASLD}} Abstracts},
  author = {{Hu K.} and {Zhu Z.} and {Mathahs M.M.} and {Bommer J.} and {Testa C.} and {Schmidt W.N.}},
  year = {2012},
  month = oct,
  journal = {Hepatology},
  volume = {56},
  number = {S1},
  pages = {191A--1144A},
  publisher = {Ovid Technologies (Wolters Kluwer Health)},
  abstract = {Introduction: Previous studies have documented the antiviral activities of the precursors and products of the heme oxygenase (HO) system, not only for HCV, but also for HIV and HBV. We recently reported that biliverdin (BV), the linear tetrapyrrole product of heme oxidation is a potent mixed inhibitor of the HCV NS3/4A protease in contrast to bilirubin, a poor protease inhibitor. The goal of the present work was to evaluate the antiprotease behavior of a variety of common tetrapyrroles such as porphyrins and metalloporphyrins, to further characterize structure-activity relationships. Method(s): Porphyrins, metalloprotoporphyrins (MPP), and linear tetrapyrroles were obtained with highest purity possible. Anti-NS3/4A activity was determined fluorometrically with SensoLyte HCV Protease Assay Systems. Optimal wavelengths for excitation/emission fluorescence energy transfer peptides were used for each compound as determined empirically from autofluorescence background assays. Competitive and non-competitive inhibitory behavior was assessed on Lineweaver-Burk (LB) plots and IC50 values calculated from inhibition curves. The effects of different compounds on HCV replication in replicon cells were determined using quantitative Realtime RT-PCR and calculation of EC50 values. Result(s): Common MPPs all inhibited NS3/4A protease activity with IC50 in low micromolar ranges: CoPP (IC50 = 0.5 uM) {$>$}ZnPP {$>$} MnPP = MgPP {$>$} FePP {$>$}CuPP = protoporphyrin {$>$} SnPP (IC50 = 12 uM). LB plots showed that nearly all MPPs elicited mixed competitive and noncompetitive inhibition, similar to biliverdin. Strikingly, comparable IC50 values for MPP inhibition were noted across genotypes 1A, !B, 2A and 3A, indicating no genotype selectivity in contrast to protease inhibitors such as the ketoamides. On the other hand, meso metalloporphyrins and tetrapyrroles such as ZnMP and mesobiliverdin showed little if any anti-protease activity suggesting that the tetrapyrrole vinyl side chains are important for protease active site binding. In support of this hypothesis, selected Cu and Fe deuteroporphyrins and isohematoporphyrins showed no anti-protease activity. Collectively, these data suggest that optimal protease binding is achieved with planar tetrapyrroles with resonance-stabilized vinyl side chains. Finally, with some exceptions, anti-protease IC50 values were comparable to in vitro EC50 for inhibition of HCV replication. Conclusion(s): These findings show the versatility of MPP and linear tetrapyrroles as antiviral agents with a wide sensitivity for HCV genotypes. They should be studied further as candidate drugs or lead compounds for development of therapeutic agents.},
  langid = {english},
  keywords = {*liver,*liver disease,*proteinase,*structure activity relation,antiviral activity,antivirus agent,assay,autofluorescence,bilirubin,biliverdin,deuteroporphyrin derivative,energy transfer,fluorescence,genotype,heme,heme oxygenase,Human immunodeficiency virus,hypothesis,in vitro study,iron,metalloporphyrin,ovid_export_ris.ris,oxidation,peptide,porphyrin,precursor,proteinase inhibitor,protoporphyrin,replicon,tetrapyrrole derivative,vinyl derivative}
}

