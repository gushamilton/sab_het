@article{gardnerAntiretroviralMedicationAdherence2009,
  title = {Antiretroviral Medication Adherence and the Development of Class-Specific Antiretroviral Resistance},
  author = {Gardner, Edward M and Burman, William J and Steiner, John F and Anderson, Peter L and Bangsberg, David R},
  year = {2009},
