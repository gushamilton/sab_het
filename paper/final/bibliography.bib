  title = {How Much Tubal Factor Infertility Is Caused by {{Chlamydia}}? {{Estimates}} Based on Serological Evidence Corrected for Sensitivity and Specificity},
  author = {Price, Malcolm J and Ades, A E and Welton, Nicky J and Macleod, John and Turner, Katy and Simms, Ian and Horner, Paddy J},
  year = {2012},
