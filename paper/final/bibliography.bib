@article{Ryter2006-hj,
  title = {Heme Oxygenase-1/Carbon Monoxide: From Basic Science to Therapeutic Applications},
  author = {Ryter, Stefan W and Alam, Jawed and Choi, Augustine M K},
  year = {2006},
  month = apr,
