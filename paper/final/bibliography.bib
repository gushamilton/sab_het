  author = {Bell, N H},
  year = {1979},
  journal = {Nephron},
  volume = {23},
  number = {2-3},
  pages = {147--151},
  address = {SWITZERLAND},
  abstract = {Current concepts concerning the mechanisms, diagnosis and means of treatment of a number of the major causes of hypercalcemia and hypocalcemia are reviewed. In particular, the role of abnormalities in metabolism of vitamin D including (1) excessive hepatic production of 25-hydroxyvitamin D (vitamin D intoxication), (2) increased production of 1 alpha, 25-dihydroxyvitamin D (hyperparathyroidism and sarcoidosis), (3) impaired production of 1 alpha, 25-dihydroxyvitamin D (hypoparathyroidism, renal failure, vitamin-D-dependent rickets type I, pseudohypoparathyroidism) and (4) resistance to 1 alpha, 25-dihydroxyvitamin D; the use of vitamin D and its metabolites therapeutically is discussed.},
  keywords = {*Hypercalcemia/di [Diagnosis],*Hypocalcemia/di [Diagnosis],Humans,hypercalcaemia SS,Hypercalcemia/dt [Drug Therapy],Hypercalcemia/et [Etiology],Hyperparathyroidism/co [Complications],Hyperthyroidism/co [Complications],Hypocalcemia/dt [Drug Therapy],Hypoparathyroidism/co [Complications],Magnesium Deficiency,Neoplasms/co [Complications],Prostaglandins/ph [Physiology],Vitamin D/me [Metabolism],Vitamin D/tu [Therapeutic Use]}
}

@article{Belliveau1975-dn,
  title = {Incidence and Sites of Bone Lesions Detected by {{99mTc-polyphosphate}} Scans in Patients with Tumors},
  author = {Belliveau, R E and Spencer, R P},
  year = {1975},
  journal = {Cancer},
  volume = {36},
  number = {2},
  pages = {359--363},
  address = {UNITED STATES},
  abstract = {The value of bone scanning with 99mTc-polyphosphate was assessed in 186 patients with various types of tumors. The sensitivity of this technique was greater than that of metastatic roentgenographic series and the reported results of 85-Sr-bone scans, in the detection of osseous involvement by tumors. Three cases with normal bone scans and abnormal roentgenographic studies illustrated the necessity and complementary value of comparing bone scan findings with radiographic studies. Patients with carcinoma of the breast, lung, or prostate displayed characteristic patterns of bone involvement by their tumors. The importance of clinical information, including bone symptoms, antecedent bone disease, and serum calcium and alkaline phosphatase, was stressed in the detection and interpretation of bone scan abnormalities.},
  keywords = {*Bone Neoplasms/di [Diagnosis],*Radionuclide Imaging,*Technetium/du [Diagnostic Use],Alkaline Phosphatase/bl [Blood],Breast Neoplasms,Evaluation Studies as Topic,Female,Humans,Hypercalcemia/et [Etiology],Lung Neoplasms,Male,Mendeley Import (Dec 08),Middle Aged,Neoplasm Metastasis,Pelvic Neoplasms/di [Diagnosis],Prostatic Neoplasms,Ribs,Skull Neoplasms/di [Diagnosis],Spinal Neoplasms/di [Diagnosis],Strontium Radioisotopes}
}

