@article{chapmanCommonNFKBIL2Polymorphisms2010,
  title = {Common {{NFKBIL2}} Polymorphisms and Susceptibility to Pneumococcal Disease: A Genetic Association Study},
  author = {Chapman, Stephen J and Khor, Chiea C and Vannberg, Fredrik O and Rautanen, Anna and Walley, Andrew and Segal, Shelley and Moore, Catrin E and Davies, Robert J O and Day, Nicholas P and Peshu, Norbert and Crook, Derrick W and Berkley, James A and Williams, Thomas N and Scott, J Anthony and Hill, Adrian V S},
  year = {2010},
