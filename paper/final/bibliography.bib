@article{uenoUniversalAntibioticProphylaxis2020,
  title = {Universal Antibiotic Prophylaxis May No Longer Be Necessary for Patients with Acute Variceal Bleeding: {{A}} Retrospective Observational Study},
  author = {Ueno, Masayuki and Kayahara, Takahisa and Sunami, Tomohiko and Takayama, Hiroshi and Takabatake, Hiroyuki and Morimoto, Youichi and Yamamoto, Hiroshi and Mizuno, Motowo},
  year = {2020},
  month = may,
  journal = {Medicine},
  volume = {99},
  number = {20},
  pages = {e19981},
  abstract = {A few decades ago, antibiotic prophylaxis for patients with acute variceal bleeding was reported beneficial. However, endoscopic and systemic therapy for variceal bleeding has dramatically improved since then, so the necessity of prophylactic antibiotics can be questioned. In this study, we reevaluated the efficacy of antibiotic prophylaxis in acute variceal bleeding, using the most recent data in our hospital.We retrospectively analyzed the medical records of 150 patients with acute variceal bleeding who were admitted to Kurashiki Central Hospital between January 2012 and December 2016. We compared the rates of bacterial infection, in-hospital mortality, 5-day rebleeding rate, and 30-day emergency readmission between patients treated or not treated with antibiotic prophylaxis.Forty-six patients (30.7\%) received antibiotic prophylaxis; 104 (69.3\%) did not. The rates of the outcomes in patients with antibiotic prophylaxis were 6.5\% (bacterial infection), 4.3\% (in-hospital mortality), 2.2\% (5-day rebleeding), and 10.9\% (30-day emergency readmission) and were not significantly different form the corresponding figures in those without antibiotic prophylaxis (1.9\%, 7.7\%, 1.9\%, and 10.6\%, respectively). Moreover, these rates in our patients, even without antibiotic prophylaxis, were much lower than rates reported in past years, perhaps because of improvements in care of patients with variceal hemorrhage.Antibiotic prophylaxis was not associated with significantly better outcomes of bacterial infection, mortality, rebleeding or readmission rate in patients with acute variceal bleeding. Universal antibiotic prophylaxis for patients with acute variceal bleeding should be reconsidered.},
  langid = {english}
}

@article{ugarteburuo.SSIEM2019Annual2019,
  title = {{{SSIEM}} 2019: {{Annual Symposium}} of the {{Society}} for the {{Study}} of {{Inborn Errors}} of {{Metabolism}}, {{Rotterdam}}, {{The Netherlands}}, 3-6 {{September}} 2019},
  author = {{Ugarteburu O.} and {Sanchez-Viles M.} and {Ramos J.} and {Garcia-Villoria J.} and {Ribes A.} and {Tort F.}},
  year = {2019},
  month = sep,
  journal = {J. Inherit. Metab. Dis.},
  volume = {42 Suppl 1},
  number = {Supplement 1},
  pages = {1--479},
  publisher = {{John Wiley and Sons Inc.}},
  address = {Netherlands},
  abstract = {Background: HACE1 encodes for an E3 ubiquitin ligase involved in different cellular processes such as autophagy and oxidative stress response. Mutations in HACE1 have been reported in a few patients (MIM\#610876) but the molecular bases of the disease have not been well determined. Here we present the first detailed characterization of the physiopathological bases underlying HACE1 deficiency in a patient with suspected mitochondrial disease. Method(s): Genetic analysis was performed by WES. Mitochondrial morphology, autophagy and mitophagy were analyzed by confocal microscopy. Protein and mRNA expression were determined by western blot and qPCR, respectively. All studies were performed in patient's fibroblasts. Result(s): We report a 10 year old patient with brain atrophy, psychomotor retardation and persistently increased levels of 3-metylglutaconic and 3-methylglutaric acids in urine. Mutations in genes previously associated with 3-methylglutaconic aciduria (3-MGA-uria) were excluded. WES identified a homozygous mutation in HACE1 (c.[240C{$>$}A];[240C{$>$}A];p. [Cys80Ter];[Cys80Ter]). Molecular studies demonstrated that HACE1 protein is cytosolic and its expression was completely absent in the patient's fibroblasts. Our results showed an increased number of LC3-II puncta in patient's cells, corresponding to a significant decrease in the autophagic flux. Slight alterations in mitochondrial morphology and increased mitophagy were also demonstrated. In addition, the Nrf2-oxidative stress response pathway was impaired, as shown by the reduced mRNA expression of NQO1 and Hmox1 detected in H2O2-treated patient cells. Discussion(s): We report a patient with a clinical and biochemical phenotype strongly suggestive of a mitochondrial disorder in whom mutations in HACE1, encoding for a cytosolic protein, were identified. We demonstrate for the first time in human disease that HACE1 deficiency is associated with defective regulation of mitophagy and the oxidative stress response, as well as persistent 3-MGA-uria.},
  langid = {english},
  keywords = {*aciduria,*gene frequency,*gene mutation,*mitophagy,*oxidative stress,azo reductase,brain atrophy,child,conference abstract,confocal microscopy,disorders of mitochondrial functions,endogenous compound,fibroblast,genetic analysis,genetic association,heme oxygenase 1,homozygosity,human,human tissue,hydrogen peroxide,in vitro study,messenger RNA,ovid_export_ris.ris,phenotype,protein expression,psychomotor retardation,school child,transcription factor Nrf2,Western blotting}
}

@article{ugarteburuPhysiopathologicalBasesDisease2020,
  title = {Physiopathological {{Bases}} of the {{Disease Caused}} by {{HACE1 Mutations}}: {{Alterations}} in {{Autophagy}}, {{Mitophagy}} and {{Oxidative Stress Response}}},
  author = {Ugarteburu, Olatz and {S{\'a}nchez-Vil{\'e}s}, Marta and Ramos, Julio and {Barcos-Rodr{\'i}guez}, Tamara and Garrabou, Gloria and {Garc{\'i}a-Villoria}, Judit and Ribes, Antonia and Tort, Frederic},
  year = {2020},
  month = mar,
  journal = {J. Clin. Med. Res.},
  volume = {9},
  number = {4},
  pages = {913},
  publisher = {MDPI AG (Postfach, Basel CH-4005, Switzerland. E-mail: rasetti@mdpi.com)},
  address = {Switzerland},
  abstract = {Recessive HACE1 mutations are associated with a severe neurodevelopmental disorder (OMIM: 616756). However, the physiopathologycal bases of the disease are yet to be completely clarified. Whole-exome sequencing identified homozygous HACE1 mutations (c.240C{$>$}A, p.Cys80Ter) in a patient with brain atrophy, psychomotor retardation and 3-methylglutaconic aciduria, a biomarker of mitochondrial dysfunction. To elucidate the pathomechanisms underlying HACE1 deficiency, a comprehensive molecular analysis was performed in patient fibroblasts. Western Blot demonstrated the deleterious effect of the mutation, as the complete absence of HACE1 protein was observed. Immunofluorescence studies showed an increased number of LC3 puncta together with the normal initiation of the autophagic cascade, indicating a reduction in the autophagic flux. Oxidative stress response was also impaired in HACE1 fibroblasts, as shown by the reduced NQO1 and Hmox1 mRNA levels observed in H2O2-treated cells. High levels of lipid peroxidation, consistent with accumulated oxidative damage, were also detected. Although the patient phenotype could resemble a mitochondrial defect, the analysis of the mitochondrial function showed no major abnormalities. However, an important increase in mitochondrial oxidative stress markers and a strong reduction in the mitophagic flux were observed, suggesting that the recycling of damaged mitochondria might be targeted in HACE1 cells. In summary, we demonstrate for the first time that the impairment of autophagy, mitophagy and oxidative damage response might be involved in the pathogenesis of HACE1 deficiency.},
  langid = {english},
  keywords = {*autophagy (cellular),*hect domain and ankyrin repeat containing e3 ubiquitin protein ligase 1/ec [Endogenous Compound],*mitophagy,*mutation,*pathophysiology,*ubiquitin protein ligase E3/ec [Endogenous Compound],3-methylglutaconic,article,autophagosome,autophagy,brain atrophy,confocal microscopy,electron microscopy,gene mutation,genetic disorder,genetic transfection,HACE1,hospital patient,human,human cell,image analysis,immunofluorescence,lipid peroxidation,mitochondria,mitochondrial membrane potential,mitochondrion,mitophagy,mRNA expression level,native polyacrylamide gel electrophoresis,nuclear magnetic resonance imaging,ovid_export_ris.ris,oxidative stress,oxygen consumption,phenotype,polyacrylamide gel electrophoresis,protein expression,psychomotor retardation,respiratory chain,reverse transcription polymerase chain reaction,transmission electron microscopy,unclassified drug,Western blotting,whole exome sequencing}
}

@article{ugenskieneGeneticPolymorphismsChronic2005,
  title = {Genetic Polymorphisms in Chronic Obstructive Pulmonary Disease},
  author = {Ugenskiene, Rasa and Sanak, Marek and Sakalauskas, Raimundas and Szczeklik, Andrew},
  year = {2005},
  journal = {Medicina},
  volume = {41},
  number = {1},
  pages = {17--22},
  address = {Switzerland},
  abstract = {Etiology of chronic obstructive pulmonary disease remains unknown but, despite some inconsistencies in reports on inflammatory cells, mediators and proteases involved in the pathogenesis of chronic obstructive pulmonary disease, genetic risk factors were proposed as a cause of susceptibility to the disease. Results of many studies suggested polygenic inheritance, with the genetic component consisting of several genes of a small effect each, rather than of single major gene. We are going to review the clinical importance of alpha-1 antitrypsin, glutathione S-transferase, microsomal epoxide hydrolase, matrix metalloproteinase, tumor necrosis factor-a, alpha-1 antichymotrypsin, alpha 2-macroglobulin, cytochrome P4501A1, heme oxygenase-1 genes polymorphisms associated with susceptibility and progression of the chronic obstructive pulmonary disease.},
  langid = {english},
  keywords = {*Polymorphism,*Pulmonary Disease,Alleles,alpha 1-Antitrypsin/ge [Genetics],Chronic Obstructive/ge [Genetics],Cytochrome P-450 Enzyme System/ge [Genetics],Disease Progression,Epoxide Hydrolases/ge [Genetics],Genetic,Genetic Predisposition to Disease,Genotype,Glutathione Transferase/ge [Genetics],Heterozygote,Homozygote,Humans,Matrix Metalloproteinases/ge [Genetics],ovid_export_ris.ris,Phenotype,Tumor Necrosis Factor-alpha/ge [Genetics]}
}

@article{Uhlig2010-eo,
  title = {{{KDOQI US}} Commentary on the 2009 {{KDIGO}} Clinical Practice Guideline for the Diagnosis, Evaluation, and Treatment of {{CKD-Mineral}} and Bone Disorder ({{CKD-MBD}})},
  author = {Uhlig, Katrin and Berns, Jeffrey S and Kestenbaum, Bryan and Kumar, Raj and Leonard, Mary B and Martin, Kevin J and Sprague, Stuart M and Goldfarb, Stanley},
  year = {2010},
  journal = {American journal of kidney diseases : the official journal of the National Kidney Foundation},
  volume = {55},
  number = {5},
  pages = {773--799},
  publisher = {Tufts Medical Center, Tufts University School of Medicine, Boston MA, USA.},
  address = {United States},
  abstract = {This commentary provides a US perspective on the 2009 KDIGO (Kidney Disease: Improving Global Outcomes) Clinical Practice Guideline for the Diagnosis, Evaluation, Prevention, and Treatment of Chronic Kidney Disease-Mineral and Bone Disorder (CKD-MBD). KDIGO is an independent international organization with the primary mission of the promotion, coordination, collaboration, and integration of initiatives to develop and implement clinical practice guidelines for the care of patients with kidney disease. The National Kidney Foundation's Kidney Disease Outcomes Quality Initiative (KDOQI), recognizing that international guidelines need to be adapted for each country, convened a group of experts to comment on the application and implementation of the KDIGO guideline for patients with CKD in the United States. This commentary puts the KDIGO guideline into the context of the supporting evidence and the setting of care delivered in the United States and summarizes important differences between prior KDOQI guidelines and the newer KDIGO guideline. It also considers the potential impact of a new bundled payment system for dialysis clinics. The KDIGO guideline addresses the evaluation and treatment of abnormalities of CKD-MBD in adults and children with CKD stages 3-5 on long-term dialysis therapy or with a kidney transplant. Tests considered are those that relate to laboratory, bone, and cardiovascular abnormality detection and monitoring. Treatments considered are interventions to treat hyperphosphatemia, hyperparathyroidism, and bone disease in patients with CKD stages 3-5D and 1-5T. Limitations of the evidence are discussed. The lack of definitive clinical outcome trials explains why most recommendations are not of level 1 but of level 2 strength, which means weak or discretionary recommendations. Suggestions for future research highlight priority areas. Copyright 2010 National Kidney Foundation, Inc. Published by Elsevier Inc. All rights reserved.},
  keywords = {*Bone Diseases,*Practice Guidelines as Topic,*Renal Insufficiency,Bone Diseases,Calcinosis,Chronic/cl [Classification],Chronic/co [Complications],Chronic/ec [Economics],Chronic/th [Therapy],Humans,Hypercalcemia/et [Etiology],Hypercalcemia/th [Therapy],Hyperphosphatemia/et [Etiology],Hyperphosphatemia/th [Therapy],Medicare/ec [Economics],Mendeley Import (Dec 08),Metabolic/di [Diagnosis],Metabolic/et [Etiology],Metabolic/pc [Prevention & Control],Metabolic/th [Therapy],Monitoring,Phosphate-Binding Proteins/ad [Administration & Do,Physiologic/st [Standards],Reimbursement Mechanisms,Renal Dialysis/ec [Economics],Renal Insufficiency,Renal Osteodystrophy/di [Diagnosis],Renal Osteodystrophy/et [Etiology],Renal Osteodystrophy/th [Therapy],United States,World Health}
}

