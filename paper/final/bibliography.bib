@article{owusu-ansaha.2012ASPHOAbstracts2012,
  title = {2012 {{ASPHO}} Abstracts},
  author = {{Owusu-Ansah A.} and {Meyerson H.} and {Letterio J.}},
  year = {2012},
  month = jul,
  journal = {Pediatr. Blood Cancer},
  volume = {58},
  number = {7},
  pages = {1014--1097},
  publisher = {Wiley},
  abstract = {Background: Clinical diversity associated with Sickle cell disease (SCD) is a function of several factors including polymerization of hemoglobin-S, single nucleotide polymorphisms (SNP) in the b-globin gene and endothelial dysfunction. Currently, hydroxyurea (HU) and chronic blood transfusions are the only available preventative strategies for SCD patients. Thus, there is a need to develop molecularly targeted drug therapies for SCD that control factors which influence disease severity. Recent reports establish a link between decreased Nrf-2 (Nuclear-factor-erythroid derived 2-like-2) activity and the erythrocyte response to oxidative stress in SCD. Activation of Nrf-2 is known to induce Hb-F (hemoglobin F), therefore, we hypothesize that induction of the Nrf-2 pathway represents a novel treatment approach for SCD. Objective(s): Our goal is to demonstrate the utility of small molecules that activate the Nrf-2 pathway as therapeutic agents for SCD. We aim to establish a link between increased Nrf-2 activity, cellular anti-oxidant levels and Hb-F expression following exposure of erythroleukemia cells to synthetic triterpenoids in vitro. Design/Method: Triterpenoids are natural pentacyclic compounds known for their anti-inflammatory and anti-oxidant activity mediated via Nrf-2 induction. In this study we examined the effects of the synthetic triterpenoid, CDDO-Me (currently in a Phase-III clinical trial for the treatment of chronic kidney disease), on the activation of Nrf-2 target genes and gamma-globin (gamma-globin) gene induction in K562 (human erythroleukemia) cells, when administered alone or in combination with HU. Result(s): Our data indicates that CDDO-Me is able to induce Nrf-2-mediated antioxidant genes including Hmox-1 (Heme Oxygenase -1), NQO1 (NADPH Quinoneoxidoreductase), GCLC (Glutamate-Cysteine Ligase Catalytic subunit) in a time and dose dependent manner in K562 cells. Treatment with HU alone had no effect on these Nrf2 target genes, but induced gamma-globin gene and HbF more effectively compared to CDDO-Me alone. However, alteration of the Ggamma and Agamma gene ratio was similar following treatment with either agent. Most importantly, the combination of CDDO and HU showed synergy in antioxidant gene induction at nanomolar doses of HU. Conclusion(s): These results suggest that CDDO-Me-induced Nrf2 signaling represents a novel molecularly targeted form of chemopreventive therapy that may act synergistically with HU treatment in patients with SCD.},
  copyright = {http://onlinelibrary.wiley.com/termsAndConditions\#vor},
  langid = {english},
  keywords = {*sickle cell anemia,*society,antioxidant,bardoxolone,bardoxolone methyl,blood transfusion,cell strain k 562,chronic kidney disease,disease severity,drug therapy,endothelial dysfunction,enzyme active site,erythrocyte,erythroleukemia,erythroleukemia cell,exposure,gene,gene induction,globin,globin gene,glutamate cysteine ligase,heme oxygenase 1,hemoglobin F,hemoglobin gamma chain,hemoglobin S,human,hydroxyurea,in vitro study,nuclear factor,ovid_export_ris.ris,oxidative stress,oxidizing agent,patient,polymerization,single nucleotide polymorphism,therapy,triterpenoid}
}

@article{Oz2013-qz,
  title = {Does Aspirin Use Prevent Acute Coronary Syndrome in Patients with Pneumonia: Multicenter Prospective Randomized Trial},
  author = {Oz, Fahrettin and Gul, Sule and Kaya, Mehmet G and Yazici, Mehmet and Bulut, Ismet and Elitok, Ali and Ersin, Gunay and Abakay, Ozlem and Akkoyun, Cayan D and Oncul, Aytac and Cetinkaya, Erdogan and Gibson, Michael C and Oflaz, Huseyin},
  year = {2013},
  month = may,
  journal = {Coronary Artery Disease},
  volume = {24},
  number = {3},
  pages = {231--237},
  abstract = {OBJECTIVES: The aim of this study was to test the hypothesis that aspirin would reduce the risk for acute coronary syndromes (ACSs) in patients with pneumonia. BACKGROUNDS: Pooled data suggest that pneumonia may trigger an ACS as a result of inflammatory reactions and the prothrombotic changes in patients with pneumonia. Hypothetically considering its antiaggregating and anti-inflammatory effects, aspirin might also be beneficial for the primary prevention of ACS in patients with pneumonia. METHODS: One hundred and eighty-five patients with pneumonia who had more than one risk factor for cardiovascular disease were randomized to an aspirin group (n=91) or a control group (n=94). The patients in the aspirin group received 300 mg of aspirin daily for 1 month. ECGs were recorded on admission and 48 h and 30 days after admission to assess silent ischemia. The level of high-sensitivity cardiac troponin T was measured on admission and 48 h after admission. The primary endpoint was the development of ACS within 1 month. The secondary endpoints included cardiovascular death and death from any cause within 1 month. RESULTS: The {$\chi$}-test showed that the rates of ACS at 1 month were 1.1\% (n=1) in the aspirin group and 10.6\% (n=10) in the control group (relative risk, 0.103; 95\% confidence interval 0.005-0.746; P=0.015). Aspirin therapy was associated with a 9\% absolute reduction in the risk for ACS. There was no significant decrease in the risk of death from any cause (P=0.151), but the aspirin group had a decreased risk of cardiovascular death (risk reduction: 0.04, P=0.044). CONCLUSION: This randomized open-label study shows that acetyl salicylic acid is beneficial in the reduction of ACS and cardiovascular mortality among patients with pneumonia.},
  langid = {english}
}

@article{ozakiImprovedRenalFunction2008,
  title = {Improved Renal Function after Kidney Transplantation Is Associated with Heme Oxygenase-1 Polymorphism},
  author = {Ozaki, K S and Marques, G M and Nogueira, E and Feitoza, R Q and Cenedeze, M A and Franco, M F and Mazzali, M and Soares, M P and {Pacheco-Silva}, A and C{\^a}mara, N O S},
  year = {2008},
  month = may,
  journal = {Clin. Transplant.},
  volume = {22},
  number = {5},
  pages = {609--616},
  publisher = {Blackwell Publishing Ltd (9600 Garsington Road, Oxford OX4 2XG, United Kingdom)},
  address = {United Kingdom},
  abstract = {Heme oxygenase-1 (HO-1) has a microsatellite polymorphism based on the number of guanosine-thymidine nucleotide repeats (GT) repeats that regulates expression levels and could have an impact on organ survival post-injury. We correlated HO-1 polymorphism with renal graft function. The HO-1 gene was sequenced (N = 181), and the allelic repeats were divided into subclasses: short repeats (S) (/=27 repeats). A total of 47.5\% of the donors carried the S allele. The allograft function was statistically improved six months, two and three yr after transplantation in patients receiving kidneys from donors with an S allele. For the recipients carrying the S allele (50.3\%), the allograft function was also better throughout the follow-up, but reached statistical significance only three yr after transplantation (p = 0.04). Considering only those patients who had chronic allograft nephropathy (CAN; 74 of 181), allograft function was also better in donors and in recipients carrying the S allele, two and three yr after transplantation (p = 0.03). Recipients of kidney transplantation from donors carrying the S allele presented better function even in the presence of CAN.},
  langid = {english},
  keywords = {*heme oxygenase 1/ec [Endogenous Compound],*kidney transplantation,adult,allele,article,chronic allograft nephropathy/co [Complication],controlled study,correlation analysis,delayed graft function/co [Complication],DNA extraction,DNA/ec [Endogenous Compound],female,gene expression regulation,genetic association,genetic polymorphism,graft recipient,graft survival,guanosine/ec [Endogenous Compound],human,human cell,kidney allograft,kidney donor,kidney function,kidney graft rejection/co [Complication],major clinical study,male,nucleotide repeat,ovid_export_ris.ris,polymerase chain reaction,postoperative period,priority journal,sequence analysis,thymidine/ec [Endogenous Compound],treatment outcome}
}

