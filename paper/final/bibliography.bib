@article{hansenj.SenescentLungCarcinoma2019,
  title = {Senescent Lung Carcinoma Cells Show Resistance to Oxidant-Induced Cell Death and Improved {{Nrf2}} Activity},
  author = {{Hansen J.} and {Davies B.} and {Alder J.}},
  year = {2019},
  month = dec,
  journal = {Free Radic. Biol. Med.},
  volume = {145},
  number = {Supplement 1},
  pages = {S132},
  publisher = {Elsevier BV},
  address = {Netherlands},
  abstract = {During the aging process, telomeres, repetitive nucleotide sequences which protect the ends of chromosomes from damage, shorten due to the end replication problem. Telomere shortening eventually leads to replicative senescence. Unexpectedly, patients with mutation in telomere maintenance genes and very short telomeres develop predominantly lung disease. We modeled telomere dysfunction in lung carcinoma A549 cells by expressing a dominant negative telomere binding protein that triggers rapid telomere dysfunction. Induced telomere dysfunction led to proliferative arrest and induction of senescence, but limited apoptosis. Senescent cells were more resistant to H2O2 toxicity than normal cells. Interestingly, glutathione (GSH) concentrations were substantially higher in senescent cells than in normal cells and glutathione disulfide (GSSG) concentrations were significantly lower. These changes reflect a significant, reducing shift in GSH redox potential by approximately -15 mV. Nrf2-related proteins (HO-1, NQO1, Gclc) were more highly expressed, as determined by immunoblot analysis. Stable transfection of an antioxidant response element (ARE) promoter reporter red fluorescence protein (RFP) construct did not demonstrate basal increases in Nrf2 activity in senescent cells but following treatment with sulforaphane, a potent Nrf2 inducer, Nrf2 activity was not only more quickly induced but was also more robustly induced in senescent cells. Together, our data suggest that activation of a senescence program in A549 cells primed cells for Nrf2 activation and may contribute to the resistance of these cells to chemotoxins. Understanding redox state changes and Nrf2 function in senescence may provide rationale in a variety of age- and disease-related processes.Copyright {\textbackslash}copyright 2019},
  langid = {english},
  keywords = {*apoptosis,*enzyme activity,*hydrogen peroxide,*lung carcinoma,*transcription factor Nrf2,adult,aging,antioxidant responsive element,azo reductase,cancer model,cancer patient,cancer resistance,chromosome,conference abstract,controlled study,endogenous compound,fluorescence,gene mutation,glutathione,glutathione disulfide,heme oxygenase 1,human,human cell,immunoblotting,in vitro study,nucleotide sequence,ovid_export_ris.ris,oxidation reduction potential,oxidation reduction state,oxygen toxicity,promoter region,protein expression,protein function,senescence,stable transfection,sulforaphane,telomere binding protein,telomere homeostasis,telomere shortening}
}

@article{hansenPrognosticValueReadingtoreading2010,
  title = {Prognostic Value of Reading-to-Reading Blood Pressure Variability over 24 Hours in 8938 Subjects from 11 Populations},
  author = {Hansen, Tine W and Thijs, Lutgarde and Li, Yan and Boggia, Jos{\'e} and Kikuya, Masahiro and {Bj{\"o}rklund-Bodeg{\aa}rd}, Kristina and Richart, Tom and Ohkubo, Takayoshi and Jeppesen, J{\o}rgen and {Torp-Pedersen}, Christian and Dolan, Eamon and Kuznetsova, Tatiana and {Stolarz-Skrzypek}, Katarzyna and Tikhonoff, Val{\'e}rie and Malyutina, Sofia and Casiglia, Edoardo and Nikitin, Yuri and Lind, Lars and Sandoya, Edgardo and {Kawecka-Jaszcz}, Kalina and Imai, Yutaka and Wang, Jiguang and Ibsen, Hans and O'Brien, Eoin and Staessen, Jan A and {International Database on Ambulatory Blood Pressure in Relation to Cardiovascular Outcomes Investigators}},
  year = {2010},
  month = apr,
  journal = {Hypertension},
  volume = {55},
  number = {4},
  pages = {1049--1057},
  publisher = {Lippincott Williams \& Wilkins},
  abstract = {In previous studies, of which several were underpowered, the relation between cardiovascular outcome and blood pressure (BP) variability was inconsistent. We followed health outcomes in 8938 subjects (mean age: 53.0 years; 46.8\% women) randomly recruited from 11 populations. At baseline, we assessed BP variability from the SD and average real variability in 24-hour ambulatory BP recordings. We computed standardized hazard ratios (HRs) while stratifying by cohort and adjusting for 24-hour BP and other risk factors. Over 11.3 years (median), 1242 deaths (487 cardiovascular) occurred, and 1049, 577, 421, and 457 participants experienced a fatal or nonfatal cardiovascular, cardiac, or coronary event or a stroke. Higher diastolic average real variability in 24-hour ambulatory BP recordings predicted (Por=1.07) with the exception of cardiac and coronary events (HR: or=0.58). Higher systolic average real variability in 24-hour ambulatory BP recordings predicted (Por=1.07), with the exception of cardiac and coronary events (HR: or=0.54). SD predicted only total and cardiovascular mortality. While accounting for the 24-hour BP level, average real variability in 24-hour ambulatory BP recordings added {$<$}1\% to the prediction of a cardiovascular event. Sensitivity analyses considering ethnicity, sex, age, previous cardiovascular disease, antihypertensive treatment, number of BP readings per recording, or the night:day BP ratio were confirmatory. In conclusion, in a large population cohort, which provided sufficient statistical power, BP variability assessed from 24-hour ambulatory recordings did not contribute much to risk stratification over and beyond 24-hour BP.},
  langid = {english},
  keywords = {ambulatory blood pressure,blood pressure variability,epidemiology,Mendeley Import (Dec 08),population science,risk factors}
}

@article{Hansson2015-br,
  title = {Polymorphisms in the {{Haem Oxygenase-1}} Promoter Are Not Associated with Severity of {{Plasmodium}} Falciparum Malaria in {{Ghanaian}} Children},
  author = {Hansson, Helle H and Maretty, Lasse and Balle, Christina and Goka, Bamenla Q and Luzon, Elisa and Nkrumah, Francis N and Schousboe, Mette L and Rodrigues, Onike P and Bygbjerg, Ib Christian and Kurtzhals, J{\o}rgen A L and Alifrangis, Michael and Hempel, Casper},
  year = {2015},
  month = apr,
  journal = {Malaria Journal},
  volume = {14},
  pages = {153},
  publisher = {malariajournal.biomedcentral.com},
  abstract = {BACKGROUND: Haem oxygenase-1 (HO-1) catabolizes haem and has both cytotoxic and cytoprotective effects. Polymorphisms in the promoter of the Haem oxygenase-1 (HMOX1) gene encoding HO-1 have been associated with several diseases including severe malaria. The objective of this study was to determine the allele and genotype frequencies of two single nucleotide polymorphisms; A(-413)T and G(-1135)A, and a (GT)n repeat length polymorphism in the HMOX1 promoter in paediatric malaria patients and controls to determine possible associations with malaria disease severity. METHODS: Study participants were Ghanaian children (n=296) admitted to the emergency room at the Department of Child Health, Korle-Bu Teaching Hospital, Accra, Ghana during the malaria season from June to August in 1995, 1996 and 1997, classified as having uncomplicated malaria (n=101) or severe malaria (n=195; defined as severe anaemia (n=63) or cerebral malaria (n=132)). Furthermore, 287 individuals without a detectable Plasmodium infection or asymptomatic carriers of the parasite were enrolled as controls. Blood samples from participants were extracted for DNA and allele and genotype frequencies were determined with allele-specific PCR, restriction fragment length analysis and microsatellite analysis. RESULTS: The number of (GT)n repeats in the study participants varied between 21 and 46 with the majority of alleles having lengths of 26 (8.1\%), 29/30 (13.2/17.9\%) and 39/40 (8.0/13.8\%) repeats, and was categorized into short, medium and long repeats. The (-413)T allele was very common (69.8\%), while the (-1135)A allele was present in only 17.4\% of the Ghanaian population. The G(-1135)A locus was excluded from further analysis after failing the Hardy-Weinberg equilibrium test. No significant differences in allele or genotype distribution of the A(-413)T and (GT)n repeat polymorphisms were found between the controls and the malaria patients, or between the disease groups, for any of the analysed polymorphisms and no associations with malaria severity were found. CONCLUSION: These results contribute to the understanding of the role of HMOX1/HO-1. This current study did not find any evidence of association between HMOX1 promoter polymorphisms and malaria susceptibility or severe malaria and hence contradicts previous findings. Further studies are needed to fully elucidate the relationship between HMOX1 polymorphisms and malarial disease.},
  langid = {english}
}

