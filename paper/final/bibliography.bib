@article{Feikin2017-xo,
  title = {The Enduring Challenge of Determining Pneumonia Etiology in Children: {{Considerations}} for Future Research Priorities},
  author = {Feikin, Daniel R and Hammitt, Laura L and Murdoch, David R and O'Brien, Katherine L and Scott, J Anthony G},
  year = {2017},
  month = jun,
  journal = {Clinical Infectious Diseases},
  volume = {64},
  number = {suppl\_3},
  pages = {S188--S196},
  abstract = {Pneumonia kills more children each year worldwide than any other disease. Nonetheless, accurately determining the causes of childhood pneumonia has remained elusive. Over the past century, the focus of pneumonia etiology research has shifted from studies of lung aspirates and postmortem specimens intent on identifying pneumococcal disease to studies of multiple specimen types distant from the lung that are tested for multiple pathogens. Some major challenges facing modern pneumonia etiology studies include the use of nonspecific and variable case definitions, poor access to pathologic lung tissue and to specimens from fatal cases, poor diagnostic accuracy of assays (especially when testing nonpulmonary specimens), and the interpretation of results when multiple pathogens are detected in a given individual. The future of childhood pneumonia etiology research will likely require integrating data from complementary approaches, including applications of advanced molecular diagnostics and vaccine probe studies, as well as a renewed emphasis on lung aspirates from radiologically confirmed pneumonia and postmortem examinations.},
  langid = {english},
  keywords = {acute lower respiratory tract infections.,causation,etiology,pneumonia}
}

