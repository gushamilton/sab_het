@article{ProCESS_Investigators2014-ag,
  title = {A Randomized Trial of Protocol-Based Care for Early Septic Shock},
  author = {{ProCESS Investigators} and Yealy, Donald M and Kellum, John A and Huang, David T and Barnato, Amber E and Weissfeld, Lisa A and Pike, Francis and Terndrup, Thomas and Wang, Henry E and Hou, Peter C and LoVecchio, Frank and Filbin, Michael R and Shapiro, Nathan I and Angus, Derek C},
  year = {2014},
  month = may,
  journal = {New England Journal of Medicine},
  volume = {370},
  number = {18},
  pages = {1683--1693},
  abstract = {BACKGROUND: In a single-center study published more than a decade ago involving patients presenting to the emergency department with severe sepsis and septic shock, mortality was markedly lower among those who were treated according to a 6-hour protocol of early goal-directed therapy (EGDT), in which intravenous fluids, vasopressors, inotropes, and blood transfusions were adjusted to reach central hemodynamic targets, than among those receiving usual care. We conducted a trial to determine whether these findings were generalizable and whether all aspects of the protocol were necessary. METHODS: In 31 emergency departments in the United States, we randomly assigned patients with septic shock to one of three groups for 6 hours of resuscitation: protocol-based EGDT; protocol-based standard therapy that did not require the placement of a central venous catheter, administration of inotropes, or blood transfusions; or usual care. The primary end point was 60-day in-hospital mortality. We tested sequentially whether protocol-based care (EGDT and standard-therapy groups combined) was superior to usual care and whether protocol-based EGDT was superior to protocol-based standard therapy. Secondary outcomes included longer-term mortality and the need for organ support. RESULTS: We enrolled 1341 patients, of whom 439 were randomly assigned to protocol-based EGDT, 446 to protocol-based standard therapy, and 456 to usual care. Resuscitation strategies differed significantly with respect to the monitoring of central venous pressure and oxygen and the use of intravenous fluids, vasopressors, inotropes, and blood transfusions. By 60 days, there were 92 deaths in the protocol-based EGDT group (21.0\%), 81 in the protocol-based standard-therapy group (18.2\%), and 86 in the usual-care group (18.9\%) (relative risk with protocol-based therapy vs. usual care, 1.04; 95\% confidence interval [CI], 0.82 to 1.31; P=0.83; relative risk with protocol-based EGDT vs. protocol-based standard therapy, 1.15; 95\% CI, 0.88 to 1.51; P=0.31). There were no significant differences in 90-day mortality, 1-year mortality, or the need for organ support. CONCLUSIONS: In a multicenter trial conducted in the tertiary care setting, protocol-based resuscitation of patients in whom septic shock was diagnosed in the emergency department did not improve outcomes. (Funded by the National Institute of General Medical Sciences; ProCESS ClinicalTrials.gov number, NCT00510835.).},
  langid = {english},
  keywords = {Adult,Aged,Anti-Bacterial Agents,Anti-Bacterial Agents: therapeutic use,Blood Transfusion,Cardiotonic Agents,Cardiotonic Agents: therapeutic use,Clinical Protocols,Combined Modality Therapy,Emergency Service,Female,Fluid Therapy,Hospital,Hospital Mortality,Humans,Male,Mendeley Import (Dec 08),Middle Aged,Outcome Assessment (Health Care),Resuscitation,Resuscitation: standards,Septic,Septic: diagnosis,Septic: mortality,Septic: therapy,Shock,Vasoconstrictor Agents,Vasoconstrictor Agents: therapeutic use}
}

