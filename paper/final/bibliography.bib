@article{andrewsShortRepeatsHeme2016,
  title = {Short Repeats in the Heme Oxygenase 1 Gene Promoter Is Associated with Increased Levels of Inflammation, Ferritin and Higher Risk of Type-2 Diabetes Mellitus},
  author = {Andrews, M{\'o}nica and Leiva, Elba and {Arredondo-Olgu{\'i}n}, Miguel},
  year = {2016},
  month = sep,
  journal = {J. Trace Elem. Med. Biol.},
  volume = {37},
  pages = {25--30},
  publisher = {Elsevier GmbH (E-mail: info@urbanfischer.de)},
  address = {Germany},
  abstract = {OBJECTIVE: We evaluated the relationship between the HO1 genotype, ferritin levels and the risk of type-2 diabetes and inflammation. RESEARCH METHODS: Eight hundred thirty-five individuals were evaluated and classified according to their nutritional status and the presence of type-2 diabetes: 153 overweight (OW); 62 obese (OB); 55 type-2 diabetes mellitus (DM); 202 OWDM; 239 OBDM and 124 controls (C). We studied biochemical (glycemia, insulin, lipid profile, liver enzyme, creatinine, hsCRP), hematological (hemoglobin, free erythrocyte protoporphyrin, transferrin receptor and serum Fe and ferritin) and oxidative stress (SOD, GHS and TBARS) parameters. We determined heme oxygenase activity and the (GT)n polymorphism in its gene promoter. RESULTS: Individuals with diabetes, independent of nutritional status, showed high levels of ferritin and HO activity compared to control subjects. Allelic frequency was not different between the groups (Chi(2), NS) however, genotypes were different (Chi(2), P{$<$}0.001). The SS (short-short) genotype was higher in all DM individuals compared to controls and MM was higher in controls. SM (short-medium) genotype was an independent risk factor for DM in logistic regression analysis. We observed high risk for type-2 diabetes mellitus in the presence of SM genotype and high levels of ferritin (OR adjusted: 2.7; 1.9-3.6; p{$<$}0.001; compared to control group). It was also significantly related to inflammation. CONCLUSION: The SM genotype in HO1 gene promoter and ferritin levels were associated with higher risk for type-2 diabetes and for having a higher marker of inflammation, which is the main risk factor for the development of chronic diseases.},
  langid = {english},
  keywords = {*ferritin/ec [Endogenous Compound],*heme oxygenase 1 gene,*heme oxygenase 1/ec [Endogenous Compound],*inflammation,*non insulin dependent diabetes mellitus/et [Etiology],adult,article,C reactive protein/ec [Endogenous Compound],controlled study,creatinine/ec [Endogenous Compound],enzyme activity,erythrocyte protoporphyrin/ec [Endogenous Compound],female,Ferritin,gene frequency,genetic association,genetic polymorphism,genotype,glutathione/ec [Endogenous Compound],Heme oxygenase,hemoglobin/ec [Endogenous Compound],human,Inflammation,insulin/ec [Endogenous Compound],Iron,liver enzyme/ec [Endogenous Compound],major clinical study,male,ovid_export_ris.ris,oxidative stress,Polymorphism,priority journal,promoter region,risk factor,superoxide dismutase/ec [Endogenous Compound],thiobarbituric acid reactive substance/ec [Endogenous Compound],transferrin receptor/ec [Endogenous Compound],Type-2 diabetes mellitus}
}

