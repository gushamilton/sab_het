@article{salisCytotoxicEffectFluvastatin2014,
  title = {Cytotoxic Effect of Fluvastatin on {{MCF-7}} Cells Possibly through a Reduction of the {{mRNA}} Expression Levels of {{SGK1}} and {{CAV1}}},
  author = {Salis, Osman and Bedir, Abdulkerim and Gulten, Sedat and Okuyucu, Ali and Kulcu, Canan and Alacam, Hasan},
  year = {2014},
  month = nov,
  journal = {Cancer Biother. Radiopharm.},
  volume = {29},
  number = {9},
  pages = {368--375},
  publisher = {Mary Ann Liebert Inc. (E-mail: info@liebertpub.com)},
  address = {United States},
  abstract = {Fluvastatin (FLU) prevents the conversion of 3-hydroxy-3-methylglutaryl coenzyme A (HMG-CoA) to mevalonic acid by inhibiting HMG-CoA reductase and decreases cholesterol level. Although the effects of FLU treatment on several cancer types through many mechanisms have been identified, its relationship with unfolded protein response and apoptosis has not been clearly understood. In this recent study, we aimed to investigate the cytotoxic effect of Fluvastatin on MCF-7 cells and define the transcriptional regulation of specific genes during the occurrence of this cytotoxic effect. We administered 0.62, 2.5, 5, and 40 {$\mu$}M FLU on MCF-7 cells singly and in combination with 2-deoxyglucose (2-DG), and we monitored cell viability and proliferation for 48 hours using real-time cell analyzer system (xCELLigence). At the same time, we measured the mRNA expression levels of glucose-regulated protein 78 (GRP78), CCAAT/enhancer binding protein, homologous protein (CHOP), caveolin-1 (CAV1), NDRG1 Variant 1 and Variant 2, HMOX1, SGK1, and prostate apoptosis response-4 (PAR4) genes using quantitative real-time polymerase chain reaction (LightCycler 480 II). We accepted GAPDH gene and control groups as the reference gene and calibrator, respectively. We performed relative gene expression analyses of the study groups using the QIAGEN 2009 Relative Expression Software Tool (REST). FLU revealed an antiproliferative and cytotoxic effect on MCF-7 cells, while causing the transcriptional regulation of many genes. Of these genes, the mRNA expressions of CHOP, heme oxygenase 1 (HMOX1), N-myc downstream-regulated gene 1 (NDRG1) V1, and NDRG1 V2 increased. On the other hand, the mRNA expression levels of SGK1 and CAV1 decreased. The antiproliferative effects of FLU may be related to the decreased expression levels of SGK1 and CAV1.},
  langid = {english},
  keywords = {*caveolin 1/ec [Endogenous Compound],*cytotoxicity,*fluindostatin/cb [Drug Combination],*fluindostatin/do [Drug Dose],*fluindostatin/pd [Pharmacology],*gene expression,*MCF-7 cell line,*messenger RNA/ec [Endogenous Compound],*serum and glucocorticoid regulated kinase 1/ec [Endogenous Compound],antiproliferative activity,apoptosis,article,CAV1,CCAAT enhancer binding protein/ec [Endogenous Compound],cell proliferation,cell viability,controlled study,cytotoxic effect,deoxyglucose/cb [Drug Combination],deoxyglucose/pd [Pharmacology],dose response,fluvastatin,glucose regulated protein 78/ec [Endogenous Compound],glyceraldehyde 3 phosphate dehydrogenase/ec [Endogenous Compound],heme oxygenase 1/ec [Endogenous Compound],human,IC50,MCF-7,N myc downstream regulated gene 1 protein/ec [Endogenous Compound],n myc downstream regulated gene 2 protein/ec [Endogenous Compound],ovid_export_ris.ris,prostate apoptosis response 4 protein/ec [Endogenous Compound],protein c Myb/ec [Endogenous Compound],quantitative analysis,real time polymerase chain reaction,SGK1,single drug dose,transcription regulation,tumor microenvironment,unclassified drug,unfolded protein response}
}

