@article{kircherGeneralFrameworkEstimating2014,
  title = {A General Framework for Estimating the Relative Pathogenicity of Human Genetic Variants},
  author = {Kircher, Martin and Witten, Daniela M and Jain, Preti and O'Roak, Brian J and Cooper, Gregory M and Shendure, Jay},
  year = {2014},
  month = mar,
  journal = {Nat. Genet.},
  volume = {46},
  number = {3},
  pages = {310--315},
  abstract = {Current methods for annotating and interpreting human genetic variation tend to exploit a single information type (for example, conservation) and/or are restricted in scope (for example, to missense changes). Here we describe Combined Annotation-Dependent Depletion (CADD), a method for objectively integrating many diverse annotations into a single measure (C score) for each variant. We implement CADD as a support vector machine trained to differentiate 14.7 million high-frequency human-derived alleles from 14.7 million simulated variants. We precompute C scores for all 8.6 billion possible human single-nucleotide variants and enable scoring of short insertions-deletions. C scores correlate with allelic diversity, annotations of functionality, pathogenicity, disease severity, experimentally measured regulatory effects and complex trait associations, and they highly rank known pathogenic variants within individual genomes. The ability of CADD to prioritize functional, deleterious and pathogenic variants across many functional categories, effect sizes and genetic architectures is unmatched by any current single-annotation method.},
  langid = {english}
}

@article{kirinoGenomewideAssociationAnalysis2013,
  title = {Genome-Wide Association Analysis Identifies New Susceptibility Loci for {{Beh{\c c}et}}'s Disease and Epistasis between {{HLA-B}}*51 and {{ERAP1}}},
  author = {Kirino, Yohei and Bertsias, George and Ishigatsubo, Yoshiaki and Mizuki, Nobuhisa and {Tugal-Tutkun}, Ilknur and Seyahi, Emire and Ozyazgan, Yilmaz and Sacli, F Sevgi and Erer, Burak and Inoko, Hidetoshi and Emrence, Zeliha and Cakar, Atilla and Abaci, Neslihan and Ustek, Duran and Satorius, Colleen and Ueda, Atsuhisa and Takeno, Mitsuhiro and Kim, Yoonhee and Wood, Geryl M and Ombrello, Michael J and Meguro, Akira and G{\"u}l, Ahmet and Remmers, Elaine F and Kastner, Daniel L},
  year = {2013},
  month = feb,
  journal = {Nat. Genet.},
  volume = {45},
  number = {2},
  pages = {202--207},
  abstract = {Individuals with Beh{\c c}et's disease suffer from episodic inflammation often affecting the orogenital mucosa, skin and eyes. To discover new susceptibility loci for Beh{\c c}et's disease, we performed a genome-wide association study (GWAS) of 779,465 SNPs with imputed genotypes in 1,209 Turkish individuals with Beh{\c c}et's disease and 1,278 controls. We identified new associations at CCR1, STAT4 and KLRC4. Additionally, two SNPs in ERAP1, encoding ERAP1 p.Asp575Asn and p.Arg725Gln alterations, recessively conferred disease risk. These findings were replicated in 1,468 independent Turkish and/or 1,352 Japanese samples (combined meta-analysis P {$<$} 2 {\textbackslash}times 10(-9)). We also found evidence for interaction between HLA-B*51 and ERAP1 (P = 9 {\textbackslash}times 10(-4)). The CCR1 and STAT4 variants were associated with gene expression differences. Three risk loci shared with ankylosing spondylitis and psoriasis (the MHC class I region, ERAP1 and IL23R and the MHC class I-ERAP1 interaction), as well as two loci shared with inflammatory bowel disease (IL23R and IL10) implicate shared pathogenic pathways in the spondyloarthritides and Beh{\c c}et's disease.},
  langid = {english}
}

