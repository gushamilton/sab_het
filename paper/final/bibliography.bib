@article{graeserNrf2dependentGeneExpression2011,
  title = {Nrf2-Dependent Gene Expression Is Affected by the Proatherogenic {{apoE4}} Genotype-Studies in Targeted Gene Replacement Mice},
  author = {Graeser, Anne-Christin and {Boesch-Saadatmandi}, Christine and Lippmann, Jana and Wagner, Anika E and Huebbe, Patricia and Storm, Niels and H{\"o}ppner, Wolfgang and Wiswedel, Ingrid and Gardemann, Andreas and Minihane, Anne M and D{\"o}ring, Frank and Rimbach, Gerald},
  year = {2011},
  month = oct,
  journal = {J. Mol. Med.},
  volume = {89},
  number = {10},
  pages = {1027--1035},
  address = {Germany},
  abstract = {An apoE4 genotype is an important risk factor for cardiovascular and other chronic diseases. The higher cardiovascular disease risk of apoE4 carriers as compared to the apoE3 genotype has been mainly attributed to the differences in blood lipids between the two genotype subgroups. Recently, a potential protective role of the transcription factor Nrf2 in cardiovascular disease prevention has been suggested. In this study, we show that Nrf2-dependent gene expression is affected by the apoE genotype. ApoE4 vs. apoE3 mice exhibited lower hepatic Nrf2 nuclear protein levels. Furthermore, mRNA and protein levels of Nrf2 target genes including glutathione-S-transferase, heme oxygenase-1 and NAD(P)H dehydrogenase, quinone 1 were significantly lower in apoE4 as compared to apoE3 mice. Lower hepatic mRNA levels of phase II enzymes, as observed in apoE4 vs. apoE3 mice, were accompanied by higher mRNA levels of phase I enzymes including Cyp26a1 and Cyp3a16. Furthermore, miRNA-144, miRNA-125b, and miRNA-29a involved in Nrf2 signaling, inflammation, and regulation of phase I enzyme gene expression were affected by the apoE genotype. We provide first evidence that Nrf2 is differentially regulated in response to the apoE genotype.},
  langid = {english},
  keywords = {*Apolipoprotein E4/ge [Genetics],*Atherosclerosis/ge [Genetics],*Gene Expression Regulation,*Gene Targeting,*NF-E2-Related Factor 2/me [Metabolism],Animals,Apolipoprotein E4/me [Metabolism],Atherosclerosis/pa [Pathology],Cell Line,Cholesterol/me [Metabolism],Computational Biology,DNA Methylation/ge [Genetics],F2-Isoprostanes/me [Metabolism],Female,Gene Expression Regulation/de [Drug Effects],Genetic/ge [Genetics],Genotype,Glutathione Transferase/ge [Genetics],Glutathione Transferase/me [Metabolism],Heme Oxygenase-1/ge [Genetics],Heme Oxygenase-1/me [Metabolism],Humans,Liver/de [Drug Effects],Liver/en [Enzymology],Mice,MicroRNAs/ge [Genetics],MicroRNAs/me [Metabolism],NAD(P)H Dehydrogenase (Quinone)/ge [Genetics],NAD(P)H Dehydrogenase (Quinone)/me [Metabolism],ovid_export_ris.ris,Promoter Regions,Real-Time Polymerase Chain Reaction,Rosiglitazone,Thiazolidinediones/pd [Pharmacology],Triglycerides/me [Metabolism],Tumor}
}

