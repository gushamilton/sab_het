@article{freystaetterRecipientsHemeOxygenase12017,
  title = {The Recipient's Heme Oxygenase-1 Promoter Region Polymorphism Is Associated with Cardiac Allograft Vasculopathy},
  author = {Freystaetter, Kathrin and Andreas, Martin and Bilban, Martin and Perkmann, Thomas and Kaider, Alexandra and Masetti, Marco and Kocher, Alfred and Wolzt, Michael and Zuckermann, Andreas},
