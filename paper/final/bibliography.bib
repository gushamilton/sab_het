@article{repessey.Tuesday26July2011,
  title = {Tuesday, 26 {{July}} 2011},
  author = {{Repesse Y.} and {Dimitrov J.} and {Dasgupta S.} and {Farrokhi E.} and {Costa C.} and {Pavlova A.} and {Borel Derlon A.} and {D'Oiron R.} and {Oldenburg J.} and {Kaveri S.} and {Lacroix-Desmazes S.}},
  year = {2011},
  month = jul,
  journal = {J. Thromb. Haemost.},
  volume = {9},
  number = {SUPPL. 2},
  pages = {251--498},
  publisher = {Elsevier BV},
  abstract = {The occurrence of inhibitory anti-factor VIII (FVIII) antibodies is the major complication of replacement therapy in hemophilia A patients. Heme oxygenase-1 (HO-1) is a stress inducible enzyme with antiinflammatory activity. HO-1 induction in hemophilic mice reduces the immunogenicity of therapeutic FVIII. Polymorphisms in the promoter of the HMOX1 gene modulate HO-1 expression. We investigated the relationship between HMOX1 promoter polymorphisms in severe hemophilia A patients and FVIII inhibitor development. We analyzed 62 patients with severe hemophilia A with FVIII inhibitors and 193 patients who did not develop inhibitor within the first 150 cumulative days of exposure to FVIII. We studied the variable (GT)n polymorphism and single nucleotide polymorphisms located at -1135 and -413 in the HMOX1 promoter. Association between individual allele frequencies or genotypes, and inhibitor development was assessed. Our results demonstrate a higher frequency of alleles with large number of GT repeat (n {$>$} 32, L) in inhibitor-positive patients (odds ratio [OR] 2.11; 95\% CI 1.04-4.26, P = 0.035). Six genotypes (L/L, L/M, L/S, M/M, M/S and S/S) of (GT)n repeats were identified (S: n {$<$} 23; M: 23 {$<$} n {$<$} 31). The genotype subgroup including L/L and L/M was more frequent among inhibitor-positive than inhibitornegative patients, as compared to the other genotypes (19.4\% vs. 9.3\%) (OR 2.33, 95\% CI 1.05-5.16, P = 0.033). To our knowledge, this is the first association between HMOX1 promoter polymorphism and the development of anti-drug antibodies. Recently, other groups identified a polymorphism in the TNF-alphaencoding gene as a predictive factor for inhibitor development in patients with hemophilia A. Interestingly, the effects of TNF-alpha and HO-1 have been shown to counteract each other. Modulating the endogenous anti-inflammatory machinery of hemophilia patients appears as a plausible therapeutic option for reducing the risk of inhibitor development.},
  copyright = {http://www.elsevier.com/open-access/userlicense/1.0/},
  langid = {english},
  keywords = {*antibody,*blood clotting factor 8,*hemophilia A,*hemostasis,*promoter region,*society,*thrombosis,allele,antiinflammatory activity,drug antibody,enzyme,exposure,gene,gene frequency,genotype,heme oxygenase 1,hemophilia,human,immunogenicity,machine,mouse,ovid_export_ris.ris,patient,risk,single nucleotide polymorphism,substitution therapy}
}

