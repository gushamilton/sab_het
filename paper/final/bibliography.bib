@article{Epiphanio2008-lm,
  title = {Heme Oxygenase-1 Is an Anti-Inflammatory Host Factor That Promotes Murine Plasmodium Liver Infection},
  author = {Epiphanio, Sabrina and Mikolajczak, Sebastian A and Gon{\c c}alves, L{\'i}gia A and Pamplona, Ana and Portugal, Silvia and Albuquerque, S{\'o}nia and Goldberg, Michael and Rebelo, Sofia and Anderson, Daniel G and Akinc, Akin and Vornlocher, Hans-Peter and Kappe, Stefan H I and Soares, Miguel P and Mota, Maria M},
  year = {2008},
  month = may,
  journal = {Cell Host \& Microbe},
  volume = {3},
  number = {5},
  pages = {331--338},
  abstract = {The clinically silent Plasmodium liver stage is an obligatory step in the establishment of malaria infection and disease. We report here that expression of heme oxygenase-1 (HO-1, encoded by Hmox1) is upregulated in the liver following infection by Plasmodium berghei and Plasmodium yoelii sporozoites. HO-1 overexpression in the liver leads to a proportional increase in parasite liver load, and treatment of mice with carbon monoxide and with biliverdin, each an enzymatic product of HO-1, also increases parasite liver load. Conversely, mice lacking Hmox1 completely resolve the infection. In the absence of HO-1, the levels of inflammatory cytokines involved in the control of liver infection are increased. These findings suggest that, while stimulating inflammation, the liver stage of Plasmodium also induces HO-1 expression, which modulates the host inflammatory response, protecting the infected hepatocytes and promoting the liver stage of infection.},
  langid = {english}
}

