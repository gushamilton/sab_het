@article{Manouras2008-fc,
  title = {Intracystic Hemorrhage in a Mediastinal Cystic Adenoma Causing Parathyrotoxic Crisis},
  author = {Manouras, Andreas and Toutouzas, Konstantinos G and Markogiannakis, Haridimos and Lagoudianakis, Emmanuel and Papadima, Artemis and Antonakis, Pantelis T and Kafiri, Georgia and Bramis, Ioannis},
  year = {2008},
  journal = {Head \& neck},
  volume = {30},
  number = {1},
  pages = {127--131},
  publisher = {Department of Endocrine Surgery, First Department of Propaedeutic Surgery, Hippokration Hospital, University of Athens, Athens Medical School, Athens, Greece.},
  address = {United States},
  abstract = {BACKGROUND: We report a case of intracystic hemorrhage in a mediastinal cystic parathyroid adenoma causing parathyrotoxic crisis., METHODS AND RESULTS: A 30-year-old man presented with a large neck mass, dyspnea, and abdominal pain. The patient's serum calcium and parathormone levels were elevated. Radiography showed a right tracheal deviation, ultrasonography identified a thyroid nodular goiter extending to the mediastinum with a large (4.0 cm x 5.6 cm) cystic mass adjacent to the lower left thyroid pole. After IV fluid, pamidronate, and furosemide were administered, the patient underwent total thyroidectomy, and excision of the cyst and a small mass (2 cm x 2 cm) adjacent to the upper right thyroid lobe. Histopathologic examination revealed a double parathyroid adenoma and identified the mediastinal lesion as a cystic adenoma with intracystic hemorrhage., CONCLUSIONS: Intracystic hemorrhage in a functional mediastinal cystic parathyroid adenoma is an extremely rare cause of parathyrotoxic crisis. Aggressive medical treatment should be immediately instituted, and surgery should be performed as soon as hypercalcemia is controlled.},
  keywords = {*Cystadenoma/pa [Pathology],*Hemorrhage/co [Complications],*Hypercalcemia/et [Etiology],*Mediastinal Neoplasms/pa [Pathology],*Thyroid Crisis/et [Etiology],Adenoma/pa [Pathology],Adenoma/su [Surgery],Adult,Bone Density Conservation Agents/tu [Therapeutic U,Cystadenoma/su [Surgery],Diphosphonates/tu [Therapeutic Use],Diuretics/tu [Therapeutic Use],Fluid Therapy,Furosemide/tu [Therapeutic Use],Hemorrhage/et [Etiology],Hemorrhage/su [Surgery],Humans,Hypercalcemia/th [Therapy],Hyperparathyroidism/et [Etiology],Hyperparathyroidism/th [Therapy],Male,Mediastinal Neoplasms/su [Surgery],Mendeley Import (Dec 08),Parathyroid Neoplasms/pa [Pathology],Parathyroid Neoplasms/su [Surgery],Thyroid Crisis/th [Therapy],Thyroidectomy}
}

