@article{foxmanTemperaturedependentInnateDefense2015,
  title = {Temperature-Dependent Innate Defense against the Common Cold Virus Limits Viral Replication at Warm Temperature in Mouse Airway Cells},
  author = {Foxman, Ellen F and Storer, James A and Fitzgerald, Megan E and Wasik, Bethany R and Hou, Lin and Zhao, Hongyu and Turner, Paul E and Pyle, Anna Marie and Iwasaki, Akiko},
  year = {2015},
  month = jan,
  journal = {Proc. Natl. Acad. Sci. U. S. A.},
  volume = {112},
  number = {3},
  pages = {827--832},
  publisher = {Proceedings of the National Academy of Sciences},
  abstract = {Most isolates of human rhinovirus, the common cold virus, replicate more robustly at the cool temperatures found in the nasal cavity (33-35 {$^\circ$}C) than at core body temperature (37 {$^\circ$}C). To gain insight into the mechanism of temperature-dependent growth, we compared the transcriptional response of primary mouse airway epithelial cells infected with rhinovirus at 33 {$^\circ$}C vs. 37 {$^\circ$}C. Mouse airway cells infected with mouse-adapted rhinovirus 1B exhibited a striking enrichment in expression of antiviral defense response genes at 37 {$^\circ$}C relative to 33 {$^\circ$}C, which correlated with significantly higher expression levels of type I and type III IFN genes and IFN-stimulated genes (ISGs) at 37 {$^\circ$}C. Temperature-dependent IFN induction in response to rhinovirus was dependent on the MAVS protein, a key signaling adaptor of the RIG-I-like receptors (RLRs). Stimulation of primary airway cells with the synthetic RLR ligand poly I:C led to greater IFN induction at 37 {$^\circ$}C relative to 33 {$^\circ$}C at early time points poststimulation and to a sustained increase in the induction of ISGs at 37 {$^\circ$}C relative to 33 {$^\circ$}C. Recombinant type I IFN also stimulated more robust induction of ISGs at 37 {$^\circ$}C than at 33 {$^\circ$}C. Genetic deficiency of MAVS or the type I IFN receptor in infected airway cells permitted higher levels of viral replication, particularly at 37 {$^\circ$}C, and partially rescued the temperature-dependent growth phenotype. These findings demonstrate that in mouse airway cells, rhinovirus replicates preferentially at nasal cavity temperature due, in part, to a less efficient antiviral defense response of infected cells at cool temperature.},
  copyright = {http://www.pnas.org/site/misc/userlicense.xhtml},
  langid = {english},
  keywords = {airway,common cold,innate immunity,rhinovirus,RIG-I}
}

@article{foxTuberculosisNewbornsLessons2016,
  title = {Tuberculosis in {{Newborns}}: {{The Lessons}} of the ``{{L{\"u}beck Disaster}}'' (1929--1933)},
  shorttitle = {Tuberculosis in {{Newborns}}},
  author = {Fox, Gregory J. and Orlova, Marianna and Schurr, Erwin},
  year = {2016},
  month = jan,
  journal = {PLOS Pathogens},
  volume = {12},
  number = {1},
  pages = {e1005271},
  publisher = {Public Library of Science},
  issn = {1553-7374},
  doi = {10.1371/journal.ppat.1005271},
  urldate = {2020-10-08},
  abstract = {In an accident later known as the L{\"u}beck disaster, 251 neonates were orally given three doses of the new Bacille Calmette--Gu{\'e}rin (BCG) antituberculosis (TB) vaccine contaminated with Mycobacterium tuberculosis. A total of 173 infants developed clinical or radiological signs of TB but survived the infection, while 72 died from TB. While some blamed the accident on BCG itself by postulating reversion to full virulence, such a possibility was conclusively disproven. Rather, by combining clinical, microbiological, and epidemiological data, the chief public health investigator Dr. A. Moegling concluded that the BCG vaccine had been contaminated with variable amounts of fully virulent M. tuberculosis. Here, we summarize the conclusions drawn by Moegling and point out three lessons that can be learned. First, while mortality was high (approximately 29\%), the majority of neonates inoculated with M. tuberculosis eventually overcame TB disease. This shows the high constitutional resistance of humans to the bacillus. Second, four semiquantitative levels of contamination were deduced by Moegling from the available data. While at low levels of M. tuberculosis there was a large spread of clinical phenotypes reflecting a good degree of innate resistance to TB, at the highest dose, the majority of neonates were highly susceptible to TB. This shows the dominating role of dose for innate resistance to TB. Third, two infants inoculated with the lowest dose nevertheless died of TB, and their median time from inoculation to death was substantially shorter than for those who died after inoculation with higher doses. This suggests that infants who developed disease after low dose inoculation are those who are most susceptible to the disease. We discuss some implications of these lessons for current study of genetic susceptibility to TB.},
  langid = {english},
  keywords = {Bovine tuberculosis,Infants,Mycobacterium tuberculosis,Prognosis,Respiratory infections,Tuberculosis,Vaccination and immunization,Vaccines},
  file = {/Users/fh6520/Zotero/storage/RVG3EWKF/Fox et al. - 2016 - Tuberculosis in Newborns The Lessons of the “Lübe.pdf;/Users/fh6520/Zotero/storage/3RBQSS87/article.html}
}

@article{foxTuberculosisNewbornsLessons2016a,
  title = {Tuberculosis in {{Newborns}}: {{The Lessons}} of the ``{{L{\"u}beck Disaster}}'' (1929-1933)},
  author = {Fox, Gregory J and Orlova, Marianna and Schurr, Erwin},
  year = {2016},
  month = jan,
  journal = {PLoS Pathog.},
  volume = {12},
  number = {1},
  pages = {e1005271},
  abstract = {In an accident later known as the L{\"u}beck disaster, 251 neonates were orally given three doses of the new Bacille Calmette-Gu{\'e}rin (BCG) antituberculosis (TB) vaccine contaminated with Mycobacterium tuberculosis. A total of 173 infants developed clinical or radiological signs of TB but survived the infection, while 72 died from TB. While some blamed the accident on BCG itself by postulating reversion to full virulence, such a possibility was conclusively disproven. Rather, by combining clinical, microbiological, and epidemiological data, the chief public health investigator Dr. A. Moegling concluded that the BCG vaccine had been contaminated with variable amounts of fully virulent M. tuberculosis. Here, we summarize the conclusions drawn by Moegling and point out three lessons that can be learned. First, while mortality was high (approximately 29\%), the majority of neonates inoculated with M. tuberculosis eventually overcame TB disease. This shows the high constitutional resistance of humans to the bacillus. Second, four semiquantitative levels of contamination were deduced by Moegling from the available data. While at low levels of M. tuberculosis there was a large spread of clinical phenotypes reflecting a good degree of innate resistance to TB, at the highest dose, the majority of neonates were highly susceptible to TB. This shows the dominating role of dose for innate resistance to TB. Third, two infants inoculated with the lowest dose nevertheless died of TB, and their median time from inoculation to death was substantially shorter than for those who died after inoculation with higher doses. This suggests that infants who developed disease after low dose inoculation are those who are most susceptible to the disease. We discuss some implications of these lessons for current study of genetic susceptibility to TB.},
  langid = {english}
}

@article{fragkouTransmissionInfectionsCardiopulmonary2021,
  title = {Transmission of {{Infections}} during {{Cardiopulmonary Resuscitation}}},
  author = {Fragkou, Paraskevi C and Dimopoulou, Dimitra and Latsios, George and Koudounis, Panagiotis and Synetos, Andreas and Dimopoulou, Anastasia and Tsioufis, Konstantinos and Papaevangelou, Vassiliki and Tsiodras, Sotirios},
  year = {2021},
  month = dec,
  journal = {Clin. Microbiol. Rev.},
  volume = {34},
  number = {4},
  pages = {e0001821},
  abstract = {Cardiopulmonary resuscitation (CPR) is an emergency lifesaving endeavor, performed in either the hospital or outpatient settings, that significantly improves outcomes and survival rates when performed in a timely fashion. As with any other medical procedure, CPR can bear potential risks not only for the patient but also for the rescuer. Among those risks, transmission of an infectious agent has been one of the most compelling triggers of reluctance to perform CPR among providers. The concern for transmission of an infection from the resuscitated subject may impede prompt initiation and implementation of CPR, compromising survival rates and neurological outcomes of the patients. Infections during CPR can be potentially acquired through airborne, droplet, contact, or hematogenous transmission. However, only a few cases of infection transmission have been actually reported globally. In this review, we present the available epidemiological findings on transmission of different pathogens during CPR and data on reluctance of health care workers to perform CPR. We also outline the levels of personal protective equipment and other protective measures according to potential infectious hazards that providers are potentially exposed to during CPR and summarize current guidelines on protection of CPR providers from international societies and stakeholders.},
  langid = {english},
  keywords = {airborne,blood-borne,cardiopulmonary,COVID-19,infection,resuscitation,SARS-CoV-2,transmission}
}

@article{Fraker1990-kb,
  title = {Undescended Parathyroid Adenoma: An Important Etiology for Failed Operations for Primary Hyperparathyroidism},
  author = {Fraker, D L and Doppman, J L and Shawker, T H and Marx, S J and Spiegel, A M and Norton, J A},
  year = {1990},
  journal = {World journal of surgery},
  volume = {14},
  number = {3},
  pages = {342--348},
  publisher = {Surgery Branch, National Cancer Institute, Bethesda, Maryland 20892.},
  address = {UNITED STATES},
  abstract = {From July, 1982 to April, 1989, a total of 145 patients with persistent or recurrent primary hyperparathyroidism (HPT) were explored; 105 patients had an adenoma as the cause of HPT, and in 9 patients (9\%), the abnormal gland was located at or superior to the carotid bifurcation (undescended parathyroid gland). These 9 patients had 14 prior explorations for HPT including 4 median sternotomies and 5 thyroidectomies. Each of the 9 patients was symptomatic of HPT, including bone disease in 8 of 9 patients and renal stones in 4 of 9 patients. Seven patients had an undescended parathyroid adenoma correctly localized preoperatively by ultrasound (n = 5), angiography (n = 5), venous sampling (n = 1), or computed tomography scan (n = 4). These 7 patients with accurate preoperative localization were explored by an incision anterior to the sternocleidomastoid muscle high in the neck that avoided the previous operative field and allowed rapid resection of the parathyroid adenoma. In the 2 patients who did not have accurate preoperative localization, the undescended adenoma was found after long tedious exploration including median sternotomy in 1 patient. Each patient (n = 9) who had an undescended parathyroid adenoma removed was cured of hypercalcemia, and 5 patients required postoperative 1,25-dihydroxy vitamin D3 for hypocalcemia. We conclude that undescended parathyroid adenomas comprise a significant proportion (9\%) of adenomas during reoperations for persistent HPT.(ABSTRACT TRUNCATED AT 250 WORDS)},
  keywords = {*Adenoma/su [Surgery],*Hyperparathyroidism/su [Surgery],*Parathyroid Glands/su [Surgery],*Parathyroid Neoplasms/su [Surgery],Adenoma/di [Diagnosis],Adult,Aged,Female,Follow-Up Studies,Humans,Hyperparathyroidism/di [Diagnosis],Male,Mendeley Import (Dec 08),Middle Aged,Parathyroid Neoplasms/di [Diagnosis],Recurrence,Reoperation}
}

