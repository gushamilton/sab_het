@article{matsumotoa.2012ISBRAInternational2012,
  title = {2012 {{ISBRA}} ({{International Society}} for {{Biomedical Research}} on {{Alcoholism}}) {{World Congress}}. {{September}} 8-12, 2012. {{Sapporo}}, {{Japan}}},
  author = {{Matsumoto A.} and {Kitagawa K.} and {Kawamoto T.} and {Vasiliou V.} and {Ichiba M.}},
  year = {2012},
  month = sep,
  journal = {Alcohol. Clin. Exp. Res.},
  volume = {36 Suppl 2},
  number = {SUPPL.2},
  pages = {1A--152A},
  publisher = {Blackwell Publishing Ltd},
  abstract = {Background: A genetic polymorphism of aldehyde dehydrogenase 2 (ALDH2), ALDH2*2 is commonly found in the Asian population. It is a relevant polymorphism because its carriers have a diminished capacity to efficiently metabolize acetaldehyde, an important ethanol metabolite. Given the pathophysiological actions of acetaldehyde, one would predict that people with this polymorphism would be more vulnerable to alcoholic liver disease. However, several studies have failed to establish a higher risk of ALDH2*2 allele on hepatic disease. Other studies have suggested a beneficial effect on liver tissue. This investigation examines the role of ALDH2 deficiency in ethanol-induced liver damage in mice. Method(s): Ethanol (0-20\%) was administered in drinking water to 10 wk old Aldh2+/+ (WT), Aldh2+/- (HT) and Aldh2-/- (KO) mice for 5 wk. All mice were provided standard hard feed. Liver damage was estimated by measurement of serum and hepatic markers and pathological evaluation at the end of the 5 wk ethanol feeding period. Result(s): At the end of the 5 wk ethanol feeding period, serum ALT levels were the same in all mice fed 0\% ethanol. Ethanol feeding induced dose-dependent decreases in serum ALT in HT and KO mice but not in WT mice. In contrast to serum ALT levels, KO showed ethanol induced ballooning change in hepatocyte dose-dependently whereas WT mice did not show a significant change. At the end of the 5 week period, oxidative stress levels were lower in KO mice and expression of heme oxygenase 1 (HO-1), thioredoxin reductase 1 (TrxR1) and cytochrome P450 2E1 (CYP2E1), was induced. Conclusion(s): Our findings suggest that inactive ALDH2 may protect livers from alcoholinduced damage by the increased expression of the oxygen radical scavenging enzymes HO-1 and TrxR1. These beneficial effects may be offset, in part, by increased CYP2E1 expression, a potential source of oxygen radicals.},
  langid = {english},
  keywords = {*alcohol,*alcoholism,*heme,*liver,*medical research,*oxidoreductase,*society,acetaldehyde,alcohol liver disease,aldehyde dehydrogenase isoenzyme 2,allele,Asian,cytochrome,cytochrome P450,drinking water,enzyme,feeding,genetic polymorphism,heme oxygenase 1,human,liver cell,liver disease,liver injury,marker,metabolite,mouse,ovid_export_ris.ris,oxidative stress,oxygen radical,population,risk,serum,thioredoxin reductase 1}
}

@article{matsumotoHemeOxygenase12016,
  title = {Heme Oxygenase 1 Protects Ethanol-Administered Liver Tissue in {{Aldh2}} Knockout Mice},
  author = {Matsumoto, Akiko and Thompson, David and Chen, Ying and Vasiliou, Vasilis and Kawamoto, Toshihiro and Ichiba, Masayoshi},
  year = {2016},
  month = may,
  journal = {Alcohol},
  volume = {52},
  pages = {49--54},
  publisher = {Elsevier Inc. (E-mail: usjcs@elsevier.com)},
  address = {United States},
  abstract = {A genetic polymorphism of the aldehyde dehydrogenase 2 (\hspace{0pt}ALDH2) gene, ALDH2*2, encodes an enzymatically defective ALDH2 protein. Recent epidemiological studies suggest that possessing ALDH2*2 is a protective factor for liver tissue in healthy individuals, although these studies lack a mechanistic explanation. Our animal studies have shown the same trend: levels of serum alanine transaminase (ALT), hepatic malondialdehyde (MDA), and hepatic tumor necrosis factor alpha (TNF-{$\alpha$}) were lower in Aldh2 knockout (Aldh2(-/-)) mice than in wild-type (Aldh2(+/+)) mice after ethanol administration. To propose a mechanistic hypothesis, residual liver specimens from the previous experiment were analyzed. An anti-oxidative protein, heme oxygenase 1 (HO-1), and an oxidative stress-producing protein, cytochrome P450 2E1 (CYP2E1), were detected at higher levels in Aldh2(-/-) mice than in Aldh2(+/+) mice, regardless of ethanol treatment. Other oxidative stress-related proteins and inflammatory cytokines did not show such a significant difference. To conclude, we propose a protective role of HO-1 in individuals with A\hspace{0pt}LDH2*2. Our continued studies support the epidemiological finding that possession of ALDH2*2 is a protective factor in the liver of the healthy individual.},
  langid = {english},
  keywords = {*alcohol/to [Drug Toxicity],*aldehyde dehydrogenase isoenzyme 2/ec [Endogenous Compound],*ALDH2 gene,*heme oxygenase 1/ec [Endogenous Compound],*liver protection,*liver toxicity,alanine aminotransferase blood level,alanine aminotransferase/ec [Endogenous Compound],ALDH2,animal experiment,animal model,animal tissue,article,controlled study,CYP2E1,cytochrome P450 2E1/ec [Endogenous Compound],cytokine/ec [Endogenous Compound],female,glutamate cysteine ligase/ec [Endogenous Compound],HO-1,inflammation,malonaldehyde/ec [Endogenous Compound],mouse,nonhuman,ovid_export_ris.ris,oxidative stress,Polymorphism,thioredoxin reductase 1/ec [Endogenous Compound],tumor necrosis factor-alpha/ec [Endogenous Compound],wild type}
}

@article{matthewsAnalysisSerialMeasurements1990,
  title = {Analysis of Serial Measurements in Medical Research},
  author = {Matthews, J N and Altman, D G and Campbell, M J and Royston, P},
  year = {1990},
  month = jan,
  journal = {BMJ},
  volume = {300},
  number = {6719},
  pages = {230--235},
  abstract = {In medical research data are often collected serially on subjects. The statistical analysis of such data is often inadequate in two ways: it may fail to settle clinically relevant questions and it may be statistically invalid. A commonly used method which compares groups at a series of time points, possibly with t tests, is flawed on both counts. There may, however, be a remedy, which takes the form of a two stage method that uses summary measures. In the first stage a suitable summary of the response in an individual, such as a rate of change or an area under a curve, is identified and calculated for each subject. In the second stage these summary measures are analysed by simple statistical techniques as though they were raw data. The method is statistically valid and likely to be more relevant to the study questions. If this method is borne in mind when the experiment is being planned it should promote studies with enough subjects and sufficient observations at critical times to enable useful conclusions to be drawn. Use of summary measures to analyse serial measurements, though not new, is potentially a useful and simple tool in medical research.},
  langid = {english}
}

