@article{Warrell1992-wi,
  title = {Etiology and Current Management of Cancer-Related Hypercalcemia},
  author = {Warrell, R P Jr},
  year = {1992},
  journal = {Oncology (Williston Park, N.Y.)},
  volume = {6},
  number = {10},
  pages = {37--50},
  publisher = {Memorial Sloan-Kettering Cancer Center, New York, New York.},
  address = {UNITED STATES},
  abstract = {Important new information has been gained concerning the etiology of cancer-related hypercalcemia and thus treatment recommendations are changing. The most common cause of hypercalcemia in cancer patients is the parathyroid hormone-like peptide, PTH-RP. Patients with elevated serum calcium due to elaboration of parathyroid hormone-like peptide commonly present with hypophosphatemia and a relatively resistant form of hypercalcemia. Our new knowledge has led to recommendations against massive amounts of IV fluids and large doses of diuretics, which restore normocalcemia in only a minority of patients. New potent drugs such as pamidronate and gallium nitrate directly inhibit accelerated bone resorption. Thus, consideration should be given to the early administration of antiresorptive drugs immediately after intravascular volume has been repleted and urinary output has been established.},
  keywords = {*Hypercalcemia/dt [Drug Therapy],*Hypercalcemia/et [Etiology],*Neoplasms/co [Complications],Humans,Mendeley Import (Dec 08)/hypercalcaemia SS,Neoplasm Proteins/ph [Physiology],Parathyroid Hormone-Related Protein,Parathyroid Hormone/ph [Physiology],Proteins/ph [Physiology]}
}

