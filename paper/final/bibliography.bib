@article{roseTwoDoseOritavancinRegimen2020,
  title = {A {{Two-Dose Oritavancin Regimen Using Pharmacokinetic Estimation Analysis}}},
  author = {Rose, Warren E and Hutson, Paul R},
  year = {2020},
  month = jun,
  journal = {Drugs Real World Outcomes},
  volume = {7},
  number = {Suppl 1},
  pages = {36--40},
  abstract = {BACKGROUND: Antibiotics for the treatment of complicated, multidrug-resistant Gram-positive infections are limited, especially when prolonged treatment is necessary. Oritavancin is approved for the treatment of serious skin infections as a 1200 mg single-dose regimen, but case reports describe supplemental doses given at weekly intervals ranging from 800 mg to 1200 mg. OBJECTIVE: This study determined population pharmacokinetic estimates for a 1200 mg single dose with and without an 800 mg dose 1 week apart. METHODS: A simulated oritavancin 1200 mg dose was infused over 3 h followed 7 days later by a simulated 800 mg dose infused over 3 h for pharmacokinetic estimation. RESULTS: The oritavancin dosing displayed predictable linear pharmacokinetics and therapeutic concentrations. The total and free oritavancin concentrations remained above the susceptibility breakpoint (0.12 mg/L) for 8 weeks and 4.6 weeks, respectively, with the two-dose regimen. This was significantly greater than the single-dose regimen. This regimen also results in a greater area under the drug concentration-time curve (AUC) above the susceptibility breakpoint compared to the single-dose regimen (p {$<$} 0.001), and it maintains a high AUC:minimum inhibitory concentration (MIC) ratio against organisms with MICs up to 0.25 mg/L. CONCLUSION: These results along with the observational clinical reports of success and safety with this dosing scheme of 1200 mg followed by 800 mg 7 days later provide evidence for further evaluation of this approach when prolonged oritavancin treatment may be indicated.},
  langid = {english}
}

@article{Rosini2015-mn,
  title = {A Randomized Trial of Loading Vancomycin in the Emergency Department},
  author = {Rosini, Jamie M and Laughner, Julie and Levine, Brian J and Papas, Mia A and Reinhardt, John F and Jasani, Neil B},
  year = {2015},
  month = jan,
  journal = {Annals of Pharmacotherapy},
  volume = {49},
  number = {1},
  pages = {6--13},
  abstract = {BACKGROUND: Optimizing vancomycin dosing may help eradicate bacteria while avoiding resistance. The guidelines recommend loading doses; however, there are no data to demonstrate that this may result in a more rapid achievement of therapeutic troughs. OBJECTIVE: To evaluate the percentage of troughs reaching therapeutic levels at 12, 24, and 36 hours following an initial vancomycin dose of 30 mg/kg compared with 15 mg/kg. METHODS: This prospective, randomized study was performed in a community academic medical center. Patients who were to receive vancomycin in the emergency department were randomized to an initial traditional dose of 15 mg/kg or a 30-mg/kg loading dose followed by 15 mg/kg every 12 hours for 3 doses. Patients weighing {\textquestiondown}120 kg or with creatinine clearances {\textexclamdown}50 mL/min were excluded. RESULTS: In total, 99 patients were enrolled; 12 hours after the initial dose of vancomycin, there was a significantly greater proportion of patients reaching target trough levels of 15 mg/L among the patients who received a loading dose as compared with a traditional dose (34\% vs 3\%, P {\textexclamdown} 0.01). This trend continued at 24 hours but was not statistically significant. At 36 hours, there was no difference in the percentage of patients reaching target levels between the 2 groups. No statistically significant difference in nephrotoxicity or adverse events among the 2 groups was demonstrated. CONCLUSION: A loading dose of 30 mg/kg of vancomycin achieved a higher percentage of therapeutic levels at 12 hours when compared with the traditional dose of 15 mg/kg, without increased nephrotoxicity or adverse events.},
  langid = {english},
  keywords = {emergency department,Mendeley Import (Dec 08),pharmacokinetics,trough,vancomycin}
}

@article{Rosini2016-qs,
  title = {High Single-Dose Vancomycin Loading Is Not Associated with Increased Nephrotoxicity in Emergency Department Sepsis Patients},
  author = {Rosini, Jamie M and Davis, Joshua J and Muenzer, Jeffrey and Levine, Brian J and Papas, Mia A and Comer, Dominique and Arnold, Ryan},
  editor = {Zehtabchi, Shahriar},
  year = {2016},
  month = jun,
  journal = {Academic Emergency Medicine},
  volume = {23},
  number = {6},
  pages = {744--746},
  abstract = {OBJECTIVE: Vancomycin loading doses are recommended; however, the risk of nephrotoxicity with these doses is unknown. The primary objective of this study was to compare nephrotoxicity in emergency department (ED) sepsis patients who received vancomycin at high doses ({\textquestiondown}20 mg/kg) versus lower doses ({$\leq$}20 mg/kg). METHODS: A retrospective cohort study was performed in three academic EDs. Inclusion criteria were age {$\geq$} 18 years, intravenous vancomycin order, and hospital admission. Exclusion criteria were no documented weight, hemodialysis-dependent, and inadequate serum creatinine (SCr) values for the measured outcome. Analyses compared the incidence of nephrotoxicity for patients who received vancomycin at high dose ({\textquestiondown}20 mg/kg) versus low dose ({$\leq$}20 mg/kg). RESULTS: A total of 2,131 consecutive patients prescribed vancomycin over 6 months were identified. Of these, 1,330 patients had three SCr values assessed for the primary outcome. High-dose initial vancomycin was associated with a significantly lower rate of nephrotoxicity (5.8\% vs. 11.1\%). After age, sex, and initial SCr were adjusted for, the risk of high-dose vancomycin compared to low-dose was decreased for the development of nephrotoxicity (relative risk = 0.60; 95\% confidence interval = 0.44 to 0.82). CONCLUSION: Initial dosing of vancomycin {\textquestiondown} 20 mg/kg was not associated with an increased rate of nephrotoxicity compared with lower doses. Findings from this study support compliance with initial weight-based vancomycin loading doses.},
  langid = {english},
  keywords = {Mendeley Import (Dec 08)}
}

@article{rosiniHighSingledoseVancomycin2016,
  title = {High {{Single-dose Vancomycin Loading Is Not Associated With Increased Nephrotoxicity}} in {{Emergency Department Sepsis Patients}}},
  author = {Rosini, Jamie M and Davis, Joshua J and Muenzer, Jeffrey and Levine, Brian J and Papas, Mia A and Comer, Dominique and Arnold, Ryan},
  editor = {Zehtabchi, Shahriar},
  year = {2016},
  month = jun,
  journal = {Acad. Emerg. Med.},
  volume = {23},
  number = {6},
  pages = {744--746},
  abstract = {OBJECTIVE: Vancomycin loading doses are recommended; however, the risk of nephrotoxicity with these doses is unknown. The primary objective of this study was to compare nephrotoxicity in emergency department (ED) sepsis patients who received vancomycin at high doses ({$>$}20 mg/kg) versus lower doses ({\textbackslash}leq20 mg/kg). METHODS: A retrospective cohort study was performed in three academic EDs. Inclusion criteria were age {\textbackslash}geq 18 years, intravenous vancomycin order, and hospital admission. Exclusion criteria were no documented weight, hemodialysis-dependent, and inadequate serum creatinine (SCr) values for the measured outcome. Analyses compared the incidence of nephrotoxicity for patients who received vancomycin at high dose ({$>$}20 mg/kg) versus low dose ({\textbackslash}leq20 mg/kg). RESULTS: A total of 2,131 consecutive patients prescribed vancomycin over 6 months were identified. Of these, 1,330 patients had three SCr values assessed for the primary outcome. High-dose initial vancomycin was associated with a significantly lower rate of nephrotoxicity (5.8\% vs. 11.1\%). After age, sex, and initial SCr were adjusted for, the risk of high-dose vancomycin compared to low-dose was decreased for the development of nephrotoxicity (relative risk = 0.60; 95\% confidence interval = 0.44 to 0.82). CONCLUSION: Initial dosing of vancomycin {$>$} 20 mg/kg was not associated with an increased rate of nephrotoxicity compared with lower doses. Findings from this study support compliance with initial weight-based vancomycin loading doses.},
  langid = {english},
  keywords = {Mendeley Import (Dec 08)}
}

@article{rosiniPEGDAAOConjugatePromising2020,
  title = {{{PEG-DAAO}} Conjugate: {{A}} Promising Tool for Cancer Therapy Optimized by Protein Engineering},
  author = {Rosini, Elena and Pollegioni, Loredano},
  year = {2020},
  month = feb,
  journal = {Nanomedicine},
  volume = {24},
  pages = {102122},
  publisher = {Elsevier Inc. (E-mail: usjcs@elsevier.com)},
  address = {United States},
  abstract = {The flavoenzyme D-amino acid oxidase (DAAO) represents a potentially good option for cancer enzyme prodrug therapy as it produces H2O2 using D-amino acids as substrates, compounds present at low concentration in vivo and that can be safely administered to regulate H2O2 production. We optimized the cytotoxicity of the treatment by: i) using an efficient enzyme variant active at low O2 and D-alanine concentrations (mDAAO); ii) improving the stability and half-life of mDAAO and the enhanced permeability and retention effect by PEGylation; and iii) inhibiting the antioxidant cellular system by a heme oxygenase-1 inhibitor (ZnPP). A very low amount of PEG-mDAAO (10 mU, 50 ng of enzyme) induces cytotoxicity on various tumor cell lines. Notably, PEG-mDAAO seems well suited for in vivo evaluation as it shows the same cytotoxicity at air saturation (21\%) and 2.5\% O2, a condition resembling the microenvironment found in the central part of tumors.},
  langid = {english},
  keywords = {*Basidiomycota/en [Enzymology],*D-Amino-Acid Oxidase,*Fungal Proteins,*Polyethylene Glycols,*Protein Engineering,Animals,Basidiomycota/ge [Genetics],Cell Line,Chlorocebus aethiops,COS Cells,D-amino acid,D-Amino-Acid Oxidase/ch [Chemistry],D-Amino-Acid Oxidase/ge [Genetics],D-Amino-Acid Oxidase/pd [Pharmacology],EPR effect,Fungal Proteins/ch [Chemistry],Fungal Proteins/ge [Genetics],Fungal Proteins/pd [Pharmacology],Neoplasms/me [Metabolism],Neoplasms/pa [Pathology],ovid_export_ris.ris,Oxidative stress,PEGylation,Polyethylene Glycols/ch [Chemistry],Polyethylene Glycols/pd [Pharmacology],Recombinant Proteins/ch [Chemistry],Recombinant Proteins/ge [Genetics],Recombinant Proteins/pd [Pharmacology],Tumor}
