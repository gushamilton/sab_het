@article{changAvExacerbatesAsynucleininduced2018,
  title = {A{$\beta$} Exacerbates {$\alpha$}-Synuclein-Induced Neurotoxicity through Impaired Insulin Signaling in {$\alpha$}-Synuclein-Overexpressed Human {{SK-N-MC}} Neuronal Cells},
  author = {Chang, Ching-Chi and Li, Hsin-Hua and Chang, Yen-Ting and Ho, Ying-Jui and Hsieh, Ling-Jia and Chiu, Pai-Yi and Cheng, Yu-Shih and Lin, Chih-Li and Lai, Te-Jen},
