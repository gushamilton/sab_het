@article{gibbons69GastroparesisAssociated2014,
  title = {69 Gastroparesis Is Associated with Expanded Polynucleotide Repeats in the Promoter Region Upstream of the Transcriptional Start Site for the Heme Oxygenase 1 ({{HO1}}) Gene},
  author = {Gibbons, Simon J and Choi, Kyoung Moo and Wilson, Laura and Tonascia, James and Pasricha, Pankaj J and Farrugia, Gianrico},
  year = {2014},
  month = may,
  journal = {Gastroenterology},
  volume = {146},
  number = {5},
  pages = {S--19},
  publisher = {Elsevier BV},
  abstract = {OBJECTIVE: Diabetic Gastroparesis occurs in a subset of patients with both type 1 and type 2 diabetes, causes significant morbidity and complicates glucose control. Gastroparesis can also be idiopathic. The reasons why some patients develop gastroparesis yet others often with equally severe diabetes do not are still not known. Studies in mice have shown that loss of heme oxygenase (HO1) up-regulation is associated with development of diabetic gastroparesis. In humans, the gene for HO1, HMOX1 contains several polymorphisms. One of these, a poly GT repeat in the promoter region of the HMOX1 gene has varying lengths with the longer alleles resulting in lower levels of HO1 protein and less favorable outcomes in cardiovascular disease and following transplantation. The AIM of this study was to test for an association between the number of GT repeats in the HMOX1 promoter and gastroparesis. METHOD(S): The length of the poly-GT repeat in HMOX1 was determined in genomic DNA from blood by PCR amplification and capillary electrophoresis on the ABI 3730 platform. Samples (n =170) from subjects with no diabetes and no motility disorders (CTLs) were compared to 124 samples from subjects with diabetic gastroparesis (DbGp: 70 type 1, 54 type 2) and 234 samples from subjects with idiopathic gastroparesis (IdGp) collected as part of the NIDDK Gastroparesis Clinical Research Consortium. Allele lengths were distributed into 3 major groups and defined as short (S, 20-28 GT repeats), medium (M, 29-32) and long (L, 33-44). Statistical analysis was done with Prism (Graphpad). RESULT(S): The GT repeat lengths in the HMOX1 gene from subjects with gastroparesis were significantly different from the repeat lengths in CTLs (P = 0.035, Kruskal-Wallis test). For the subgroups, repeat lengths in DbGp, and type 2 DbGp subjects were significantly longer than in controls (P {$<$} 0.05, Dunn's multiple comparisons test). In CTLs, the allele lengths were 46\%S, 49\%M, 5\%L vs 35\%S, 54\%M, 10\%L for DbGp and 40\%S, 53\%M, 10\%L for IdGp (Both P {$<$} 0.01, Chi Square test). Significant differences were not detected between type 1 DbGp patients and the other groups but the power was lower for this group. CONCLUSION(S): Longer GT repeats in the promoter region of the HMOX1 gene are associated with a higher risk of developing gastroparesis. This increased risk is detected in subjects with both diabetic and idiopathic gastroparesis. These data suggest that as in the mouse model, there is a critical role for HO1 in the development of human gastroparesis. The lengths of the GT repeats in the promoter region may be correlated with the severity of symptoms.},
  keywords = {*gastrointestinal disease,*gene,*heme oxygenase 1,*polynucleotide,*promoter region,*stomach paresis,allele,blood,capillary electrophoresis,cardiovascular disease,chi square test,clinical research,diabetes mellitus,diseases,DNA,genomic DNA,glucose,heme oxygenase,human,Kruskal Wallis test,morbidity,mouse,mouse model,non insulin dependent diabetes mellitus,ovid_export_ris.ris,patient,prism,protein,risk,statistical analysis,transplantation,upregulation}
}

@article{gibbonsRepeatPolymorphismsHomo2017,
  title = {Repeat Polymorphisms in the {{Homo}} Sapiens Heme Oxygenase-1 Gene in Diabetic and Idiopathic Gastroparesis},
  author = {Gibbons, Simon J and Grover, Madhusudan and Choi, Kyoung Moo and Wadhwa, Akhilesh and Zubair, Adeel and Wilson, Laura A and Wu, Yanhong and Abell, Thomas L and Hasler, William L and Koch, Kenneth L and McCallum, Richard W and Nguyen, Linda A B and Parkman, Henry P and Sarosiek, Irene and Snape, William J and Tonascia, James and Hamilton, Frank A and Pasricha, Pankaj J and Farrugia, Gianrico},
  year = {2017},
  month = nov,
  journal = {PLoS One},
  volume = {12},
  number = {11},
  pages = {e0187772},
  publisher = {Public Library of Science (E-mail: plos@plos.org)},
  address = {United States},
  abstract = {BACKGROUND: Idiopathic and diabetic gastroparesis in Homo sapiens cause significant morbidity. Etiology or risk factors have not been clearly identified. Failure to sustain elevated heme oxygenase-1 (HO1) expression is associated with delayed gastric emptying in diabetic mice and polymorphisms in the HO1 gene (HMOX1, NCBI Gene ID:3162) are associated with worse outcomes in other diseases. AIM: Our hypothesis was that longer polyGT alleles are more common in the HMOX1 genes of individuals with gastroparesis than in controls without upper gastrointestinal motility disorders. METHODS: Repeat length was determined in genomic DNA. Controls with diabetes (84 type 1, 84 type 2) and without diabetes (n = 170) were compared to diabetic gastroparetics (99 type 1, 72 type 2) and idiopathic gastroparetics (n = 234). Correlations of repeat lengths with clinical symptom sub-scores on the gastroparesis cardinal symptom index (GCSI) were done. Statistical analyses of short (32) repeat alleles and differences in allele length were used to test for associations with gastroparesis. RESULTS: The distribution of allele lengths was different between groups (P = 0.016). Allele lengths were longest in type 2 diabetics with gastroparesis (29.18{\textbackslash}pm0.35, mean {\textbackslash}pm SEM) and longer in gastroparetics compared to non-diabetic controls (28.50{\textbackslash}pm0.14 vs 27.64{\textbackslash}pm0.20 GT repeats/allele, P = 0.0008). Type 2 diabetic controls had longer alleles than non-diabetic controls. In all gastroparetic groups, allele lengths were longer in African Americans compared to other racial groups, differences in the proportion of African Americans in the groups accounted for the differences between gastroparetics and controls. Diabetic gastroparetics with 1 or 2 long alleles had worse GCSI nausea sub-scores (3.30{\textbackslash}pm0.23) as compared to those with 0 long alleles (2.66{\textbackslash}pm0.12), P = 0.022. CONCLUSIONS: Longer poly-GT repeats in the HMOX1 gene are more common in African Americans with gastroparesis. Nausea symptoms are worse in subjects with longer alleles.},
  langid = {english},
  keywords = {*genetic polymorphism,*heme oxygenase 1/ec [Endogenous Compound],*HMOX1 gene,*idiopathic gastroparesis,*non insulin dependent diabetes mellitus,*stomach paresis,adult,African American,aged,allele,American Indian,article,Caucasian,controlled study,diabetic stomach paresis,disease exacerbation,DNA sequence,female,gastrointestinal motility,genetic association,genetic variation,Hispanic,human,Indian,major clinical study,male,nausea,ovid_export_ris.ris,race difference}
}

@article{gibbonss.j.Abstracts1stFederation2014,
  title = {Abstracts of the 1st {{Federation Neurogastroenterology}} and {{Motility Scientific Meeting}}, {{September}} 5-7, 2014, {{Guangzhou}}, {{China}}},
  author = {{Gibbons S.J.} and {Choi K.M.} and {Wilson L.A.} and {Pasricha P.J.} and {Farrugia G.}},
  year = {2014},
  month = sep,
  journal = {Neurogastroenterol. Motil.},
  volume = {26 Suppl 1},
  number = {SUPPL. 1},
  pages = {1--82},
  publisher = {Blackwell Publishing Ltd},
  abstract = {Objectives: Gastroparesis occurs in patients with diabetes or can be idiopathic. It causes significant morbidity and complicates glucose control. It is not known why only some patients develop gastroparesis. Heme oxygenase (HO1) upregulation is associated with development of diabetic gastroparesis in mice. The human gene for HO1, HMOX1 contains several polymorphisms including a poly GT repeat in the 50 region of the gene with varying lengths. Longer alleles result in lower HO1 protein and less favorable outcomes in disease. The aim of this study was to test for associations between numbers of GT repeats in HMOX1 and gastroparesis. Method(s): The length of polyGT repeats in HMOX1 was determined in genomic DNA from blood. Samples (n = 170) from subjects with no diabetes and no motility disorders (CTLs) were compared to samples from subjects with diabetic gastroparesis (DbGp: 70 type1, 54 type2) and 234 samples from subjects with idiopathic gastroparesis (IdGp) collected as part of the NIDDK Gastroparesis Clinical Research Consortium. Allele lengths fell into 3 groups defined as short (S), medium (M) and long (L). Correlations between allele lengths and HbA1c levels, gastric emptying and symptom severity (reported in the gastroparesis combined symptom index, GCSI) were examined. Result(s): GT repeat lengths in HMOX1 from subjects with gastroparesis were different from repeat lengths in CTLs (p = 0.016). Repeat lengths in DbGp, and type2 DbGp subjects were longer than in controls (p {$<$} 0.05, Dunn's test). There was no correlation between allele length and HbA1c, gastric emptying or GCSI in DbGp. There was also no correlation of allele length with bloating or fullness symptom scores. There was a correlation with nausea scores (p = 0.03 vs zero slope) and patients with 1 or 2 long alleles had significantly worse scores (with L, 3.30 +/- 0.33; No L, 2.63 +/- 0.14, p {$<$} 0.05, Mann-Whitney). Conclusion(s): Longer GT repeats in the 50 region of HMOX1 associate with a higher risk of gastroparesis. There appears be a specific association between nausea symptoms and longer allele lengths. These data suggest that as in mice, there is a critical role for HO1 in development of human gastroparesis.},
  langid = {english},
  keywords = {*diabetes mellitus,*gene,*heme oxygenase 1,*human,*nausea,*patient,*polynucleotide,*stomach paresis,allele,bloating,blood,clinical research,diseases,DNA,genomic DNA,glucose,heme oxygenase,hemoglobin A1c,morbidity,mouse,ovid_export_ris.ris,protein,risk,stomach emptying,upregulation}
}

@article{gibsonChallengesOpportunitiesInvolving2019,
  title = {Challenges and Opportunities for Involving Patients and the Public in Acute Antimicrobial Medicine Development Research: An Interview Study},
  author = {Gibson, Andy and Kok, Michele and Evans, David and Grier, Sally and MacGowan, Alasdair},
  year = {2019},
  month = may,
  journal = {BMJ Open},
  volume = {9},
  number = {4},
  pages = {e024918},
  abstract = {OBJECTIVES: To explore what approaches to patient and public involvement (PPI) in antimicrobial medicines development are currently being used, what the impacts of PPI are on antimicrobial medicines development and what the barriers are to its implementation. DESIGN: Interview study. SETTING: Antimicrobial medicines development research. PARTICIPANTS: Principal investigators known to have led studies involving PPI or expressed an interest in PPI. RESULTS: There is very little published work on PPI in antimicrobial research. Individual interviewees expressed scepticism about the contribution that PPI could make to different stages of the medicines development life cycle but collectively identified a range of potential benefits of PPI covering most stages of the medicines development process. CONCLUSIONS: A major issue in developing PPI in antimicrobial medicines development research will be in overcoming the view that, at best, PPI has only a marginal contribution to make in this area of research. The findings from this study, although mixed, suggest that well-designed PPI has an untapped potential to enhance antimicrobial research.},
  langid = {english},
  keywords = {acute infections,antimicrobial research,challenges and opportunities,patient and public involvement}
}

@article{gichohi-wainainaAssociationsCommonVariants2016,
  title = {Associations between {{Common Variants}} in {{Iron-Related Genes}} with {{Haematological Traits}} in {{Populations}} of {{African Ancestry}}},
  author = {{Gichohi-Wainaina}, Wanjiku N and Tanaka, Toshiko and Towers, G Wayne and Verhoef, Hans and Veenemans, Jacobien and Talsma, Elise F and Harryvan, Jan and Boekschoten, Mark V and Feskens, Edith J and {Melse-Boonstra}, Alida},
  year = {2016},
  month = jun,
  journal = {PLoS One},
  volume = {11},
  number = {6},
  pages = {e0157996},
  abstract = {BACKGROUND: Large genome-wide association (GWA) studies of European ancestry individuals have identified multiple genetic variants influencing iron status. Studies on the generalizability of these associations to African ancestry populations have been limited. These studies are important given interethnic differences in iron status and the disproportionate burden of iron deficiency among African ancestry populations. METHODS: We tested the associations of 20 previously identified iron status-associated single nucleotide polymorphisms (SNPs) in 628 Kenyans, 609 Tanzanians, 608 South Africans and 228 African Americans. In each study, we examined the associations present between 20 SNPs with ferritin and haemoglobin, adjusting for age, sex and CRP levels. RESULTS: In the meta analysis including all 4 African ancestry cohorts, we replicated previously reported associations with lowered haemoglobin concentrations for rs2413450 ({$\beta$} = -0.19, P = 0.02) and rs4820268 ({$\beta$} = -0.16, P = 0.04) in TMPRSS6. An association with increased ferritin concentrations was also confirmed for rs1867504 in TF ({$\beta$} = 1.04, P = {$<$}0.0001) in the meta analysis including the African cohorts only. CONCLUSIONS: In all meta analyses, we only replicated 4 of the 20 single nucleotide polymorphisms reported to be associated with iron status in large GWA studies of European ancestry individuals. While there is now evidence for the associations of a number of genetic variants with iron status in both European and African ancestry populations, the considerable lack of concordance highlights the importance of continued ancestry-specific studies to elucidate the genetic underpinnings of iron status in ethnically diverse populations.},
  langid = {english}
}

@article{gilbertAssociationMalariaParasite1998,
  title = {Association of Malaria Parasite Population Structure, {{HLA}}, and Immunological Antagonism},
  author = {Gilbert, S C and Plebanski, M and Gupta, S and Morris, J and Cox, M and Aidoo, M and Kwiatkowski, D and Greenwood, B M and Whittle, H C and Hill, A V},
  year = {1998},
  month = feb,
  journal = {Science},
  volume = {279},
  number = {5354},
  pages = {1173--1177},
  abstract = {Host-parasite coevolution has been likened to a molecular arms race, with particular parasite genes evolving to evade specific host defenses. Study of the variants of an antigenic epitope of Plasmodium falciparum that induces a cytotoxic T cell response supports this view. In African children with malaria, the variants present are influenced by the presence of a human leukocyte antigen (HLA) type that restricts the immune response to this epitope. The distribution of parasite variants may be further influenced by the ability of cohabiting parasite strains to facilitate each other's survival by down-regulating cellular immune responses, using altered peptide ligand antagonism.},
  langid = {english},
  keywords = {mandel}
}

