@article{kralGeneticVariantsHaem2011,
  title = {Genetic Variants in Haem Oxygenase-1 and Endothelial Nitric Oxide Synthase Influence the Extent and Evolution of Coronary Artery Atherosclerosis},
  author = {Kr{\'a}l, A and Kov{\'a}rn{\'i}k, T and Kr{\'a}l{\'i}k, L and Skalick{\'a}, H and Hor{\'a}k, J and Mintz, G S and Uhrov{\'a}, J and Sonka, M and Wahle, A and Downe, R and Aschermann, M and Mart{\'a}sek, P and Linhart, A},
  year = {2011},
  journal = {Folia Biol.},
  volume = {57},
  number = {5},
  pages = {182--190},
  publisher = {Charles University},
  address = {Czech Republic},
  abstract = {The genetic basis for atherosclerosis development and progression is poorly characterized. We aimed to assess the relationship between endothelial nitric oxide synthase (ENOS) 894 G/T, haem oxygenase-1 (HO1) dinucleotide-length promoter polymorphisms and coronary artery atherosclerotic invol vement and its changes during statin therapy. Coronary angiography, intravascular ultrasound (IVUS), IVUS-derived virtual histology (VH) and genetic polymorphism analysis were performed at study entry. Patients were randomized 1:1 to standard or aggressive hypolipidaemic treatment, and a follow-up evaluation was performed after twelve months. Plaque magnitude was significantly higher in carriers of HO1 risk variants when compared with carriers of the protective variants ({$<$} 25 GT repeats). Similarly, the total coronary atherosclerotic burden was significantly greater in HO1 risk variant carriers than in HO1 protective variant carriers. Both parameters did not differ with respect to the ENOS genotype. A higher prevalence of thin-cap fibroatheroma (TCFA) in HO1 risk variant carriers was observed, compared with the HO1 protective variant carriers. The prevalence of TCFA was not influenced by the ENOS genotype. Baseline plaque composition did not differ significantly with respect to both polymorphisms. Significant interactions between plaque composition changes and ENOS and HO1 genotypes were observed during statin treatment. In conclusion, the protective HO1 promoter polymorphism correlates with a lower coronary artery plaque burden, whereas the protective ENOS 894 G/T polymorphism seems to favourably influence changes of coronary artery plaque composition during statin therapy, but has no significant correlation to the magnitude of coronary atherosclerosis.},
  langid = {english},
  keywords = {*coronary artery atherosclerosis/dt [Drug Therapy],*endothelial nitric oxide synthase/ec [Endogenous Compound],*genetic variability,*heme oxygenase 1/ec [Endogenous Compound],adult,aged,angiocardiography,article,atheroma,atorvastatin/dt [Drug Therapy],coronary artery atherosclerosis/dt [Drug Therapy],ezetimibe/dt [Drug Therapy],female,fluindostatin/dt [Drug Therapy],follow up,genetic polymorphism,genotype,glyceryl trinitrate/dt [Drug Therapy],glyceryl trinitrate/iv [Intravenous Drug Administration],homozygote,human,hydroxymethylglutaryl coenzyme A reductase inhibitor/dt [Drug Therapy],intravascular ultrasound,major clinical study,male,ovid_export_ris.ris,promoter region,simvastatin/dt [Drug Therapy]}
}

@article{kramerAlternative5Untranslated2013,
  title = {Alternative 5' Untranslated Regions Are Involved in Expression Regulation of Human Heme Oxygenase-1},
  author = {Kramer, Marcel and Sponholz, Christoph and Slaba, Monique and Wissuwa, Bianka and Claus, Ralf A and Menzel, Uwe and Huse, Klaus and Platzer, Matthias and Bauer, Michael},
  year = {2013},
  month = oct,
  journal = {PLoS One},
  volume = {8},
  number = {10},
  pages = {e77224},
  publisher = {Public Library of Science (185 Berry Street, Suite 1300, San Francisco CA 94107, United States)},
  address = {United States},
  abstract = {The single nucleotide polymorphism rs2071746 and a (GT)n microsatellite within the human gene encoding heme oxygenase-1 (HMOX1) are associated with incidence or outcome in a variety of diseases. Most of these associations involve either release of heme or oxidative stress. Both polymorphisms are localized in the promoter region, but previously reported correlations with heme oxygenase-1 expression remain not coherent. This ambiguity suggests a more complex organization of the 5' gene region which we sought to investigate more fully. We evaluated the 5' end of HMOX1 and found a novel first exon 1a placing the two previously reported polymorphisms in intronic or exonic positions within the 5' untranslated region respectively. Expression of exon 1a can be induced in HepG2 hepatoma cells by hemin and is a repressor of heme oxygenase-1 translation as shown by luciferase reporter assays. Moreover, minigene approaches revealed that the quantitative outcome of alternative splicing within the 5' untranslated region is affected by the (GT)n microsatellite. This data supporting an extended HMOX1 gene model and provide further insights into expression regulation of heme oxygenase-1. Alternative splicing within the HMOX1 5' untranslated region contributes to translational regulation and is a mechanistic feature involved in the interplay between genetic variations, heme oxygenase-1 expression and disease outcome.},
  langid = {english},
  keywords = {*5' untranslated region,*gene expression regulation,*heme oxygenase 1/ec [Endogenous Compound],alternative RNA splicing,article,cell strain HepG2,exon,gene amplification,gene expression,genetic variability,hemin,HMOX1 gene,human,human cell,luciferase reporter assay,microsatellite DNA/ec [Endogenous Compound],microsatellite marker,nucleotide sequence,ovid_export_ris.ris,oxidative stress,protein expression,quantitative genetics,single nucleotide polymorphism,transcript_regulation,translation regulation}
}

@article{kramerm.SepsisMultiorganDysfunction2013,
  title = {Sepsis and Multiorgan Dysfunction. {{Abstracts}} of the 6th {{International Congress}}, {{Weimar Sepsis Update}} 2013-{{Consensus}} and {{Controversies}}. {{September}} 4-6, 2013. {{Weimer}}, {{Germany}}},
  author = {{Kramer M.} and {Sponholz C.} and {Slaba M.} and {Wissuwa B.} and {Claus R.A.} and {Menzel U.} and {Huse K.} and {Platzer M.} and {Bauer M.}},
  year = {2013},
  month = aug,
  journal = {Infection},
  volume = {41 Suppl 1},
  number = {S1},
  pages = {1--90},
  publisher = {{Springer Science and Business Media LLC}},
  abstract = {Introduction: Heme oxygenases break down heme yielding biliverdin, iron (II) ions, and carbon monoxide. Heme oxygenase-1 (HO-1) induction protects against cell death associated with ischemia/reperfusion or inflammation, making the gene a promising target in sepsis and organ failure. The single nucleotide polymorphism rs2071746 and a (GT)n microsatellite within the human gene encoding HO-1 (HMOX1) are associated with incidence, progression, or outcome of various clinical diagnoses as sepsis and failure of kidney and liver grafts. Both polymorphisms are localized in the promoter region of HMOX1, but correlations with HO-1 expression remain not coherent. Since the protective action of HO-1 is restricted to a narrow threshold of over-expression a fine-tuned regulation of HO-1 expression is required potentially encoded by a complex organization of the five gene region. Objective(s): Our analyses re-evaluate the current HMOX1 gene model. We test the effect of rs2071746 and (GT)n on alternative splicing of HMOX1 5 untranslated region (UTR) and subsequent effects on HO-1 translation efficiency. Method(s): RT-PCR, cloning and sequencing was used to detect transcripts with elongated 5-UTR. HMOX1 minigenes representing several haplotypes of rs2071746 and (GT)n were set up to evaluate effects on alternative splicing of the 5 UTR. Quantification of alternative splice-isoforms frequencies was done with RT-PCR using 5-6- carboxyfluorescein (FAM)-labeled oligonucleotides before capillary sequencing. Alternative UTRs were validated concerning translation efficiency using a luciferase reporter assay. Result(s): We provide evidence for a revised gene structure with an alternative first exon (1a) placing rs2071746 and (GT)n in intronic or exonic position. Expression of exon 1a can be induced by hemin in HepG2 cells generating several alternative splice-isoforms with different 5 UTRs. Minigene analysis revealed that the quantitative outcome of alternative splicing in human cell lines (HepG2, HEK293- EBNA) is affected by (GT)n length and can be modified by hemin treatment. 5 UTRs of alternatively spliced transcripts containing exon 1a showed lower translation capacity compared to the 5 UTR of the canonical first exon. Thus, expression of exon 1a and alternatively splicing within the 5 UTR of HMOX1 contribute to the regulation of HO-1 translation in a (GT)n-dependent manner. Conclusion(s): Our data support an extended HMOX1 gene model and provide evidence for a mechanism to fine-tune HO-1 expression. Alternative splicing within the HMOX1 50 UTR contributes to translation regulation and is a mechanistic feature involved in the interplay between genetic variations, HO-1 expression and disease outcome.},
  langid = {english},
  keywords = {*consensus,*heme oxygenase 1,*human,*sepsis,*untranslated region,5' untranslated region,6 carboxyfluorescein,alternative RNA splicing,assay,biliverdin,capillary,carbon monoxide,cell death,cloning,diagnosis,exon,ferrous ion,gene,gene structure,genetic variability,haplotype,heme,hemin,human cell,inflammation,ion,kidney,liver graft,luciferase,model,oligonucleotide,ovid_export_ris.ris,oxygenase,promoter region,single nucleotide polymorphism,translation regulation}
}

