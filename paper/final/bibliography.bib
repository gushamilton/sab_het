  author = {Ishikawa, K and Sato, M and Ito, M and Yoshida, T},
  year = {1992},
  month = feb,
  journal = {Biochem. Biophys. Res. Commun.},
  volume = {182},
  number = {3},
  pages = {981--986},
  publisher = {Academic Press Inc. (6277 Sea Harbor Drive, Orlando FL 32887-4900, United States)},
  address = {United States},
  abstract = {A truncated, soluble, and enzymatically active rat heme oxygenase lacking its membrane-associative, C-terminal segment was expressed in E. coli strain JM109. The roles of its four histidine residues were examined by determining the enzymatic activities of mutant enzymes in which each of these residues in turn was replaced by alanine. Mutation of histidine residue 25 to alanine resulted in marked decrease in activity for heme breakdown, indicating that this histidine residue has an important role in the heme oxygenase reaction.},
  langid = {english},
  keywords = {*Heme Oxygenase (Decyclizing)/me [Metabolism],*Histidine,Alanine,Amino Acid Sequence,Animals,Base Sequence,Binding Sites,Cloning,Escherichia coli/ge [Genetics],Heme Oxygenase (Decyclizing)/ge [Genetics],Molecular,Molecular Sequence Data,Mutagenesis,Oligodeoxyribonucleotides,ovid_export_ris.ris,Peptide Fragments/me [Metabolism],Polymerase Chain Reaction,Rats,Recombinant Proteins/me [Metabolism],Site-Directed,Spectrophotometry}
}

