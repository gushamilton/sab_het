@article{Horner2012-iy,
  title = {Azithromycin Antimicrobial Resistance and Genital {{Chlamydia}} Trachomatis Infection: Duration of Therapy May Be the Key to Improving Efficacy},
  author = {Horner, Paddy J},
  year = {2012},
  month = apr,
  journal = {Sexually Transmitted Infections},
  volume = {88},
  number = {3},
  pages = {154--156},
  abstract = {A test of cure following treatment for uncomplicated cervical or urethral Chlamydia trachomatis infection with either single dose azithromycin (1 g) or doxycyline (100 mg twice daily for 7 days) is currently not recommended. Earlier trials indicated that both treatments are more than 95\% effective.1e3 However, recent evidence strongly suggests that treatment failure may occur in more than 5\% patients. This was the subject of a recent editorial by Handsfield4 and a late breaker symposium at the recent ISSTDR meeting in Quebec. Handsfield has argued persuasively that this apparent increase in treatment failure with azithromycin is probably not real. Tissue culture, which is less sensitive than nucleic acid amplification tests, was predominantly used in the original treatment trials and would not have been able to detect small numbers of persistent of C trachomatis bacteria.1 4 This article reviews the evidence for treatment failure, considers whether we need to modify current treatment regimes and suggests possible topics for future research.},
  langid = {english},
  keywords = {Anti-Bacterial Agents,Anti-Bacterial Agents: administration & dosage,Anti-Bacterial Agents: pharmacology,Azithromycin,Azithromycin: administration & dosage,Azithromycin: pharmacology,Bacterial,Chlamydia trachomatis,Chlamydia trachomatis: drug effects,Chlamydia trachomatis: isolation & purification,Drug Resistance,Drug Therapy,Drug Therapy: methods,Female,Humans,Lymphogranuloma Venereum,Lymphogranuloma Venereum: drug therapy,Lymphogranuloma Venereum: microbiology,Male,Mendeley Import (Dec 08),Time Factors,Treatment Outcome}
}

