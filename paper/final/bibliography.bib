@article{Yokoyama2012-fm,
  title = {Cinacalcet for Hemodialyzed Patients with or without a High {{PTH}} Level to Control Serum Calcium and Phosphorus: {{ECO}} (Evaluation of Cinacalcet {{HCl}} Outcome) Study},
  author = {Yokoyama, Keitaro and Ohkido, Ichiro and Ishida, Mari and Hashimoto, Hiroyuki and Urae, Jun and Sekino, Hiroshi and Kimura, Yasuo and Shimada, Hidetaka and Urashima, Mitsuyoshi and Hosoya, Tatsuo},
  year = {2012},
  journal = {Clinical nephrology},
  volume = {78},
  number = {2},
  pages = {87--92},
  publisher = {{Division of Kidney and Hypertension, Department of Internal Medicine, The Jikei University School of Medicine, Tokyo, Japan. keitaro@jikei.ac.jp}},
  address = {Germany},
  abstract = {BACKGROUND: We investigated the influence of cinacalcet on serum Ca and P in hemodialyzed patients with or without a high PTH level, according to K/DOQI guideline, to control serum Ca and P levels., METHODS: We recruited 130 patients in this prospective cohort study and classified them into Group A (iPTH {\textquestiondown} 300 pg/ml), Group B (iPTH = 181 - 300 pg/ml), and Group C (iPTH {\textexclamdown}= 180 pg/ml). After 24 weeks on cinacalcet, serum Ca, P and iPTH were measured., RESULTS: The achievement rate of the target iPTH level in JSDT guideline was significantly higher in Group B compared with Group A. The achievement rate of serum Ca and P target levels in the Japanese Society for Dialysis Therapy (JSDT) guideline was higher in Group C. In Group A and Group C, the simultaneous achievement rates (Ca, P, and iPTH) in KDOQI guideline increased after treatment with cinacalcet (p {\textexclamdown} 0.01). There was no difference in the reduction of Ca and P among the groups, while the iPTH reduction was significantly lower in groups B and C compared with that in A., CONCLUSION: Administration of cinacalcet to patients with or without high PTH levels, according to the K/DOQI guideline, facilitates the control of Ca and P levels.},
  keywords = {*Calcium/bl [Blood],*Hyperparathyroidism,*Naphthalenes/tu [Therapeutic Use],*Parathyroid Hormone/bl [Blood],*Phosphorus/bl [Blood],*Renal Dialysis,Cohort Studies,Female,Humans,Male,Mendeley Import (Dec 08),Middle Aged,Prospective Studies,Secondary/bl [Blood],Secondary/dt [Drug Therapy]}
}

