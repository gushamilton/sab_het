@article{hershAttemptedReplicationReported2005,
  title = {Attempted Replication of Reported Chronic Obstructive Pulmonary Disease Candidate Gene Associations},
  author = {Hersh, Craig P and Demeo, Dawn L and Lange, Christoph and Litonjua, Augusto A and Reilly, John J and Kwiatkowski, David and Laird, Nan and Sylvia, Jody S and Sparrow, David and Speizer, Frank E and Weiss, Scott T and Silverman, Edwin K},
  year = {2005},
