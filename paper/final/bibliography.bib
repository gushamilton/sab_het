  title = {Abstract 18540: {{Heme Oxygenase}} 1 {{Activity}} and {{Expression Suppresses}} a {{Proinflammatory Phenotype}} in {{Monocytes}} and {{Correlates With Endothelial Function}} in {{Mice}} and {{Humans}}},
  author = {Wenzel, Philip and Rossmann, Heidi and M{\"u}ller, Christian and Kossmann, Sabine and Simsek, Canan and {Kr{\"o}ller-Sch{\"o}n}, Swenja and Schulz, Eberhard and Oelze, Matthias and Daiber, Andreas and Lackner, Karl and Schnabel, Renate and Blankenberg, Stefan and Zeller, Tanja and Wild, Philipp and M{\"u}nzel, Thomas},
