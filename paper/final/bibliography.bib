@article{urbanekNoAssociationPromoter2011,
  title = {No Association of Promoter Variations of {{HMOX1}} and {{UGT1A1}} Genes with Liver Injury in Chronic Hepatitis {{C}}},
  author = {Urb{\'a}nek, Petr and Len{\'i}{\v c}ek, Martin and Muchov{\'a}, Lucie and Subhanov{\'a}, Iva and Du{\v s}ek, Ladislav and Kasp{\v r}{\'i}kov{\'a}, Nikola and Hrabal, Petr and Bruha, Radan and V{\'i}tek, Libor},
  year = {2011},
  journal = {Ann. Hepatol.},
  volume = {10},
  number = {4},
  pages = {445--451},
  publisher = {Fundacion Clinica Medica Sur (Puente de Piedra 150, Toriello Guerra, C.P. 14050, Mexico)},
  address = {Mexico},
  abstract = {BACKGROUND: Heme oxygenase-1 (HMOX1) and bilirubin UDP-glucuronosyltransferase (UGT1A1), both enzymes involved in bilirubin homeostasis, play an important role in oxidative stress defense. OBJECTIVE: To assess the effect of promoter variations of HMOX1 and UGT1A1 genes on the progression of fibrosis in patients chronically infected with the hepatitis C virus (HCV). MATERIAL AND METHODS: The study was performed on146 chronic HCV infection patients, plus 146 age- and sex-matched healthy subjects. The (GT)n and (TA)n dinucleotide variations in HMOX1 and UGT1A1 gene promoters, respectively, were determined by fragment analysis in all subjects. RESULTS: No differences were found in the frequencies of each particular allele of both genes, between HCV patients and a control group (p {$>$} 0.05). Furthermore, no association was detected (p {$>$} 0.05) between either the HMOX1 or the UGT1A1 promoter variants and the individual histological stages of liver disease in the HCV positive patients. Finally, no differences in the HMOX1 and UGT1A1 genotype prevalence rates were found between pre-cirrhotic and cirrhotic patients (p {$>$} 0.05). CONCLUSION: Based on our data, microsatellite variations in the HMOX1 and UGT1A1 genes are not likely to protect from progression of liver disease in patients with chronic hepatitis C.},
  langid = {english},
  keywords = {*gene,*hepatitis C,*hmox1 gene,*liver fibrosis/co [Complication],*liver fibrosis/et [Etiology],*promoter region,*single nucleotide polymorphism,*ugt1a1 gene,article,controlled study,dinucleotide/ec [Endogenous Compound],disease course,DNA/ec [Endogenous Compound],gene frequency,genetic analysis,genetic association,genetic predisposition,genetic variability,genotype,glucuronosyltransferase 1A1/ec [Endogenous Compound],heme oxygenase 1/ec [Endogenous Compound],histopathology,human,human tissue,liver biopsy,liver protection,major clinical study,microsatellite marker,ovid_export_ris.ris,oxidative stress,prevalence,sr_hmox_include,virus load,virus RNA}
}

