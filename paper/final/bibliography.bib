@article{marchiniGenotypeImputationGenomewide2010,
  title = {Genotype Imputation for Genome-Wide Association Studies},
  author = {Marchini, Jonathan and Howie, Bryan},
  year = {2010},
  month = jul,
  journal = {Nat. Rev. Genet.},
  volume = {11},
  number = {7},
  pages = {499--511},
  abstract = {In the past few years genome-wide association (GWA) studies have uncovered a large number of convincingly replicated associations for many complex human diseases. Genotype imputation has been used widely in the analysis of GWA studies to boost power, fine-map associations and facilitate the combination of results across studies using meta-analysis. This Review describes the details of several different statistical methods for imputing genotypes, illustrates and discusses the factors that influence imputation performance, and reviews methods that can be used to assess imputation performance and test association at imputed SNPs.},
  langid = {english}
}

@article{Marcus1989-ml,
  title = {Laboratory Diagnosis of Primary Hyperparathyroidism},
  author = {Marcus, R},
  year = {1989},
  journal = {Endocrinology and metabolism clinics of North America},
  volume = {18},
  number = {3},
  pages = {647--658},
  publisher = {Aging Study Unit, Veterans Administration Medical Center, Palo Alto, California.},
  address = {UNITED STATES},
  abstract = {Although considerable effort has gone into the development and modernization of indirect parathyroid function tests, recent experience indicates that they do not possess adequate diagnostic specificity or sensitivity to provide a definitive diagnosis of HPT when they are most needed, that is, in mild or intermittent hypercalcemia. Conversely, in most research and some commercial laboratories, the combination of hypercalcemia and an elevated mid-molecule or intact PTH level will be diagnostic in more than 90\% of patients.},
  keywords = {*Hyperparathyroidism/di [Diagnosis],Cyclic AMP/bl [Blood],Cyclic AMP/ur [Urine],Humans,Hypercalcemia/di [Diagnosis],Hypercalcemia/et [Etiology],Hyperparathyroidism/co [Complications],Immunoassay,Mendeley Import (Dec 08),Parathyroid Glands/pp [Physiopathology],Parathyroid Hormone/bl [Blood],Phosphorus/bl [Blood],Phosphorus/ur [Urine],Radioimmunoassay/mt [Methods]}
