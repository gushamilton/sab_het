  title = {Host Genotype-Specific Therapies Can Optimize the Inflammatory Response to Mycobacterial Infections},
  author = {Tobin, David M and Roca, Francisco J and Oh, Sungwhan F and McFarland, Ross and Vickery, Thad W and Ray, John P and Ko, Dennis C and Zou, Yuxia and Bang, Nguyen D and Chau, Tran T H and Vary, Jay C and Hawn, Thomas R and Dunstan, Sarah J and Farrar, Jeremy J and Thwaites, Guy E and King, Mary-Claire and Serhan, Charles N and Ramakrishnan, Lalita},
