@article{Pollak1993-wi,
  title = {Mutations in the Human {{Ca}}(2+)-Sensing Receptor Gene Cause Familial Hypocalciuric Hypercalcemia and Neonatal Severe Hyperparathyroidism},
  author = {Pollak, M R and Brown, E M and Chou, Y H and Hebert, S C and Marx, S J and Steinmann, B and Levi, T and Seidman, C E and Seidman, J G},
  year = {1993},
  journal = {Cell},
  volume = {75},
  number = {7},
  pages = {1297--1303},
  publisher = {{Department of Medicine, Brigham and Women's Hospital, Boston, Massachusetts 02115.}},
  address = {UNITED STATES},
  abstract = {We demonstrate that mutations in the human Ca(2+)-sensing receptor gene cause familial hypocalciuric hypercalcemia (FHH) and neonatal severe hyperparathyroidism (NSHPT), two inherited conditions characterized by altered calcium homeostasis. The Ca(2+)-sensing receptor belongs to the superfamily of seven membrane-spanning G protein-coupled receptors. Three nonconservative missense mutations are reported: two occur in the extracellular N-terminal domain of the receptor; the third occurs in the final intracellular loop. One mutated receptor identified in FHH individuals was expressed in X. laevis oocytes. The expressed wild-type receptor elicited large inward currents in response to perfused polyvalent cations; a markedly attenuated response was observed with the mutated protein. We conclude that the mammalian Ca(2+)-sensing receptor ``sets'' the extracellular Ca2+ level and is defective in individuals with FHH and NSHPT.},
  keywords = {*Hypercalcemia/ge [Genetics],*Hyperparathyroidism/ge [Genetics],*Receptors,Amino Acid,Amino Acid Sequence,Base Sequence,Calcium-Sensing,Calcium/ph [Physiology],Cell Surface/ge [Genetics],Cloning,DNA Primers/ch [Chemistry],Gene Expression,Genes,Humans,Hyperparathyroidism/cn [Congenital],Membrane Glycoproteins/ge [Genetics],Mendeley Import (Dec 08),Messenger/ge [Genetics],Molecular,Molecular Sequence Data,Mutation,Pedigree,Receptors,RNA,Sequence Alignment,Sequence Homology}
}

@article{Pollak1994-zy,
  title = {Autosomal Dominant Hypocalcaemia Caused by a {{Ca}}(2+)-Sensing Receptor Gene Mutation},
  author = {Pollak, M R and Brown, E M and Estep, H L and McLaine, P N and Kifor, O and Park, J and Hebert, S C and Seidman, C E and Seidman, J G},
  year = {1994},
  journal = {Nature genetics},
  volume = {8},
  number = {3},
  pages = {303--307},
  publisher = {{Department of Medicine, Brigham and Women's Hospital, Boston, Massachusetts 02115.}},
  address = {UNITED STATES},
  abstract = {Defects in the human Ca(2+)-sensing receptor gene have recently been shown to cause familial hypocalciuric hypercalcaemia and neonatal severe hyperparathyroidism. We now demonstrate that a missense mutation (Glu128Ala) in this gene causes familial hypocalcaemia in affected members of one family. Xenopus oocytes expressing the mutant receptor exhibit a larger increase in inositol 1,4,5-triphosphate in response to Ca2+ than oocytes expressing the wild-type receptor. We conclude that this extracellular domain mutation increases the receptor's activity at low Ca2+ concentrations, causing hypocalcaemia in patients heterozygous for such a mutation.},
  keywords = {*Calcium/bl [Blood],*Genes,*Hypocalcemia/ge [Genetics],*Point Mutation,*Receptors,4,5-Trisphosphate/me [Metabolism],Amino Acid Sequence,Animals,Base Sequence,Calcium-Sensing,Cell Surface/ge [Genetics],Complementary/ge [Genetics],DNA,DNA Mutational Analysis,Dominant,Female,Heterozygote,Homeostasis,Humans,Inositol 1,Lod Score,Male,Mendeley Import (Dec 08),Molecular Sequence Data,Mutagenesis,Oocytes,Pedigree,Receptors,Recombinant Fusion Proteins/me [Metabolism],Site-Directed,Tetany/ge [Genetics],Xenopus laevis}
}

