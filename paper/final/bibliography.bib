@article{Nicolas1993-lt,
  title = {St{\'e}rilisation Par 2 Grammes d'{{Augmentin}}{\textregistered} Des Urines Infect{\'e}es {\`a} Staphylococcus Aureus R{\'e}sistant {\`a} La M{\'e}ticilline},
  author = {Nicolas, M H and {Kitzis} and Karim, A},
  year = {1993},
