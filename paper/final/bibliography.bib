@article{Saab2007-qe,
  title = {Prevalence of Vitamin {{D}} Deficiency and the Safety and Effectiveness of Monthly Ergocalciferol in Hemodialysis Patients},
  author = {Saab, Georges and Young, Daniel O and Gincherman, Yekaterina and Giles, Karla and Norwood, Kathryn and Coyne, Daniel W},
  year = {2007},
  journal = {Nephron. Clinical practice},
  volume = {105},
  number = {3},
  pages = {c132--8},
  publisher = {{Chromalloy American Kidney Center and Washington University School of Medicine, Department of Internal Medicine, Renal Division, Saint Louis, MO 65212, USA. saabg@health.missouri.edu}},
  address = {Switzerland},
  abstract = {BACKGROUND: Vitamin D deficiency is common in CKD and dialysis patients. Studies suggest a physiologic autocrine and/or paracrine role for 1,25(OH)D produced via 1alpha-hydroxylase in tissues such as vascular smooth muscle, breast, prostate, and bone marrow. Studies have not yet defined the optimal dose and duration of vitamin D necessary to replete and maintain stores in dialysis patients, or whether it is safe or beneficial., METHODS: We performed a review of the prevalence of vitamin D deficiency and the safety and effectiveness of ergocalciferol oral supplementation (vitamin D(2), 50,000 IU monthly) given to hemodialysis patients during dialysis May to October 2005 in St. Louis (latitude 38 degrees )., RESULTS: Among the 119-patient cohort present for the entire 6 months, 25(OH)D was (mean +/- SD) 16.9 +/- 8.5 ng/ml, (91\% 30 ng/ml, and none {\textquestiondown} 100 ng/ml). Initial versus 6 mo. serum calcium (9.1 +/- 0.56 vs. 9.2 +/- 0.70), phosphorus (5.25 +/- 1.38 vs. 5.11 +/- 1.31), Ca x P, and paricalcitol dose (10.3 +/- 9.6 vs. 11.3 +/- 9.2 mcg/week) were not significantly different. No hypercalcemia could be attributed to supplementation. Mean hemoglobin did not change significantly (11.96 +/- 1.4 vs. 11.69 +/- 1.4, p = 0.124), but most patients experienced a reduced weekly epoetin dose. Epoetin dose decreased in 64\% of patients, and increased in 28\%., CONCLUSIONS: We conclude that the vast majority of hemodialysis patients are vitamin D-deficient; monthly ergocalciferol 50,000 IU is safe and effective in normalizing serum 25(OH)D levels and may have an epoetin-sparing effect. Copyright 2007 S. Karger AG, Basel.},
  keywords = {*Ergocalciferols/ad [Administration & Dosage],*Hypercalcemia/ep [Epidemiology],*Kidney Failure,*Renal Dialysis/sn [Statistics & Numerical Data],*Risk Assessment/mt [Methods],*Vitamin D Deficiency/pc [Prevention & Control],80 and over,Adult,Aged,Bone Density Conservation Agents/ad [Administratio,Chronic/ep [Epidemiology],Chronic/rh [Rehabilitation],Comorbidity,Drug Administration Schedule,Female,Humans,Male,Mendeley Import (Dec 08),Middle Aged,Missouri/ep [Epidemiology],Retrospective Studies,Risk Factors,Treatment Outcome}
}

