@article{hackettMeningococcalBacterialDNA2002,
  title = {Meningococcal Bacterial {{DNA}} Load at Presentation Correlates with Disease Severity},
  author = {Hackett, S. J. and Guiver, M. and Marsh, J. and Sills, J. A. and Thomson, A. P. J. and Kaczmarski, E. B. and Hart, C. A.},
  year = {2002},
  month = jan,
  journal = {Archives of Disease in Childhood},
  volume = {86},
  number = {1},
  pages = {44--46},
  publisher = {BMJ Publishing Group Ltd},
  issn = {0003-9888, 1468-2044},
  doi = {10.1136/adc.86.1.44},
  urldate = {2020-10-14},
  abstract = {Aims: To determine bacterial loads in meningococcal disease (MCD), their relation with disease severity, and the factors which determine bacterial load. Methods: Meningococcal DNA quantification was performed by the Taqman PCR method on admission and sequential blood samples from patients with MCD. Disease severity was assessed using the Glasgow Septicaemia Prognostic Score (GMSPS, range 0--15, severe disease {$\geq$}8). Results: Median admission bacterial load was 1.6 {\texttimes} 106 DNA copies/ml of blood (range 2.2 {\texttimes} 104 to 1.6 {\texttimes} 108). Bacterial load was significantly higher in patients with severe (8.4 {\texttimes} 106) compared to milder disease (1.1 {\texttimes} 106, p = 0.018). This difference was greater in septicaemic patients (median 1.6 {\texttimes} 107 versus 9.2 {\texttimes} 105, p {$<$} 0.001). Bacterial loads were significantly higher in patients that died (p = 0.017). Admission bacterial load was independent of the duration of clinical symptoms prior to admission, with no difference between the duration of symptoms in mild or severe cases (median, 10.5 and 11 hours respectively). Bacterial loads were independent of DNA elimination rates following treatment. Conclusion: Patients with MCD have higher bacterial loads than previously determined with quantitative culture methods. Admission bacterial load is significantly higher in patients with severe disease (GMSPS {$\geq$}8) and maximum load is highest in those who die. Bacterial load is independent of the duration of clinical symptoms or the decline in DNA load.},
  chapter = {Acute paediatrics},
  copyright = {Copyright 2002 Archives of Disease in Childhood},
  langid = {english},
  pmid = {11806883},
  keywords = {bacterial load,disease severity,meningococcal disease},
  file = {/Users/fh6520/Zotero/storage/QZSA5LBC/Hackett et al. - 2002 - Meningococcal bacterial DNA load at presentation c.pdf;/Users/fh6520/Zotero/storage/SGQ6NB2E/44.html}
}

