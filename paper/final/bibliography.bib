@article{kurlandskylePatternsCarboxyhemoglobinChanges2015,
  title = {Patterns of Carboxyhemoglobin Changes in Cystic Fibrosis Patients Imply a Heme Oxygenase Modifier Effect},
  author = {{Kurlandsky L E}},
  year = {2015},
  journal = {Am. J. Respir. Crit. Care Med.},
  volume = {191},
  number = {MeetingAbstracts},
  publisher = {American Thoracic Society},
  abstract = {Introduction: Carbon monoxide (CO) bound to hemoglobin as carboxyhemoglobin can be measured noninvasively by transcutaneous pulse CO-Oximetry and expressed as SpCO\%. Previous observations in clinically stable outpatients with cystic fibrosis (CF) showed a positive and statistically significant correlation between SpCO\% and FEV1\% suggesting that elevated CO was endogenously produced by heme oxygenase (HO). The objective of the observations herein reported was to see if SpCO\% varied over time, with changes in FEV1\%, or during pulmonary exacerbations. Method(s): Fourteen patients (5-21 years old) had two or more simultaneous SpCO\% and FEV1\% measurements. SpCO\% was measured noninvasively within a range of +2\% by the Rainbow-SET Rad-57 Pulse CO-Oximeter (Masimo Inc., Irvine, CA). The Upstate Medical University Institutional Review Board approved exploratory measuring and waived the need for informed consent. No treatment decisions were made based on SpCO\%. Result(s): Seven patients with FEV1\% {$>$} 85\% and SpCO\% {$>$} 7 maintained these values steadily. Two patients: a 9 year old girl with an initial normal FEV1\% showed SpCO\% elevation following a declining FEV1\%, and an 11 year old girl with an initially low FEV1\% as well as low SpCO\% showed SpCO\% elevation with declining FEV1\%. These responses occurred during repeated episodes of hospitalizations for pulmonary exacerbations. In both of these cases, SpCO\% then decreased after FEV1\% improved. The other five patients (14-21 years old ) showed persistently low SpCO\% {$<$} 7 regardless of a therapeutic response to a pulmonary exacerbation and improved FEV1\%. Conclusion(s): While observations are limited in number, a few patterns of SpCO\% response to changes in FEV1\% in CF were noted. SpCO\% remained high in some CF patients with consistently normal lung function. In a few patients, SpCO\% increased with declining lung function and stabilized or declined after lung function improved. In other CF patients, SpCO\% remained unchanged despite marked fluctuation in FEV1\% during pulmonary exacerbations and treatment. These variable SpCO\% patterns may be reflective of endogenous HO activity and CO production. They suggest a modifier gene effect of HO polymorphisms in CF. If these observations can be replicated, measurement of SpCO\% may be an easy, noninvasive method of monitoring HO activity in CF.},
  keywords = {*American,*carboxyhemoglobin,*cystic fibrosis,*heme oxygenase,*human,*patient,*society,carbon monoxide,female,girl,hemoglobin,hospitalization,informed consent,institutional review,lung function,modifier gene,monitoring,non invasive procedure,outpatient,ovid_export_ris.ris,oximeter,oximetry,pulse oximeter,pulse rate,treatment response,university}
}

