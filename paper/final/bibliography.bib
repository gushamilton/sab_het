@article{Peuchant2011-ex,
  title = {First Case of {{Chlamydia}} Trachomatis {{L2b}} Proctitis in a Woman},
  author = {Peuchant, O and Baldit, C and Le Roy, C and {Trombert-Paolantoni}, S and Clerc, M and B{\'e}b{\'e}ar, C and {de Barbeyrac}, B},
  year = {2011},
  month = dec,
  journal = {Clin. Microbiol. Infect.},
  volume = {17},
  number = {12},
  pages = {E21--3},
  abstract = {Since 2003, outbreaks of lymphogranuloma venereum (LGV) have been reported in European countries, North America, and Australia. Current LGV cases have been caused by Chlamydia trachomatis serovar L2. This sexually transmitted infection is predominantly found among men who have sex with men, specifically men who are seropositive for human immunodeficiency virus and have clinical signs of proctitis. The current outbreak has been almost exclusively attributed to a new variant, designated L2b. Although urogenital cases of LGV have been described in the heterosexual population, we report the first case of C. trachomatis L2b proctitis in a woman.},
  langid = {english},
  keywords = {Chlamydia trachomatis,Female,First case,L2b,Mendeley Import (Dec 08),Proctitis}
}

