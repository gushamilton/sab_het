  journal = {J. Neurochem.},
  volume = {146},
  number = {2},
  pages = {198},
  publisher = {Blackwell Publishing Ltd},
  address = {United Kingdom},
  abstract = {The following published article from the Journal of Neurochemistry, entitled ``Pre-treatment with the synthetic antioxidant T-butyl bisphenol protects cerebral tissues from experimental ischemia reperfusion injury'' Thi Thuy Hong Duong, Belal Chami, Aisling C. McMahon, Genevieve M. Fong, Joanne M. Dennis, Saul B. Freedman, Paul K. Witting (J. Neurochem. 2014 Sep;130(6):733-47; https://doi.org/10.1111/jnc.12747; PMID: 24766199) is being corrected. The corresponding author notified the Editorial Office that in Table, incorrect PCR primer sequences for beta-actin and hemeoxygenase-1 (HO-1) were reported. The cited primers amplify the corresponding human cDNA, not rat cDNA as incorrectly stated in the publication. New validation experiments (listed below) have been performed that demonstrate that the correct primers were used in the original research: an in silico analysis of the primer sequences; review of the original qPCR data, specifically the unique thermal melting points of the PCR products; a repeat of the original experiment using the correct and validated rat PCR primers. The corrected Table is shown below. Corrections are highlighted in green: Sequences of primers used for mRNA detection by RT-PCR (Table presented.) Primers were designed using a BLAST search of protein databases and converting sequence data to the primary DNA sequence. Primers were designed using this consensus sequence with specific fragments between 100 and 200 bp chosen for each of the genes of interest.Copyright {\textbackslash}copyright 2018 International Society for Neurochemistry},
  langid = {english},
  keywords = {*erratum,ovid_export_ris.ris}
}

