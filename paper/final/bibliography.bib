@book{schwarzerMetaAnalysis2015,
  title = {Meta-{{Analysis}} with {{R}}},
  author = {Schwarzer, Guido and Carpenter, James R and R{\"u}cker, Gerta},
  year = {2015},
  month = oct,
  publisher = {Springer International Publishing},
  abstract = {This book provides a comprehensive introduction to performing meta-analysis using the statistical software R. It is intended for quantitative researchers and students in the medical and social sciences who wish to learn how to perform meta-analysis with R. As such, the book introduces the key concepts and models used in meta-analysis. It also includes chapters on the following advanced topics: publication bias and small study effects; missing data; multivariate meta-analysis, network meta-analysis; and meta-analysis of diagnostic studies.},
  langid = {english}
}

@article{Schweitzer1978-ff,
  title = {Management of Severe Hypercalcemia Caused by Primary Hyperparathyroidism},
  author = {Schweitzer, V G and Thompson, N W and Harness, J K and Nishiyama, R H},
  year = {1978},
  journal = {Archives of surgery (Chicago, Ill. : 1960)},
  volume = {113},
  number = {4},
  pages = {373--381},
  address = {UNITED STATES},
  abstract = {Hypercalcemic crisis is a rare but often fatal complication of hyperparathyroidism (HPT). The reported mortality of 60\% has been related to delay in diagnosis and appropriate treatment. During a 16-year period (1961 to 1977), 29 patients with severe symptomatic hypercalcemia caused by primary HPT were treated at the Surgical Service at the University of Michigan Hospital. This group represents 6\% of the patients with primary HPT treated during this period. All but one patient had an exploration of the neck when the serum calcium level had been decreased to 12 mg/100 ml by intravenous hydration with saline, furosemide diuresis, and mithramycin when a hypocalcemic agent was required. One comatose patient died of irreversible shock. All of the 28 patients who had parathyroidectomies survived the early postoperative period. One patient died three weeks later of a myocardial infarction. This study demonstrates that emergent nonoperative care of parathyroid crisis, followed promptly by parathyroidectomy, can be successful in nearly all cases.},
  keywords = {*Hypercalcemia/et [Etiology],*Hyperparathyroidism/co [Complications],Adult,Age Factors,Aged,Calcium/bl [Blood],Female,Follow-Up Studies,Humans,Hypercalcemia/su [Surgery],Hyperparathyroidism/su [Surgery],Male,Mendeley Import (Dec 08),Methods,Middle Aged,Parathyroid Hormone/bl [Blood],Postoperative Complications,Preoperative Care}
}

