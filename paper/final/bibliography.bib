  author = {{EmmaHook}},
  journal = {Diabetes UK},
  abstract = {When you have diabetes, it's important to know how to cope when you're unwell. Especially if you have to go into hospital. Being ill can upset your diabetes management, so you need to know what to do to keep your blood glucose (sugar) levels as close to target as possible. Some people will know these as diabetes sick day rules.},
