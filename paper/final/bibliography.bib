@article{arnoldKrebsLungen62021,
  title = {Krebs von Den {{Lungen}} 6 ({{KL-6}}) as a Marker for Disease Severity and Persistent Radiological Abnormalities Following {{COVID-19}} Infection at 12 Weeks},
  author = {Arnold, David T and Donald, Charmaine and Lyon, Max and Hamilton, Fergus W and Morley, Anna J and Attwood, Marie and Dipper, Alexandra and Barratt, Shaney L},
  year = {2021},
