@article{Edis1979-yu,
  title = {The Undescended ``Parathymus''. {{An}} Occasional Cause of Failed Neck Exploration for Hyperparathyroidism},
  author = {Edis, A J and Purnell, D C and {van Heerden}, J A},
  year = {1979},
  journal = {Annals of surgery},
  volume = {190},
  number = {1},
  pages = {64--68},
  address = {UNITED STATES},
  abstract = {Arrested descent of the inferior parathyroid gland (``parathymus'') during embryologic development may leave the gland stranded high in the neck. Adenomas of such undescended glands are a rare cause of primary hyperparathyroidism, but they may not be uncommon among patients who have already had a failed cervical exploration. Unless the surgeon is aware of this entity, he will probably overlook it. If one is to find these tumors, it is necessary to extend the dissection upward above the superior pole of the thyroid gland, sometimes as far as the angle of the jaw. Adenomas of undescended ``parathymus'' glands were encountered in seven patients during a recent 20 month (May 1975 through December 1976) surgical experience encompassing 414 primary operations and 27 reoperations for hyperparathyroidism. These tumors were found at initial exploration in one patient and at reoperation in six patients. The individual case histories are presented to illustrate the difficulties posed by this anatomic variant.},
  keywords = {*Adenoma/su [Surgery],*Hyperparathyroidism/et [Etiology],*Parathyroid Glands/ab [Abnormalities],*Parathyroid Neoplasms/su [Surgery],Adenoma/co [Complications],Adolescent,Adult,Aged,Female,Humans,Hypercalcemia/co [Complications],Kidney Calculi/co [Complications],Male,Mendeley Import (Dec 08),Middle Aged,Nephrocalcinosis/co [Complications],Parathyroid Glands/em [Embryology],Parathyroid Neoplasms/co [Complications],Thymus Gland/em [Embryology]}
}

