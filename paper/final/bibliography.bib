@article{distanteOriginSpreadHFEC282Y2004,
  title = {The Origin and Spread of the {{HFE-C282Y}} Haemochromatosis Mutation},
  author = {Distante, S and Robson, K J H and {Graham-Campbell}, J and {Arnaiz-Villena}, A and Brissot, P and Worwood, Mark},
  year = {2004},
  month = sep,
