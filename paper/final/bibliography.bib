@article{jin301IntracavernousDelivery2010,
  title = {301 Intracavernous Delivery of Comp-Angiopoietin-1 Protein Rescues Erectile Function through Enhanced Cavernous Endothelial Regeneration in the Streptozotocin-Induced Diabetic Mice},
  author = {Jin, H R and Song, J S and Kim, W J and Piao, S and Choi, M J and Tumurbaatar, M and Shin, S H and Tuvshintur, B and Seong, D H and Yoon, S M and Koh, G Y and Ryu, J K and Suh, J K},
  year = {2010},
  month = apr,
  journal = {Eur. Urol. Suppl.},
  volume = {9},
  number = {2},
  pages = {121},
  publisher = {Elsevier BV},
  abstract = {Introduction \& Objectives: Patients with erectile dysfunction (ED) associated with diabetes often have severe endothelial dysfunction and respond poorly to oral phosphodiesterase-5 inhibitors. Therefore, cavernous endothelial regeneration is a promising strategy for curing diabetic ED. In the present study, we determined the effectiveness of the soluble, stable, and potent angiopoietin-1 (Ang1) variant, cartilage oligomeric matrix protein (COMP)-Angl, in promoting cavernous angiogenesis and erectile function in a mouse model of type I diabetic ED. Material(s) and Method(s): Eight-week-old C57BL/6J mice were used and diabetes was induced by intraperitoneal injection of streptozotocin (50 mg/kg for 5 days). Eight weeks after induction of diabetes, mice were divided into 4 groups (N = 18 per group): age-matched controls, diabetic mice without treatment, and diabetic mice receiving repeated intracavernous (IC) injections of saline (days -3 and 0; 20 ul), or COMP-Ang1 protein (days -3 and 0; 5.8 mug/20 ul). Two weeks later, erectile function was measured by electrical stimulation of cavernous nerve. The penis was then harvested and stained with antibody to PECAM-1, phosphohistone H3 (PH3), phospho-eNOS, and nitrotyrosine (N = 6 per group). We performed western blot analysis of p47phonx, iNOS, heme oxygenase-1 (HO-1), and endothelial cell-to-cell junction proteins including VE-cadherin, ZO-1, occludin, and claudin-5 (N = 4 per group). Penis specimens from a separate group of animals were used for cGMP quantification (N = 4 per group) and vascular permeability test (N = 4 per group). Result(s): Local delivery of COMP-Ang1 protein significantly increased cavernous endothelial proliferation, eNOS phosphorylation, and cGMP expression compared with that in untreated or saline-treated diabetic group, which resulted in restoration of erectile function (85-90\% of control values). Cavernous p47phonx, iNOS, and HO-1 protein expression and nitrotyrosine production was significantly decreased in COMP-Ang1-treated diabetic mice compared with that in untreated or saline-treated diabetic group. IC injection of COMP-Ang1 protein significantly decreased cavernous endothelial permeability in the diabetic mice through restoration of endothelial cell-to-cell junction proteins, whereas untreated or saline-treated diabetic mice revealed a significant leakage of 3 kDa fluorescent tracer across the cavernous endothelium. Conclusion(s): These findings support the concept of cavernous endothelial regeneration using recombinant Ang1 protein as curative therapy for ED. Source of Funding This work was supported by the Korea Science and Engineering Foundation (KOSEF) grant funded by the Korea government (MEST) (R0A-2007-000-20018-0, J.K. Suh).},
  langid = {english},
  keywords = {*diabetes mellitus,*mouse,*protein,*regeneration,*streptozocin,*urology,3 nitrotyrosine,angiogenesis,angiopoietin 1,antibody,blood vessel permeability,cartilage oligomeric matrix protein,CD31 antigen,cell junction,claudin 5,cyclic GMP,electrostimulation,endothelial dysfunction,endothelium,endothelium cell,engineering,erectile dysfunction,funding,government,heme oxygenase 1,injection,intracavernous drug administration,intraperitoneal drug administration,Korea,model,nerve,non profit organization,occludin,ovid_export_ris.ris,patient,penis,permeability,phosphodiesterase V inhibitor,phosphorylation,protein expression,sodium chloride,therapy,tracer,vascular endothelial cadherin,Western blotting}
}

@article{jinEfficacyImmunogenicityVitetanus2017,
  title = {Efficacy and Immunogenicity of a {{Vi-tetanus}} Toxoid Conjugate Vaccine in the Prevention of Typhoid Fever Using a Controlled Human Infection Model of {{Salmonella Typhi}}: A Randomised Controlled, Phase 2b Trial},
  shorttitle = {Efficacy and Immunogenicity of a {{Vi-tetanus}} Toxoid Conjugate Vaccine in the Prevention of Typhoid Fever Using a Controlled Human Infection Model of {{Salmonella Typhi}}},
  author = {Jin, Celina and Gibani, Malick M. and Moore, Maria and Juel, Helene B. and Jones, Elizabeth and Meiring, James and Harris, Victoria and Gardner, Jonathan and Nebykova, Anna and Kerridge, Simon A. and Hill, Jennifer and {Thomaides-Brears}, Helena and Blohmke, Christoph J. and Yu, Ly-Mee and Angus, Brian and Pollard, Andrew J.},
  year = {2017},
  month = dec,
  journal = {The Lancet},
  volume = {390},
  number = {10111},
  pages = {2472--2480},
  issn = {0140-6736, 1474-547X},
  doi = {10.1016/S0140-6736(17)32149-9},
  urldate = {2020-10-14},
  abstract = {{$<$}h2{$>$}Summary{$<$}/h2{$><$}h3{$>$}Background{$<$}/h3{$><$}p{$>$}\emph{Salmonella enterica} serovar Typhi (\emph{S} Typhi) is responsible for an estimated 20 million infections and 200 000 deaths each year in resource poor regions of the world. Capsular Vi-polysaccharide-protein conjugate vaccines (Vi-conjugate vaccines) are immunogenic and can be used from infancy but there are no efficacy data for the leading candidate vaccine being considered for widespread use. To address this knowledge gap, we assessed the efficacy of a Vi-tetanus toxoid conjugate vaccine using an established human infection model of \emph{S} Typhi.{$<$}/p{$><$}h3{$>$}Methods{$<$}/h3{$><$}p{$>$}In this single-centre, randomised controlled, phase 2b study, using an established outpatient-based human typhoid infection model, we recruited healthy adult volunteers aged between 18 and 60 years, with no previous history of typhoid vaccination, infection, or prolonged residency in a typhoid-endemic region. Participants were randomly assigned (1:1:1) to receive a single dose of Vi-conjugate (Vi-TT), Vi-polysaccharide (Vi-PS), or control meningococcal vaccine with a computer-generated randomisation schedule (block size 6). Investigators and participants were masked to treatment allocation, and an unmasked team of nurses administered the vaccines. Following oral ingestion of \emph{S} Typhi, participants were assessed with daily blood culture over a 2-week period and diagnosed with typhoid infection when meeting pre-defined criteria. The primary endpoint was the proportion of participants diagnosed with typhoid infection (ie, attack rate), defined as persistent fever of 38{$^\circ$}C or higher for 12 h or longer or \emph{S} Typhi bacteraemia, following oral challenge administered 1 month after Vi-vaccination (Vi-TT or Vi-PS) compared with control vaccination. Analysis was per protocol. This trial is registered with ClinicalTrials.gov, number NCT02324751, and is ongoing.{$<$}/p{$><$}h3{$>$}Findings{$<$}/h3{$><$}p{$>$}Between Aug 18, 2015, and Nov 4, 2016, 112 participants were enrolled and randomly assigned; 34 to the control group, 37 to the Vi-PS group, and 41 to the Vi-TT group. 103 participants completed challenge (31 in the control group, 35 in the Vi-PS group, and 37 in the Vi-TT group) and were included in the per-protocol population. The composite criteria for typhoid diagnosis was met in 24 (77\%) of 31 participants in the control group, 13 (35\%) of 37 participants in the Vi-TT group, and 13 (35\%) of 35 participants in the Vi-PS group to give vaccine efficacies of 54{$\cdot$}6\% (95\% CI 26{$\cdot$}8--71{$\cdot$}8) for Vi-TT and 52{$\cdot$}0\% (23{$\cdot$}2--70{$\cdot$}0) for Vi-PS. Seroconversion was 100\% in Vi-TT and 88{$\cdot$}6\% in Vi-PS participants, with significantly higher geometric mean titres detected 1-month post-vaccination in Vi-TT vaccinees. Four serious adverse events were reported during the conduct of the study, none of which were related to vaccination (one in the Vi-TT group and three in the Vi-PS group).{$<$}/p{$><$}h3{$>$}Interpretation{$<$}/h3{$><$}p{$>$}Vi-TT is a highly immunogenic vaccine that significantly reduces typhoid fever cases when assessed using a stringent controlled model of typhoid infection. Vi-TT use has the potential to reduce both the burden of typhoid fever and associated health inequality.{$<$}/p{$><$}h3{$>$}Funding{$<$}/h3{$><$}p{$>$}The Bill \& Melinda Gates Foundation and the European Commission FP7 grant, Advanced Immunization Technologies (ADITEC).{$<$}/p{$>$}},
  langid = {english},
  pmid = {28965718},
  file = {/Users/fh6520/Zotero/storage/H7HQCV9N/Jin et al. - 2017 - Efficacy and immunogenicity of a Vi-tetanus toxoid.pdf;/Users/fh6520/Zotero/storage/SDXN4K9N/Jin et al. - 2017 - Efficacy and immunogenicity of a Vi-tetanus toxoid.html}
}

@article{jinEnhancementDENinducedLiver2016,
  title = {Enhancement of {{DEN-induced}} Liver Tumorigenesis in Heme Oxygenase-1 {{G143H}} Mutant Transgenic Mice},
  author = {Jin, Jianfeng and Wang, Dayong and Xiao, Haifeng and Wei, Huiyan and Matunda, Cedric and Zhang, He and Li, Xin and Wang, Chuxuan and Zou, Chaoxia and Gao, Xu and Zhao, Weiming and Li, Qiang},
  year = {2016},
  month = dec,
  journal = {Biochem. Biophys. Res. Commun.},
  volume = {481},
  number = {1-2},
  pages = {169--175},
  publisher = {Elsevier B.V. (E-mail: apjcs@harcourt.com)},
  address = {United States},
  abstract = {Heme oxygenase (HO) is the rate-limiting enzyme in heme metabolism. HO-1 exhibits anti-oxidative and anti-inflammatory function via the actions of its metabolite, respectively. A growing body of evidence demonstrates that HO-1 is implicated in the pathogenesis and progression of several types of cancer. However, whether HO-1 takes part in healthy-premalignant-malignant transformation is still undefined. In this study, we took advantage of transgenic mice which over-expressed HO-1 dominant negative mutant (HO-1 G143H) and observed its susceptibility to DEN-induced hepatocarcinogenesis. Our results indicate that HO-1 G143H mutant accelerates the progression of tumorigenesis and tumor growth. The mechanism is closely related to enhancement of ROS production which induce more hepatocytes death and secretion of inflammatory cytokines, proliferation of surviving hepatocytes. Our result provides the direct evidence that HO-1 plays an important protective role in liver carcinogenesis. Alternatively, we suggest the possible explanation on effect of HO-1 promoter polymorphism which involved in tumorigenesis.},
  langid = {english},
  keywords = {*heme oxygenase 1/ec [Endogenous Compound],*liver carcinogenesis/et [Etiology],animal cell,animal experiment,animal model,animal tissue,article,cancer growth,cancer susceptibility,cell death,cell proliferation,controlled study,cytokine release,diethylnitrosamine,female,Heme oxygenase-1,liver,liver cell,liver regeneration,Liver tumorigenesis,male,mouse,nonhuman,ovid_export_ris.ris,oxidative stress,priority journal,protein expression,reactive oxygen metabolite/ec [Endogenous Compound],signal transduction,Transgenic animal}
}

@article{jinHippocampalLipocalin22020,
  title = {Hippocampal {{Lipocalin}} 2 {{Is Associated With Neuroinflammation}} and {{Iron-Related Oxidative Stress}} in Ob/Ob {{Mice}}},
  author = {Jin, Zhen and Kim, Kyung Eun and Shin, Hyun Joo and Jeong, Eun Ae and Park, Kyung-Ah and Lee, Jong Youl and An, Hyeong Seok and Choi, Eun Bee and Jeong, Jae Hun and Kwak, Woori and Roh, Gu Seob},
  year = {2020},
  month = may,
  journal = {J. Neuropathol. Exp. Neurol.},
  volume = {79},
  number = {5},
  pages = {530--541},
  publisher = {Oxford University Press},
  address = {United States},
  abstract = {Obesity causes brain injuries with inflammatory and structural changes, leading to neurodegeneration. Although increased circulating lipocalin 2 (LCN2) level has been implicated in neurodegenerative diseases, the precise mechanism of neurodegeneration in obesity is not clear. Here, we investigated whether LCN2-mediated signaling promotes neurodegeneration in the hippocampus of leptin-deficient ob/ob mice, which are characterized by obesity, insulin resistance, systemic inflammation, and neuroinflammation. In particular, there was significant upregulation of both LCN2 and matrix metalloproteinase 9 levels from serum and hippocampus in ob/ob mice. Using RNA-seq analysis, we found that neurodegeneration- sortilin-related receptor 1 (Sorl1) and brain-derived neurotrophic factor (Bdnf) genes were significantly reduced in the hippocampus of ob/ob mice. We additionally found that the endosome-related WD repeat and FYVE-domain-containing 1 (Wdfy1) gene were upregulated in ob/ob mice. In particular, iron overload-related mitochondrial ferritin and nuclear factor erythroid 2-related factor 2 (Nrf2)/heme oxygenase-1 (HO-1) proteins were increased in the hippocampus of ob/ob. Thus, these findings indicate that iron-binding protein LCN2-mediated oxidative stress promotes neurodegeneration in ob/ob mice.},
  langid = {english},
  keywords = {*hippocampus,*iron,*iron overload,*nervous system inflammation,*neutrophil gelatinase associated lipocalin/ec [Endogenous Compound],*oxidative stress,animal experiment,animal model,article,brain derived neurotrophic factor/ec [Endogenous Compound],controlled study,endosome,enzyme linked immunosorbent assay,eotaxin/ec [Endogenous Compound],ferritin/ec [Endogenous Compound],food intake,gelatinase B/ec [Endogenous Compound],gene expression,heme oxygenase 1/ec [Endogenous Compound],high throughput sequencing,Hippocampus,immunofluorescence,insulin resistance,insulin tolerance test,interleukin 10/ec [Endogenous Compound],interleukin 1beta/ec [Endogenous Compound],interleukin 2 receptor/ec [Endogenous Compound],interleukin 5/ec [Endogenous Compound],interleukin 6/ec [Endogenous Compound],Iron,iron binding protein/ec [Endogenous Compound],leptin deficiency,Lipocalin 2,male,mouse,nerve degeneration,Neurodegeneration,nonhuman,Ob/ob mice,obesity,ovid_export_ris.ris,Oxidative stress,priority journal,reactive oxygen metabolite/ec [Endogenous Compound],real time polymerase chain reaction,recombinant human insulin,RNA sequencing,toll like receptor 11/ec [Endogenous Compound],toll like receptor 4/ec [Endogenous Compound],transcription factor Nrf2/ec [Endogenous Compound],tumor necrosis factor/ec [Endogenous Compound],upregulation,vasculotropin/ec [Endogenous Compound],WD repeat}
}

@article{jiraskovaAssociationSerumBilirubin2012,
  title = {Association of Serum Bilirubin and Promoter Variations in {{HMOX1}} and {{UGT1A1}} Genes with Sporadic Colorectal Cancer},
  author = {Jir{\'a}skov{\'a}, Alena and Novotn{\'y}, Jan and Novotn{\'y}, Ladislav and Vodicka, Pavel and Pardini, Barbara and Naccarati, Alessio and Schwertner, Harvey A and Hub{\'a}cek, Jaroslav A and Puncoch{\'a}rov{\'a}, Lucie and {\v S}merhovsk{\'y}, Zdenek and V{\'i}tek, Libor},
  year = {2012},
  month = oct,
  journal = {Int. J. Cancer},
  volume = {131},
  number = {7},
  pages = {1549--1555},
  publisher = {Wiley-Liss Inc. (111 River Street, Hoboken NJ 07030-5774, United States)},
  address = {United States},
  abstract = {Heme oxygenase-1 (HMOX1) and bilirubin UDP-glucuronosyltransferase (UGT1A1) enzymes, both involved in bilirubin homeostasis, play an important role in the oxidative stress defense. The objective of our study was to assess the effect of promoter variations of HMOX1 and UGT1A1 genes and of serum bilirubin on the risk of sporadic colorectal cancer (CRC). This exploratory case-control study was based on 777 CRC patients and 986 controls from the Czech Republic. The (GT)(n) and (TA)(n) dinucleotide variations in HMOX1 and UGT1A1 gene promoters, respectively, were determined by fragment analysis. In addition, the A(-413)T variant in HMOX1 promoter was also analyzed using a polymerase chain reaction-restriction fragment length polymorphism (PCR-RFLP) method. Serum bilirubin levels were compared in a subset of 174 cases and 247 controls, for whom biochemical data were available. After adjustment for age, a significant association between CRC risk and UGT1A1*28 allele carrier status was detected [odds ratio (95\% confidence intervals) = 0.80 (0.60-0.97), p = 0.022]. No association between CRC risk and individual HMOX1 gene variants was observed, although a diplotype analysis revealed an increased risk for a specific HMOX1 genotype combination. These effects were more pronounced in males. Substantially lower serum bilirubin levels were detected in CRC patients compared to the controls (p {$<$} 0.001); each 1 {$\mu$}mol/L decrease in serum bilirubin was associated with a 7\% increase of CRC risk (p {$<$} 0.001). In conclusion, UGT1A1*28 allele carrier status might be a protective factor against the development of CRC in the male population, whereas low serum bilirubin levels are associated with an increased risk of CRC in both genders.},
  langid = {english},
  keywords = {*bilirubin blood level,*bilirubin/ec [Endogenous Compound],*colorectal cancer/et [Etiology],*genetic variability,*hmox1 gene,*promoter region,*ugt1a1 gene,adult,age,aged,allele,article,cancer risk,case control study,controlled study,Czech Republic,disease association,exploratory research,female,gene,genotype,heterozygote,human,human cell,major clinical study,male,nucleotide sequence,ovid_export_ris.ris,priority journal,sex difference}
}

@article{jiraskovaPW209AssociationSerum2014,
  title = {{{PW209 Association}} of Serum Bilirubin Levels and Promoter Variations of {{HMOX1}} and {{UGT1A1}} Genes with Fabry Disease},
  author = {Jiraskova, Alena and Bortolussi, Giulia and Dostalova, Gabriela and Kadlckova, Lenka and Belohlavek, Jan and Golan, Lubor and Linhart, Ales and Vitek, Libor},
  year = {2014},
  month = mar,
  journal = {Glob. Heart},
  volume = {9},
  number = {1},
  pages = {e299--e300},
  publisher = {Ubiquity Press, Ltd.},
  abstract = {Introduction: Bilirubin belongs to the major endogenous antioxidants and its serum concentrations are regulated by enzymes heme oxygenase (HMOX) and bilirubin UDPglucuronosyl transferase (UGT1A1). It has been proved that highly polymorphic promoters of genes coding for these enzymes are associated with diseases mediated by increased oxidative stress, including atherosclerosis. Objective(s): The aim of our study was to assess possible relationship between these polymorphic gene promoters, serum bilirubin levels and Fabry disease (FD) characterized by disordered glycosphingolipid metabolism, and accompanied by premature atherosclerosis. Method(s): The study was performed on 56 patients with FD (M:F ratio = 0.54) and 185 healthy individuals. Complete standard laboratory and clinical work-up was performed in all subjects, together with determination of total peroxyl radical scavenging capacity. The (GT)n and (TA)n dinucleotide variations in HMOX1 and UGT1A1 gene promoters, respectively, were determined by fragment analysis. Analyzed variables were assessed by respective statistical tests (Mann-Whithey test and logistic regression analysis). Result(s): Compared to controls, patients with FD had substantially lower serum bilirubin levels (12.0 vs. 8.85 umol/L, p=0.003) and also total peroxyl radical scavenging capacity (p{$<$}0.05), which was in a close positive relationship with serum bilirubin levels (p=0.05) and also with use of enzyme replacement therapy (p=0.036). Presence of L allele in HMOX1 gene promoter responsible for lower enzyme activity was not associated with manifestation of FD (OR=1.69; 95\% CI=0.54-5.24, p=0.46). On the other hand, presence of TA7 allele UGT1A1 gene promoter responsible for higher systemic bilirubin levels was associated with two-fold lower risk of manifestation of FD (OR=0.51, 95\% CI=0.27-0.97 p=0.038). Conclusion(s): FD is associated with markedly lower serum bilirubin levels, most likely due to bilirubin consumption during increased oxidative stress accompanying FD. However genetic factors affecting defense against increased oxidative stress (UGT1A1 promoter gene polymorphism) seems to contribute to manifestation of FD as well.},
  langid = {english},
  keywords = {*bilirubin blood level,*cardiology,*Fabry disease,*gene,*promoter region,allele,antioxidant,atherosclerosis,bilirubin,blood level,dinucleotide,diseases,DNA polymorphism,enzyme,enzyme activity,enzyme replacement,glycosphingolipid,heme oxygenase,heredity,human,laboratory,logistic regression analysis,metabolism,ovid_export_ris.ris,oxidative stress,patient,peroxy radical,risk,transferase}
}

@article{jiraskovaSerumBilirubinLevels2017,
  title = {Serum {{Bilirubin Levels}} and {{Promoter Variations}} in {{HMOX1}} and {{UGT1A1 Genes}} in {{Patients}} with {{Fabry Disease}}},
  author = {Jir{\'a}skov{\'a}, Alena and Bortolussi, Giulia and Dost{\'a}lov{\'a}, Gabriela and Eremi{\'a}{\v s}ov{\'a}, Lenka and Gola{\v n}, Lubor and Danzig, Vil{\'e}m and s Linhart, Ale{\textbackslash}v and V{\'i}tek, Libor},
  year = {2017},
  month = aug,
  journal = {Oxid. Med. Cell. Longev.},
  volume = {2017},
  pages = {9478946},
  publisher = {Hindawi Limited (410 Park Avenue, 15th Floor, 287 pmb, New York NY 10022, United States)},
  address = {United States},
  abstract = {The aim of our study was to assess the possible relationships among heme oxygenase (HMOX), bilirubin UDP-glucuronosyl transferase (UGT1A1) promoter gene variations, serum bilirubin levels, and Fabry disease (FD). The study included 56 patients with FD (M : F ratio = 0.65) and 185 healthy individuals. Complete standard laboratory and clinical work-up was performed on all subjects, together with the determination of total peroxyl radical-scavenging capacity. The (GT)n and (TA)n dinucleotide variations in the HMOX1 and UGT1A1 gene promoters, respectively, were determined by DNA fragment analysis. Compared to controls, patients with FD had substantially lower serum bilirubin levels (12.0 versus 8.85 {$\mu$}mol/L, p = 0.003) and also total antioxidant capacity (p {$<$} 0.05), which showed a close positive relationship with serum bilirubin levels (p = 0.067) and the use of enzyme replacement therapy (p = 0.036). There was no association between HMOX1 gene promoter polymorphism and manifestation of FD. However, the presence of the TA7 allele UGT1A1 gene promoter, responsible for higher systemic bilirubin levels, was associated with a twofold lower risk of manifestation of FD (OR = 0.51, 95\% CI = 0.27-0.97, p = 0.038). Markedly lower serum bilirubin levels in FD patients seem to be due to bilirubin consumption during increased oxidative stress, although UGT1A1 promoter gene polymorphism may modify the manifestation of FD as well.},
  langid = {english},
  keywords = {*bilirubin blood level,*bilirubin/ec [Endogenous Compound],*Fabry disease,*glucuronosyltransferase 1A1/ec [Endogenous Compound],*heme oxygenase 1/ec [Endogenous Compound],adult,allele,antioxidant assay,article,controlled study,dinucleotide,enzyme replacement,female,genetic variation,human,laboratory test,major clinical study,male,ovid_export_ris.ris,oxidative stress,peroxy radical,promoter region}
}

@article{jiraskovaSimultaneousGenotypingMicrosatellite2010,
