  author = {Bock, Andrew and Hanson, Blake M and Ruffin, Felicia and Parsons, Joshua B and Park, Lawrence P and {Sharma-Kuinkel}, Batu and Mohnasky, Michael and Arias, Cesar A and Fowler, Vance G and Thaden, Joshua T},
  year = {2023},
