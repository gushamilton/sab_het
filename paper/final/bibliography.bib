@article{yinEffectsSaltSubstitutes2022,
  title = {Effects of Salt Substitutes on Clinical Outcomes: A Systematic Review and Meta-Analysis},
  author = {Yin, Xuejun and Rodgers, Anthony and Perkovic, Adam and Huang, Liping and Li, Ka-Chun and Yu, Jie and Wu, Yangfeng and Wu, J H Y and Marklund, Matti and Huffman, Mark D and Miranda, J Jaime and Di Tanna, Gian Luca and Labarthe, Darwin and Elliott, Paul and Tian, Maoyi and Neal, Bruce},
  year = {2022},
  month = sep,
  journal = {Heart},
  volume = {108},
