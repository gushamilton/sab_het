@article{Derfus2002-it,
  title = {The High Prevalence of Pathologic Calcium Crystals in Pre-Operative Knees},
  author = {Derfus, Beth A and Kurian, Jason B and Butler, Jeffrey J and Daft, Laureen J and Carrera, Guillermo F and Ryan, Lawrence M and Rosenthal, Ann K},
  year = {2002},
  journal = {The Journal of rheumatology},
  volume = {29},
  number = {3},
  pages = {570--574},
  publisher = {Department of Medicine, Medical College of Wisconsin, Milwaukee, USA.},
  address = {Canada},
  abstract = {OBJECTIVE: Calcium pyrophosphate dihydrate (CPPD) and basic calcium phosphate (BCP) crystals are important in the pathogenesis of osteoarthritis (OA) but are under recognized even in end stage disease. We determined the prevalence of these calcium crystals in synovial fluid (SF) of persons undergoing total knee arthroplasty for degenerative arthritis., METHODS: SF samples were obtained from 53 knee joints undergoing total arthroplasty for a pre-operative diagnosis of OA. SF were analyzed via compensated light microscopy for CPPD crystals and a semiquantitative radiometric assay for BCP crystals. Fifty pre-operative radiographs were analyzed and graded according to the scale of Kellgren and Lawrence., RESULTS: Patients had an average age of 70 years at the time of surgery. CPPD and/or BCP crystals were identified in 60\% of SF. Overall radiographic scores correlated with mean concentrations of BCP crystals. Higher mean radiographic scores correlated with the presence of calcium-containing crystals of either type in SF Radiographic chondrocalcinosis was identified in only 31\% of those with SF CPPD., CONCLUSIONS: Pathologic calcium crystals were present in a majority of SF at the time of total knee arthroplasty. Intraoperative SF analysis could conveniently identify pathologic calcium crystals providing information that may be relevant to the future care of the patient's replaced joint and that of other joints. This information could also potentially aid in predicting the likelihood of the need for contralateral total knee arthroplasty.},
  keywords = {*Calcinosis/ep [Epidemiology],*Calcium Phosphates/an [Analysis],*Calcium Pyrophosphate/an [Analysis],*Chondrocalcinosis/ep [Epidemiology],*Osteoarthritis,80 and over,Aged,Arthroplasty,Calcinosis/su [Surgery],Calcium Phosphates/ch [Chemistry],Calcium Pyrophosphate/ch [Chemistry],Chondrocalcinosis/su [Surgery],Crystallization,Female,Humans,Knee,Knee Joint/ch [Chemistry],Knee Joint/pa [Pathology],Knee/ep [Epidemiology],Knee/su [Surgery],Male,Mendeley Import (Dec 08),Middle Aged,Osteoarthritis,Preoperative Care,Prevalence,Replacement}
}

