@article{brundlerImmunityVirusesCelldeficient1996,
  title = {Immunity to Viruses in {{B}} Cell-Deficient Mice: Influence of Antibodies on Virus Persistence and on {{T}} Cell Memory},
  shorttitle = {Immunity to Viruses in {{B}} Cell-Deficient Mice},
  author = {Br{\"u}ndler, M. A. and Aichele, P. and Bachmann, M. and Kitamura, D. and Rajewsky, K. and Zinkernagel, R. M.},
  year = {1996},
