@article{tomczykmEnhancedCardiacMCP12015,
  title = {Enhanced Cardiac {{MCP-1}} and Monocyte Expansion Impede the Injured Heart Recovery in Heme Oxygenase-1-Deficient Mice},
  author = {{Tomczyk M} and {Bukowska-strakova K} and {Szade K} and {Jozkowicz A} and {Dulak J} and {Jazwa A}},
  year = {2015},
  journal = {J. Vasc. Res.},
  volume = {52},
  number = {SUPPL. 1},
  pages = {81--82},
  publisher = {S. Karger AG},
  abstract = {Aim: The aim of our study was to investigate a role of pro-angiogenic and cytoprotective enzyme, heme oxygenase-1 (HO-1), in acute myocardial infarction (MI). Method(s): HO-1 knock-out (KO) and wild type (WT) mice were subjected to surgically induced myocardial infarction. Heart function was weekly monitored with high frequency ultrasonography. Detection of gene and miRNA expression was done using real-time PCR. Flow cytometry was employed for detection of peripheral blood and splenic monocytes and cardiac macrophages. Result(s): Impaired restoration of ejection fraction in HO-1 KO mice was observed up to 3 weeks post-injury when compared to WT littermates. Importantly, improved in WT mice cardiac function was associated with initial upregulation of HO-1 expression in peri-infarct zone. Some genotype-dependent differences were observed in expression of cardiac myocytes-associated miRNAs (i.a. anti-fibrotic miR-29a, pro-proliferative miR-199). Moreover, higher numbers of classical (Ly6C++CD43+) monocytes in peripheral blood of HO-1 KO mice were detected, along with upregulated monocyte chemoatrractant protein-1 (MCP-1) in the heart and increased numbers of cardiac macrophages. Conclusion(s): HO-1 deprivation diminishes recovery of heart function following MI and affects monocyte/macrophage-mediated heart remodeling and repair potential.},
  keywords = {*European,*heart,*heme oxygenase 1,*microcirculation,*monocyte,*mouse,*organization,*society,*vascular biology,acute heart infarction,blood,echography,enzyme,flow cytometry,gene,genotype,heart ejection fraction,heart function,heart infarction,heart muscle cell,infarction,injury,knockout mouse,leukosialin,macrophage,microRNA,microRNA 29a,monocyte chemotactic protein 1,ovid_export_ris.ris,real time polymerase chain reaction,synapsin I,upregulation,wild type mouse}
}

