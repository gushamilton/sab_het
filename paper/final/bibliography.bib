@article{garcia-laordenRoleMannosebindingLectin2013,
  title = {The Role of Mannose-Binding Lectin in Pneumococcal Infection},
  author = {{Garc{\'i}a-Laorden}, M Isabel and {Rodr{\'i}guez de Castro}, Felipe and {Sol{\'e}-Viol{\'a}n}, Jordi and Payeras, Antoni and Briones, M Luisa and Border{\'i}as, Luis and Aspa, Javier and Blanquer, Jos{\'e} and Rajas, Olga and {Marcos-Ramos}, J Alberto and {Herrera-Ramos}, Estefan{\'i}a and {Garc{\'i}a-Bello}, Miguel A and Noda, Judith and Ferrer, Jos{\'e} M and Rello, Jordi and {Rodr{\'i}guez-Gallego}, Carlos},
  year = {2013},
  month = jan,
  journal = {Eur. Respir. J.},
  volume = {41},
  number = {1},
  pages = {131--139},
  abstract = {The role of mannose-binding lectin (MBL) deficiency (MBL2; XA/O and O/O genotypes) in host defences remains controversial. The surfactant proteins (SP)-A1, -A2 and -D, other collectins whose genes are located near MBL2, are part of the first-line lung defence against infection. We analysed the role of MBL on susceptibility to pneumococcal infection and the existence of linkage disequilibrium (LD) among the four genes. We studied 348 patients with pneumococcal community-acquired pneumonia (P-CAP) and 2,110 controls. A meta-analysis of MBL2 genotypes in susceptibility to P-CAP and to invasive pneumococcal disease (IPD) was also performed. The extent of LD of MBL2 with SFTPA1, SFTPA2 and SFTPD was analysed. MBL2 genotypes did not associate with either P-CAP or bacteraemic P-CAP in the case-control study. The MBL-deficient O/O genotype was significantly associated with higher risk of IPD in a meta-analysis, whereas the other MBL-deficient genotype (XA/O) showed a trend towards a protective role. We showed the existence of LD between MBL2 and SP genes. The data do not support a role of MBL deficiency on susceptibility to P-CAP or to IPD. LD among MBL2 and SP genes must be considered in studies on the role of MBL in infectious diseases.},
  langid = {english}
}

@article{garcia-martinHemeOxygenase122015,
  title = {Heme {{Oxygenase-1}} and 2 {{Common Genetic Variants}} and {{Risk}} for {{Restless Legs Syndrome}}},
  author = {{Garc{\'i}a-Mart{\'i}n}, Elena and {Jim{\'e}nez-Jim{\'e}nez}, F{\'e}lix Javier and {Alonso-Navarro}, Hortensia and Mart{\'i}nez, Carmen and Zurdo, Mart{\'i}n and {Turp{\'i}n-Fenoll}, Laura and {Mill{\'a}n-Pascual}, Jorge and {Adeva-Bartolom{\'e}}, Teresa and Cubo, Esther and Navacerrada, Francisco and {Rojo-Sebasti{\'a}n}, Ana and Rubio, Lluisa and {Ortega-Cubero}, Sara and Pastor, Pau and Calleja, Marisol and {Plaza-Nieto}, Jos{\'e} Francisco and {Pilo-de-la-Fuente}, Bel{\'e}n and {Arroyo-Solera}, Margarita and {Garc{\'i}a-Albea}, Esteban and Ag{\'u}ndez, Jos{\'e} A G},
  year = {2015},
  month = aug,
  journal = {Medicine},
  volume = {94},
  number = {34},
  pages = {e1448},
  publisher = {{Lippincott Williams and Wilkins (E-mail: kathiest.clai@apta.org)}},
  address = {United States},
  abstract = {Several neurochemical, neuropathological, neuroimaging, and experimental data, suggest that iron deficiency plays an important role in the pathophysiology of restless legs syndrome (RLS). Heme-oxygenases (HMOX) are an important defensive mechanism against oxidative stress, mainly through the degradation of heme to biliverdin, free iron, and carbon monoxide. We analyzed whether HMOX1 and HMOX2 genes are related with the risk to develop RLS.We analyzed the distribution of genotypes and allelic frequencies of the HMOX1 rs2071746, HMOX1 rs2071747, HMOX2 rs2270363, and HMOX2 rs1051308 SNPs, as well as the presence of Copy number variations (CNVs) of these genes in 205 subjects RLS and 445 healthy controls.The frequencies of rs2071746TT genotype and rs2071746T allelic variant were significantly lower in RLS patients than that in controls, although the other 3 studied SNPs did not differ between RLS patients and controls. None of the studied polymorphisms influenced the disease onset, severity of RLS, family history of RLS, serum ferritin levels, or response to dopaminergic agonist, clonazepam or GABAergic drugs.The present study suggests a weak association between HMOX1 rs2071746 polymorphism and the risk to develop RLS in the Spanish population.},
  langid = {english},
  keywords = {*gene,*genetic risk,*genetic variability,*heme oxygenase 1/ec [Endogenous Compound],*heme oxygenase 2/ec [Endogenous Compound],*Hmox1 gene,*HMOX2 gene,*restless legs syndrome,adult,article,clonazepam,controlled study,copy number variation,dopamine receptor stimulating agent,female,ferritin blood level,ferritin/ec [Endogenous Compound],gabapentin,gene frequency,gene identification,genetic association,genomic DNA/ec [Endogenous Compound],genotype,haplotype,human,major clinical study,male,middle aged,null allele,open reading frame,ovid_export_ris.ris,predictive value,priority journal,single nucleotide polymorphism}
}

@article{garcia-santosHO1PolymorphismGenetic2010,
  title = {{{HO-1}} Polymorphism as a Genetic Determinant behind the Malaria Resistance Afforded by Haemolytic Disorders},
  author = {{Garcia-Santos}, D and Chies, J A B},
  year = {2010},
  month = may,
  journal = {Med. Hypotheses},
  volume = {74},
  number = {5},
  pages = {807--813},
  abstract = {Malaria affects thousands of people around the world representing a critical issue regarding health policies in tropical countries. Similarly, also haemolytic diseases such as sickle cell disease and thalassemias are a concern in different parts of the globe. It is well established that haemolytic diseases, such as sickle cell disease (SCD) and thalassemias, represent a resistance factor to malaria, which explains the high frequencies of such genetic variants in malaria endemic areas. In this context, it has been shown that the rate limiting enzyme heme oxygenase I (HO-1), responsible for the catabolism of the free heme in the body, is an important resistance factor in malaria and is also important in the physiopathology of haemolytic diseases. Here, we suggest that allelic variants of HO-1, which display significant differences in terms of protein expression, have been selected in endemic malaria areas since the HO-1 enzyme can enhance the protection against malaria conferred by haemolytic diseases This protection apply mainly in what concerns protection against severe malaria forms. Therefore, HO-1 genotyping would be fundamental to determine resistance of a given individual to lethal forms of malaria as well as to common clinical complications typical to haemolytic diseases and would be helpful in the establishment of public health politics.},
  langid = {english}
}

@article{Garcia-Talavera2012-wi,
  title = {{{SPECT-CT}} in the Localization of an Ectopic Retropharyngeal Parathyroid Adenoma as a Cause for Persistent Primary Hyperparathyroidism},
  author = {{Garcia-Talavera}, P and Gonzalez, M L and Ais, G and Olmos, R and Ruiz, M A and Sainz, A and Gamazo, C and Gomez, A},
  year = {2012},
  journal = {Revista espanola de medicina nuclear e imagen molecular},
  series = {[{{Erratum}} Appears in Rev Esp Med Nucl Imagen Mol. 2013 {{Jan}};32(1):64]},
  volume = {31},
  number = {5},
  pages = {275--277},
  publisher = {Servicio de Medicina Nuclear, Hospital Clinico Universitario de Valladolid, Valladolid, Spain. palomagtalavera@gmail.com},
  address = {Spain},
  abstract = {A common cause for surgical failure of primary hyperparathyroidism (pHPT) is the non-detection of an ectopic adenoma during the intervention. We present a case of a patient with pHPT in whom an ectopic gland was found in the right retropharyngeal space by means of a double phase (99m)Tc-methoxy-isobutyl-isonitrile ((99m)Tc-MIBI) scintigraphy and early SPECT-CT after several surgeries and imaging tests. The addition of a tomography to the planar scintigraphy increases its sensitivity and improves pathological parathyroid glands localization. The hybrid imaging is sometimes essential to obtain surgical success, as in the case of ectopic adenomas. Copyright 2011 Elsevier Espana, S.L. y SEMNIM. All rights reserved.},
  keywords = {*Adenoma/ri [Radionuclide Imaging],*Choristoma/ri [Radionuclide Imaging],*Hyperparathyroidism,*Parathyroid Neoplasms/ri [Radionuclide Imaging],*Pharyngeal Diseases/ri [Radionuclide Imaging],*Positron-Emission Tomography and Computed Tomogra,Adenoma/co [Complications],Adenoma/su [Surgery],Choristoma/co [Complications],Choristoma/su [Surgery],Female,Humans,Hypercalcemia/et [Etiology],Hyperparathyroidism,Kidney Calculi/et [Etiology],Mendeley Import (Dec 08),Middle Aged,Parathyroid Neoplasms/co [Complications],Parathyroid Neoplasms/su [Surgery],Pharyngeal Diseases/co [Complications],Pharyngeal Diseases/su [Surgery],Primary/et [Etiology],Primary/ri [Radionuclide Ima,Radiopharmaceuticals/du [Diagnostic Use],Reoperation,Technetium Tc 99m Sestamibi/du [Diagnostic Use]}
}

